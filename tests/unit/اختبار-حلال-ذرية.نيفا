# اختبار وحدة حلّال — الذرية: حل ناجح يكتب القفل كاملا، وحل فاشل لا يمس القفل القديم، وحل ناجح ثان يستبدل القديم، ولا ملف مؤقت يبقى
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل
استورد حلال

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح3_مرشح(ح3_نص_بيان، ح3_مصدر، ح3_منشور):
  م_ن = بيان.حلّل_بيان(ح3_نص_بيان)
  إذا م_ن["نجاح"] == خطأ:
    ارجع م_ن
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": م_ن["بيان"]["إصدار"]، "بيان": م_ن["بيان"]، "مصدر": ح3_مصدر، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"، "منشور": ح3_منشور}}

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"
ح3_خيارات = حلال.خيارات_افتراضية()
ح3_مسار = "قفل-ذرية-اختبار.حزمة"

ح3_م_أ = ح3_مرشح("اسم: حزمة-أ\nإصدار: 1.0.0\n", "مصدر-أ", لاشيء)
تحقق(ح3_م_أ["نجاح"], "تحليل مرشح أ")
ح3_م_ب = ح3_مرشح("اسم: حزمة-ب\nإصدار: 1.0.0\n", "مصدر-ب", لاشيء)
تحقق(ح3_م_ب["نجاح"], "تحليل مرشح ب")
ح3_بيان_أول = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ ^1.0\n")
تحقق(ح3_بيان_أول["نجاح"], "تحليل بيان أول")
ح3_قفل_أول = حلال.حلّ_إلى_قفل(ح3_بيان_أول["بيان"], {"حزمة-أ": [ح3_م_أ["مرشح"]]}, ح3_خيارات, ح3_مسار)
تحقق(ح3_قفل_أول["نجاح"], "حل أول ناجح يكتب")
ح3_متوقع_أول = "# قفل حزم — يولَّد آليا؛ لا تحرره بيدك\nحزمة-أ 1.0.0 مصدر-أ 9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c\n"
ح3_مقروء_أول = اقرأ_ملف(ح3_مسار)
تحقق(ح3_مقروء_أول == ح3_متوقع_أول, "ملف القفل الأول نصا حرفيا")
تحقق(ح3_قفل_أول["قفل"] == ح3_متوقع_أول, "القفل المولد الأول نصا حرفيا")
تحقق(موجود(ح3_مسار + ".مؤقت") == خطأ, "لا ملف مؤقت بعد كتابة ناجحة")

ح3_م_أ_متعارض = ح3_مرشح("اسم: حزمة-أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-ب 1.2.3\n", "مصدر-أ", لاشيء)
تحقق(ح3_م_أ_متعارض["نجاح"], "تحليل مرشح أ متعارض")
ح3_م_ب_متعارض = ح3_مرشح("اسم: حزمة-ب\nإصدار: 1.0.0\n", "مصدر-ب", لاشيء)
تحقق(ح3_م_ب_متعارض["نجاح"], "تحليل مرشح ب متعارض")
ح3_بيان_فاشل = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ ^1.0\n  حزمة-ب 1.0.0\n")
تحقق(ح3_بيان_فاشل["نجاح"], "تحليل بيان فاشل")
ح3_قفل_فاشل = حلال.حلّ_إلى_قفل(ح3_بيان_فاشل["بيان"], {"حزمة-أ": [ح3_م_أ_متعارض["مرشح"]]، "حزمة-ب": [ح3_م_ب_متعارض["مرشح"]]}, ح3_خيارات, ح3_مسار)
تحقق(ح3_قفل_فاشل["نجاح"] == خطأ, "حل فاشل يرفض")
تحقق_خطأ(ح3_قفل_فاشل, "تعارض اعتماديات في الحزمة حزمة-ب:\n  مشروعي يطلب 1.0.0\n  حزمة-أ يطلب 1.2.3\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما", "رسالة حل فاشل")
ح3_مقروء_بعد_فشل = اقرأ_ملف(ح3_مسار)
تحقق(ح3_مقروء_بعد_فشل == ح3_متوقع_أول, "حل فاشل لا يمس القفل القديم")
تحقق(موجود(ح3_مسار + ".مؤقت") == خطأ, "لا ملف مؤقت بعد حل فاشل")

ح3_بيان_ثان = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ ^1.0\n  حزمة-ب 1.0.0\n")
تحقق(ح3_بيان_ثان["نجاح"], "تحليل بيان ثان")
ح3_قفل_ثان = حلال.حلّ_إلى_قفل(ح3_بيان_ثان["بيان"], {"حزمة-أ": [ح3_م_أ["مرشح"]]، "حزمة-ب": [ح3_م_ب["مرشح"]]}, ح3_خيارات, ح3_مسار)
تحقق(ح3_قفل_ثان["نجاح"], "حل ثان ناجح يكتب")
ح3_متوقع_ثان = "# قفل حزم — يولَّد آليا؛ لا تحرره بيدك\nحزمة-أ 1.0.0 مصدر-أ 9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c\nحزمة-ب 1.0.0 مصدر-ب 9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c\n"
ح3_مقروء_ثان = اقرأ_ملف(ح3_مسار)
تحقق(ح3_مقروء_ثان == ح3_متوقع_ثان, "حل ثان يستبدل القفل القديم كاملا")
تحقق(موجود(ح3_مسار + ".مؤقت") == خطأ, "لا ملف مؤقت بعد كتابة ثانية")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
