# اختبار وحدة حلّال — الدائرة: دائرة مباشرة، ودائرة طويلة، ودائرة بعيدة عن الجذر، وماسة بلا دائرة، وتعارض يسبق الدائرة
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل
استورد حلال

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح3_مرشح(ح3_نص_بيان، ح3_مصدر، ح3_منشور):
  م_ن = بيان.حلّل_بيان(ح3_نص_بيان)
  إذا م_ن["نجاح"] == خطأ:
    ارجع م_ن
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": م_ن["بيان"]["إصدار"]، "بيان": م_ن["بيان"]، "مصدر": ح3_مصدر، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"، "منشور": ح3_منشور}}

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"
ح3_خيارات = حلال.خيارات_افتراضية()

ح3_م_أ = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ب ^1.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ["نجاح"], "تحليل مرشح أ")
ح3_م_ب = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب["نجاح"], "تحليل مرشح ب")
ح3_بيان_دائرة = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n")
تحقق(ح3_بيان_دائرة["نجاح"], "تحليل بيان الدائرة")
ح3_حل_دائرة = حلال.حلّ(ح3_بيان_دائرة["بيان"], {"حزمة_أ": [ح3_م_أ["مرشح"]]، "حزمة_ب": [ح3_م_ب["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_دائرة["نجاح"] == خطأ, "دائرة مباشرة ترفض")
تحقق_خطأ(ح3_حل_دائرة, "اعتماد دائري: حزمة_أ ← حزمة_ب ← حزمة_أ", "رسالة دائرة مباشرة")

ح3_م_ب2 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^1.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب2["نجاح"], "تحليل مرشح ب طويلة")
ح3_م_ج = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج["نجاح"], "تحليل مرشح ج")
ح3_حل_طويلة = حلال.حلّ(ح3_بيان_دائرة["بيان"], {"حزمة_أ": [ح3_م_أ["مرشح"]]، "حزمة_ب": [ح3_م_ب2["مرشح"]]، "حزمة_ج": [ح3_م_ج["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_طويلة["نجاح"] == خطأ, "دائرة طويلة ترفض")
تحقق_خطأ(ح3_حل_طويلة, "اعتماد دائري: حزمة_أ ← حزمة_ب ← حزمة_ج ← حزمة_أ", "رسالة دائرة طويلة")

ح3_م_أ_بعيدة = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ب ^1.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ_بعيدة["نجاح"], "تحليل مرشح أ بعيدة")
ح3_م_ب_بعيدة = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^1.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب_بعيدة["نجاح"], "تحليل مرشح ب بعيدة")
ح3_م_ج_بعيدة = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ب ^1.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج_بعيدة["نجاح"], "تحليل مرشح ج بعيدة")
ح3_حل_بعيدة = حلال.حلّ(ح3_بيان_دائرة["بيان"], {"حزمة_أ": [ح3_م_أ_بعيدة["مرشح"]]، "حزمة_ب": [ح3_م_ب_بعيدة["مرشح"]]، "حزمة_ج": [ح3_م_ج_بعيدة["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_بعيدة["نجاح"] == خطأ, "دائرة بعيدة عن الجذر ترفض")
تحقق_خطأ(ح3_حل_بعيدة, "اعتماد دائري: حزمة_ب ← حزمة_ج ← حزمة_ب", "رسالة دائرة بعيدة")

ح3_م_أ_ماسة = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ب ^1.0\n  حزمة_ج ^1.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ_ماسة["نجاح"], "تحليل مرشح أ ماسة")
ح3_م_ب_ماسة = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_د ^1.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب_ماسة["نجاح"], "تحليل مرشح ب ماسة")
ح3_م_ج_ماسة = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_د ^1.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج_ماسة["نجاح"], "تحليل مرشح ج ماسة")
ح3_م_د = ح3_مرشح("اسم: حزمة_د\nإصدار: 1.0.0\n", "مصدر_د", لاشيء)
تحقق(ح3_م_د["نجاح"], "تحليل مرشح د")
ح3_حل_ماسة = حلال.حلّ(ح3_بيان_دائرة["بيان"], {"حزمة_أ": [ح3_م_أ_ماسة["مرشح"]]، "حزمة_ب": [ح3_م_ب_ماسة["مرشح"]]، "حزمة_ج": [ح3_م_ج_ماسة["مرشح"]]، "حزمة_د": [ح3_م_د["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_ماسة["نجاح"], "ماسة بلا دائرة تحل")
تحقق(طول(ح3_حل_ماسة["حزم"]) == ٤, "ماسة تحل أربع حزم")

ح3_م_ب_متعارضة = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^2.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب_متعارضة["نجاح"], "تحليل مرشح ب متعارضة")
ح3_م_أ2 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 2.0.0\nاعتماديات:\n  حزمة_ب ^1.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ2["نجاح"], "تحليل مرشح أ 2.0.0")
ح3_حل_متعارضة = حلال.حلّ(ح3_بيان_دائرة["بيان"], {"حزمة_أ": [ح3_م_أ["مرشح"]، ح3_م_أ2["مرشح"]]، "حزمة_ب": [ح3_م_ب_متعارضة["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_متعارضة["نجاح"] == خطأ, "تعارض يسبق الدائرة ويرفض أولا")
تحقق_خطأ(ح3_حل_متعارضة, "تعارض اعتماديات في الحزمة حزمة_أ:\n  مشروعي يطلب ^1.0\n  حزمة_ب يطلب ^2.0\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما", "رسالة تعارض قبل الدائرة")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
