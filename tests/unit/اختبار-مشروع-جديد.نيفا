# اختبار وحدة مشاريع — جديد: القوالب الثلاثة، والهيكل، والبيان، والرفض
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد بيان
استورد مشروع

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

# خارج المشروع أولا: المجلد المؤقت بلا بيان
ح4_خارج = مشروع.اقرأ_مشروع("")
تحقق_خطأ(ح4_خارج، "ليس مشروع حزم — شغّل حزم جديد أولا"، "خارج المشروع يرفض")

# قالب أداة (الافتراضي)
ح4_جديد1 = مشروع.جديد("مشروعي"، "أداة"، "مشروع تجريبي"، "")
تحقق(ح4_جديد1["نجاح"]، "جديد أداة ينجح")
تحقق(موجود("مشروعي/بيان.حزمة")، "بيان الأداة موجود")
تحقق(موجود("مشروعي/مصدر/رئيسي.نيفا")، "دخول الأداة موجود")
تحقق(موجود("مشروعي/حزم")، "مجلد حزم موجود")
تحقق(موجود("مشروعي/اختبارات")، "مجلد اختبارات موجود")
تحقق(موجود("مشروعي/اختبارات/اختبار-أول.نيفا")، "اختبار أول موجود")
تحقق(موجود("مشروعي/قفل.حزمة") == خطأ، "لا قفل عند الإنشاء")
ح4_بيان1 = بيان.اقرأ_بيان("مشروعي/بيان.حزمة")
تحقق(ح4_بيان1["نجاح"]، "بيان الأداة يُحلل")
تحقق(ح4_بيان1["بيان"]["اسم"] == "مشروعي"، "اسم البيان")
تحقق(ح4_بيان1["بيان"]["إصدار"] == "0.1.0"، "إصدار البيان 0.1.0")
تحقق(ح4_بيان1["بيان"]["دخول"] == "مصدر/رئيسي.نيفا"، "دخول الأداة")
تحقق(ح4_بيان1["بيان"]["وصف"] == "مشروع تجريبي"، "وصف البيان")
ح4_نص_دخول = اقرأ_ملف("مشروعي/مصدر/رئيسي.نيفا")
تحقق(ح4_نص_دخول.يحتوي("مرحبا من مشروعي")، "نص دخول الأداة")

# قالب مكتبة
ح4_جديد2 = مشروع.جديد("مكتبتي"، "مكتبة"، "وصف المكتبة"، "")
تحقق(ح4_جديد2["نجاح"]، "جديد مكتبة ينجح")
تحقق(موجود("مكتبتي/مكتبتي.نيفا")، "دخول المكتبة ملف الجذر")
تحقق(موجود("مكتبتي/مصدر") == خطأ، "المكتبة بلا مصدر/")
تحقق(موجود("مكتبتي/اختبارات/اختبار-أول.نيفا")، "اختبار أول في المكتبة")
ح4_بيان2 = بيان.اقرأ_بيان("مكتبتي/بيان.حزمة")
تحقق(ح4_بيان2["نجاح"]، "بيان المكتبة يُحلل")
تحقق(ح4_بيان2["بيان"]["دخول"] == "مكتبتي.نيفا"، "دخول المكتبة")
تحقق(ح4_بيان2["بيان"]["وصف"] == "وصف المكتبة"، "وصف المكتبة")
ح4_نص_مكتبة = اقرأ_ملف("مكتبتي/مكتبتي.نيفا")
تحقق(ح4_نص_مكتبة.يحتوي("صدر مرحبا")، "مكتبة تصدر مرحبا")

# قالب فارغ
ح4_جديد3 = مشروع.جديد("فارغي"، "فارغ"، "", "")
تحقق(ح4_جديد3["نجاح"]، "جديد فارغ ينجح")
تحقق(موجود("فارغي/مصدر") == خطأ، "الفارغ بلا مصدر/")
تحقق(موجود("فارغي/مصدر/رئيسي.نيفا") == خطأ، "الفارغ بلا ملف دخول")
تحقق(موجود("فارغي/اختبارات/اختبار-أول.نيفا")، "اختبار أول في الفارغ")
ح4_بيان3 = بيان.اقرأ_بيان("فارغي/بيان.حزمة")
تحقق(ح4_بيان3["نجاح"]، "بيان الفارغ يُحلل")
تحقق(ح4_بيان3["بيان"]["دخول"] == "مصدر/رئيسي.نيفا"، "دخول الفارغ الافتراضي")

# الشرطة السفلية فاصل قانوني في الاسم
ح4_جديد4 = مشروع.جديد("مشروع_جديد"، "أداة"، "", "")
تحقق(ح4_جديد4["نجاح"]، "اسم بشرطة سفلية ينجح")

# الرفض: موجود، وشرطة، وغير صالح، ووحدة أصلية، وقالب غريب
ح4_مكرر = مشروع.جديد("مشروعي"، "أداة"، "", "")
تحقق_خطأ(ح4_مكرر، "المجلد مشروعي موجود — اختر اسما آخر"، "مجلد موجود يرفض")
ح4_شرطة = مشروع.جديد("مشروع-سيئ"، "أداة"، "", "")
تحقق_خطأ(ح4_شرطة، "اسم المشروع مشروع-سيئ فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"، "شرطة في الاسم ترفض")
ح4_سيئ = مشروع.جديد("مشروع سيئ"، "أداة"، "", "")
تحقق_خطأ(ح4_سيئ، "اسم مشروع غير صالح: مشروع سيئ"، "اسم بفراغ يرفض")
ح4_أصلي = مشروع.جديد("تشفير"، "أداة"، "", "")
تحقق_خطأ(ح4_أصلي، "تشفير وحدة أصلية — لا يمكن تثبيت حزمة بهذا الاسم"، "اسم وحدة أصلية يرفض")
ح4_قالب = مشروع.جديد("مشروع_قالب"، "غريب"، "", "")
تحقق_خطأ(ح4_قالب، "قالب غير معروف: غريب — القوالب: أداة، مكتبة، فارغ"، "قالب غريب يرفض")

# أساس متداخل: القاعدة موجودة والمشروع داخلها
أنشئ_مجلد("قاعدة")
ح4_جديد5 = مشروع.جديد("داخلي"، "أداة"، "", "قاعدة")
تحقق(ح4_جديد5["نجاح"]، "جديد بأساس ينجح")
تحقق(موجود("قاعدة/داخلي/بيان.حزمة")، "مشروع داخل القاعدة")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
