# اختبار وحدة حلّال — وضع الأدنى: أدنى مباشر، وأدنى مع الأحدث، ومحدد ثابت في الوضعين، وأدنى متعدٍّ عبر الشجرة، ووحدات اختر_أدنى
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل
استورد حلال

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح3_مرشح(ح3_نص_بيان، ح3_مصدر، ح3_منشور):
  م_ن = بيان.حلّل_بيان(ح3_نص_بيان)
  إذا م_ن["نجاح"] == خطأ:
    ارجع م_ن
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": م_ن["بيان"]["إصدار"]، "بيان": م_ن["بيان"]، "مصدر": ح3_مصدر، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"، "منشور": ح3_منشور}}

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"
ح3_خيارات_أدنى = {"وضع": "الأدنى"، "تهدئة_أيام": ٠، "الآن": لاشيء، "مصادر": {}، "تطوير": خطأ، "مثبّتة": []، "هدف_تحديث": لاشيء}

ح3_م_أ10 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ10["نجاح"], "تحليل أ 1.0.0")
ح3_م_أ15 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.5.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ15["نجاح"], "تحليل أ 1.5.0")
ح3_م_أ19 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.9.9\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ19["نجاح"], "تحليل أ 1.9.9")
ح3_فهرس_أ = {"حزمة_أ": [ح3_م_أ19["مرشح"]، ح3_م_أ10["مرشح"]، ح3_م_أ15["مرشح"]]}
ح3_بيان_نطاق = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n")
تحقق(ح3_بيان_نطاق["نجاح"], "تحليل بيان النطاق")

ح3_حل_أدنى = حلال.حلّ(ح3_بيان_نطاق["بيان"], ح3_فهرس_أ, ح3_خيارات_أدنى)
تحقق(ح3_حل_أدنى["نجاح"], "الأدنى المباشر يحل")
تحقق(ح3_حل_أدنى["حزم"][٠]["إصدار"] == "1.0.0", "الأدنى المباشر يأخذ الأدنى")
ح3_حل_أحدث = حلال.حلّ(ح3_بيان_نطاق["بيان"], ح3_فهرس_أ, حلال.خيارات_افتراضية())
تحقق(ح3_حل_أحدث["نجاح"], "الأحدث المباشر يحل")
تحقق(ح3_حل_أحدث["حزم"][٠]["إصدار"] == "1.9.9", "الأحدث المباشر يأخذ الأحدث")

ح3_م_أ20 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 2.0.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ20["نجاح"], "تحليل أ 2.0.0")
ح3_م_أ30_تجريبي = ح3_مرشح("اسم: حزمة_أ\nإصدار: 3.0.0-تجريبي\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ30_تجريبي["نجاح"], "تحليل أ 3.0.0 تجريبي")
ح3_فهرس_أحدث = {"حزمة_أ": [ح3_م_أ10["مرشح"]، ح3_م_أ20["مرشح"]، ح3_م_أ30_تجريبي["مرشح"]]}
ح3_بيان_أحدث = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ الأحدث\n")
تحقق(ح3_بيان_أحدث["نجاح"], "تحليل بيان الأحدث")
ح3_حل_أدنى_أحدث = حلال.حلّ(ح3_بيان_أحدث["بيان"], ح3_فهرس_أحدث, ح3_خيارات_أدنى)
تحقق(ح3_حل_أدنى_أحدث["نجاح"], "الأدنى مع الأحدث يحل")
تحقق(ح3_حل_أدنى_أحدث["حزم"][٠]["إصدار"] == "1.0.0", "الأدنى مع الأحدث يأخذ الأدنى المستقر")
ح3_حل_أحدث_أحدث = حلال.حلّ(ح3_بيان_أحدث["بيان"], ح3_فهرس_أحدث, حلال.خيارات_افتراضية())
تحقق(ح3_حل_أحدث_أحدث["نجاح"], "الأحدث مع الأحدث يحل")
تحقق(ح3_حل_أحدث_أحدث["حزم"][٠]["إصدار"] == "2.0.0", "الأحدث مع الأحدث يتخطى التجريبي")

ح3_بيان_محدد = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ 1.5.0\n")
تحقق(ح3_بيان_محدد["نجاح"], "تحليل بيان المحدد")
ح3_حل_أدنى_محدد = حلال.حلّ(ح3_بيان_محدد["بيان"], ح3_فهرس_أ, ح3_خيارات_أدنى)
تحقق(ح3_حل_أدنى_محدد["نجاح"], "الأدنى مع محدد يحل")
تحقق(ح3_حل_أدنى_محدد["حزم"][٠]["إصدار"] == "1.5.0", "الأدنى مع محدد يثبت المحدد")

ح3_م_أ10_ب1 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ب ^1.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ10_ب1["نجاح"], "تحليل أ 1.0.0 مع ب")
ح3_م_أ19_ب2 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.9.9\nاعتماديات:\n  حزمة_ب ^2.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ19_ب2["نجاح"], "تحليل أ 1.9.9 مع ب")
ح3_م_ب10 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب10["نجاح"], "تحليل ب 1.0.0")
ح3_م_ب15 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.5.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب15["نجاح"], "تحليل ب 1.5.0")
ح3_م_ب20 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 2.0.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب20["نجاح"], "تحليل ب 2.0.0")
ح3_فهرس_متعد = {"حزمة_أ": [ح3_م_أ10_ب1["مرشح"]، ح3_م_أ19_ب2["مرشح"]]، "حزمة_ب": [ح3_م_ب10["مرشح"]، ح3_م_ب15["مرشح"]، ح3_م_ب20["مرشح"]]}
ح3_حل_أدنى_متعد = حلال.حلّ(ح3_بيان_نطاق["بيان"], ح3_فهرس_متعد, ح3_خيارات_أدنى)
تحقق(ح3_حل_أدنى_متعد["نجاح"], "الأدنى المتعدي يحل")
تحقق(ح3_حل_أدنى_متعد["حزم"][٠]["إصدار"] == "1.0.0", "الأدنى المتعدي يأخذ أدنى أ")
تحقق(ح3_حل_أدنى_متعد["حزم"][١]["إصدار"] == "1.0.0", "الأدنى المتعدي يأخذ أدنى ب")
ح3_حل_أحدث_متعد = حلال.حلّ(ح3_بيان_نطاق["بيان"], ح3_فهرس_متعد, حلال.خيارات_افتراضية())
تحقق(ح3_حل_أحدث_متعد["نجاح"], "الأحدث المتعدي يحل")
تحقق(ح3_حل_أحدث_متعد["حزم"][٠]["إصدار"] == "1.9.9", "الأحدث المتعدي يأخذ أحدث أ")
تحقق(ح3_حل_أحدث_متعد["حزم"][١]["إصدار"] == "2.0.0", "الأحدث المتعدي يأخذ أحدث ب")

ح3_أدنى_وحدة = إصدار.اختر_أدنى("حزمة_أ", {"نوع": "نطاق"، "مواصفة": "^1.0"}, ["1.9.9"، "1.0.0"، "1.5.0"])
تحقق(ح3_أدنى_وحدة["نجاح"], "اختر_أدنى وحدة ينجح")
تحقق(ح3_أدنى_وحدة["إصدار"] == "1.0.0", "اختر_أدنى يأخذ الأدنى من قائمة غير مرتبة")
ح3_أدنى_بلا = إصدار.اختر_أدنى("حزمة_أ", {"نوع": "نطاق"، "مواصفة": "^3.0"}, ["1.9.9"، "1.0.0"])
تحقق(ح3_أدنى_بلا["نجاح"] == خطأ, "اختر_أدنى بلا مطابق يرفض")
تحقق_خطأ(ح3_أدنى_بلا, "لا يوجد إصدار يطابق ^3.0 للحزمة حزمة_أ", "رسالة اختر_أدنى بلا مطابق")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
