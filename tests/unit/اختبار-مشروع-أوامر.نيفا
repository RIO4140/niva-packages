# أضف: متعدية عبر الوسط (وسط + صغيرة معا)
ح4_جديد_وسط = مشروع.جديد("مشروع_وسط"، "أداة"، "", "")
تحقق(ح4_جديد_وسط["نجاح"]، "جديد مشروع_وسط")
ح4_أضف_وسط = مشروع.أضف_اعتماد("مشروع_وسط"، "حزمة_وسط"، لاشيء، ح4_فهرس، {})
تحقق(ح4_أضف_وسط["نجاح"]، "أضف الوسط ينجح")
