ح4_أضف_بقاء1 = مشروع.أضف_اعتماد("مشروع_بقاء"، "حزمة_وسط"، لاشيء، ح4_فهرس، {})
تحقق(ح4_أضف_بقاء1["نجاح"]، "أضف وسط للبقاء")
ح4_أضف_بقاء2 = مشروع.أضف_اعتماد("مشروع_بقاء"، "حزمة_صغيرة"، لاشيء، ح4_فهرس، {})
تحقق(ح4_أضف_بقاء2["نجاح"]، "أضف صغيرة مباشرة للبقاء")
ح4_حذف_بقاء = مشروع.احذف_اعتماد("مشروع_بقاء"، "حزمة_صغيرة"، ح4_فهرس، {})
تحقق(ح4_حذف_بقاء["نجاح"]، "احذف صغيرة المباشرة ينجح")
تحقق(ح4_حذف_بقاء["بقيت"] == "حزمة_صغيرة"، "الصغيرة بقيت")
تحقق(ح4_حذف_بقاء["طالب"] == "حزمة_وسط"، "الطالب هو الوسط")
تحقق(موجود("مشروع_بقاء/حزم/حزمة_صغيرة")، "الصغيرة ما زالت مثبّتة")
ح4_نص_بيان_بقاء = اقرأ_ملف("مشروع_بقاء/بيان.حزمة")
تحقق(ح4_نص_بيان_بقاء.يحتوي("حزمة_صغيرة") == خطأ، "البيان بلا صغيرة المباشرة")

# احذف: غائب، وحذف اعتماد تطوير
ح4_حذف_غائب = مشروع.احذف_اعتماد("مشروعي"، "حزمة_غائبة"، ح4_فهرس، {})
تحقق_خطأ(ح4_حذف_غائب، "الحزمة حزمة_غائبة ليست اعتمادا في المشروع"، "غائب للحذف يرفض")
ح4_حذف_تطوير = مشروع.احذف_اعتماد("مشروع_تطوير"، "حزمة_صغيرة"، ح4_فهرس، {})
