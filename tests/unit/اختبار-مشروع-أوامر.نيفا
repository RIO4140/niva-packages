# اختبار وحدة مشاريع — أوامر: أضف، احذف، تثبيت، تحديث
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد بيان
استورد تشفير
استورد مشروع

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

# مرشح فهرس من مجلد تجهيزة: بصمة حقيقية من بيانها
دالة ح4_مرشح_من_مجلد(ح4_مجلد):
  ح4_بيان = بيان.اقرأ_بيان(ح4_مجلد + "/بيان.حزمة")
  إذا ح4_بيان["نجاح"] == خطأ:
    ارجع ح4_بيان
  ح4_نص = اقرأ_ملف(ح4_مجلد + "/بيان.حزمة")
  ح4_بصمة = تشفير.جزّئ(ح4_نص)
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": ح4_بيان["بيان"]["إصدار"]، "بيان": ح4_بيان["بيان"]، "مصدر": "مصدر_" + ح4_بيان["بيان"]["اسم"]، "بصمة": ح4_بصمة، "مجلد": ح4_مجلد، "منشور": لاشيء}}

ح4_م_صغيرة = ح4_مرشح_من_مجلد("حزمة_صغيرة")
تحقق(ح4_م_صغيرة["نجاح"]، "مرشح الصغيرة 1.0.0")
ح4_م_صغيرة11 = ح4_مرشح_من_مجلد("حزمة_صغيرة_1_1_0")
تحقق(ح4_م_صغيرة11["نجاح"]، "مرشح الصغيرة 1.1.0")
ح4_م_وسط = ح4_مرشح_من_مجلد("حزمة_وسط")
تحقق(ح4_م_وسط["نجاح"]، "مرشح الوسط")
ح4_فهرس = {"حزمة_صغيرة": [ح4_م_صغيرة["مرشح"]، ح4_م_صغيرة11["مرشح"]]، "حزمة_وسط": [ح4_م_وسط["مرشح"]]}
ح4_فهرس_قديم = {"حزمة_صغيرة": [ح4_م_صغيرة["مرشح"]]، "حزمة_وسط": [ح4_م_وسط["مرشح"]]}

# أضف: مواصفة غائبة تعني الأحدث (1.1.0)
ح4_جديد = مشروع.جديد("مشروعي"، "أداة"، "", "")
تحقق(ح4_جديد["نجاح"]، "جديد مشروعي")
ح4_أضف1 = مشروع.أضف_اعتماد("مشروعي"، "حزمة_صغيرة"، لاشيء، ح4_فهرس، {})
تحقق(ح4_أضف1["نجاح"]، "أضف الصغيرة ينجح")
تحقق(ح4_أضف1["إصدار"] == "1.1.0"، "الأحدث 1.1.0")
تحقق(موجود("مشروعي/حزم/حزمة_صغيرة")، "الصغيرة مثبّتة في حزم/")
تحقق(موجود("مشروعي/قفل.حزمة")، "القفل موجود بعد أضف")
ح4_مثبتة1 = بيان.اقرأ_بيان("مشروعي/حزم/حزمة_صغيرة/بيان.حزمة")
تحقق(ح4_مثبتة1["نجاح"]، "بيان المثبّتة يُحلل")
تحقق(ح4_مثبتة1["بيان"]["إصدار"] == "1.1.0"، "المثبّتة 1.1.0")
ح4_نص_قفل1 = اقرأ_ملف("مشروعي/قفل.حزمة")
تحقق(ح4_نص_قفل1.يحتوي("حزمة_صغيرة 1.1.0")، "القفل فيه الصغيرة 1.1.0")
