ح4_حدث_دقيق_صريح = مشروع.حدّث("مشروع_دقيق"، "حزمة_صغيرة"، "1.0.0"، ح4_فهرس، {})
تحقق(ح4_حدث_دقيق_صريح["نجاح"]، "تحديث دقيق بإصدار صريح ينجح")
تحقق(ح4_حدث_دقيق_صريح["إصدار"] == "1.0.0"، "الصريح أعاد إلى 1.0.0")
ح4_حدث_غائب = مشروع.حدّث("مشروع_دقيق"، "حزمة_غائبة"، لاشيء، ح4_فهرس، {})
تحقق_خطأ(ح4_حدث_غائب، "الحزمة حزمة_غائبة غير مثبّتة — لا يمكن تحديثها"، "تحديث غائب يرفض")

# تحديث: المحدد الدقيق لا يتحرك في التحديث الكلي
ح4_جديد_دقيق2 = مشروع.جديد("مشروع_دقيق2"، "أداة"، "", "")
تحقق(ح4_جديد_دقيق2["نجاح"]، "جديد مشروع_دقيق2")
ح4_أضف_دقيق2_ص = مشروع.أضف_اعتماد("مشروع_دقيق2"، "حزمة_صغيرة"، "1.0.0"، ح4_فهرس، {})
تحقق(ح4_أضف_دقيق2_ص["نجاح"]، "أضف محدد دقيق")
ح4_حدث_كلي_دقيق = مشروع.حدّث("مشروع_دقيق2"، لاشيء، لاشيء، ح4_فهرس، {})
تحقق(ح4_حدث_كلي_دقيق["نجاح"]، "تحديث كلي للمحدد ينجح")
ح4_مثبتة_بعد_كلي = بيان.اقرأ_بيان("مشروع_دقيق2/حزم/حزمة_صغيرة/بيان.حزمة")
تحقق(ح4_مثبتة_بعد_كلي["بيان"]["إصدار"] == "1.0.0"، "المحدد الدقيق بقي 1.0.0")


# الثقة (الفكرة 6 + القاعدة 5): بلا بصمة مسجلة لا تثبيت،
# ولا مخرج صامت عند عدم تطابق بصمة — فالمصدر المعدَّل
# يُرفض قبل النسخ، ولا يبقى تثبيت جزئي أبدا.
# مرشح بلا بصمة يرفضه الحلّ نفسه قبل الوصول إلى التثبيت
ح4_جديد_بلا = مشروع.جديد("مشروع_بلا_بصمة"، "أداة"، "", "")
تحقق(ح4_جديد_بلا["نجاح"]، "جديد مشروع_بلا_بصمة")
ح4_مرشح_بلا = {"إصدار": "1.0.0"، "بيان": ح4_م_صغيرة["مرشح"]["بيان"]، "مصدر": "مصدر_حزمة_صغيرة"، "بصمة": ""، "مجلد": "حزمة_صغيرة"، "منشور": لاشيء}
ح4_فهرس_بلا = {"حزمة_صغيرة": [ح4_مرشح_بلا]}
ح4_أضف_بلا = مشروع.أضف_اعتماد("مشروع_بلا_بصمة"، "حزمة_صغيرة"، لاشيء، ح4_فهرس_بلا، {})
تحقق_خطأ(ح4_أضف_بلا، "لا يوجد إصدار للحزمة حزمة_صغيرة"، "مرشح بلا بصمة يرفضه الحل")
تحقق(موجود("مشروع_بلا_بصمة/حزم/حزمة_صغيرة") == خطأ، "بلا بصمة بلا تثبيت")
تحقق(موجود("مشروع_بلا_بصمة/قفل.حزمة") == خطأ، "بلا بصمة بلا قفل")

# فحص المزامنة المباشر: بصمة مسجلة غير صالحة تُرفض
ح4_مزامنة_بلا = مشروع.مزامنة_حزم("مشروع_بلا_بصمة"، [{"اسم": "حزمة_صغيرة"، "إصدار": "1.0.0"، "مصدر": "مصدر_حزمة_صغيرة"، "بصمة": ""}]، ح4_فهرس)
تحقق_خطأ(ح4_مزامنة_بلا، "الحزمة حزمة_صغيرة بلا بصمة مسجلة — لا يمكن تثبيتها"، "مزامنة بلا بصمة ترفض")
تحقق(موجود("مشروع_بلا_بصمة/حزم/حزمة_صغيرة") == خطأ، "مزامنة بلا بصمة بلا مجلد")

# مصدر معدَّل: نسخة ببيان مغير وبصمة الأصل — تُرفض قبل النسخ
ح4_نسخ_معدلة = مشروع.انسخ_مجلد("حزمة_صغيرة"، "حزمة_معدلة")
تحقق(ح4_نسخ_معدلة["نجاح"]، "نسخ المعدلة")
ح4_بصمة_أصل = تشفير.جزّئ(اقرأ_ملف("حزمة_صغيرة/بيان.حزمة"))
ح4_نص_معدلة = اقرأ_ملف("حزمة_معدلة/بيان.حزمة")
اكتب_ملف("حزمة_معدلة/بيان.حزمة", ح4_نص_معدلة.استبدل("حزمة صغيرة للاختبار", "حزمة معدلة"))
ح4_مرشح_معدل = {"إصدار": "1.0.0"، "بيان": ح4_م_صغيرة["مرشح"]["بيان"]، "مصدر": "مصدر_حزمة_صغيرة"، "بصمة": ح4_بصمة_أصل، "مجلد": "حزمة_معدلة"، "منشور": لاشيء}
ح4_فهرس_معدل = {"حزمة_صغيرة": [ح4_مرشح_معدل]}
ح4_جديد_معدلة = مشروع.جديد("مشروع_معدلة"، "أداة"، "", "")
تحقق(ح4_جديد_معدلة["نجاح"]، "جديد مشروع_معدلة")
ح4_أضف_معدلة = مشروع.أضف_اعتماد("مشروع_معدلة"، "حزمة_صغيرة"، لاشيء، ح4_فهرس_معدل، {})
تحقق_خطأ(ح4_أضف_معدلة، "بصمة الحزمة حزمة_صغيرة لا تطابق البصمة المسجلة"، "مصدر معدَّل يرفض في أضف")
تحقق(موجود("مشروع_معدلة/حزم/حزمة_صغيرة") == خطأ، "معدَّل بلا تثبيت جزئي")
تحقق(موجود("مشروع_معدلة/قفل.حزمة") == خطأ، "معدَّل بلا قفل")

# تثبيت القفل حرفيا من مصدر معدَّل: يُرفض ولا يبقى مجلد
ح4_جديد_بصمة = مشروع.جديد("مشروع_بصمة"، "أداة"، "", "")
تحقق(ح4_جديد_بصمة["نجاح"]، "جديد مشروع_بصمة")
ح4_أضف_بصمة = مشروع.أضف_اعتماد("مشروع_بصمة"، "حزمة_صغيرة"، "1.0.0"، ح4_فهرس، {})
تحقق(ح4_أضف_بصمة["نجاح"]، "أضف للبصمة")
ح4_حذف_بصمة = مشروع.احذف_شجرة("مشروع_بصمة/حزم")
تحقق(ح4_حذف_بصمة["نجاح"]، "حذف حزم البصمة")
ح4_ثبت_معدل = مشروع.ثبّت_القفل("مشروع_بصمة"، ح4_فهرس_معدل، {})
تحقق_خطأ(ح4_ثبت_معدل، "بصمة الحزمة حزمة_صغيرة لا تطابق البصمة المسجلة"، "مصدر معدَّل يرفض في تثبيت القفل")
تحقق(موجود("مشروع_بصمة/حزم/حزمة_صغيرة") == خطأ، "تثبيت معدَّل بلا مجلد")

