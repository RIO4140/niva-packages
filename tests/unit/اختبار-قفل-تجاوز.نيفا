# اختبار وحدة قفل — التجاوز: توليد مع تجاوزات، وتحليل يعيدها، وقفل قديم بلا تجاوزات، وتحقق ضد بيان مع تجاوز، وتجاوز مكرر، وسطر تجاوز ناقص
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"
ح3_حزم = [{"اسم": "حزمة_أ"، "إصدار": "1.0.0"، "مصدر": "مصدر_أ"، "بصمة": ح3_بصمة}، {"اسم": "حزمة_ج"، "إصدار": "1.2.3"، "مصدر": "مصدر_ج"، "بصمة": ح3_بصمة}]
ح3_تجاوزات = [{"اسم": "حزمة_ج"، "إصدار": "1.2.3"}]

ح3_قفل = قفل.ولّد_قفل_بتجاوز(ح3_حزم، ح3_تجاوزات)
تحقق(ح3_قفل["نجاح"], "توليد قفل مع تجاوز ينجح")
ح3_متوقع = "# قفل حزم — يولَّد آليا؛ لا تحرره بيدك\nحزمة_أ 1.0.0 مصدر_أ 9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c\nحزمة_ج 1.2.3 مصدر_ج 9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c\n# تجاوز: حزمة_ج 1.2.3\n"
تحقق(ح3_قفل["قفل"] == ح3_متوقع, "نص القفل مع تجاوز حرفيا")

ح3_محلل = قفل.حلّل_قفل(ح3_قفل["قفل"])
تحقق(ح3_محلل["نجاح"], "تحليل قفل مع تجاوز ينجح")
تحقق(طول(ح3_محلل["حزم"]) == ٢, "تحليل القفل يعيد حزمتين")
تحقق(طول(ح3_محلل["تجاوزات"]) == ١, "تحليل القفل يعيد تجاوزا واحدا")
تحقق(ح3_محلل["تجاوزات"][٠]["اسم"] == "حزمة_ج", "تحليل القفل يعيد اسم التجاوز")
تحقق(ح3_محلل["تجاوزات"][٠]["إصدار"] == "1.2.3", "تحليل القفل يعيد إصدار التجاوز")

ح3_قفل_قديم = قفل.ولّد_قفل(ح3_حزم)
تحقق(ح3_قفل_قديم["نجاح"], "توليد قفل قديم ينجح")
ح3_محلل_قديم = قفل.حلّل_قفل(ح3_قفل_قديم["قفل"])
تحقق(ح3_محلل_قديم["نجاح"], "تحليل قفل قديم ينجح")
تحقق(طول(ح3_محلل_قديم["تجاوزات"]) == ٠, "قفل قديم بلا تجاوزات")

ح3_بيان_تجاوز = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n  حزمة_ج 1.2.3\nتجاوز:\n  حزمة_ج 1.2.3\n")
تحقق(ح3_بيان_تجاوز["نجاح"], "تحليل بيان تجاوز")
ح3_تحقق_صحيح = قفل.تحقق_قفل_ضد_بيان(ح3_بيان_تجاوز["بيان"], ح3_محلل["حزم"])
تحقق(ح3_تحقق_صحيح["نجاح"], "قفل يطابق بيانا مع تجاوز ينجح")
ح3_حزم_مختلف = [{"اسم": "حزمة_أ"، "إصدار": "1.0.0"، "مصدر": "مصدر_أ"، "بصمة": ح3_بصمة}، {"اسم": "حزمة_ج"، "إصدار": "1.5.0"، "مصدر": "مصدر_ج"، "بصمة": ح3_بصمة}]
ح3_تحقق_مختلف = قفل.تحقق_قفل_ضد_بيان(ح3_بيان_تجاوز["بيان"], ح3_حزم_مختلف)
تحقق(ح3_تحقق_مختلف["نجاح"] == خطأ, "قفل يخالف تجاوز البيان يرفض")
تحقق_خطأ(ح3_تحقق_مختلف, "البيان والقفل مختلفان — شغّل حزم تحديث", "رسالة قفل يخالف التجاوز")
ح3_حزم_ناقص = [{"اسم": "حزمة_أ"، "إصدار": "1.0.0"، "مصدر": "مصدر_أ"، "بصمة": ح3_بصمة}]
ح3_تحقق_ناقص = قفل.تحقق_قفل_ضد_بيان(ح3_بيان_تجاوز["بيان"], ح3_حزم_ناقص)
تحقق(ح3_تحقق_ناقص["نجاح"] == خطأ, "قفل ينقصه حزمة التجاوز يرفض")
تحقق_خطأ(ح3_تحقق_ناقص, "البيان والقفل مختلفان — شغّل حزم تحديث", "رسالة قفل ينقصه التجاوز")
ح3_بيان_تجاوز_وحده = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\nتجاوز:\n  حزمة_ج 1.2.3\n")
تحقق(ح3_بيان_تجاوز_وحده["نجاح"], "تحليل بيان تجاوز وحده")
ح3_تحقق_تجاوز_وحده = قفل.تحقق_قفل_ضد_بيان(ح3_بيان_تجاوز_وحده["بيان"], ح3_حزم_مختلف)
تحقق(ح3_تحقق_تجاوز_وحده["نجاح"] == خطأ, "قفل يخالف التجاوز وحده يرفض")
تحقق_خطأ(ح3_تحقق_تجاوز_وحده, "البيان والقفل مختلفان — شغّل حزم تحديث", "رسالة قفل يخالف التجاوز وحده")

ح3_قفل_مكرر = قفل.ولّد_قفل_بتجاوز(ح3_حزم, [{"اسم": "حزمة_ج"، "إصدار": "1.2.3"}، {"اسم": "حزمة_ج"، "إصدار": "1.5.0"}])
تحقق(ح3_قفل_مكرر["نجاح"] == خطأ, "تجاوز مكرر في القفل يرفض")
تحقق_خطأ(ح3_قفل_مكرر, "تجاوز مكرر في القفل: حزمة_ج", "رسالة تجاوز مكرر في القفل")

ح3_نص_ناقص = "# قفل حزم — يولَّد آليا؛ لا تحرره بيدك\n# تجاوز: حزمة_ج\nحزمة_أ 1.0.0 مصدر_أ 9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c\n"
ح3_محلل_ناقص = قفل.حلّل_قفل(ح3_نص_ناقص)
تحقق(ح3_محلل_ناقص["نجاح"] == خطأ, "سطر تجاوز ناقص يرفض")
تحقق_خطأ(ح3_محلل_ناقص, "سطر غير صالح في القفل (السطر 2)", "رسالة سطر تجاوز ناقص")

ح3_نص_مكرر = "# قفل حزم — يولَّد آليا؛ لا تحرره بيدك\n# تجاوز: حزمة_ج 1.2.3\n# تجاوز: حزمة_ج 1.5.0\nحزمة_أ 1.0.0 مصدر_أ 9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c\n"
ح3_محلل_مكرر = قفل.حلّل_قفل(ح3_نص_مكرر)
تحقق(ح3_محلل_مكرر["نجاح"] == خطأ, "سطرا تجاوز لنفس الحزمة يرفضان")
تحقق_خطأ(ح3_محلل_مكرر, "تجاوز مكرر في القفل: حزمة_ج (السطر 3)", "رسالة سطري تجاوز مكررين")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
