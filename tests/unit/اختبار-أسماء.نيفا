# اختبار وحدة أسماء — صحة اسم الحزمة والمساواة الحرفية بين الأسماء
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد بيان

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

تحقق(بيان.نفس_الحزمة("أداة-مثال"، "أداة-مثال")، "نفس الاسم")
تحقق(بيان.نفس_الحزمة("أداة-مثال"، "أداة-مثال2") == خطأ، "اسم برقم زائد مختلف")
تحقق(بيان.نفس_الحزمة("أداة"، "أداة ") == خطأ، "مسافة زائدة مختلفة")
تحقق(بيان.نفس_الحزمة("tool"، "tool")، "اسم لاتيني نفسه")
تحقق(بيان.نفس_الحزمة("tool"، "Tool") == خطأ، "حالة الأحرف اللاتينية تفرّق")
تحقق(بيان.نفس_الحزمة("أداة"، "اداة") == خطأ، "همزة وألف تهجئتان مختلفتان")
تحقق(بيان.نفس_الحزمة("أداة"، "أداه") == خطأ، "تاء مربوطة وهاء مختلفتان")

تحقق(بيان.صالح_اسم_حزمة("tool-1")، "اسم لاتيني برقم صالح")
تحقق(بيان.صالح_اسم_حزمة("أداة1")، "اسم برقم صالح")
تحقق(بيان.صالح_اسم_حزمة("أداة_مثال") == خطأ، "اسم بشرطة سفلية مرفوض")
تحقق(بيان.صالح_اسم_حزمة("أداة/مثال") == خطأ، "اسم بشرطة مائلة مرفوض")
تحقق(بيان.صالح_اسم_حزمة("أداة:مثال") == خطأ، "اسم بنقطتين مرفوض")
تحقق(بيان.صالح_اسم_حزمة("أداة،مثال") == خطأ، "اسم بفاصلة عربية مرفوض")
تحقق(بيان.صالح_اسم_حزمة("أداةـمثال") == خطأ، "اسم بتطويل مرفوض")
تحقق(بيان.صالح_اسم_حزمة("أداةً") == خطأ، "اسم بتنوين مرفوض")
تحقق(بيان.صالح_اسم_حزمة("أ")، "اسم حرف واحد صالح")
تحقق(بيان.صالح_اسم_حزمة("1أداة")، "اسم يبدأ برقم صالح")
تحقق(بيان.صالح_اسم_حزمة("أداة-مثال-٢")، "اسم بشرطات وأرقام مشرقية صالح")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
