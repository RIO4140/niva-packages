# اختبار وحدة تجريبي — تحليل الإصدارات التجريبية ومقارنتها
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

ن_تجريبي = إصدار.حلّل_إصدار("1.2.3-تجريبي")
تحقق(ن_تجريبي["نجاح"]، "تحليل تجريبي نجاح")
تحقق(ن_تجريبي["قانوني"] == "1.2.3-تجريبي"، "تجريبي قانوني")
تحقق(ن_تجريبي["تجريبي"]، "تجريبي علم صحيح")
تحقق(ن_تجريبي["لاحقة"] == "تجريبي"، "تجريبي لاحقة")
تحقق(ن_تجريبي["رئيسي"] == ١، "تجريبي رئيسي")
تحقق(ن_تجريبي["فرعي"] == ٢، "تجريبي فرعي")
تحقق(ن_تجريبي["إصلاحي"] == ٣، "تجريبي إصلاحي")
ن_ألفا = إصدار.حلّل_إصدار("1.0.0-ألفا.٢")
تحقق(ن_ألفا["قانوني"] == "1.0.0-ألفا.2"، "ألفا مشرقي يطبّع")
تحقق(ن_ألفا["لاحقة"] == "ألفا.2"، "ألفا لاحقة مطبعة")
ن_بيتا = إصدار.حلّل_إصدار("1.2.3-بيتا-١")
تحقق(ن_بيتا["قانوني"] == "1.2.3-بيتا-1"، "بيتا بشرطة يطبّع")
ن_لاتيني = إصدار.حلّل_إصدار("1.0.0-alpha.1")
تحقق(ن_لاتيني["قانوني"] == "1.0.0-alpha.1"، "لاحقة لاتينية مقبولة")
ن_مستقر = إصدار.حلّل_إصدار("1.2.3")
تحقق(ن_مستقر["تجريبي"] == خطأ، "مستقر علم خطأ")
تحقق(ن_مستقر["لاحقة"] == لاشيء، "مستقر بلا لاحقة")

ن_فارغ = إصدار.حلّل_إصدار("1.2.3-")
تحقق(ن_فارغ["نجاح"] == خطأ، "رفض لاحقة فارغة")
تحقق_خطأ(ن_فارغ، "إصدار غير صالح: 1.2.3- — الصيغة رئيسي.فرعي.إصلاحي"، "رسالة لاحقة فارغة")
ن_نقطة = إصدار.حلّل_إصدار("1.2.3-.")
تحقق(ن_نقطة["نجاح"] == خطأ، "رفض لاحقة نقطة")
ن_مزدوج = إصدار.حلّل_إصدار("1.2.3-تجريبي..ألفا")
تحقق(ن_مزدوج["نجاح"] == خطأ، "رفض معرف فارغ في اللاحقة")
ن_مسافة = إصدار.حلّل_إصدار("1.2.3-تجريبي ألفا")
تحقق(ن_مسافة["نجاح"] == خطأ، "رفض مسافة في اللاحقة")
ن_زائد = إصدار.حلّل_إصدار("1.2.3-تجريبي+بناء")
تحقق(ن_زائد["نجاح"] == خطأ، "رفض زائد في اللاحقة")
ن_شرطة_سفلية = إصدار.حلّل_إصدار("1.2.3-تجريبي_ألفا")
تحقق(ن_شرطة_سفلية["نجاح"] == خطأ، "رفض شرطة سفلية في اللاحقة")
ن_شرطة = إصدار.حلّل_إصدار("1.2.3--")
تحقق(ن_شرطة["نجاح"] == خطأ، "رفض لاحقة شرطة وحدها")
ن_تعجب = إصدار.حلّل_إصدار("1.2.3-تجريبي!")
تحقق(ن_تعجب["نجاح"] == خطأ، "رفض تعجب في اللاحقة")
ن_فاصلة = إصدار.حلّل_إصدار("1.2.3-تجريبي،ألفا")
تحقق(ن_فاصلة["نجاح"] == خطأ، "رفض فاصلة عربية في اللاحقة")
ن_بناء = إصدار.حلّل_إصدار("1.2.3+بناء")
تحقق(ن_بناء["نجاح"] == خطأ، "رفض بيانات بناء بزائد")

م_أصغر = إصدار.قارن_إصدارين("1.2.3-تجريبي"، "1.2.3")
تحقق(م_أصغر["مقارنة"] < ٠، "تجريبي أصغر من إصداره")
م_ألفا_بيتا = إصدار.قارن_إصدارين("1.0.0-ألفا"، "1.0.0-بيتا")
تحقق(م_ألفا_بيتا["مقارنة"] < ٠، "ألفا أصغر من بيتا")
م_رقمي = إصدار.قارن_إصدارين("1.0.0-ألفا.2"، "1.0.0-ألفا.10")
تحقق(م_رقمي["مقارنة"] < ٠، "معرف رقمي يقارن عدديا")
م_رقمي_حرفي = إصدار.قارن_إصدارين("1.0.0-1"، "1.0.0-ألفا")
تحقق(م_رقمي_حرفي["مقارنة"] < ٠، "معرف رقمي أصغر من حرفي")
م_أطول = إصدار.قارن_إصدارين("1.0.0-ألفا"، "1.0.0-ألفا.1")
تحقق(م_أطول["مقارنة"] < ٠، "قائمة أقصر أصغر")
م_متساو = إصدار.قارن_إصدارين("1.2.3-تجريبي"، "1.2.3-تجريبي")
تحقق(م_متساو["مقارنة"] == ٠، "تجريبيان متساويان")
م_ثلاثية = إصدار.قارن_إصدارين("1.2.4-تجريبي"، "1.2.3")
تحقق(م_ثلاثية["مقارنة"] > ٠، "ثلاثية أعلى تغلب التجريبي")
م_مشرقي = إصدار.قارن_إصدارين("١٫٢٫٣-تجريبي"، "1.2.3-تجريبي")
تحقق(م_مشرقي["مقارنة"] == ٠، "تجريبي مشرقي يساوي لاتينيه")
م_أكبر = إصدار.قارن_إصدارين("1.2.3"، "1.2.3-تجريبي")
تحقق(م_أكبر["مقارنة"] > ٠، "مستقر أكبر من تجريبيه")
م_خاطئ = إصدار.قارن_إصدارين("1.2.3-تجريبي"، "خاطئ")
تحقق(م_خاطئ["نجاح"] == خطأ، "مقارنة تجريبي بخاطئ ترفض")

تحقق(إصدار.صالح_لاحقة("تجريبي.1")، "لاحقة صالحة")
تحقق(إصدار.صالح_لاحقة("") == خطأ، "لاحقة فارغة غير صالحة")
تحقق(إصدار.صالح_لاحقة("-") == خطأ، "لاحقة شرطة غير صالحة")
تحقق(إصدار.صالح_لاحقة("تجريبي_ألفا") == خطأ، "لاحقة بشرطة سفلية غير صالحة")
تحقق(إصدار.صالح_لاحقة("تجريبي.ألفا-٢")، "لاحقة مركبة صالحة")

ت_تجريبي = إصدار.تجريبي("1.2.3-تجريبي")
تحقق(ت_تجريبي["تجريبي"]، "مساعد تجريبي صحيح")
ت_مستقر = إصدار.تجريبي("1.2.3")
تحقق(ت_مستقر["تجريبي"] == خطأ، "مساعد مستقر خطأ")
ت_خاطئ = إصدار.تجريبي("خاطئ")
تحقق(ت_خاطئ["نجاح"] == خطأ، "مساعد خاطئ يرفض")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
