# اختبار وحدة مخزن — المخزن العام وتثبيت محلي
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
# يعمل في مجلد اختبار مؤقت يجهزه مشغّل الاختبارات (المخزن فيه
# .نيفا/حزم/ تحت مجلد البرنامج — فلا يمس مخزنا حقيقيا).
استورد مخزن

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

تحقق(مخزن.مسار_المخزن() == "~/.نيفا/حزم"، "مسار المخزن")

ن_تأكد = مخزن.تأكد_المخزن()
تحقق(ن_تأكد["نجاح"]، "تأكد المخزن")
تحقق(موجود(".نيفا/حزم")، "مجلد المخزن موجود")
تحقق(موجود(".نيفا/حزم/ذاكرة")، "مجلد الذاكرة موجود")
تحقق(موجود(".نيفا/حزم/فهرس")، "مجلد الفهرس موجود")

ن_حجم_فارغ = مخزن.حجم_المخزن()
تحقق(ن_حجم_فارغ["نجاح"]، "حجم مخزن فارغ يقرأ")
تحقق(ن_حجم_فارغ["حجم"] == ٠، "حجم مخزن فارغ صفر")

ن_سقف = مخزن.تحقق_سقف_المخزن(٠)
تحقق(ن_سقف["نجاح"]، "سقف المخزن يقبل صفرا إضافيا")
ن_سقف_ممتلئ = مخزن.تحقق_سقف_المخزن(٢٠٠٠٠٠٠٠٠٠)
تحقق(ن_سقف_ممتلئ["نجاح"] == خطأ، "سقف المخزن يرفض إضافيا ضخما")
تحقق(ن_سقف_ممتلئ["خطأ"] == "مخزن الحزم ممتلئ (1 غيغابايت) — احذف حزمة أو امسح الذاكرة"، "رسالة سقف المخزن")

تحقق(مخزن.ملف_ضمن_السقف(٥٢٤٢٨٨٠)["نجاح"]، "ملف ضمن السقف عند الحد")
تحقق(مخزن.ملف_ضمن_السقف(٥٢٤٢٨٨١)["نجاح"] == خطأ، "ملف فوق السقف يرفض")

ن_حجم_حزمة = مخزن.احسب_حجم_مجلد("أداة_مثال")
تحقق(ن_حجم_حزمة["نجاح"]، "حجم مجلد حزمة يقرأ")
تحقق(ن_حجم_حزمة["حجم"] > ٠، "حجم مجلد حزمة أكبر من صفر")

ن_تثبيت = مخزن.ثبّت_محليا("أداة_مثال")
تحقق(ن_تثبيت["نجاح"]، "تثبيت أداة_مثال")
إذا ن_تثبيت["نجاح"]:
  تحقق(ن_تثبيت["مسار"] == "~/.نيفا/حزم/أداة_مثال-1.0.0"، "تثبيت أداة_مثال المسار")
  تحقق(موجود(".نيفا/حزم/أداة_مثال-1.0.0/بيان.حزمة")، "تثبيت أداة_مثال البيان موجود")
  تحقق(موجود(".نيفا/حزم/أداة_مثال-1.0.0/مصدر/رئيسي.نيفا")، "تثبيت أداة_مثال الدخول موجود")
  نص_المصدر = اقرأ_ملف("أداة_مثال/بيان.حزمة")
  نص_المنسوخ = اقرأ_ملف(".نيفا/حزم/أداة_مثال-1.0.0/بيان.حزمة")
  تحقق(نص_المصدر == نص_المنسوخ، "تثبيت أداة_مثال البيان مطابق")
  نص_دخول_المصدر = اقرأ_ملف("أداة_مثال/مصدر/رئيسي.نيفا")
  نص_دخول_المنسوخ = اقرأ_ملف(".نيفا/حزم/أداة_مثال-1.0.0/مصدر/رئيسي.نيفا")
  تحقق(نص_دخول_المصدر == نص_دخول_المنسوخ، "تثبيت أداة_مثال الدخول مطابق")
  ن_حجم_بعد = مخزن.حجم_المخزن()
  تحقق(ن_حجم_بعد["نجاح"]، "حجم المخزن بعد التثبيت يقرأ")
  تحقق(ن_حجم_بعد["حجم"] == ن_حجم_حزمة["حجم"]، "حجم المخزن بعد التثبيت يساوي حجم الحزمة")
  تحقق(ن_تثبيت["حجم"] == ن_حجم_حزمة["حجم"]، "حجم التثبيت المبلغ يساوي حجم الحزمة")

ن_تكرار = مخزن.ثبّت_محليا("أداة_مثال")
تحقق(ن_تكرار["نجاح"] == خطأ، "رفض تثبيت مكرر")
تحقق(ن_تكرار["خطأ"] == "الحزمة أداة_مثال مثبّتة أصلا — احذفها أولا لإعادة تثبيتها"، "رسالة تثبيت مكرر")

ن_بلا_بيان = مخزن.ثبّت_محليا("حزمة_بلا_بيان")
تحقق(ن_بلا_بيان["نجاح"] == خطأ، "رفض حزمة بلا بيان")
تحقق(ن_بلا_بيان["خطأ"] == "الحزمة بلا بيان: حزمة_بلا_بيان"، "رسالة حزمة بلا بيان")

ن_أجنبي = مخزن.ثبّت_محليا("حزمة_ملف_أجنبي")
تحقق(ن_أجنبي["نجاح"] == خطأ، "رفض حزمة بملف أجنبي")

ن_أصلية = مخزن.ثبّت_محليا("حزمة_أصلية")
تحقق(ن_أصلية["نجاح"] == خطأ، "رفض حزمة باسم أصلي")

ن_قديم = مخزن.ثبّت_محليا("حزمة_محرك_قديم")
تحقق(ن_قديم["نجاح"] == خطأ، "رفض حزمة تطلب محركا أحدث")

ن_غائب = مخزن.ثبّت_محليا("حزمة_لاوجود")
تحقق(ن_غائب["نجاح"] == خطأ، "رفض حزمة غائبة")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
