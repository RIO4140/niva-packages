# اختبار وحدة إصدار — تحليل وتطبيع ومقارنة
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

تحقق(إصدار.طبّع_أرقام("١٫٢٫٣") == "1.2.3"، "تطبيع ١٫٢٫٣")
تحقق(إصدار.طبّع_أرقام("١٢٣") == "123"، "تطبيع ١٢٣")
تحقق(إصدار.طبّع_أرقام("1.2.3") == "1.2.3"، "تطبيع لاتيني كما هو")
تحقق(إصدار.طبّع_أرقام("أ١ب٢") == "أ1ب2"، "تطبيع مختلط")
تحقق(إصدار.كلها_أرقام("123")، "كلها_أرقام صحيح")
تحقق(إصدار.كلها_أرقام("12أ") == خطأ، "كلها_أرقام خطأ")
تحقق(إصدار.كلها_أرقام("") == خطأ، "كلها_أرقام فارغ")
ن = إصدار.حلّل_إصدار("1.2.3")
تحقق(ن["نجاح"]، "تحليل 1.2.3 نجاح")
تحقق(ن["قانوني"] == "1.2.3"، "تحليل 1.2.3 قانوني")
تحقق(ن["رئيسي"] == ١، "تحليل 1.2.3 رئيسي")
تحقق(ن["فرعي"] == ٢، "تحليل 1.2.3 فرعي")
تحقق(ن["إصلاحي"] == ٣، "تحليل 1.2.3 إصلاحي")
ن2 = إصدار.حلّل_إصدار("١٫٢٫٣")
تحقق(ن2["نجاح"]، "تحليل ١٫٢٫٣ نجاح")
تحقق(ن2["قانوني"] == "1.2.3"، "تحليل ١٫٢٫٣ قانوني")
ن3 = إصدار.حلّل_إصدار("1.10.0")
تحقق(ن3["قانوني"] == "1.10.0"، "تحليل 1.10.0 قانوني")
ن4 = إصدار.حلّل_إصدار("1.2")
تحقق(ن4["نجاح"] == خطأ، "رفض 1.2")
تحقق(ن4["خطأ"] == "إصدار غير صالح: 1.2 — الصيغة رئيسي.فرعي.إصلاحي"، "رسالة رفض 1.2")
ن5 = إصدار.حلّل_إصدار("1.2.3.4")
تحقق(ن5["نجاح"] == خطأ، "رفض 1.2.3.4")
ن6 = إصدار.حلّل_إصدار("أ.ب.ج")
تحقق(ن6["نجاح"] == خطأ، "رفض أ.ب.ج")
ن7 = إصدار.حلّل_إصدار("")
تحقق(ن7["نجاح"] == خطأ، "رفض فارغ")
م1 = إصدار.قارن_إصدارين("1.10.0"، "1.2.0")
تحقق(م1["مقارنة"] == ١، "مقارنة 1.10.0 أكبر")
م2 = إصدار.قارن_إصدارين("1.2.3"، "1.2.3")
تحقق(م2["مقارنة"] == ٠، "مقارنة متساو")
م3 = إصدار.قارن_إصدارين("1.2.3"، "2.0.0")
تحقق(م3["مقارنة"] < ٠، "مقارنة 1.2.3 أصغر")
م4 = إصدار.قارن_إصدارين("1.2.9"، "1.2.10")
تحقق(م4["مقارنة"] < ٠، "مقارنة إصلاحي عددي")
م5 = إصدار.قارن_إصدارين("خاطئ"، "1.0.0")
تحقق(م5["نجاح"] == خطأ، "مقارنة خاطئ ترفض")
ن_محرك = إصدار.نسخة_المحرك()
تحقق(ن_محرك["نجاح"]، "نسخة المحرك تقرأ")
ن_محرك2 = إصدار.حلّل_إصدار(ن_محرك["قانوني"])
تحقق(ن_محرك2["نجاح"]، "نسخة المحرك صالحة للتحليل")
ت1 = إصدار.تحقق_نسخة_نيفا("1.0.0")
تحقق(ت1["نجاح"]، "تحقق نسخة 1.0.0 ينجح")
ت2 = إصدار.تحقق_نسخة_نيفا("99.0.0")
تحقق(ت2["نجاح"] == خطأ، "تحقق نسخة 99.0.0 يرفض")
ت3 = إصدار.تحقق_نسخة_نيفا("خاطئ")
تحقق(ت3["نجاح"] == خطأ، "تحقق نسخة خاطئة يرفض")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
