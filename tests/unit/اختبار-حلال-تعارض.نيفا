# اختبار وحدة حلّال — التعارض: محددان مختلفان، ونطاقان لا يتقاطعان، ومحدد ضد نطاق، وثلاثة طالبين، وحالات بلا تعارض، وحزمة غائبة
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل
استورد حلال

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح3_مرشح(ح3_نص_بيان، ح3_مصدر، ح3_منشور):
  م_ن = بيان.حلّل_بيان(ح3_نص_بيان)
  إذا م_ن["نجاح"] == خطأ:
    ارجع م_ن
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": م_ن["بيان"]["إصدار"]، "بيان": م_ن["بيان"]، "مصدر": ح3_مصدر، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"، "منشور": ح3_منشور}}

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"
ح3_خيارات = حلال.خيارات_افتراضية()

ح3_م_أ1 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 1.2.3\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ1["نجاح"], "تحليل مرشح أ")
ح3_م_ب1 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 1.5.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب1["نجاح"], "تحليل مرشح ب")
ح3_م_ج1 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.2.3\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج1["نجاح"], "تحليل مرشح ج 1.2.3")
ح3_م_ج2 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.5.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج2["نجاح"], "تحليل مرشح ج 1.5.0")
ح3_فهرس_تعارض = {"حزمة_أ": [ح3_م_أ1["مرشح"]]، "حزمة_ب": [ح3_م_ب1["مرشح"]]، "حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]]}
ح3_بيان_تعارض = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n  حزمة_ب 1.0.0\n")
تحقق(ح3_بيان_تعارض["نجاح"], "تحليل بيان التعارض")
ح3_حل_تعارض = حلال.حلّ(ح3_بيان_تعارض["بيان"], ح3_فهرس_تعارض, ح3_خيارات)
تحقق(ح3_حل_تعارض["نجاح"] == خطأ, "محددان مختلفان يرفضان")
تحقق_خطأ(ح3_حل_تعارض, "تعارض اعتماديات في الحزمة حزمة_ج:\n  حزمة_أ يطلب 1.2.3\n  حزمة_ب يطلب 1.5.0\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما", "رسالة تعارض محددين حرفيا")

ح3_م_أ2 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^1.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ2["نجاح"], "تحليل مرشح أ نطاق")
ح3_م_ب2 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^2.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب2["نجاح"], "تحليل مرشح ب نطاق")
ح3_فهرس_نطاقين = {"حزمة_أ": [ح3_م_أ2["مرشح"]]، "حزمة_ب": [ح3_م_ب2["مرشح"]]، "حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]]}
ح3_حل_نطاقين = حلال.حلّ(ح3_بيان_تعارض["بيان"], ح3_فهرس_نطاقين, ح3_خيارات)
تحقق(ح3_حل_نطاقين["نجاح"] == خطأ, "نطاقان لا يتقاطعان يرفضان")
تحقق_خطأ(ح3_حل_نطاقين, "تعارض اعتماديات في الحزمة حزمة_ج:\n  حزمة_أ يطلب ^1.0\n  حزمة_ب يطلب ^2.0\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما", "رسالة تعارض نطاقين")

ح3_حل_محدد_نطاق = حلال.حلّ(ح3_بيان_تعارض["بيان"], {"حزمة_أ": [ح3_م_أ1["مرشح"]]، "حزمة_ب": [ح3_م_ب2["مرشح"]]، "حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_محدد_نطاق["نجاح"] == خطأ, "محدد ضد نطاق لا يرضيه يرفض")
تحقق_خطأ(ح3_حل_محدد_نطاق, "تعارض اعتماديات في الحزمة حزمة_ج:\n  حزمة_أ يطلب 1.2.3\n  حزمة_ب يطلب ^2.0\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما", "رسالة تعارض محدد ونطاق")

ح3_م_د1 = ح3_مرشح("اسم: حزمة_د\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 2.0.0\n", "مصدر_د", لاشيء)
تحقق(ح3_م_د1["نجاح"], "تحليل مرشح د")
ح3_م_ج3 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 2.0.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج3["نجاح"], "تحليل مرشح ج 2.0.0")
ح3_بيان_ثلاثة = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n  حزمة_ب 1.0.0\n  حزمة_د 1.0.0\n")
تحقق(ح3_بيان_ثلاثة["نجاح"], "تحليل بيان ثلاثة طالبين")
ح3_حل_ثلاثة = حلال.حلّ(ح3_بيان_ثلاثة["بيان"], {"حزمة_أ": [ح3_م_أ1["مرشح"]]، "حزمة_ب": [ح3_م_ب1["مرشح"]]، "حزمة_د": [ح3_م_د1["مرشح"]]، "حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]، ح3_م_ج3["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_ثلاثة["نجاح"] == خطأ, "ثلاثة طالبين بإصدارات مختلفة يرفضون")
تحقق_خطأ(ح3_حل_ثلاثة, "تعارض اعتماديات في الحزمة حزمة_ج:\n  حزمة_أ يطلب 1.2.3\n  حزمة_ب يطلب 1.5.0\n  حزمة_د يطلب 2.0.0\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما", "رسالة تعارض ثلاثة طالبين")

ح3_م_ب3 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 1.2.3\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب3["نجاح"], "تحليل مرشح ب نفس المحدد")
ح3_حل_نفس_المحدد = حلال.حلّ(ح3_بيان_تعارض["بيان"], {"حزمة_أ": [ح3_م_أ1["مرشح"]]، "حزمة_ب": [ح3_م_ب3["مرشح"]]، "حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_نفس_المحدد["نجاح"], "محدد واحد من طالبين يحل")
تحقق(ح3_حل_نفس_المحدد["حزم"][٢]["إصدار"] == "1.2.3", "محدد واحد يختار إصداره")

ح3_م_أ3 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^1.2\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ3["نجاح"], "تحليل مرشح أ نطاق 1.2")
ح3_م_ب4 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^1.5\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب4["نجاح"], "تحليل مرشح ب نطاق 1.5")
ح3_م_ج4 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.9.9\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج4["نجاح"], "تحليل مرشح ج 1.9.9")
ح3_حل_نطاقين_متقاطعين = حلال.حلّ(ح3_بيان_تعارض["بيان"], {"حزمة_أ": [ح3_م_أ3["مرشح"]]، "حزمة_ب": [ح3_م_ب4["مرشح"]]، "حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]، ح3_م_ج4["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_نطاقين_متقاطعين["نجاح"], "نطاقان متقاطعان يحلان")
تحقق(ح3_حل_نطاقين_متقاطعين["حزم"][٢]["إصدار"] == "1.9.9", "نطاقان متقاطعان يأخذان الأحدث في الأعلى")

ح3_م_ب5 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^1.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب5["نجاح"], "تحليل مرشح ب نطاق 1.0")
ح3_حل_محدد_يرضي = حلال.حلّ(ح3_بيان_تعارض["بيان"], {"حزمة_أ": [ح3_م_أ1["مرشح"]]، "حزمة_ب": [ح3_م_ب5["مرشح"]]، "حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]، ح3_م_ج4["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_محدد_يرضي["نجاح"], "محدد يرضي النطاق يحل")
تحقق(ح3_حل_محدد_يرضي["حزم"][٢]["إصدار"] == "1.2.3", "محدد يرضي النطاق يثبت إصداره")

ح3_م_أ4 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^2.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ4["نجاح"], "تحليل مرشح أ نطاق 2.0")
ح3_حل_أحدث_نطاق = حلال.حلّ(ح3_بيان_تعارض["بيان"], {"حزمة_أ": [ح3_م_أ4["مرشح"]]، "حزمة_ب": [ح3_م_ب1["مرشح"]]، "حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]، ح3_م_ج4["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_أحدث_نطاق["نجاح"] == خطأ, "نطاق ومحدد لا يرضيه يرفضان")
تحقق_خطأ(ح3_حل_أحدث_نطاق, "تعارض اعتماديات في الحزمة حزمة_ج:\n  حزمة_أ يطلب ^2.0\n  حزمة_ب يطلب 1.5.0\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما", "رسالة تعارض نطاق ومحدد لا يرضيه")

ح3_بيان_غائبة = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_غائبة ^1.0\n")
تحقق(ح3_بيان_غائبة["نجاح"], "تحليل بيان حزمة غائبة")
ح3_حل_غائبة = حلال.حلّ(ح3_بيان_غائبة["بيان"], {}, ح3_خيارات)
تحقق(ح3_حل_غائبة["نجاح"] == خطأ, "حزمة غائبة من الفهرس ترفض")
تحقق_خطأ(ح3_حل_غائبة, "الحزمة حزمة_غائبة غير موجودة في الفهرس", "رسالة حزمة غائبة")

ح3_بيان_إصدار_غائب = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 9.9.9\n")
تحقق(ح3_بيان_إصدار_غائب["نجاح"], "تحليل بيان إصدار غائب")
ح3_حل_إصدار_غائب = حلال.حلّ(ح3_بيان_إصدار_غائب["بيان"], {"حزمة_ج": [ح3_م_ج1["مرشح"]، ح3_م_ج2["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_إصدار_غائب["نجاح"] == خطأ, "إصدار غير منشور يرفض")
تحقق_خطأ(ح3_حل_إصدار_غائب, "الإصدار 9.9.9 غير موجود للحزمة حزمة_ج", "رسالة إصدار غير منشور")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
