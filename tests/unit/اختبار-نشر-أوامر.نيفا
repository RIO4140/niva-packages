# اختبار وحدة الموزّع — أمر حزم انشر: الصيغ والرايات
# والرفض قبل الشبكة، والنشر الكامل والسحب المركزي عبر
# المحاكي. يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد أوامر
استورد شبكة

ناجح = صحيح
سبب = ""
ح6_قاعدة = "http://127.0.0.1:39401"
ح6_خيارات_نجاح = {"قاعدة": ح6_قاعدة، "سيناريو": "نجاح"}

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة أعد_المحاكي():
  حاول:
    شبكة.اجلب(ح6_قاعدة + "/__إعادة")
    ارجع صحيح
  ماعدا:
    ارجع خطأ

تحقق(أوامر.استعمال().يحتوي("حزم انشر --مستودع مالك/مستودع --وسم وسم --ناشر دخول")، "استعمال فيه انشر")
تحقق(أوامر.استعمال().يحتوي("حزم انشر --سحب <اسم> <إصدار>")، "استعمال فيه انشر سحب")
ح6_انشر_بلا = أوامر.نفّذ(["انشر"], {}, {})
تحقق_خطأ(ح6_انشر_بلا، "حزم انشر يحتاج --مستودع <مالك/مستودع>"، "انشر بلا مستودع يرفض")
ح6_انشر_بلا_وسم = أوامر.نفّذ(["انشر", "--مستودع", "tester/مصدر_صغير"], {}, {})
تحقق_خطأ(ح6_انشر_بلا_وسم، "حزم انشر يحتاج --وسم <وسم>"، "انشر بلا وسم يرفض")
ح6_انشر_بلا_ناشر = أوامر.نفّذ(["انشر", "--مستودع", "tester/مصدر_صغير", "--وسم", "v1.0.0"], {}, {})
تحقق_خطأ(ح6_انشر_بلا_ناشر، "حزم انشر يحتاج --ناشر <دخول جيت هاب>"، "انشر بلا ناشر يرفض")
ح6_سحب_بلا = أوامر.نفّذ(["انشر", "--سحب", "حزمة_صغيرة"], {}, {})
تحقق_خطأ(ح6_سحب_بلا، "حزم انشر --سحب يحتاج اسم حزمة وإصدارا"، "انشر سحب بلا إصدار يرفض")
ح6_سحب_بلا_ناشر = أوامر.نفّذ(["انشر", "--سحب", "حزمة_صغيرة", "1.0.0"], {}, {})
تحقق_خطأ(ح6_سحب_بلا_ناشر، "حزم انشر يحتاج --ناشر <دخول جيت هاب>"، "انشر سحب بلا ناشر يرفض")

ح6_نص_بيان = اقرأ_ملف("حزمة_صغيرة/بيان.حزمة")
اكتب_ملف("بيان.حزمة"، ح6_نص_بيان)
تحقق(أعد_المحاكي()، "إعادة المحاكي قبل نشر الموزع")
ح6_نشر_موزع = أوامر.نفّذ(["انشر", "--مستودع", "tester/مصدر_صغير", "--وسم", "v1.0.0", "--ناشر", "tester"], {}, ح6_خيارات_نجاح)
تحقق(ح6_نشر_موزع["نجاح"]، "انشر موزع ينجح")
تحقق(ح6_نشر_موزع["نص"] == "نُشرت الحزمة حزمة_صغيرة 1.0.0 — طلب الدمج رقم 42 في مستودع الفهرس"، "انشر موزع نصه")
تحقق(أعد_المحاكي()، "إعادة المحاكي قبل سحب الموزع")
ح6_سحب_موزع = أوامر.نفّذ(["انشر", "--سحب", "حزمة_وسط", "1.0.0", "إصدار", "معيب", "--ناشر", "tester"], {}, ح6_خيارات_نجاح)
تحقق(ح6_سحب_موزع["نجاح"]، "انشر سحب موزع ينجح")
تحقق(ح6_سحب_موزع["نص"] == "سُحب الإصدار 1.0.0 للحزمة حزمة_وسط — طلب الدمج رقم 42 في مستودع الفهرس"، "انشر سحب موزع نصه")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
