# اختبار وحدة حلّال — تعيين المصادر: قاعدة اسم-إلى-مصدر، ومصدر بلا مرشح يرفض، واعتماد برابط، ورابط بلا مرشح يرفض، ورابط مع نطاق، وتعيين يخالف الرابط
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل
استورد حلال

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح3_مرشح(ح3_نص_بيان، ح3_مصدر، ح3_منشور):
  م_ن = بيان.حلّل_بيان(ح3_نص_بيان)
  إذا م_ن["نجاح"] == خطأ:
    ارجع م_ن
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": م_ن["بيان"]["إصدار"]، "بيان": م_ن["بيان"]، "مصدر": ح3_مصدر، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"، "منشور": ح3_منشور}}

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"

ح3_م_أ19 = ح3_مرشح("اسم: حزمة-أ\nإصدار: 1.9.9\n", "مصدر-عام", لاشيء)
تحقق(ح3_م_أ19["نجاح"], "تحليل أ 1.9.9 عام")
ح3_م_أ15 = ح3_مرشح("اسم: حزمة-أ\nإصدار: 1.5.0\n", "مصدر-خاص", لاشيء)
تحقق(ح3_م_أ15["نجاح"], "تحليل أ 1.5.0 خاص")
ح3_فهرس = {"حزمة-أ": [ح3_م_أ19["مرشح"]، ح3_م_أ15["مرشح"]]}
ح3_بيان_أ = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ ^1.0\n")
تحقق(ح3_بيان_أ["نجاح"], "تحليل بيان أ")

ح3_حل_بلا = حلال.حلّ(ح3_بيان_أ["بيان"], ح3_فهرس, حلال.خيارات_افتراضية())
تحقق(ح3_حل_بلا["نجاح"], "بلا تعيين يحل")
تحقق(ح3_حل_بلا["حزم"][٠]["إصدار"] == "1.9.9", "بلا تعيين يأخذ الأحدث")
تحقق(ح3_حل_بلا["حزم"][٠]["مصدر"] == "مصدر-عام", "بلا تعيين يسجل مصدر الأحدث")

ح3_خيارات_خاص = {"وضع": "الأحدث"، "تهدئة_أيام": ٠، "الآن": لاشيء، "مصادر": {"حزمة-أ": "مصدر-خاص"}، "تطوير": خطأ، "مثبّتة": []، "هدف_تحديث": لاشيء}
ح3_حل_خاص = حلال.حلّ(ح3_بيان_أ["بيان"], ح3_فهرس, ح3_خيارات_خاص)
تحقق(ح3_حل_خاص["نجاح"], "تعيين إلى مصدر خاص يحل")
تحقق(ح3_حل_خاص["حزم"][٠]["إصدار"] == "1.5.0", "تعيين إلى مصدر خاص يأخذ إصداره")
تحقق(ح3_حل_خاص["حزم"][٠]["مصدر"] == "مصدر-خاص", "تعيين إلى مصدر خاص يسجل مصدره")

ح3_خيارات_مجهول = {"وضع": "الأحدث"، "تهدئة_أيام": ٠، "الآن": لاشيء، "مصادر": {"حزمة-أ": "مصدر-مجهول"}، "تطوير": خطأ، "مثبّتة": []، "هدف_تحديث": لاشيء}
ح3_حل_مجهول = حلال.حلّ(ح3_بيان_أ["بيان"], ح3_فهرس, ح3_خيارات_مجهول)
تحقق(ح3_حل_مجهول["نجاح"] == خطأ, "تعيين إلى مصدر بلا مرشح يرفض")
تحقق_خطأ(ح3_حل_مجهول, "الحزمة حزمة-أ غير موجودة في المصدر مصدر-مجهول", "رسالة مصدر بلا مرشح")

ح3_م_أ_رابط = ح3_مرشح("اسم: حزمة-أ\nإصدار: 1.2.3\n", "https://github.com/مالك/حزمة-أ", لاشيء)
تحقق(ح3_م_أ_رابط["نجاح"], "تحليل أ رابط")
ح3_بيان_رابط = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ https://github.com/مالك/حزمة-أ\n")
تحقق(ح3_بيان_رابط["نجاح"], "تحليل بيان رابط")
ح3_حل_رابط = حلال.حلّ(ح3_بيان_رابط["بيان"], {"حزمة-أ": [ح3_م_أ19["مرشح"]، ح3_م_أ_رابط["مرشح"]]}, حلال.خيارات_افتراضية())
تحقق(ح3_حل_رابط["نجاح"], "اعتماد برابط يحل")
تحقق(ح3_حل_رابط["حزم"][٠]["إصدار"] == "1.2.3", "اعتماد برابط يأخذ إصدار الرابط")
تحقق(ح3_حل_رابط["حزم"][٠]["مصدر"] == "https://github.com/مالك/حزمة-أ", "اعتماد برابط يسجل الرابط مصدرا")

ح3_حل_رابط_بلا = حلال.حلّ(ح3_بيان_رابط["بيان"], {"حزمة-أ": [ح3_م_أ19["مرشح"]]}, حلال.خيارات_افتراضية())
تحقق(ح3_حل_رابط_بلا["نجاح"] == خطأ, "رابط بلا مرشح يرفض")
تحقق_خطأ(ح3_حل_رابط_بلا, "الحزمة حزمة-أ غير موجودة في المصدر https://github.com/مالك/حزمة-أ", "رسالة رابط بلا مرشح")

ح3_م_ب = ح3_مرشح("اسم: حزمة-ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ ^2.0\n", "مصدر-ب", لاشيء)
تحقق(ح3_م_ب["نجاح"], "تحليل مرشح ب")
ح3_بيان_رابط_نطاق = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ https://github.com/مالك/حزمة-أ\n  حزمة-ب 1.0.0\n")
تحقق(ح3_بيان_رابط_نطاق["نجاح"], "تحليل بيان رابط مع نطاق")
ح3_حل_رابط_نطاق = حلال.حلّ(ح3_بيان_رابط_نطاق["بيان"], {"حزمة-أ": [ح3_م_أ_رابط["مرشح"]]، "حزمة-ب": [ح3_م_ب["مرشح"]]}, حلال.خيارات_افتراضية())
تحقق(ح3_حل_رابط_نطاق["نجاح"] == خطأ, "رابط مع نطاق لا يرضيه يرفض")
تحقق_خطأ(ح3_حل_رابط_نطاق, "لا يوجد إصدار يطابق ^2.0 للحزمة حزمة-أ", "رسالة رابط مع نطاق لا يرضيه")

ح3_خيارات_يخالف = {"وضع": "الأحدث"، "تهدئة_أيام": ٠، "الآن": لاشيء، "مصادر": {"حزمة-أ": "مصدر-خاص"}، "تطوير": خطأ، "مثبّتة": []، "هدف_تحديث": لاشيء}
ح3_حل_يخالف = حلال.حلّ(ح3_بيان_رابط["بيان"], {"حزمة-أ": [ح3_م_أ19["مرشح"]، ح3_م_أ_رابط["مرشح"]]}, ح3_خيارات_يخالف)
تحقق(ح3_حل_يخالف["نجاح"] == خطأ, "تعيين يخالف الرابط يرفض")
تحقق_خطأ(ح3_حل_يخالف, "الحزمة حزمة-أ غير موجودة في المصدر مصدر-خاص", "رسالة تعيين يخالف الرابط")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
