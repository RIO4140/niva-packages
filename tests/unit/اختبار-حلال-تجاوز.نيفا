# اختبار وحدة حلّال — التجاوز الصريح: يحل تعارضا، ويُسجَّل في القفل، ويتعارض مع قيد مباشر، وبلا اعتماد يرفض، وإصدار غير منشور يرفض، وتجريبي بالاسم الكامل، وتحليل مكرر
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل
استورد حلال

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح3_مرشح(ح3_نص_بيان، ح3_مصدر، ح3_منشور):
  م_ن = بيان.حلّل_بيان(ح3_نص_بيان)
  إذا م_ن["نجاح"] == خطأ:
    ارجع م_ن
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": م_ن["بيان"]["إصدار"]، "بيان": م_ن["بيان"]، "مصدر": ح3_مصدر، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"، "منشور": ح3_منشور}}

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"
ح3_خيارات = حلال.خيارات_افتراضية()

ح3_م_أ = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 1.2.3\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ["نجاح"], "تحليل مرشح أ")
ح3_م_ب = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 1.5.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب["نجاح"], "تحليل مرشح ب")
ح3_م_ج12 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.2.3\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج12["نجاح"], "تحليل مرشح ج 1.2.3")
ح3_م_ج15 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.5.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج15["نجاح"], "تحليل مرشح ج 1.5.0")
ح3_فهرس = {"حزمة_أ": [ح3_م_أ["مرشح"]]، "حزمة_ب": [ح3_م_ب["مرشح"]]، "حزمة_ج": [ح3_م_ج12["مرشح"]، ح3_م_ج15["مرشح"]]}

ح3_بيان_تجاوز = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n  حزمة_ب 1.0.0\nتجاوز:\n  حزمة_ج 1.2.3\n")
تحقق(ح3_بيان_تجاوز["نجاح"], "تحليل بيان التجاوز")
ح3_حل_تجاوز = حلال.حلّ(ح3_بيان_تجاوز["بيان"], ح3_فهرس, ح3_خيارات)
تحقق(ح3_حل_تجاوز["نجاح"], "تجاوز يحل تعارضا")
تحقق(ح3_حل_تجاوز["حزم"][٢]["إصدار"] == "1.2.3", "تجاوز يثبت إصداره")
تحقق(طول(ح3_حل_تجاوز["تجاوزات"]) == ١, "تجاوز واحد مسجل في النتيجة")
تحقق(ح3_حل_تجاوز["تجاوزات"][٠]["اسم"] == "حزمة_ج", "اسم التجاوز مسجل")
تحقق(ح3_حل_تجاوز["تجاوزات"][٠]["إصدار"] == "1.2.3", "إصدار التجاوز مسجل")

ح3_قفل_تجاوز = حلال.حلّ_إلى_قفل(ح3_بيان_تجاوز["بيان"], ح3_فهرس, ح3_خيارات, "قفل-تجاوز-اختبار.حزمة")
تحقق(ح3_قفل_تجاوز["نجاح"], "حل إلى قفل مع تجاوز ينجح")
ح3_نص_قفل = اقرأ_ملف("قفل-تجاوز-اختبار.حزمة")
تحقق(ح3_نص_قفل == ح3_قفل_تجاوز["قفل"], "ملف القفل يطابق المولد")
ح3_فيه_سطر_تجاوز = خطأ
لكل ح3_سطر في ح3_نص_قفل.قسم("\n"):
  إذا ح3_سطر == "# تجاوز: حزمة_ج 1.2.3":
    ح3_فيه_سطر_تجاوز = صحيح
تحقق(ح3_فيه_سطر_تجاوز, "سطر التجاوز في نص القفل")
ح3_قفل_محلل = قفل.حلّل_قفل(ح3_نص_قفل)
تحقق(ح3_قفل_محلل["نجاح"], "تحليل قفل فيه تجاوز ينجح")
تحقق(طول(ح3_قفل_محلل["تجاوزات"]) == ١, "تحليل القفل يعيد التجاوز")
تحقق(ح3_قفل_محلل["تجاوزات"][٠]["إصدار"] == "1.2.3", "تحليل القفل يعيد إصدار التجاوز")

ح3_بيان_تجاوز_مباشر = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 1.2.3\nتجاوز:\n  حزمة_ج 1.5.0\n")
تحقق(ح3_بيان_تجاوز_مباشر["نجاح"], "تحليل بيان تجاوز مباشر")
ح3_حل_تجاوز_مباشر = حلال.حلّ(ح3_بيان_تجاوز_مباشر["بيان"], ح3_فهرس, ح3_خيارات)
تحقق(ح3_حل_تجاوز_مباشر["نجاح"] == خطأ, "تجاوز يتعارض مع قيد مباشر يرفض")
تحقق_خطأ(ح3_حل_تجاوز_مباشر, "تعارض اعتماديات في الحزمة حزمة_ج:\n  مشروعي يطلب 1.2.3\n  تجاوز يطلب 1.5.0\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما", "رسالة تعارض التجاوز مع المباشر")

ح3_بيان_تجاوز_نطاق = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج ^1.0\nتجاوز:\n  حزمة_ج 1.2.3\n")
تحقق(ح3_بيان_تجاوز_نطاق["نجاح"], "تحليل بيان تجاوز مع نطاق")
ح3_حل_تجاوز_نطاق = حلال.حلّ(ح3_بيان_تجاوز_نطاق["بيان"], ح3_فهرس, ح3_خيارات)
تحقق(ح3_حل_تجاوز_نطاق["نجاح"], "تجاوز يرضيه نطاق مباشر يحل")
تحقق(ح3_حل_تجاوز_نطاق["حزم"][٠]["إصدار"] == "1.2.3", "تجاوز يرضيه نطاق مباشر يثبت إصداره")

ح3_م_ز = ح3_مرشح("اسم: حزمة_ز\nإصدار: 1.0.0\n", "مصدر_ز", لاشيء)
تحقق(ح3_م_ز["نجاح"], "تحليل مرشح ز")
ح3_بيان_تجاوز_بلا = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\nتجاوز:\n  حزمة_ز 1.0.0\n")
تحقق(ح3_بيان_تجاوز_بلا["نجاح"], "تحليل بيان تجاوز بلا اعتماد")
ح3_حل_تجاوز_بلا = حلال.حلّ(ح3_بيان_تجاوز_بلا["بيان"], {"حزمة_أ": [ح3_م_أ["مرشح"]]، "حزمة_ج": [ح3_م_ج12["مرشح"]، ح3_م_ج15["مرشح"]]، "حزمة_ز": [ح3_م_ز["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_تجاوز_بلا["نجاح"] == خطأ, "تجاوز بلا اعتماد يرفض")
تحقق_خطأ(ح3_حل_تجاوز_بلا, "التجاوز حزمة_ز لا يطابق أي اعتماد — تحقق من الاسم", "رسالة تجاوز بلا اعتماد")

ح3_بيان_تجاوز_غائب = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n  حزمة_ب 1.0.0\nتجاوز:\n  حزمة_ج 9.9.9\n")
تحقق(ح3_بيان_تجاوز_غائب["نجاح"], "تحليل بيان تجاوز غائب")
ح3_حل_تجاوز_غائب = حلال.حلّ(ح3_بيان_تجاوز_غائب["بيان"], ح3_فهرس, ح3_خيارات)
تحقق(ح3_حل_تجاوز_غائب["نجاح"] == خطأ, "تجاوز بإصدار غير منشور يرفض")
تحقق_خطأ(ح3_حل_تجاوز_غائب, "الإصدار 9.9.9 غير موجود للحزمة حزمة_ج", "رسالة تجاوز بإصدار غائب")

ح3_م_ج_تجريبي = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.5.0-تجريبي\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج_تجريبي["نجاح"], "تحليل مرشح ج تجريبي")
ح3_بيان_تجاوز_تجريبي = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\nتجاوز:\n  حزمة_ج 1.5.0-تجريبي\n")
تحقق(ح3_بيان_تجاوز_تجريبي["نجاح"], "تحليل بيان تجاوز تجريبي")
ح3_حل_تجاوز_تجريبي = حلال.حلّ(ح3_بيان_تجاوز_تجريبي["بيان"], {"حزمة_أ": [ح3_م_أ["مرشح"]]، "حزمة_ج": [ح3_م_ج12["مرشح"]، ح3_م_ج_تجريبي["مرشح"]]}, ح3_خيارات)
تحقق(ح3_حل_تجاوز_تجريبي["نجاح"], "تجاوز تجريبي بالاسم الكامل ينجح")
تحقق(ح3_حل_تجاوز_تجريبي["حزم"][١]["إصدار"] == "1.5.0-تجريبي", "تجاوز تجريبي يثبت إصداره")

ح3_بيان_تجاوز_مكرر = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nتجاوز:\n  حزمة_ج 1.2.3\n  حزمة_ج 1.5.0\n")
تحقق(ح3_بيان_تجاوز_مكرر["نجاح"] == خطأ, "تجاوز مكرر في البيان يرفض")
تحقق_خطأ(ح3_بيان_تجاوز_مكرر, "تجاوز مكرر في البيان: حزمة_ج (السطر 5)", "رسالة تجاوز مكرر")

ح3_بيان_قسم_مكرر = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nتجاوز:\n  حزمة_ج 1.2.3\nتجاوز:\n  حزمة_ب 1.0.0\n")
تحقق(ح3_بيان_قسم_مكرر["نجاح"] == خطأ, "قسم تجاوز مكرر يرفض")
تحقق_خطأ(ح3_بيان_قسم_مكرر, "قسم مكرر في البيان: تجاوز (السطر 5)", "رسالة قسم تجاوز مكرر")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
