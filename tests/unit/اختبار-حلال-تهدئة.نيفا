# اختبار وحدة حلّال — التهدئة: حديث يتخطى، وكلها حديثة ترفض، ومحدد يتخطى التهدئة، وبلا طابع يعد قديما، وعلى الحد تماما يعد قديما
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل
استورد حلال

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح3_مرشح(ح3_نص_بيان، ح3_مصدر، ح3_منشور):
  م_ن = بيان.حلّل_بيان(ح3_نص_بيان)
  إذا م_ن["نجاح"] == خطأ:
    ارجع م_ن
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": م_ن["بيان"]["إصدار"]، "بيان": م_ن["بيان"]، "مصدر": ح3_مصدر، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"، "منشور": ح3_منشور}}

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"
ح3_الآن = 1000000000
ح3_خيارات_تهدئة = {"وضع": "الأحدث"، "تهدئة_أيام": ٧، "الآن": ح3_الآن، "مصادر": {}، "تطوير": خطأ، "مثبّتة": []، "هدف_تحديث": لاشيء}

ح3_م_أ19 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.9.9\n", "مصدر_أ", 999999000)
تحقق(ح3_م_أ19["نجاح"], "تحليل أ 1.9.9 حديث")
ح3_م_أ15 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.5.0\n", "مصدر_أ", 900000000)
تحقق(ح3_م_أ15["نجاح"], "تحليل أ 1.5.0 قديم")
ح3_م_أ10 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\n", "مصدر_أ", 800000000)
تحقق(ح3_م_أ10["نجاح"], "تحليل أ 1.0.0 قديم")
ح3_فهرس = {"حزمة_أ": [ح3_م_أ19["مرشح"]، ح3_م_أ15["مرشح"]، ح3_م_أ10["مرشح"]]}
ح3_بيان_نطاق = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n")
تحقق(ح3_بيان_نطاق["نجاح"], "تحليل بيان النطاق")

ح3_حل_تهدئة = حلال.حلّ(ح3_بيان_نطاق["بيان"], ح3_فهرس, ح3_خيارات_تهدئة)
تحقق(ح3_حل_تهدئة["نجاح"], "تهدئة تتخطى الحديث تحل")
تحقق(ح3_حل_تهدئة["حزم"][٠]["إصدار"] == "1.5.0", "تهدئة تتخطى الحديث وتأخذ القديم الأحدث")
ح3_حل_بلا_تهدئة = حلال.حلّ(ح3_بيان_نطاق["بيان"], ح3_فهرس, حلال.خيارات_افتراضية())
تحقق(ح3_حل_بلا_تهدئة["نجاح"], "بلا تهدئة يحل")
تحقق(ح3_حل_بلا_تهدئة["حزم"][٠]["إصدار"] == "1.9.9", "بلا تهدئة يأخذ الأحدث")

ح3_فهرس_كلها_حديثة = {"حزمة_أ": [ح3_م_أ19["مرشح"]]}
ح3_حل_كلها_حديثة = حلال.حلّ(ح3_بيان_نطاق["بيان"], ح3_فهرس_كلها_حديثة, ح3_خيارات_تهدئة)
تحقق(ح3_حل_كلها_حديثة["نجاح"] == خطأ, "كل الإصدارات حديثة ترفض")
تحقق_خطأ(ح3_حل_كلها_حديثة, "كل إصدارات الحزمة حزمة_أ حديثة — انتظر انتهاء التهدئة أو اطلب إصدارا بعينه", "رسالة كلها حديثة")

ح3_بيان_محدد = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ 1.9.9\n")
تحقق(ح3_بيان_محدد["نجاح"], "تحليل بيان المحدد")
ح3_حل_محدد_حديث = حلال.حلّ(ح3_بيان_محدد["بيان"], ح3_فهرس, ح3_خيارات_تهدئة)
تحقق(ح3_حل_محدد_حديث["نجاح"], "محدد حديث يتخطى التهدئة يحل")
تحقق(ح3_حل_محدد_حديث["حزم"][٠]["إصدار"] == "1.9.9", "محدد حديث يتخطى التهدئة يثبت إصداره")

ح3_م_أ19_بلا = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.9.9\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ19_بلا["نجاح"], "تحليل أ 1.9.9 بلا طابع")
ح3_حل_بلا_طابع = حلال.حلّ(ح3_بيان_نطاق["بيان"], {"حزمة_أ": [ح3_م_أ19_بلا["مرشح"]، ح3_م_أ10["مرشح"]]}, ح3_خيارات_تهدئة)
تحقق(ح3_حل_بلا_طابع["نجاح"], "بلا طابع يحل")
تحقق(ح3_حل_بلا_طابع["حزم"][٠]["إصدار"] == "1.9.9", "بلا طابع يعد قديما ويؤخذ")

ح3_حد_تهدئة = ح3_الآن - (٧ * ٨٦٤٠٠)
ح3_م_أ19_حد = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.9.9\n", "مصدر_أ", ح3_حد_تهدئة)
تحقق(ح3_م_أ19_حد["نجاح"], "تحليل أ 1.9.9 على الحد")
ح3_حل_حد = حلال.حلّ(ح3_بيان_نطاق["بيان"], {"حزمة_أ": [ح3_م_أ19_حد["مرشح"]، ح3_م_أ10["مرشح"]]}, ح3_خيارات_تهدئة)
تحقق(ح3_حل_حد["نجاح"], "على الحد تماما يحل")
تحقق(ح3_حل_حد["حزم"][٠]["إصدار"] == "1.9.9", "على الحد تماما يعد قديما ويؤخذ")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
