# اختبار وحدة مواصفة-أخطاء — رفض صيغ المواصفات المرفوضة برسائل مسماة
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد بيان

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

رسالة_نطاق = " — النطاقات غير مدعومة في v1 (المسموح: إصدار محدد أو الأحدث أو ^)"
م_تلدة = بيان.حلّل_مواصفة("~1.2")
تحقق(م_تلدة["نجاح"] == خطأ، "رفض تلدة")
تحقق_خطأ(م_تلدة، "مواصفة إصدار غير صالحة: ~1.2" + رسالة_نطاق، "رسالة تلدة")
م_أكبر_يساوي = بيان.حلّل_مواصفة(">=1.2.3")
تحقق(م_أكبر_يساوي["نجاح"] == خطأ، "رفض أكبر يساوي")
تحقق_خطأ(م_أكبر_يساوي، "مواصفة إصدار غير صالحة: >=1.2.3" + رسالة_نطاق، "رسالة أكبر يساوي")
م_أكبر = بيان.حلّل_مواصفة(">1.0.0")
تحقق(م_أكبر["نجاح"] == خطأ، "رفض أكبر")
تحقق_خطأ(م_أكبر، "مواصفة إصدار غير صالحة: >1.0.0" + رسالة_نطاق، "رسالة أكبر")
م_أصغر = بيان.حلّل_مواصفة("<2.0.0")
تحقق(م_أصغر["نجاح"] == خطأ، "رفض أصغر")
تحقق_خطأ(م_أصغر، "مواصفة إصدار غير صالحة: <2.0.0" + رسالة_نطاق، "رسالة أصغر")
م_أصغر_يساوي = بيان.حلّل_مواصفة("<=2.0.0")
تحقق(م_أصغر_يساوي["نجاح"] == خطأ، "رفض أصغر يساوي")
تحقق_خطأ(م_أصغر_يساوي، "مواصفة إصدار غير صالحة: <=2.0.0" + رسالة_نطاق، "رسالة أصغر يساوي")
م_يساوي = بيان.حلّل_مواصفة("=1.2.3")
تحقق(م_يساوي["نجاح"] == خطأ، "رفض يساوي")
تحقق_خطأ(م_يساوي، "مواصفة إصدار غير صالحة: =1.2.3" + رسالة_نطاق، "رسالة يساوي")

م_نطاق1 = بيان.حلّل_مواصفة("^1")
تحقق(م_نطاق1["نجاح"] == خطأ، "رفض نطاق جزء واحد")
تحقق_خطأ(م_نطاق1، "مواصفة إصدار غير صالحة: ^1"، "رسالة نطاق جزء واحد")
م_نطاق4 = بيان.حلّل_مواصفة("^1.2.3.4")
تحقق(م_نطاق4["نجاح"] == خطأ، "رفض نطاق أربعة أجزاء")
تحقق_خطأ(م_نطاق4، "مواصفة إصدار غير صالحة: ^1.2.3.4"، "رسالة نطاق أربعة أجزاء")
م_جزآن = بيان.حلّل_مواصفة("1.2")
تحقق(م_جزآن["نجاح"] == خطأ، "رفض جزأين")
تحقق_خطأ(م_جزآن، "مواصفة إصدار غير صالحة: 1.2"، "رسالة جزأين")
م_أربعة = بيان.حلّل_مواصفة("1.2.3.4")
تحقق(م_أربعة["نجاح"] == خطأ، "رفض أربعة أجزاء")
تحقق_خطأ(م_أربعة، "مواصفة إصدار غير صالحة: 1.2.3.4"، "رسالة أربعة أجزاء")
م_حروف = بيان.حلّل_مواصفة("أ.ب.ج")
تحقق(م_حروف["نجاح"] == خطأ، "رفض حروف")
تحقق_خطأ(م_حروف، "مواصفة إصدار غير صالحة: أ.ب.ج"، "رسالة حروف")
م_سين = بيان.حلّل_مواصفة("1.2.x")
تحقق(م_سين["نجاح"] == خطأ، "رفض سين بدل رقم")
تحقق_خطأ(م_سين، "مواصفة إصدار غير صالحة: 1.2.x"، "رسالة سين")
م_فارغ = بيان.حلّل_مواصفة("")
تحقق(م_فارغ["نجاح"] == خطأ، "رفض مواصفة فارغة")
تحقق_خطأ(م_فارغ، "مواصفة إصدار غير صالحة: "، "رسالة فارغة")
م_خاطئ = بيان.حلّل_مواصفة("خاطئ")
تحقق(م_خاطئ["نجاح"] == خطأ، "رفض كلمة خاطئة")
تحقق_خطأ(م_خاطئ، "مواصفة إصدار غير صالحة: خاطئ"، "رسالة خاطئة")
م_قبع = بيان.حلّل_مواصفة("^")
تحقق(م_قبع["نجاح"] == خطأ، "رفض قبع وحده")
تحقق_خطأ(م_قبع، "مواصفة إصدار غير صالحة: ^"، "رسالة قبع وحده")

م_نطاق_تجريبي = بيان.حلّل_مواصفة("^1.2.3-تجريبي")
تحقق(م_نطاق_تجريبي["نجاح"] == خطأ، "رفض نطاق بأساس تجريبي")
تحقق_خطأ(م_نطاق_تجريبي، "مواصفة إصدار غير صالحة: ^1.2.3-تجريبي — النطاق لا يقبل إصدارا تجريبيا"، "رسالة نطاق بأساس تجريبي")
م_نطاق_تجريبي_مشرقي = بيان.حلّل_مواصفة("^١٫٢٫٣-تجريبي")
تحقق(م_نطاق_تجريبي_مشرقي["نجاح"] == خطأ، "رفض نطاق مشرقي بأساس تجريبي")

م_نطاق_مشرقي = بيان.حلّل_مواصفة("^١٫٢")
تحقق(م_نطاق_مشرقي["نجاح"]، "قبول نطاق مشرقي")
تحقق(م_نطاق_مشرقي["نوع"] == "نطاق"، "نطاق مشرقي نوع")
تحقق(م_نطاق_مشرقي["مواصفة"] == "^1.2"، "نطاق مشرقي مواصفة مطبعة")
م_محدد_مشرقي = بيان.حلّل_مواصفة("١٫٢٫٣")
تحقق(م_محدد_مشرقي["نوع"] == "إصدار"، "محدد مشرقي نوع")
تحقق(م_محدد_مشرقي["مواصفة"] == "1.2.3"، "محدد مشرقي مواصفة مطبعة")
م_تجريبي_صريح = بيان.حلّل_مواصفة("1.2.3-تجريبي")
تحقق(م_تجريبي_صريح["نوع"] == "إصدار"، "تجريبي صريح نوع")
تحقق(م_تجريبي_صريح["مواصفة"] == "1.2.3-تجريبي"، "تجريبي صريح مواصفة")
م_أحدث = بيان.حلّل_مواصفة("الأحدث")
تحقق(م_أحدث["نوع"] == "الأحدث"، "أحدث نوع")
م_نطاق3 = بيان.حلّل_مواصفة("^1.2.3")
تحقق(م_نطاق3["نوع"] == "نطاق"، "نطاق ثلاثي نوع")
تحقق(م_نطاق3["مواصفة"] == "^1.2.3"، "نطاق ثلاثي مواصفة")

بيان_تلدة = بيان.حلّل_بيان("اسم: أداة\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ~1.2\n")
تحقق(بيان_تلدة["نجاح"] == خطأ، "رفض تلدة في البيان")
تحقق_خطأ(بيان_تلدة، "مواصفة إصدار غير صالحة: ~1.2" + رسالة_نطاق، "رسالة تلدة في البيان")
بيان_نطاق_مشرقي = بيان.حلّل_بيان("اسم: أداة\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ب ^١٫٢\n")
تحقق(بيان_نطاق_مشرقي["نجاح"]، "قبول نطاق مشرقي في البيان")
تحقق(بيان_نطاق_مشرقي["بيان"]["اعتماديات"][٠]["مواصفة"] == "^1.2"، "نطاق مشرقي في البيان مطبّع")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
