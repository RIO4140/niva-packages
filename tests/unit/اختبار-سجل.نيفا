دالة ح5_مرشح_من_مجلد(ح5_مجلد):
  ح5_بيان_مرشح = بيان.اقرأ_بيان(ح5_مجلد + "/بيان.حزمة")
  إذا ح5_بيان_مرشح["نجاح"] == خطأ:
    ارجع ح5_بيان_مرشح
  ح5_نص_بيان = اقرأ_ملف(ح5_مجلد + "/بيان.حزمة")
  ح5_بصمة_بيان = تشفير.جزّئ(ح5_نص_بيان)
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": ح5_بيان_مرشح["بيان"]["إصدار"]، "بيان": ح5_بيان_مرشح["بيان"]، "مصدر": "مصدر_" + ح5_بيان_مرشح["بيان"]["اسم"]، "بصمة": ح5_بصمة_بيان، "مجلد": ح5_مجلد، "منشور": لاشيء}}

