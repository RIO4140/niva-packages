# اختبار تكامل الاستيراد — بدائيتا المحرك: حزم/<اسم> والمخزن العام
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
# والبرامج الفرعية تعمل عبر قناة؛ ونصف المفسر تكيف مع الوضع:
# موثوق يمر، ومقيد يُتخطى (فالاسم العاري `نيفا` يحتاج المسار).
استورد بيان
استورد تشفير
استورد إصدار
استورد نص باسم نصوص
استورد تواصل
استورد مشروع

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

# تشغيل برنامج فرعي عبر قناة وجمع سطوره ورمز خروجه
دالة ح4_شغّل_برنامج(ح4_أمر، ح4_ملف):
  حاول:
    ح4_معرف = تواصل.أنبوب(ح4_أمر)
  ماعدا:
    ارجع {"حالة": "متخطى"، "سطور": []، "رمز": لاشيء، "سبب": "التشغيل الخارجي غير متاح في هذه البيئة"}
  ح4_سطور = []
  ح4_انتهى = خطأ
  بينما ح4_انتهى == خطأ:
    حاول:
      ح4_سطر = تواصل.استقبل(ح4_معرف)
      ح4_سطور.أضف(ح4_سطر)
    ماعدا:
      ح4_انتهى = صحيح
  حاول:
    ح4_رمز = تواصل.أغلق(ح4_معرف)
  ماعدا:
    حاول:
      تواصل.أوقف(ح4_معرف)
    ماعدا:
      ارجع {"حالة": "فاشل"، "سطور": ح4_سطور، "رمز": لاشيء، "سبب": "تعذّر إغلاق قناة الاختبار: " + ح4_ملف}
    ارجع {"حالة": "فاشل"، "سطور": ح4_سطور، "رمز": لاشيء، "سبب": "تعذّر إغلاق قناة الاختبار: " + ح4_ملف}
  ح4_ناجح = خطأ
  ح4_فاشل = خطأ
  لكل ح4_سطر_م في ح4_سطور:
    إذا ح4_سطر_م == "ناجح":
      ح4_ناجح = صحيح
    إذا نصوص.يبدأ_ب(ح4_سطر_م، "فاشل"):
      ح4_فاشل = صحيح
  إذا ح4_رمز != ٠:
    ارجع {"حالة": "فاشل"، "سطور": ح4_سطور، "رمز": ح4_رمز، "سبب": "انتهى " + ح4_ملف + " برمز خروج " + إصدار.رقم_لاتيني(ح4_رمز)}
  إذا ح4_فاشل:
    ارجع {"حالة": "فاشل"، "سطور": ح4_سطور، "رمز": ح4_رمز، "سبب": "البرنامج " + ح4_ملف + " طبع فاشل"}
  إذا ح4_ناجح:
    ارجع {"حالة": "ناجح"، "سطور": ح4_سطور، "رمز": ح4_رمز، "سبب": ""}
  ارجع {"حالة": "فاشل"، "سطور": ح4_سطور، "رمز": ح4_رمز، "سبب": "البرنامج " + ح4_ملف + " لم يطبع ناجح"}

دالة ح4_مرشح_من_مجلد(ح4_مجلد):
  ح4_بيان = بيان.اقرأ_بيان(ح4_مجلد + "/بيان.حزمة")
  إذا ح4_بيان["نجاح"] == خطأ:
    ارجع ح4_بيان
  ح4_نص = اقرأ_ملف(ح4_مجلد + "/بيان.حزمة")
  ح4_بصمة = تشفير.جزّئ(ح4_نص)
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": ح4_بيان["بيان"]["إصدار"]، "بيان": ح4_بيان["بيان"]، "مصدر": "مصدر_" + ح4_بيان["بيان"]["اسم"]، "بصمة": ح4_بصمة، "مجلد": ح4_مجلد، "منشور": لاشيء}}

ح4_م_صغيرة = ح4_مرشح_من_مجلد("حزمة_صغيرة")
ح4_م_صغيرة11 = ح4_مرشح_من_مجلد("حزمة_صغيرة_1_1_0")
ح4_م_وسط = ح4_مرشح_من_مجلد("حزمة_وسط")
ح4_فهرس = {"حزمة_صغيرة": [ح4_م_صغيرة["مرشح"]، ح4_م_صغيرة11["مرشح"]]، "حزمة_وسط": [ح4_م_وسط["مرشح"]]}

# مشروع بالوسط: الاستيراد المتعدي يعطي ٤٤ (٤٣ من الصغيرة 1.1.0 + ١)
ح4_جديد = مشروع.جديد("مشروعي"، "أداة"، "", "")
تحقق(ح4_جديد["نجاح"]، "جديد مشروعي")
ح4_أضف = مشروع.أضف_اعتماد("مشروعي"، "حزمة_وسط"، لاشيء، ح4_فهرس، {})
تحقق(ح4_أضف["نجاح"]، "أضف الوسط")
اكتب_ملف("مشروعي/برنامج-استيراد.نيفا", "استورد حزمة_وسط\nإذا حزمة_وسط.قيمة == ٤٤:\n  اطبع \"ناجح\"\nوإلا:\n  اطبع \"فاشل: القيمة\"\n")
ح4_ن1 = ح4_شغّل_برنامج("مشروعي/برنامج-استيراد.نيفا", "برنامج-استيراد.نيفا")
تحقق(ح4_ن1["حالة"] == "ناجح"، "استيراد الوسط مترجم ناجح")
ح4_ن1_مفسر = ح4_شغّل_برنامج("نيفا --مفسر مشروعي/برنامج-استيراد.نيفا", "برنامج-استيراد.نيفا")
تحقق(ح4_ن1_مفسر["حالة"] == "ناجح" أو ح4_ن1_مفسر["حالة"] == "متخطى"، "استيراد الوسط مفسر ناجح أو متخطى")

# مشروع مثبت 1.0.0: القفل يثبّت ٤٢ رغم وجود 1.1.0 في الفهرس
ح4_جديد_مثبت = مشروع.جديد("مشروع_مثبت"، "أداة"، "", "")
تحقق(ح4_جديد_مثبت["نجاح"]، "جديد مشروع_مثبت")
ح4_أضف_مثبت = مشروع.أضف_اعتماد("مشروع_مثبت"، "حزمة_صغيرة"، "1.0.0"، ح4_فهرس، {})
تحقق(ح4_أضف_مثبت["نجاح"]، "أضف مثبت 1.0.0")
اكتب_ملف("مشروع_مثبت/برنامج-استيراد.نيفا", "استورد حزمة_صغيرة\nإذا حزمة_صغيرة.قيمة == ٤٢:\n  اطبع \"ناجح\"\nوإلا:\n  اطبع \"فاشل: القيمة\"\n")
ح4_ن2 = ح4_شغّل_برنامج("مشروع_مثبت/برنامج-استيراد.نيفا", "برنامج-استيراد.نيفا")
تحقق(ح4_ن2["حالة"] == "ناجح"، "قفل 1.0.0 يعطي ٤٢")
ح4_ن2_مفسر = ح4_شغّل_برنامج("نيفا --مفسر مشروع_مثبت/برنامج-استيراد.نيفا", "برنامج-استيراد.نيفا")
تحقق(ح4_ن2_مفسر["حالة"] == "ناجح" أو ح4_ن2_مفسر["حالة"] == "متخطى"، "قفل 1.0.0 مفسر ناجح أو متخطى")

# بلا قفل: الأحدث من المخزن العام يعطي ٤٣
ح4_ثبت_مخزن = مشروع.ثبّت_بالاسم("حزمة_صغيرة"، لاشيء، ح4_فهرس، {})
تحقق(ح4_ثبت_مخزن["نجاح"]، "تثبيت الأحدث في المخزن")
اكتب_ملف("برنامج-بلا-قفل.نيفا", "استورد حزمة_صغيرة\nإذا حزمة_صغيرة.قيمة == ٤٣:\n  اطبع \"ناجح\"\nوإلا:\n  اطبع \"فاشل: القيمة\"\n")
ح4_ن3 = ح4_شغّل_برنامج("برنامج-بلا-قفل.نيفا", "برنامج-بلا-قفل.نيفا")
تحقق(ح4_ن3["حالة"] == "ناجح"، "بلا قفل الأحدث يعطي ٤٣")
ح4_ن3_مفسر = ح4_شغّل_برنامج("نيفا --مفسر برنامج-بلا-قفل.نيفا", "برنامج-بلا-قفل.نيفا")
تحقق(ح4_ن3_مفسر["حالة"] == "ناجح" أو ح4_ن3_مفسر["حالة"] == "متخطى"، "بلا قفل مفسر ناجح أو متخطى")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
