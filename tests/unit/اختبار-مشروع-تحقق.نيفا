# اختبار وحدة مشاريع — تحقق، لماذا، اعرض، عزل
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد بيان
استورد تشفير
استورد مشروع

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح4_مرشح_من_مجلد(ح4_مجلد):
  ح4_بيان = بيان.اقرأ_بيان(ح4_مجلد + "/بيان.حزمة")
  إذا ح4_بيان["نجاح"] == خطأ:
    ارجع ح4_بيان
  ح4_نص = اقرأ_ملف(ح4_مجلد + "/بيان.حزمة")
  ح4_بصمة = تشفير.جزّئ(ح4_نص)
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": ح4_بيان["بيان"]["إصدار"]، "بيان": ح4_بيان["بيان"]، "مصدر": "مصدر_" + ح4_بيان["بيان"]["اسم"]، "بصمة": ح4_بصمة، "مجلد": ح4_مجلد، "منشور": لاشيء}}

ح4_م_صغيرة = ح4_مرشح_من_مجلد("حزمة_صغيرة")
ح4_م_صغيرة11 = ح4_مرشح_من_مجلد("حزمة_صغيرة_1_1_0")
ح4_م_وسط = ح4_مرشح_من_مجلد("حزمة_وسط")
ح4_فهرس = {"حزمة_صغيرة": [ح4_م_صغيرة["مرشح"]، ح4_م_صغيرة11["مرشح"]]، "حزمة_وسط": [ح4_م_وسط["مرشح"]]}

ح4_جديد = مشروع.جديد("مشروعي"، "أداة"، "", "")
تحقق(ح4_جديد["نجاح"]، "جديد مشروعي")
ح4_أضف = مشروع.أضف_اعتماد("مشروعي"، "حزمة_وسط"، لاشيء، ح4_فهرس، {})
تحقق(ح4_أضف["نجاح"]، "أضف الوسط")

# تحقق: سليم
ح4_تحقق1 = مشروع.تحقق("مشروعي")
تحقق(ح4_تحقق1["نجاح"]، "تحقق سليم ينجح")
تحقق(طول(ح4_تحقق1["مخالفات"]) == ٠، "سليم بلا مخالفات")

# تحقق: مجلد ناقص
ح4_حذف_ص = مشروع.احذف_شجرة("مشروعي/حزم/حزمة_صغيرة")
تحقق(ح4_حذف_ص["نجاح"]، "حذف الصغيرة")
ح4_تحقق2 = مشروع.تحقق("مشروعي")
تحقق_خطأ(ح4_تحقق2، "الشجرة المثبتة لا تطابق القفل:\n  الحزمة حزمة_صغيرة في القفل وليست مثبّتة في حزم/"، "ناقص يرفض")
ح4_ثبت2 = مشروع.ثبّت_القفل("مشروعي"، ح4_فهرس، {})
تحقق(ح4_ثبت2["نجاح"]، "استعادة بعد الناقص")
تحقق(مشروع.تحقق("مشروعي")["نجاح"]، "سليم بعد الاستعادة")

# تحقق: إصدار خاطئ (بتعديل بيان المثبّتة)
ح4_نص_مثبتة = اقرأ_ملف("مشروعي/حزم/حزمة_صغيرة/بيان.حزمة")
اكتب_ملف("مشروعي/حزم/حزمة_صغيرة/بيان.حزمة"، ح4_نص_مثبتة.استبدل("إصدار: 1.1.0"، "إصدار: 1.0.0"))
ح4_تحقق3 = مشروع.تحقق("مشروعي")
تحقق_خطأ(ح4_تحقق3، "الشجرة المثبتة لا تطابق القفل:\n  الحزمة حزمة_صغيرة مثبّتة بالإصدار 1.0.0 والقفل يطلب 1.1.0"، "إصدار خاطئ يرفض")
ح4_ثبت3 = مشروع.ثبّت_القفل("مشروعي"، ح4_فهرس، {})
تحقق(ح4_ثبت3["نجاح"]، "استعادة بعد الإصدار")

# تحقق: بصمة خاطئة (بتعديل الوصف وحده)
ح4_نص_مثبتة2 = اقرأ_ملف("مشروعي/حزم/حزمة_صغيرة/بيان.حزمة")
اكتب_ملف("مشروعي/حزم/حزمة_صغيرة/بيان.حزمة"، ح4_نص_مثبتة2.استبدل("حزمة صغيرة للاختبار"، "حزمة معدلة"))
ح4_تحقق4 = مشروع.تحقق("مشروعي")
تحقق_خطأ(ح4_تحقق4، "الشجرة المثبتة لا تطابق القفل:\n  بصمة الحزمة حزمة_صغيرة لا تطابق القفل"، "بصمة خاطئة ترفض")
ح4_ثبت4 = مشروع.ثبّت_القفل("مشروعي"، ح4_فهرس، {})
تحقق(ح4_ثبت4["نجاح"]، "استعادة بعد البصمة")

# تحقق: مجلد زائد
أنشئ_مجلد("مشروعي/حزم/حزمة_زائدة")
ح4_تحقق5 = مشروع.تحقق("مشروعي")
تحقق_خطأ(ح4_تحقق5، "الشجرة المثبتة لا تطابق القفل:\n  مجلد زائد في حزم/ ليس في القفل: حزمة_زائدة"، "زائد يرفض")
ح4_حذف_ز = مشروع.احذف_شجرة("مشروعي/حزم/حزمة_زائدة")
تحقق(ح4_حذف_ز["نجاح"]، "حذف الزائد")

# تحقق: بيان وقفل مختلفان، وقفل غائب
ح4_نص_بيان_أصلي = اقرأ_ملف("مشروعي/بيان.حزمة")
اكتب_ملف("مشروعي/بيان.حزمة"، ح4_نص_بيان_أصلي.استبدل("حزمة_وسط الأحدث"، "حزمة_وسط 2.0.0"))
ح4_تحقق6 = مشروع.تحقق("مشروعي")
تحقق_خطأ(ح4_تحقق6، "الشجرة المثبتة لا تطابق القفل:\n  البيان والقفل مختلفان — شغّل حزم تحديث"، "مختلفان يرفض")
اكتب_ملف("مشروعي/بيان.حزمة"، ح4_نص_بيان_أصلي)
تحقق(مشروع.تحقق("مشروعي")["نجاح"]، "سليم بعد رد البيان")
احذف("مشروعي/قفل.حزمة")
ح4_تحقق7 = مشروع.تحقق("مشروعي")
تحقق_خطأ(ح4_تحقق7، "الشجرة المثبتة لا تطابق القفل:\n  لا يوجد قفل.حزمة — شغّل حزم تحديث"، "قفل غائب يرفض")
ح4_حدث_رد = مشروع.حدّث("مشروعي"، لاشيء، لاشيء، ح4_فهرس، {})
تحقق(ح4_حدث_رد["نجاح"]، "تحديث يعيد بناء القفل الغائب")
تحقق(مشروع.تحقق("مشروعي")["نجاح"]، "سليم بعد إعادة القفل")

# لماذا: مباشرة، ومتعدية، وغائبة، وذاتية
ح4_لماذا1 = مشروع.لماذا("مشروعي"، "حزمة_صغيرة")
تحقق(ح4_لماذا1["نجاح"]، "لماذا الصغيرة ينجح")
تحقق(ح4_لماذا1["نص"] == "مشروعي ← حزمة_وسط ← حزمة_صغيرة (1.1.0)"، "سلسلة الصغيرة")
ح4_لماذا2 = مشروع.لماذا("مشروعي"، "حزمة_وسط")
تحقق(ح4_لماذا2["نجاح"]، "لماذا الوسط ينجح")
تحقق(ح4_لماذا2["نص"] == "مشروعي ← حزمة_وسط (1.0.0)"، "سلسلة الوسط")
ح4_لماذا3 = مشروع.لماذا("مشروعي"، "حزمة_غائبة")
تحقق_خطأ(ح4_لماذا3، "لا توجد سلسلة اعتماديات إلى الحزمة حزمة_غائبة"، "غائبة ترفض")
ح4_لماذا4 = مشروع.لماذا("مشروعي"، "مشروعي")
تحقق_خطأ(ح4_لماذا4، "لا توجد سلسلة اعتماديات إلى الحزمة مشروعي"، "ذاتية ترفض")

# اعرض: الشجرة نصا، والغائب يُوسم ولا يُنزَل فيه
ح4_اعرض1 = مشروع.اعرض("مشروعي"، {})
تحقق(ح4_اعرض1["نجاح"]، "اعرض ينجح")
تحقق(ح4_اعرض1["شجرة"] == "مشروعي 0.1.0\n  حزمة_وسط 1.0.0\n    حزمة_صغيرة 1.1.0"، "نص الشجرة")
ح4_حذف_ص2 = مشروع.احذف_شجرة("مشروعي/حزم/حزمة_صغيرة")
تحقق(ح4_حذف_ص2["نجاح"]، "حذف الصغيرة للعرض")
ح4_اعرض2 = مشروع.اعرض("مشروعي"، {})
تحقق(ح4_اعرض2["شجرة"] == "مشروعي 0.1.0\n  حزمة_وسط 1.0.0\n    حزمة_صغيرة 1.1.0 (غير مثبّتة)"، "الغائب يُوسم")
ح4_ثبت_عرض = مشروع.ثبّت_القفل("مشروعي"، ح4_فهرس، {})
تحقق(ح4_ثبت_عرض["نجاح"]، "استعادة بعد العرض")

# اعرض: خارج المشروع قائمة المخزن العام
ح4_ثبت_مخزن = مشروع.ثبّت_بالاسم("حزمة_صغيرة"، "1.0.0"، ح4_فهرس، {})
تحقق(ح4_ثبت_مخزن["نجاح"]، "تثبيت المخزن للعرض")
ح4_اعرض_خارج = مشروع.اعرض("", {})
تحقق(ح4_اعرض_خارج["نجاح"]، "اعرض خارج المشروع ينجح")
تحقق(ح4_اعرض_خارج["مشروع"] == خطأ، "خارج المشروع ليس مشروعا")
تحقق(ح4_اعرض_خارج["شجرة"] == "حزمة_صغيرة 1.0.0"، "قائمة المخزن")

# عزل: سليم، ومخالفة، وصيغة من، ومسموحات
ح4_عزل1 = مشروع.افحص_عزل("مشروعي")
تحقق(ح4_عزل1["نجاح"]، "عزل سليم ينجح")
اكتب_ملف("مشروعي/مصدر/مساعد.نيفا", "استورد حزمة_غائبة\n")
ح4_عزل2 = مشروع.افحص_عزل("مشروعي")
تحقق_خطأ(ح4_عزل2، "استيراد غير معلن: حزمة_غائبة في مصدر/مساعد.نيفا — أعلنه في البيان أولا"، "غير معلن يرفض")
احذف("مشروعي/مصدر/مساعد.نيفا")
اكتب_ملف("مشروعي/مصدر/مساعد.نيفا", "من حزمة_غائبة استورد قيمة\n")
ح4_عزل3 = مشروع.افحص_عزل("مشروعي")
تحقق_خطأ(ح4_عزل3، "استيراد غير معلن: حزمة_غائبة في مصدر/مساعد.نيفا — أعلنه في البيان أولا"، "صيغة من غير معلن يرفض")
احذف("مشروعي/مصدر/مساعد.نيفا")
اكتب_ملف("مشروعي/مصدر/مساعد.نيفا", "استورد تشفير\nاستورد حزمة_وسط\n")
ح4_عزل4 = مشروع.افحص_عزل("مشروعي")
تحقق(ح4_عزل4["نجاح"]، "أصلي ومعلن مسموحان")
احذف("مشروعي/مصدر/مساعد.نيفا")
اكتب_ملف("مشروعي/مصدر/مساعد.نيفا", "استورد مساعد_ثان\n")
اكتب_ملف("مشروعي/مصدر/مساعد_ثان.نيفا", "صدر قيمة\nقيمة = ١\n")
ح4_عزل5 = مشروع.افحص_عزل("مشروعي")
تحقق(ح4_عزل5["نجاح"]، "أخ في المجلد مسموح")
احذف("مشروعي/مصدر/مساعد.نيفا")
احذف("مشروعي/مصدر/مساعد_ثان.نيفا")

# عزل: اعتماد التطوير مسموح في الاختبارات وحدها
ح4_جديد_عزل = مشروع.جديد("مشروع_عزل"، "أداة"، "", "")
تحقق(ح4_جديد_عزل["نجاح"]، "جديد مشروع_عزل")
ح4_أضف_عزل = مشروع.أضف_اعتماد("مشروع_عزل"، "حزمة_صغيرة"، لاشيء، ح4_فهرس، {"تطوير": صحيح})
تحقق(ح4_أضف_عزل["نجاح"]، "أضف تطوير للعزل")
اكتب_ملف("مشروع_عزل/اختبارات/اختبار-استيراد.نيفا", "استورد حزمة_صغيرة\n")
ح4_عزل6 = مشروع.افحص_عزل("مشروع_عزل")
تحقق(ح4_عزل6["نجاح"]، "تطوير مسموح في الاختبارات")
اكتب_ملف("مشروع_عزل/مصدر/مساعد.نيفا", "استورد حزمة_صغيرة\n")
ح4_عزل7 = مشروع.افحص_عزل("مشروع_عزل")
تحقق_خطأ(ح4_عزل7، "استيراد غير معلن: حزمة_صغيرة في مصدر/مساعد.نيفا — أعلنه في البيان أولا"، "تطوير ممنوع في مصدر/")
احذف("مشروع_عزل/مصدر/مساعد.نيفا")
احذف("مشروع_عزل/اختبارات/اختبار-استيراد.نيفا")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
