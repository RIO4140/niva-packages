# اختبار وحدة الموزّع — أوامر الخطوة 5: ابحث، وقديم،
# واعرض باسم، واسحب، وانشر، وتجديد الفهرس في تحديث.
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
# وبلا مشروع جذر هنا — فـ`قديم` بلا اسم يقرأ المخزن
# العام، و`اعرض` بلا اسم يسرد المخزن العام.
# والترتيب مقصود: `اعرض` بلا اسم بمخزن فارغ قبل
# التثبيت في المخزن، وبعده بعده.
استورد مخزن
استورد مشروع
استورد سجل
استورد أوامر

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

تحقق(أوامر.استعمال().يحتوي("حزم ابحث <كلمة>")، "استعمال فيه ابحث")
تحقق(أوامر.استعمال().يحتوي("حزم قديم [اسم]")، "استعمال فيه قديم")
تحقق(أوامر.استعمال().يحتوي("حزم اسحب <اسم> <إصدار>")، "استعمال فيه اسحب")
تحقق(أوامر.استعمال().يحتوي("حزم انشر --مستودع مالك/مستودع --وسم وسم --ناشر دخول")، "استعمال فيه انشر")
ح5_ابحث_بلا = أوامر.نفّذ(["ابحث"], {}, {})
تحقق_خطأ(ح5_ابحث_بلا، "حزم ابحث يحتاج كلمة بحث"، "ابحث بلا كلمة يرفض")
ح5_ابحث = أوامر.نفّذ(["ابحث", "صغيرة", "--فهرس", "فهرس_اختبار"], {}, {})
تحقق(ح5_ابحث["نجاح"]، "ابحث موزع ينجح")
تحقق(ح5_ابحث["نص"] == "حزمة_صغيرة 1.2.0 — حزمة صغيرة للاختبار\n  حزم أضف حزمة_صغيرة 1.2.0"، "ابحث موزع نصه")
ح5_ابحث_قديمة = أوامر.نفّذ(["ابحث", "قديمة", "--فهرس", "فهرس_اختبار"], {}, {})
تحقق(ح5_ابحث_قديمة["نص"] == "لا توجد نتائج لـ قديمة"، "ابحث مسحوبة موزع نصها")
ح5_ابحث_بلا_فهرس = أوامر.نفّذ(["ابحث", "صغيرة"], {}, {})
تحقق_خطأ(ح5_ابحث_بلا_فهرس، "لا يوجد فهرس محفوظ محليا — اتصل بالإنترنت لتنزيله أولا"، "ابحث بلا فهرس وبلا محفوظ يرفض")
ح5_اعرض_فارغ = أوامر.نفّذ(["اعرض"], {}, {})
تحقق(ح5_اعرض_فارغ["نجاح"]، "اعرض مخزن فارغ ينجح")
تحقق(ح5_اعرض_فارغ["نص"] == "المخزن العام فارغ"، "اعرض مخزن فارغ نصه")
ح5_اعرض_حزمة = أوامر.نفّذ(["اعرض", "حزمة_صغيرة", "--فهرس", "فهرس_اختبار"], {}, {})
تحقق(ح5_اعرض_حزمة["نجاح"]، "اعرض حزمة موزع ينجح")
تحقق(ح5_اعرض_حزمة["نص"].يحتوي("الأحدث: 1.2.0")، "اعرض حزمة موزع الأحدث")
تحقق(ح5_اعرض_حزمة["نص"].يحتوي("سطر الإضافة: حزم أضف حزمة_صغيرة 1.2.0")، "اعرض حزمة موزع سطر الإضافة")
ح5_اعرض_غائبة = أوامر.نفّذ(["اعرض", "حزمة_غائبة", "--فهرس", "فهرس_اختبار"], {}, {})
تحقق_خطأ(ح5_اعرض_غائبة، "الحزمة حزمة_غائبة غير موجودة في الفهرس"، "اعرض غائبة موزع يرفض")
ح5_قديم_حزمة = أوامر.نفّذ(["قديم", "حزمة_صغيرة", "--فهرس", "فهرس_اختبار"], {}, {})
تحقق(ح5_قديم_حزمة["نجاح"]، "قديم حزمة موزع ينجح")
تحقق(ح5_قديم_حزمة["نص"].يحتوي("  1.2.0 (الأحدث)")، "قديم حزمة موزع الأحدث")
ح5_ثبت_مخزن = مخزن.ثبّت_محليا("حزمة_صغيرة")
تحقق(ح5_ثبت_مخزن["نجاح"]، "تثبيت صغيرة للمخزن موزع")
ح5_قديم_مخزن = أوامر.نفّذ(["قديم", "--فهرس", "فهرس_اختبار"], {}, {})
تحقق(ح5_قديم_مخزن["نجاح"]، "قديم مخزن موزع ينجح")
تحقق(ح5_قديم_مخزن["نص"] == "المثبت / المسموح / الأحدث:\nحزمة_صغيرة: المثبت 1.0.0، المسموح —، الأحدث 1.2.0"، "قديم مخزن موزع نصه")
ح5_اعرض_بعد = أوامر.نفّذ(["اعرض"], {}, {})
تحقق(ح5_اعرض_بعد["نص"] == "حزمة_صغيرة 1.0.0"، "اعرض مخزن بعد التثبيت نصه")
ح5_نسخ_فهرس = مشروع.انسخ_مجلد("فهرس_اختبار"، "فهرس_موزع")
تحقق(ح5_نسخ_فهرس["نجاح"]، "نسخ فهرس للموزع")
ح5_اسحب = أوامر.نفّذ(["اسحب", "حزمة_صغيرة", "1.1.0", "سبب", "تجريبي", "--فهرس", "فهرس_موزع"], {}, {})
تحقق(ح5_اسحب["نجاح"]، "اسحب موزع ينجح")
تحقق(ح5_اسحب["نص"] == "سُحب الإصدار 1.1.0 للحزمة حزمة_صغيرة"، "اسحب موزع نصه")
ح5_اسحب_بلا = أوامر.نفّذ(["اسحب", "حزمة_صغيرة"], {}, {})
تحقق_خطأ(ح5_اسحب_بلا، "حزم اسحب يحتاج اسم حزمة وإصدارا"، "اسحب بلا إصدار يرفض")
ح5_اسحب_بلا_فهرس = أوامر.نفّذ(["اسحب", "حزمة_صغيرة", "1.1.0"], {}, {})
تحقق_خطأ(ح5_اسحب_بلا_فهرس، "السحب يكون في فهرس محلي — حدّد المجلد بـ --فهرس <مجلد> (سحب نسخة من الفهرس المركزي يتم بطلب دمج — انظر خطة الخطوة الخامسة)"، "اسحب بلا فهرس يرفض")
ح5_انشر = أوامر.نفّذ(["انشر"], {}, {})
تحقق_خطأ(ح5_انشر، "حزم انشر يحتاج --مستودع <مالك/مستودع>"، "انشر موزع بلا مستودع يرفض")
ح5_حدث = أوامر.نفّذ(["تحديث"], {}, {})
تحقق_خطأ(ح5_حدث، "ليس مشروع حزم — شغّل حزم جديد أولا"، "تحديث بلا مشروع يرفض رغم تجديد الفهرس الصامت")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
