# اختبار وحدة نص — أدوات نصية صغيرة
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد نص

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

تحقق(نص.يبدأ_ب("محمود"، "محم")، "يبدأ_ب صحيح")
تحقق(نص.يبدأ_ب("محمود"، "مود") == خطأ، "يبدأ_ب خطأ")
تحقق(نص.يبدأ_ب("محمود"، "")، "يبدأ_ب فارغ")
تحقق(نص.يبدأ_ب("م", "محمود") == خطأ، "يبدأ_ب بادئة أطول")
تحقق(نص.ينتهي_ب("محمود"، "مود")، "ينتهي_ب صحيح")
تحقق(نص.ينتهي_ب("محمود"، "محم") == خطأ، "ينتهي_ب خطأ")
تحقق(نص.ينتهي_ب("محمود"، "")، "ينتهي_ب فارغ")
كلمات = نص.قسم_كلمات("أ ب  ج")
تحقق(طول(كلمات) == ٣، "قسم_كلمات العدد")
تحقق(كلمات[٠] == "أ"، "قسم_كلمات الأول")
تحقق(كلمات[٢] == "ج"، "قسم_كلمات الأخير")
كلمات_فارغة = نص.قسم_كلمات("   ")
تحقق(طول(كلمات_فارغة) == ٠، "قسم_كلمات فارغ")
تحقق(نص.عدد_مسافات_بادئة("  أ") == ٢، "مسافات بادئة ٢")
تحقق(نص.عدد_مسافات_بادئة("أ") == ٠، "مسافات بادئة ٠")
تحقق(نص.عدد_مسافات_بادئة("    ") == ٤، "مسافات بادئة ٤")
تحقق(نص.من_الفهرس("محمود"، ٢) == "مود"، "من_الفهرس")
تحقق(نص.من_الفهرس("محمود"، ٥) == ""، "من_الفهرس النهاية")
تحقق(نص.قبل_الفهرس("محمود"، ٢) == "مح"، "قبل_الفهرس")
تحقق(نص.قبل_الفهرس("محمود"، ٠) == ""، "قبل_الفهرس صفر")
تحقق(نص.اسم_الملف("أ/ب/ج.نيفا") == "ج.نيفا"، "اسم_الملف")
تحقق(نص.اسم_الملف("ج.نيفا") == "ج.نيفا"، "اسم_الملف بلا مجلد")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
