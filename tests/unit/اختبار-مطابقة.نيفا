# اختبار وحدة مطابقة — يطابق واختر_إصدار ومطابقة القفل للنطاق والأحدث
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

مواصفة_محدد = بيان.حلّل_مواصفة("1.2.3")
تحقق(مواصفة_محدد["نجاح"]، "تحليل مواصفة محددة")
تحقق(مواصفة_محدد["نوع"] == "إصدار"، "مواصفة محددة نوع")
ط_محدد_صحيح = إصدار.يطابق(مواصفة_محدد، "1.2.3")
تحقق(ط_محدد_صحيح["يطابق"]، "محدد يطابق نفسه")
ط_محدد_أعلى = إصدار.يطابق(مواصفة_محدد، "1.2.4")
تحقق(ط_محدد_أعلى["يطابق"] == خطأ، "محدد لا يطابق أعلى")
ط_محدد_تجريبي = إصدار.يطابق(مواصفة_محدد، "1.2.3-تجريبي")
تحقق(ط_محدد_تجريبي["يطابق"] == خطأ، "محدد لا يطابق تجريبيه")
ط_محدد_مشرقي = إصدار.يطابق(مواصفة_محدد، "١٫٢٫٣")
تحقق(ط_محدد_مشرقي["يطابق"]، "محدد يطابق مرشحا مشرقيا")
ط_محدد_خاطئ = إصدار.يطابق(مواصفة_محدد، "خاطئ")
تحقق(ط_محدد_خاطئ["نجاح"] == خطأ، "مطابقة مرشح خاطئ ترفض")

مواصفة_نطاق = بيان.حلّل_مواصفة("^1.2")
تحقق(مواصفة_نطاق["نجاح"]، "تحليل مواصفة نطاق")
تحقق(مواصفة_نطاق["نوع"] == "نطاق"، "مواصفة نطاق نوع")
ط_نطاق_أساس = إصدار.يطابق(مواصفة_نطاق، "1.2.0")
تحقق(ط_نطاق_أساس["يطابق"]، "نطاق يطابق أساسه")
ط_نطاق_أعلى = إصدار.يطابق(مواصفة_نطاق، "1.9.9")
تحقق(ط_نطاق_أعلى["يطابق"]، "نطاق يطابق أعلى فرعي")
ط_نطاق_إصلاحي = إصدار.يطابق(مواصفة_نطاق، "1.2.3")
تحقق(ط_نطاق_إصلاحي["يطابق"]، "نطاق يطابق إصلاحيا أعلى")
ط_نطاق_رئيسي = إصدار.يطابق(مواصفة_نطاق، "2.0.0")
تحقق(ط_نطاق_رئيسي["يطابق"] == خطأ، "نطاق يرفض رئيسيا أعلى")
ط_نطاق_أدنى = إصدار.يطابق(مواصفة_نطاق، "1.1.9")
تحقق(ط_نطاق_أدنى["يطابق"] == خطأ، "نطاق يرفض أدنى من أساسه")
ط_نطاق_صفر = إصدار.يطابق(مواصفة_نطاق، "0.9.9")
تحقق(ط_نطاق_صفر["يطابق"] == خطأ، "نطاق يرفض رئيسيا أدنى")
ط_نطاق_تجريبي = إصدار.يطابق(مواصفة_نطاق، "1.5.0-تجريبي")
تحقق(ط_نطاق_تجريبي["يطابق"] == خطأ، "نطاق لا يطابق تجريبيا أبدا")
مواصفة_نطاق3 = بيان.حلّل_مواصفة("^2.0.1")
ط_نطاق3_أساس = إصدار.يطابق(مواصفة_نطاق3، "2.0.1")
تحقق(ط_نطاق3_أساس["يطابق"]، "نطاق ثلاثي يطابق أساسه")
ط_نطاق3_أعلى = إصدار.يطابق(مواصفة_نطاق3، "2.5.0")
تحقق(ط_نطاق3_أعلى["يطابق"]، "نطاق ثلاثي يطابق أعلى")
ط_نطاق3_أدنى = إصدار.يطابق(مواصفة_نطاق3، "2.0.0")
تحقق(ط_نطاق3_أدنى["يطابق"] == خطأ، "نطاق ثلاثي يرفض أدنى من أساسه")
ط_نطاق3_رئيسي = إصدار.يطابق(مواصفة_نطاق3، "3.0.0")
تحقق(ط_نطاق3_رئيسي["يطابق"] == خطأ، "نطاق ثلاثي يرفض رئيسيا أعلى")
مواصفة_نطاق_مشرقي = بيان.حلّل_مواصفة("^١٫٢")
تحقق(مواصفة_نطاق_مشرقي["مواصفة"] == "^1.2"، "نطاق مشرقي يطبّع")
ط_نطاق_مشرقي = إصدار.يطابق(مواصفة_نطاق_مشرقي، "1.5.0")
تحقق(ط_نطاق_مشرقي["يطابق"]، "نطاق مشرقي يطابق")

مواصفة_أحدث = بيان.حلّل_مواصفة("الأحدث")
تحقق(مواصفة_أحدث["نوع"] == "الأحدث"، "مواصفة أحدث نوع")
ط_أحدث_صغير = إصدار.يطابق(مواصفة_أحدث، "1.0.0")
تحقق(ط_أحدث_صغير["يطابق"]، "أحدث يطابق مستقرا")
ط_أحدث_كبير = إصدار.يطابق(مواصفة_أحدث، "2.3.4")
تحقق(ط_أحدث_كبير["يطابق"]، "أحدث يطابق مستقرا كبيرا")
ط_أحدث_تجريبي = إصدار.يطابق(مواصفة_أحدث، "1.0.0-تجريبي")
تحقق(ط_أحدث_تجريبي["يطابق"] == خطأ، "أحدث لا يطابق تجريبيا")
ط_أحدث_ألفا = إصدار.يطابق(مواصفة_أحدث، "2.0.0-ألفا")
تحقق(ط_أحدث_ألفا["يطابق"] == خطأ، "أحدث لا يطابق ألفا")

مواصفة_مصدر = بيان.حلّل_مواصفة("https://github.com/مالك/حزمة-أ")
تحقق(مواصفة_مصدر["نوع"] == "مصدر"، "مواصفة مصدر نوع")
ط_مصدر = إصدار.يطابق(مواصفة_مصدر، "1.2.3")
تحقق(ط_مصدر["نجاح"] == خطأ، "مطابقة مصدر ترفض")
تحقق_خطأ(ط_مصدر، "المواصفة مصدر رابط — لا تطابق إصدارا"، "رسالة مطابقة مصدر")

اخ_محدد = إصدار.اختر_إصدار("حزمة-أ"، مواصفة_محدد، ["1.0.0"، "1.2.3"، "2.0.0"])
تحقق(اخ_محدد["إصدار"] == "1.2.3"، "اختيار محدد موجود")
اخ_محدد_غائب = إصدار.اختر_إصدار("حزمة-أ"، بيان.حلّل_مواصفة("9.9.9")، ["1.0.0"، "1.2.3"])
تحقق(اخ_محدد_غائب["نجاح"] == خطأ، "اختيار محدد غائب يرفض")
تحقق_خطأ(اخ_محدد_غائب، "الإصدار 9.9.9 غير موجود للحزمة حزمة-أ"، "رسالة محدد غائب")
اخ_نطاق = إصدار.اختر_إصدار("حزمة-أ"، مواصفة_نطاق، ["1.2.0"، "1.9.9"، "1.5.0"، "2.0.0"، "1.7.0-تجريبي"])
تحقق(اخ_نطاق["إصدار"] == "1.9.9"، "اختيار نطاق يأخذ الأحدث المستقر")
اخ_أحدث = إصدار.اختر_إصدار("حزمة-ب"، مواصفة_أحدث، ["1.0.0"، "2.0.0-تجريبي"، "1.5.0"])
تحقق(اخ_أحدث["إصدار"] == "1.5.0"، "اختيار أحدث يتخطى التجريبي الأعلى")
اخ_أحدث_تجريبي = إصدار.اختر_إصدار("حزمة-ب"، مواصفة_أحدث، ["1.0.0-تجريبي"، "2.0.0-ألفا"])
تحقق(اخ_أحدث_تجريبي["نجاح"] == خطأ، "أحدث بلا مستقر يرفض")
تحقق_خطأ(اخ_أحدث_تجريبي، "لا يوجد إصدار مستقر للحزمة حزمة-ب — والإصدارات المتاحة تجريبية فقط"، "رسالة أحدث بلا مستقر")
اخ_أحدث_فارغ = إصدار.اختر_إصدار("حزمة-ب"، مواصفة_أحدث، [])
تحقق_خطأ(اخ_أحدث_فارغ، "لا يوجد إصدار للحزمة حزمة-ب"، "رسالة أحدث بقائمة فارغة")
اخ_نطاق_بلا = إصدار.اختر_إصدار("حزمة-ج"، بيان.حلّل_مواصفة("^3.0")، ["1.0.0"، "2.0.0"])
تحقق_خطأ(اخ_نطاق_بلا، "لا يوجد إصدار يطابق ^3.0 للحزمة حزمة-ج"، "رسالة نطاق بلا مطابقة")
مواصفة_تجريبي_صريح = بيان.حلّل_مواصفة("1.2.3-تجريبي")
اخ_تجريبي_صريح = إصدار.اختر_إصدار("حزمة-أ"، مواصفة_تجريبي_صريح، ["1.2.3"، "1.2.3-تجريبي"])
تحقق(اخ_تجريبي_صريح["إصدار"] == "1.2.3-تجريبي"، "اختيار تجريبي بالاسم الكامل")
اخ_خاطئ_يتخطى = إصدار.اختر_إصدار("حزمة-أ"، مواصفة_محدد، ["خاطئ"، "1.2.3"])
تحقق(اخ_خاطئ_يتخطى["إصدار"] == "1.2.3"، "اختيار يتخطى مرشحا خاطئا")
اخ_مشرقي = إصدار.اختر_إصدار("حزمة-أ"، مواصفة_نطاق، ["١٫٢٫٣"، "1.5.0"])
تحقق(اخ_مشرقي["إصدار"] == "1.5.0"، "اختيار يطبّع مرشحا مشرقيا")

بيان_نطاق = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ ^1.0\n  حزمة-ب الأحدث\n")
تحقق(بيان_نطاق["نجاح"]، "تحليل بيان نطاق وأحدث")
قفل_موافق = [{"اسم": "حزمة-أ"، "إصدار": "1.0.0"، "مصدر": "مصدر"، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"}، {"اسم": "حزمة-ب"، "إصدار": "3.1.4"، "مصدر": "مصدر"، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"}]
ق_موافق = قفل.تحقق_قفل_ضد_بيان(بيان_نطاق["بيان"]، قفل_موافق)
تحقق(ق_موافق["نجاح"]، "قفل موافق للنطاق والأحدث")
قفل_رئيسي = [{"اسم": "حزمة-أ"، "إصدار": "2.0.0"، "مصدر": "مصدر"، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"}، {"اسم": "حزمة-ب"، "إصدار": "3.1.4"، "مصدر": "مصدر"، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"}]
ق_رئيسي = قفل.تحقق_قفل_ضد_بيان(بيان_نطاق["بيان"]، قفل_رئيسي)
تحقق(ق_رئيسي["نجاح"] == خطأ، "قفل خارج النطاق يرفض")
تحقق_خطأ(ق_رئيسي، "البيان والقفل مختلفان — شغّل حزم تحديث"، "رسالة قفل خارج النطاق")
قفل_تجريبي = [{"اسم": "حزمة-أ"، "إصدار": "1.0.0"، "مصدر": "مصدر"، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"}، {"اسم": "حزمة-ب"، "إصدار": "3.1.4-تجريبي"، "مصدر": "مصدر"، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"}]
ق_تجريبي = قفل.تحقق_قفل_ضد_بيان(بيان_نطاق["بيان"]، قفل_تجريبي)
تحقق(ق_تجريبي["نجاح"] == خطأ، "قفل تجريبي مع الأحدث يرفض")
بيان_نطاق3 = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ ^2.0.1\n")
قفل_أدنى = [{"اسم": "حزمة-أ"، "إصدار": "2.0.0"، "مصدر": "مصدر"، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"}]
ق_أدنى = قفل.تحقق_قفل_ضد_بيان(بيان_نطاق3["بيان"]، قفل_أدنى)
تحقق(ق_أدنى["نجاح"] == خطأ، "قفل أدنى من أساس النطاق يرفض")
بيان_مصدر = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة-أ https://github.com/مالك/حزمة-أ\n")
قفل_مصدر = [{"اسم": "حزمة-أ"، "إصدار": "9.9.9"، "مصدر": "مصدر"، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"}]
ق_مصدر = قفل.تحقق_قفل_ضد_بيان(بيان_مصدر["بيان"]، قفل_مصدر)
تحقق(ق_مصدر["نجاح"]، "قفل مصدر يكتفي بالوجود")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
