# اختبار وحدة حلّال — التحديث الدقيق: تحديث حزمة بعينها، وإصدار معيّن، وحزمة غير مثبّتة، وتعارض مع التثبيت، وحذف اعتماد زال، ولا إصدار أحدث، وقفل قديم
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد إصدار
استورد بيان
استورد قفل
استورد حلال

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح3_مرشح(ح3_نص_بيان، ح3_مصدر، ح3_منشور):
  م_ن = بيان.حلّل_بيان(ح3_نص_بيان)
  إذا م_ن["نجاح"] == خطأ:
    ارجع م_ن
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": م_ن["بيان"]["إصدار"]، "بيان": م_ن["بيان"]، "مصدر": ح3_مصدر، "بصمة": "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"، "منشور": ح3_منشور}}

ح3_بصمة = "9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c9f2c"
ح3_خيارات = حلال.خيارات_افتراضية()

ح3_بيان_جذر = بيان.حلّل_بيان("اسم: مشروعي\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_أ ^1.0\n  حزمة_ب ^1.0\n")
تحقق(ح3_بيان_جذر["نجاح"], "تحليل بيان الجذر")

ح3_م_أ10 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.0.0\nاعتماديات:\n  حزمة_ج 1.0.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ10["نجاح"], "تحليل أ 1.0.0")
ح3_م_أ15 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.5.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ15["نجاح"], "تحليل أ 1.5.0")
ح3_م_أ19 = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.9.9\nاعتماديات:\n  حزمة_ج ^1.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ19["نجاح"], "تحليل أ 1.9.9")
ح3_م_ب10 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 1.0.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب10["نجاح"], "تحليل ب 1.0.0")
ح3_م_ب20 = ح3_مرشح("اسم: حزمة_ب\nإصدار: 2.0.0\n", "مصدر_ب", لاشيء)
تحقق(ح3_م_ب20["نجاح"], "تحليل ب 2.0.0")
ح3_م_ج10 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.0.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج10["نجاح"], "تحليل ج 1.0.0")
ح3_م_ج15 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 1.5.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج15["نجاح"], "تحليل ج 1.5.0")
ح3_فهرس = {"حزمة_أ": [ح3_م_أ10["مرشح"]، ح3_م_أ15["مرشح"]، ح3_م_أ19["مرشح"]]، "حزمة_ب": [ح3_م_ب10["مرشح"]، ح3_م_ب20["مرشح"]]، "حزمة_ج": [ح3_م_ج10["مرشح"]، ح3_م_ج15["مرشح"]]}
ح3_قفل = [{"اسم": "حزمة_أ"، "إصدار": "1.0.0"، "مصدر": "مصدر_أ"، "بصمة": ح3_بصمة}، {"اسم": "حزمة_ب"، "إصدار": "1.0.0"، "مصدر": "مصدر_ب"، "بصمة": ح3_بصمة}، {"اسم": "حزمة_ج"، "إصدار": "1.0.0"، "مصدر": "مصدر_ج"، "بصمة": ح3_بصمة}]

ح3_تحديث_أ = حلال.حدّث_حزمة(ح3_بيان_جذر["بيان"], ح3_قفل, "حزمة_أ", لاشيء, ح3_فهرس, ح3_خيارات)
تحقق(ح3_تحديث_أ["نجاح"], "تحديث أ ينجح")
تحقق(ح3_تحديث_أ["إصدار"] == "1.9.9", "تحديث أ يأخذ الأحدث المسموح")
تحقق(ح3_تحديث_أ["سابق"] == "1.0.0", "تحديث أ يذكر السابق")
ح3_إصدار_ب_بعد = لاشيء
ح3_إصدار_ج_بعد = لاشيء
لكل ح3_حزمة_بعد في ح3_تحديث_أ["حزم"]:
  إذا ح3_حزمة_بعد["اسم"] == "حزمة_ب":
    ح3_إصدار_ب_بعد = ح3_حزمة_بعد["إصدار"]
  إذا ح3_حزمة_بعد["اسم"] == "حزمة_ج":
    ح3_إصدار_ج_بعد = ح3_حزمة_بعد["إصدار"]
تحقق(ح3_إصدار_ب_بعد == "1.0.0", "تحديث أ لا يمس ب")
تحقق(ح3_إصدار_ج_بعد == "1.0.0", "تحديث أ لا يمس ج المثبت")

ح3_تحديث_أ_معين = حلال.حدّث_حزمة(ح3_بيان_جذر["بيان"], ح3_قفل, "حزمة_أ", "1.5.0", ح3_فهرس, ح3_خيارات)
تحقق(ح3_تحديث_أ_معين["نجاح"], "تحديث أ إلى إصدار معيّن ينجح")
تحقق(ح3_تحديث_أ_معين["إصدار"] == "1.5.0", "تحديث أ إلى إصدار معيّن يثبته")

ح3_تحديث_غائبة = حلال.حدّث_حزمة(ح3_بيان_جذر["بيان"], ح3_قفل, "حزمة_ز", لاشيء, ح3_فهرس, ح3_خيارات)
تحقق(ح3_تحديث_غائبة["نجاح"] == خطأ, "تحديث حزمة غير مثبّتة يرفض")
تحقق_خطأ(ح3_تحديث_غائبة, "الحزمة حزمة_ز غير مثبّتة — لا يمكن تحديثها", "رسالة تحديث غير مثبّتة")

ح3_م_أ19_متعارضة = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.9.9\nاعتماديات:\n  حزمة_ج ^2.0\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ19_متعارضة["نجاح"], "تحليل أ 1.9.9 متعارضة")
ح3_فهرس_تعارض = {"حزمة_أ": [ح3_م_أ10["مرشح"]، ح3_م_أ15["مرشح"]، ح3_م_أ19_متعارضة["مرشح"]]، "حزمة_ب": [ح3_م_ب10["مرشح"]، ح3_م_ب20["مرشح"]]، "حزمة_ج": [ح3_م_ج10["مرشح"]، ح3_م_ج15["مرشح"]]}
ح3_تحديث_متعارض = حلال.حدّث_حزمة(ح3_بيان_جذر["بيان"], ح3_قفل, "حزمة_أ", لاشيء, ح3_فهرس_تعارض, ح3_خيارات)
تحقق(ح3_تحديث_متعارض["نجاح"] == خطأ, "تحديث يحتاج إصدارا غير موجود يرفض")
تحقق_خطأ(ح3_تحديث_متعارض, "لا يوجد إصدار يطابق ^2.0 للحزمة حزمة_ج", "رسالة تحديث بلا إصدار مطابق")

ح3_م_ج20 = ح3_مرشح("اسم: حزمة_ج\nإصدار: 2.0.0\n", "مصدر_ج", لاشيء)
تحقق(ح3_م_ج20["نجاح"], "تحليل ج 2.0.0")
ح3_فهرس_نقل = {"حزمة_أ": [ح3_م_أ10["مرشح"]، ح3_م_أ15["مرشح"]، ح3_م_أ19_متعارضة["مرشح"]]، "حزمة_ب": [ح3_م_ب10["مرشح"]، ح3_م_ب20["مرشح"]]، "حزمة_ج": [ح3_م_ج10["مرشح"]، ح3_م_ج15["مرشح"]، ح3_م_ج20["مرشح"]]}
ح3_تحديث_نقل = حلال.حدّث_حزمة(ح3_بيان_جذر["بيان"], ح3_قفل, "حزمة_أ", لاشيء, ح3_فهرس_نقل, ح3_خيارات)
تحقق(ح3_تحديث_نقل["نجاح"], "تحديث ينقل اعتمادا ينجح")
ح3_إصدار_ج_منقول = لاشيء
لكل ح3_حزمة_منقولة في ح3_تحديث_نقل["حزم"]:
  إذا ح3_حزمة_منقولة["اسم"] == "حزمة_ج":
    ح3_إصدار_ج_منقول = ح3_حزمة_منقولة["إصدار"]
تحقق(ح3_تحديث_نقل["إصدار"] == "1.9.9", "تحديث ينقل اعتمادا يرفع الهدف")
تحقق(ح3_إصدار_ج_منقول == "2.0.0", "تحديث ينقل اعتمادا يرفع الاعتماد معه")

ح3_م_أ19_بلا_ج = ح3_مرشح("اسم: حزمة_أ\nإصدار: 1.9.9\n", "مصدر_أ", لاشيء)
تحقق(ح3_م_أ19_بلا_ج["نجاح"], "تحليل أ 1.9.9 بلا ج")
ح3_فهرس_حذف = {"حزمة_أ": [ح3_م_أ10["مرشح"]، ح3_م_أ15["مرشح"]، ح3_م_أ19_بلا_ج["مرشح"]]، "حزمة_ب": [ح3_م_ب10["مرشح"]، ح3_م_ب20["مرشح"]]، "حزمة_ج": [ح3_م_ج10["مرشح"]، ح3_م_ج15["مرشح"]]}
ح3_تحديث_حذف = حلال.حدّث_حزمة(ح3_بيان_جذر["بيان"], ح3_قفل, "حزمة_أ", لاشيء, ح3_فهرس_حذف, ح3_خيارات)
تحقق(ح3_تحديث_حذف["نجاح"], "تحديث يزيل اعتمادا ينجح")
تحقق(طول(ح3_تحديث_حذف["حزم"]) == ٢, "تحديث يزيل اعتمادا يحذف حزمته من الشجرة")

ح3_قفل_أحدث = [{"اسم": "حزمة_أ"، "إصدار": "1.9.9"، "مصدر": "مصدر_أ"، "بصمة": ح3_بصمة}، {"اسم": "حزمة_ب"، "إصدار": "1.0.0"، "مصدر": "مصدر_ب"، "بصمة": ح3_بصمة}، {"اسم": "حزمة_ج"، "إصدار": "1.0.0"، "مصدر": "مصدر_ج"، "بصمة": ح3_بصمة}]
ح3_تحديث_ب_بلا = حلال.حدّث_حزمة(ح3_بيان_جذر["بيان"], ح3_قفل_أحدث, "حزمة_ب", لاشيء, ح3_فهرس, ح3_خيارات)
تحقق(ح3_تحديث_ب_بلا["نجاح"], "تحديث بلا أحدث ينجح")
تحقق(ح3_تحديث_ب_بلا["إصدار"] == "1.0.0", "تحديث بلا أحدث يبقي الإصدار")
تحقق(ح3_تحديث_ب_بلا["سابق"] == "1.0.0", "تحديث بلا أحدث سابقا يساوي الحالي")

ح3_قفل_قديم = [{"اسم": "حزمة_أ"، "إصدار": "2.0.0"، "مصدر": "مصدر_أ"، "بصمة": ح3_بصمة}، {"اسم": "حزمة_ب"، "إصدار": "1.0.0"، "مصدر": "مصدر_ب"، "بصمة": ح3_بصمة}، {"اسم": "حزمة_ج"، "إصدار": "1.0.0"، "مصدر": "مصدر_ج"، "بصمة": ح3_بصمة}]
ح3_تحديث_قفل_قديم = حلال.حدّث_حزمة(ح3_بيان_جذر["بيان"], ح3_قفل_قديم, "حزمة_أ", لاشيء, ح3_فهرس, ح3_خيارات)
تحقق(ح3_تحديث_قفل_قديم["نجاح"] == خطأ, "قفل قديم يرفض التحديث")
تحقق_خطأ(ح3_تحديث_قفل_قديم, "البيان والقفل مختلفان — شغّل حزم تحديث", "رسالة قفل قديم")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
