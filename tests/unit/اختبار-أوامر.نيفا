# اختبار وحدة الموزّع — أوامر: استعمال، وأخطاء، وجديد، وأضف، وتثبيت، واعرض، ولماذا، وتحقق، وافحص، وشغل، واختبر، وابن، وتحديث، واحذف
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
# والموزّع يعمل في المجلد الحالي؛ فالمشروع هنا هو جذر المجلد
# المؤقت نفسه (أُنشئ من مشروع فرعي نُسخت ملفاته إلى الجذر).
استورد بيان
استورد تشفير
استورد مشروع
استورد أوامر

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح4_مرشح_من_مجلد(ح4_مجلد):
  ح4_بيان = بيان.اقرأ_بيان(ح4_مجلد + "/بيان.حزمة")
  إذا ح4_بيان["نجاح"] == خطأ:
    ارجع ح4_بيان
  ح4_نص = اقرأ_ملف(ح4_مجلد + "/بيان.حزمة")
  ح4_بصمة = تشفير.جزّئ(ح4_نص)
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": ح4_بيان["بيان"]["إصدار"]، "بيان": ح4_بيان["بيان"]، "مصدر": "مصدر_" + ح4_بيان["بيان"]["اسم"]، "بصمة": ح4_بصمة، "مجلد": ح4_مجلد، "منشور": لاشيء}}

ح4_م_صغيرة = ح4_مرشح_من_مجلد("حزمة_صغيرة")
ح4_م_صغيرة11 = ح4_مرشح_من_مجلد("حزمة_صغيرة_1_1_0")
ح4_م_وسط = ح4_مرشح_من_مجلد("حزمة_وسط")
ح4_فهرس = {"حزمة_صغيرة": [ح4_م_صغيرة["مرشح"]، ح4_م_صغيرة11["مرشح"]]، "حزمة_وسط": [ح4_م_وسط["مرشح"]]}

# استعمال، ومساعدة، وغريب، وانشر، ونقص وسائط
# (ابحث وقديم لهما ملف اختبار مستقل: اختبار-سجل-أوامر)
ح4_بلا = أوامر.نفّذ([], ح4_فهرس, {})
تحقق(ح4_بلا["نجاح"]، "بلا وسائط ينجح")
تحقق(ح4_بلا["نص"] == أوامر.استعمال()، "بلا وسائط يعرض الاستعمال")
ح4_مساعدة = أوامر.نفّذ(["مساعدة"], ح4_فهرس, {})
تحقق(ح4_مساعدة["نص"] == أوامر.استعمال()، "مساعدة تعرض الاستعمال")
ح4_غريب = أوامر.نفّذ(["غريب"], ح4_فهرس, {})
تحقق_خطأ(ح4_غريب، "أمر غير معروف: غريب"، "غريب يرفض")
ح4_انشر = أوامر.نفّذ(["انشر"], ح4_فهرس, {})
تحقق_خطأ(ح4_انشر، "النشر ينتظر بدائية شبكة.أرسل في المحرك — انظر خطة الخطوة الخامسة"، "انشر ينتظر البدائية")
ح4_جديد_بلا = أوامر.نفّذ(["جديد"], ح4_فهرس, {})
تحقق_خطأ(ح4_جديد_بلا، "حزم جديد يحتاج اسم مشروع"، "جديد بلا اسم يرفض")
ح4_أضف_بلا = أوامر.نفّذ(["أضف"], ح4_فهرس, {})
تحقق_خطأ(ح4_أضف_بلا، "حزم أضف يحتاج اسم حزمة"، "أضف بلا اسم يرفض")
ح4_لماذا_بلا = أوامر.نفّذ(["لماذا"], ح4_فهرس, {})
تحقق_خطأ(ح4_لماذا_بلا، "حزم لماذا يحتاج اسم حزمة"، "لماذا بلا اسم يرفض")

# جديد عبر الموزّع: مكتبة براية، وشرطة
ح4_جديد_م = أوامر.نفّذ(["جديد", "مشروع_موزع", "--قالب", "مكتبة"], ح4_فهرس, {})
تحقق(ح4_جديد_م["نجاح"]، "جديد موزع ينجح")
تحقق(موجود("مشروع_موزع/مشروع_موزع.نيفا")، "موزع مكتبة")
ح4_جديد_شرطة = أوامر.نفّذ(["جديد", "مشروع-سيئ"], ح4_فهرس, {})
تحقق_خطأ(ح4_جديد_شرطة، "اسم المشروع مشروع-سيئ فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"، "شرطة عبر الموزّع ترفض")

# المشروع الجذر: من مشروع فرعي نُسخت ملفاته إلى الجذر
ح4_جديد = مشروع.جديد("مشروعي"، "أداة"، "", "")
تحقق(ح4_جديد["نجاح"]، "جديد مشروعي")
ح4_نسخ_مصدر = مشروع.انسخ_مجلد("مشروعي/مصدر"، "مصدر")
تحقق(ح4_نسخ_مصدر["نجاح"]، "نسخ مصدر إلى الجذر")
ح4_نسخ_خت = مشروع.انسخ_مجلد("مشروعي/اختبارات"، "اختبارات")
تحقق(ح4_نسخ_خت["نجاح"]، "نسخ اختبارات إلى الجذر")
أنشئ_مجلد("حزم")
اكتب_ملف("بيان.حزمة", اقرأ_ملف("مشروعي/بيان.حزمة"))

# أضف، وتثبيت، واعرض، ولماذا، وتحقق، وافحص عبر الموزّع
ح4_أضف = أوامر.نفّذ(["أضف", "حزمة_صغيرة"], ح4_فهرس, {})
تحقق(ح4_أضف["نجاح"]، "أضف عبر الموزّع ينجح")
تحقق(ح4_أضف["نص"] == "أضيف الاعتماد حزمة_صغيرة (1.1.0)"، "نص أضف")
ح4_حذف_شجرة = مشروع.احذف_شجرة("حزم")
تحقق(ح4_حذف_شجرة["نجاح"]، "حذف حزم الجذر")
ح4_ثبت = أوامر.نفّذ(["تثبيت"], ح4_فهرس, {})
تحقق(ح4_ثبت["نجاح"]، "تثبيت عبر الموزّع ينجح")
تحقق(ح4_ثبت["نص"] == "ثُبّت القفل حرفيا"، "نص تثبيت")
ح4_اعرض = أوامر.نفّذ(["اعرض"], ح4_فهرس, {})
تحقق(ح4_اعرض["نجاح"]، "اعرض عبر الموزّع ينجح")
تحقق(ح4_اعرض["نص"] == "مشروعي 0.1.0\n  حزمة_صغيرة 1.1.0"، "نص اعرض")
ح4_لماذا = أوامر.نفّذ(["لماذا", "حزمة_صغيرة"], ح4_فهرس, {})
تحقق(ح4_لماذا["نجاح"]، "لماذا عبر الموزّع ينجح")
تحقق(ح4_لماذا["نص"] == "مشروعي ← حزمة_صغيرة (1.1.0)"، "نص لماذا")
ح4_تحقق = أوامر.نفّذ(["تحقق"], ح4_فهرس, {})
تحقق(ح4_تحقق["نجاح"]، "تحقق عبر الموزّع ينجح")
تحقق(ح4_تحقق["نص"] == "الشجرة المثبتة تطابق القفل"، "نص تحقق")
ح4_افحص = أوامر.نفّذ(["افحص"], ح4_فهرس, {})
تحقق(ح4_افحص["نجاح"]، "افحص عبر الموزّع ينجح")
تحقق(ح4_افحص["نص"] == "لا استيراد غير معلن"، "نص افحص")

# شغل، وابن، واختبر، وتحديث، واحذف عبر الموزّع (ابن واختبر تكيفية)
ح4_شغل = أوامر.نفّذ(["شغل"], ح4_فهرس, {})
تحقق(ح4_شغل["نجاح"]، "شغل عبر الموزّع ينجح")
تحقق(ح4_شغل["نص"] == "انتهى التشغيل بنجاح"، "نص شغل")
ح4_ابن = أوامر.نفّذ(["ابن"], ح4_فهرس, {})
إذا ح4_ابن["نجاح"]:
  تحقق(ح4_ابن["نص"] == "انتهى البناء بنجاح"، "نص ابن موثوق")
وإلا:
  تحقق_خطأ(ح4_ابن، "حزم ابن يحتاج سطر الأوامر — شغّل مباشرة: نيفا ابن مصدر/رئيسي.نيفا"، "ابن مقيد عبر الموزّع")
ح4_اختبر = أوامر.نفّذ(["اختبر"], ح4_فهرس, {})
إذا ح4_اختبر["نجاح"]:
  تحقق(ح4_اختبر["نص"] == "نجحت كل الاختبارات في الوضعين"، "نص اختبر موثوق")
وإلا:
  تحقق_خطأ(ح4_اختبر، "اختبر: المفسر متخطى — شغّل في وضع موثوق للتحقق من الوضعين"، "اختبر مقيد عبر الموزّع")
ح4_حدث = أوامر.نفّذ(["تحديث"], ح4_فهرس, {})
تحقق(ح4_حدث["نجاح"]، "تحديث عبر الموزّع ينجح")
تحقق(ح4_حدث["نص"] == "حُدّثت الشجرة"، "نص تحديث")
ح4_احذف = أوامر.نفّذ(["احذف", "حزمة_صغيرة"], ح4_فهرس, {})
تحقق(ح4_احذف["نجاح"]، "احذف عبر الموزّع ينجح")
تحقق(ح4_احذف["نص"] == "حُذف الاعتماد حزمة_صغيرة"، "نص احذف")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
