# اختبار وحدة قفل — توليد وتحليل ومطابقة قفل.حزمة
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد قفل
استورد تشفير

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

بصمة_أ = تشفير.جزّئ("بيان حزمة-أ")
بصمة_ب = تشفير.جزّئ("بيان حزمة-ب")
بصمة_ج = تشفير.جزّئ("بيان حزمة-ج")
حزم = [{"اسم": "حزمة-ج"، "إصدار": "2.0.1"، "مصدر": "github.com/مالك/حزمة-ج"، "بصمة": بصمة_ج}، {"اسم": "حزمة-أ"، "إصدار": "1.2.3"، "مصدر": "github.com/مالك/حزمة-أ"، "بصمة": بصمة_أ}، {"اسم": "حزمة-ب"، "إصدار": "1.0.0"، "مصدر": "github.com/مالك/حزمة-ب"، "بصمة": بصمة_ب}]
ن = قفل.ولّد_قفل(حزم)
تحقق(ن["نجاح"]، "توليد قفل")
متوقع = "# قفل حزم — يولَّد آليا؛ لا تحرره بيدك\nحزمة-أ 1.2.3 github.com/مالك/حزمة-أ " + بصمة_أ + "\nحزمة-ب 1.0.0 github.com/مالك/حزمة-ب " + بصمة_ب + "\nحزمة-ج 2.0.1 github.com/مالك/حزمة-ج " + بصمة_ج + "\n"
تحقق(ن["قفل"] == متوقع، "توليد قفل مرتب بالاسم ونصه حرفي")

ن_تحليل = قفل.حلّل_قفل(ن["قفل"])
تحقق(ن_تحليل["نجاح"]، "تحليل قفل مولّد")
تحقق(طول(ن_تحليل["حزم"]) == ٣، "تحليل قفل العدد")
تحقق(ن_تحليل["حزم"][٠]["اسم"] == "حزمة-أ"، "تحليل قفل أول اسم")
تحقق(ن_تحليل["حزم"][٠]["بصمة"] == بصمة_أ، "تحليل قفل أول بصمة")
تحقق(ن_تحليل["حزم"][٢]["إصدار"] == "2.0.1"، "تحليل قفل ثالث إصدار")

ن_سطر = قفل.حلّل_قفل("حزمة-أ 1.2.3 github.com/مالك/حزمة-أ\n")
تحقق(ن_سطر["نجاح"] == خطأ، "رفض سطر قفل ناقص")

بصمة_قصيرة = "9f2c"
ن_بصمة = قفل.حلّل_قفل("حزمة-أ 1.2.3 github.com/مالك/حزمة-أ " + بصمة_قصيرة + "\n")
تحقق(ن_بصمة["نجاح"] == خطأ، "رفض بصمة قصيرة")

ن_مكرر = قفل.ولّد_قفل([{"اسم": "حزمة-أ"، "إصدار": "1.0.0"، "مصدر": "مصدر"، "بصمة": بصمة_أ}، {"اسم": "حزمة-أ"، "إصدار": "2.0.0"، "مصدر": "مصدر"، "بصمة": بصمة_ب}])
تحقق(ن_مكرر["نجاح"] == خطأ، "رفض حزمة مكررة في التوليد")

ن_إصدار = قفل.ولّد_قفل([{"اسم": "حزمة-أ"، "إصدار": "1.2"، "مصدر": "مصدر"، "بصمة": بصمة_أ}])
تحقق(ن_إصدار["نجاح"] == خطأ، "رفض إصدار خاطئ في التوليد")

بيان_مشروع = {"اسم": "مشروعي"، "إصدار": "1.0.0"، "وصف": ""، "دخول": "مصدر/رئيسي.نيفا"، "نسخة_نيفا": لاشيء، "اعتماديات": [{"اسم": "حزمة-أ"، "نوع": "إصدار"، "مواصفة": "1.2.3"}، {"اسم": "حزمة-ب"، "نوع": "نطاق"، "مواصفة": "^1.0"}]، "اعتماديات_التطوير": [{"اسم": "حزمة-اختبار"، "نوع": "إصدار"، "مواصفة": "0.1.0"}]}
ن_مطابقة = قفل.تحقق_قفل_ضد_بيان(بيان_مشروع، ن_تحليل["حزم"])
تحقق(ن_مطابقة["نجاح"]، "مطابقة بيان وقفل موافقين")

قفل_ناقص = [{"اسم": "حزمة-أ"، "إصدار": "1.2.3"، "مصدر": "github.com/مالك/حزمة-أ"، "بصمة": بصمة_أ}]
ن_ناقص = قفل.تحقق_قفل_ضد_بيان(بيان_مشروع، قفل_ناقص)
تحقق(ن_ناقص["نجاح"] == خطأ، "رفض قفل ناقص")
تحقق(ن_ناقص["خطأ"] == "البيان والقفل مختلفان — شغّل حزم تحديث"، "رسالة قفل ناقص")

قفل_إصدار_مختلف = [{"اسم": "حزمة-أ"، "إصدار": "1.2.4"، "مصدر": "github.com/مالك/حزمة-أ"، "بصمة": بصمة_أ}، {"اسم": "حزمة-ب"، "إصدار": "1.0.0"، "مصدر": "github.com/مالك/حزمة-ب"، "بصمة": بصمة_ب}]
ن_مختلف = قفل.تحقق_قفل_ضد_بيان(بيان_مشروع، قفل_إصدار_مختلف)
تحقق(ن_مختلف["نجاح"] == خطأ، "رفض قفل بإصدار مختلف للمحدد")

قفل_زائد = [{"اسم": "حزمة-أ"، "إصدار": "1.2.3"، "مصدر": "github.com/مالك/حزمة-أ"، "بصمة": بصمة_أ}، {"اسم": "حزمة-ب"، "إصدار": "1.0.0"، "مصدر": "github.com/مالك/حزمة-ب"، "بصمة": بصمة_ب}، {"اسم": "حزمة-ج"، "إصدار": "2.0.1"، "مصدر": "github.com/مالك/حزمة-ج"، "بصمة": بصمة_ج}]
ن_زائد = قفل.تحقق_قفل_ضد_بيان(بيان_مشروع، قفل_زائد)
تحقق(ن_زائد["نجاح"]، "قفل زائد متعدٍّ مقبول في الخطوة 1")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
