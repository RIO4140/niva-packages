# اختبار وحدة النشر — خطة الخطوة الخامسة §4: تدفق الجهاز
# (نجاح + رفض + انتهاء + بطء + تعليق)، وسلسلة POST
# الثماني حتى رقم طلب الدمج، وفحوص ما قبل النشر، والسحب
# المركزي — كلها ضد خادم جيت هاب المحاكي على 127.0.0.1:39401
# (يُشغَّله المشغّل؛ بلا شبكة حقيقية).
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
استورد نشر
استورد سجل
استورد شبكة
استورد تشفير

ناجح = صحيح
سبب = ""
ح6_قاعدة = "http://127.0.0.1:39401"
ح6_خيارات_نجاح = {"قاعدة": ح6_قاعدة، "سيناريو": "نجاح"}
ح6_خيارات_رفض = {"قاعدة": ح6_قاعدة، "سيناريو": "رفض"}
ح6_خيارات_انتهاء = {"قاعدة": ح6_قاعدة، "سيناريو": "انتهاء"}
ح6_خيارات_بطء = {"قاعدة": ح6_قاعدة، "سيناريو": "بطء"}
ح6_خيارات_تعليق = {"قاعدة": ح6_قاعدة، "سيناريو": "تعليق"}

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة أعد_المحاكي():
  حاول:
    شبكة.اجلب(ح6_قاعدة + "/__إعادة")
    ارجع صحيح
  ماعدا:
    ارجع خطأ

تحقق(نشر.معرف_العميل() == "Ov23li5eP6OjsCudgfnM"، "معرف العميل العلني")
تحقق(نشر.ابحث_في("abcabc"، "bc"، ٠) == ١، "ابحث في أول ظهور")
تحقق(نشر.ابحث_في("abcabc"، "bc"، ٢) == ٤، "ابحث في من موضع")
تحقق(نشر.ابحث_في("abcabc"، "zz"، ٠) == ٠ - ١، "ابحث في غائب -١")
تحقق(نشر.ابحث_في("abc"، ""، ١) == ١، "ابحث في جزء فارغ")
ح6_جسون_نص = نشر.استخرج_نص("{\"device_code\": \"dev-1\", \"user_code\": \"WXYZ-ABCD\"}"، "device_code")
تحقق(ح6_جسون_نص["نجاح"]، "استخرج نص ينجح")
تحقق(ح6_جسون_نص["قيمة"] == "dev-1"، "استخرج نص قيمته")
تحقق_خطأ(نشر.استخرج_نص("{\"a\": \"b\"}"، "غائب")، "الحقل مفقود في الرد: غائب"، "استخرج نص غائب يرفض")
ح6_جسون_هروب = نشر.استخرج_نص("{\"a\": \"x\\ny\"}"، "a")
تحقق(ح6_جسون_هروب["قيمة"] == "x\ny"، "استخرج نص يفك الهروب")
ح6_جسون_متداخل = نشر.استخرج_نص_بعد("{\"object\": {\"sha\": \"abc123\"}}"، "sha"، نشر.ابحث_في("{\"object\": {\"sha\": \"abc123\"}}"، "\"object\""، ٠))
تحقق(ح6_جسون_متداخل["قيمة"] == "abc123"، "استخرج نص بعد موضع")
ح6_جسون_عدد = نشر.استخرج_عدد("{\"number\": 42, \"interval\": 0}"، "number")
تحقق(ح6_جسون_عدد["قيمة"] == ٤٢، "استخرج عدد قيمته")
تحقق(نشر.استخرج_عدد("{\"number\": 42, \"interval\": 0}"، "interval")["قيمة"] == ٠، "استخرج عدد صفر")
تحقق_خطأ(نشر.استخرج_عدد("{\"a\": \"b\"}"، "a")، "الحقل a ليس عددا في الرد"، "استخرج عدد نصي يرفض")
تحقق(نشر.هرّب_جسون("a\"b\\c\nd") == "a\\\"b\\\\c\\nd"، "هرّب جسون")
تحقق(سجل.صالح_طابع(نشر.طابع_الآن())، "طابع الآن صالح")
تحقق(طول(نشر.طابع_الآن()) == ٢٠، "طابع الآن 20 حرفا")

تحقق_خطأ(نشر.انشر("حزمة_بلا_بيان"، "tester/مصدر_صغير"، "v1.0.0"، "tester"، ح6_خيارات_نجاح)، "ليس مشروع حزم — شغّل حزم جديد أولا"، "انشر بلا بيان يرفض")
تحقق_خطأ(نشر.انشر("حزمة-شرطة"، "tester/مصدر_صغير"، "v1.0.0"، "tester"، ح6_خيارات_نجاح)، "اسم الحزمة حزمة-شرطة فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها (السطر 1)"، "انشر اسم بشرطة يرفض")
تحقق_خطأ(نشر.انشر("حزمة_صغيرة"، "بلا-شرطة-مائلة"، "v1.0.0"، "tester"، ح6_خيارات_نجاح)، "مستودع المصدر غير صالح — اكتبه مالك/مستودع"، "انشر مستودع بلا شرطة مائلة يرفض")
تحقق_خطأ(نشر.انشر("حزمة_صغيرة"، "tester/مصدر_صغير"، ""، "tester"، ح6_خيارات_نجاح)، "الوسم غير صالح — اكتب وسم الإصدار كما في جيت هاب (مثال v1.0.0)"، "انشر وسم فارغ يرفض")
تحقق_خطأ(نشر.انشر("حزمة_صغيرة"، "tester/مصدر_صغير"، "v1.0.0"، ""، ح6_خيارات_نجاح)، "اسم الناشر غير صالح — اكتب دخول جيت هاب"، "انشر ناشر فارغ يرفض")
تحقق_خطأ(نشر.اسحب_مركزيا("حزمة-شرطة"، "1.0.0"، ""، "tester"، ح6_خيارات_نجاح)، "اسم الحزمة حزمة-شرطة فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"، "سحب اسم بشرطة يرفض")
تحقق_خطأ(نشر.اسحب_مركزيا("حزمة_صغيرة"، "بلا-إصدار"، ""، "tester"، ح6_خيارات_نجاح)، "إصدار غير صالح: بلا-إصدار — الصيغة رئيسي.فرعي.إصلاحي"، "سحب إصدار بلا صيغة يرفض")

ح6_دخول_ناجح = نشر.سجّل_دخول(ح6_خيارات_نجاح)
تحقق(ح6_دخول_ناجح["نجاح"]، "دخول ناجح ينجح")
تحقق(ح6_دخول_ناجح["رمز"] == "gho_mock_token_123"، "دخول ناجح رمزه")
تحقق_خطأ(نشر.سجّل_دخول(ح6_خيارات_رفض)، "ألغى الناشر التفويض"، "دخول مرفوض يرفض")
تحقق_خطأ(نشر.سجّل_دخول(ح6_خيارات_انتهاء)، "انتهت صلاحية رمز الجهاز — أعد حزم انشر من جديد"، "دخول منتهي يرفض")
ح6_دخول_بطيء = نشر.سجّل_دخول(ح6_خيارات_بطء)
تحقق(ح6_دخول_بطيء["نجاح"]، "دخول بطيء ينجح بعد التباطؤ")
تحقق(ح6_دخول_بطيء["رمز"] == "gho_mock_token_123"، "دخول بطيء رمزه")
تحقق_خطأ(نشر.سجّل_دخول(ح6_خيارات_تعليق)، "انتهت مهلة التفويض — أعد حزم انشر من جديد"، "دخول معلّق تنتهي مهلته")

تحقق(أعد_المحاكي()، "إعادة المحاكي قبل النشر")
ح6_نشر = نشر.انشر("حزمة_صغيرة"، "tester/مصدر_صغير"، "v1.0.0"، "tester"، ح6_خيارات_نجاح)
تحقق(ح6_نشر["نجاح"]، "انشر كامل ينجح")
تحقق(ح6_نشر["طلب"] == ٤٢، "انشر رقم الطلب 42")
تحقق(ح6_نشر["نص"] == "نُشرت الحزمة حزمة_صغيرة 1.0.0 — طلب الدمج رقم 42 في مستودع الفهرس"، "انشر نصه")
تحقق(ح6_نشر["فرع"] == "انشر-حزمة_صغيرة-1.0.0"، "انشر فرعه")
ح6_بلوب_نص = شبكة.اجلب(ح6_قاعدة + "/__آخر_بلوب")
ح6_بلوب = نشر.استخرج_نص(ح6_بلوب_نص، "content")
تحقق(ح6_بلوب["نجاح"]، "قراءة آخر بلوب تنجح")
ح6_فهرس_جديد = سجل.حلّل_فهرس(ح6_بلوب["قيمة"])
تحقق(ح6_فهرس_جديد["نجاح"]، "بلوب النشر فهرس صالح")
تحقق(طول(ح6_فهرس_جديد["إدخالات"]) == ٣، "بلوب النشر 3 إدخالات")
تحقق(طول(ح6_فهرس_جديد["سحوبات"]) == ١، "بلوب النشر سحب واحد قديم")
ح6_إدخال_جديد = لاشيء
لكل ح6_إدخال في ح6_فهرس_جديد["إدخالات"]:
  إذا ح6_إدخال["اسم"] == "حزمة_صغيرة":
    إذا ح6_إدخال["إصدار"] == "1.0.0":
      ح6_إدخال_جديد = ح6_إدخال
تحقق(ح6_إدخال_جديد != لاشيء، "بلوب النشر فيه الإدخال الجديد")
تحقق(ح6_إدخال_جديد["مستودع"] == "github.com/tester/مصدر_صغير"، "بلوب النشر مستودعه")
تحقق(ح6_إدخال_جديد["وسم"] == "v1.0.0"، "بلوب النشر وسمه")
تحقق(ح6_إدخال_جديد["بصمة_التزام"] == "1234567890abcdef1234567890abcdef12345678"، "بلوب النشر بصمة التزامه")
تحقق(ح6_إدخال_جديد["ناشر"] == "tester"، "بلوب النشر ناشره")
تحقق(سجل.صالح_طابع(ح6_إدخال_جديد["طابع"])، "بلوب النشر طابعه صالح")
ح6_نص_بيان = اقرأ_ملف("حزمة_صغيرة/بيان.حزمة")
تحقق(ح6_إدخال_جديد["بصمة"] == تشفير.جزّئ(ح6_نص_بيان)، "بلوب النشر بصمة بيانه")
تحقق(ح6_إدخال_جديد["وصف"] == "حزمة صغيرة للاختبار"، "بلوب النشر وصفه")
تحقق(ح6_إدخال_جديد["حجم"] == ١٦٢، "بلوب النشر حجمه مقاس من المجلد")
تحقق(طول(ح6_إدخال_جديد["اعتماديات"]) == ٠، "بلوب النشر بلا اعتماديات")
ح6_طلبات = شبكة.اجلب(ح6_قاعدة + "/__طلبات")
ح6_م_فهرس = نشر.ابحث_في(ح6_طلبات، "GET /RIO4140/niva-index/main/فهرس.حزمة"، ٠)
ح6_م_بيان = نشر.ابحث_في(ح6_طلبات، "GET /tester/مصدر_صغير/v1.0.0/بيان.حزمة"، ٠)
ح6_م_التزام = نشر.ابحث_في(ح6_طلبات، "GET /repos/tester/مصدر_صغير/commits/v1.0.0"، ٠)
ح6_م_رمز = نشر.ابحث_في(ح6_طلبات، "POST /login/device/code"، ٠)
ح6_م_دخول = نشر.ابحث_في(ح6_طلبات، "POST /login/oauth/access_token"، ٠)
ح6_م_تفرع = نشر.ابحث_في(ح6_طلبات، "POST /repos/RIO4140/niva-index/forks"، ٠)
ح6_م_مرجع = نشر.ابحث_في(ح6_طلبات، "GET /repos/tester/niva-index/git/ref/heads/main"، ٠)
ح6_م_كائن = نشر.ابحث_في(ح6_طلبات، "POST /repos/tester/niva-index/git/blobs"، ٠)
ح6_م_شجرة = نشر.ابحث_في(ح6_طلبات، "POST /repos/tester/niva-index/git/trees"، ٠)
ح6_م_التزام_سلسلة = نشر.ابحث_في(ح6_طلبات، "POST /repos/tester/niva-index/git/commits"، ٠)
ح6_م_مرجع_سلسلة = نشر.ابحث_في(ح6_طلبات، "POST /repos/tester/niva-index/git/refs"، ٠)
ح6_م_طلب = نشر.ابحث_في(ح6_طلبات، "POST /repos/RIO4140/niva-index/pulls"، ٠)
تحقق(ح6_م_فهرس >= ٠، "سجل الطلبات فيه الفهرس المركزي")
تحقق(ح6_م_فهرس < ح6_م_بيان، "ترتيب الطلبات: الفهرس قبل بيان الوسم")
تحقق(ح6_م_بيان < ح6_م_التزام، "ترتيب الطلبات: بيان الوسم قبل التزامه")
تحقق(ح6_م_التزام < ح6_م_رمز، "ترتيب الطلبات: التزام الوسم قبل رمز الجهاز")
تحقق(ح6_م_رمز < ح6_م_دخول، "ترتيب الطلبات: رمز الجهاز قبل الدخول")
تحقق(ح6_م_دخول < ح6_م_تفرع، "ترتيب الطلبات: الدخول قبل التفرع")
تحقق(ح6_م_تفرع < ح6_م_مرجع، "ترتيب الطلبات: التفرع قبل مرجع الأساس")
تحقق(ح6_م_مرجع < ح6_م_كائن، "ترتيب الطلبات: مرجع الأساس قبل الكائن")
تحقق(ح6_م_كائن < ح6_م_شجرة، "ترتيب الطلبات: الكائن قبل الشجرة")
تحقق(ح6_م_شجرة < ح6_م_التزام_سلسلة، "ترتيب الطلبات: الشجرة قبل الالتزام")
تحقق(ح6_م_التزام_سلسلة < ح6_م_مرجع_سلسلة، "ترتيب الطلبات: الالتزام قبل المرجع")
تحقق(ح6_م_مرجع_سلسلة < ح6_م_طلب، "ترتيب الطلبات: المرجع قبل طلب الدمج")

تحقق_خطأ(نشر.انشر("حزمة_وسط"، "tester/مصدر_وسط"، "v1.0.0"، "tester"، ح6_خيارات_نجاح)، "الإصدار 1.0.0 للحزمة حزمة_وسط منشور أصلا في الفهرس — غيّر الإصدار"، "انشر مكرر يرفض")
تحقق_خطأ(نشر.انشر("حزمة_صغيرة_1_1_0"، "tester/مصدر_صغير"، "v1.1.0"، "tester"، ح6_خيارات_نجاح)، "بيان.حزمة عند الوسم v1.1.0 بإصدار 1.0.0 لا يطابق المشروع المحلي 1.1.0"، "انشر بيان وسم مختلف يرفض")

تحقق(أعد_المحاكي()، "إعادة المحاكي قبل السحب")
ح6_سحب = نشر.اسحب_مركزيا("حزمة_وسط"، "1.0.0"، "إصدار معيب"، "tester"، ح6_خيارات_نجاح)
تحقق(ح6_سحب["نجاح"]، "سحب مركزي ينجح")
تحقق(ح6_سحب["طلب"] == ٤٢، "سحب مركزي رقم الطلب 42")
تحقق(ح6_سحب["نص"] == "سُحب الإصدار 1.0.0 للحزمة حزمة_وسط — طلب الدمج رقم 42 في مستودع الفهرس"، "سحب مركزي نصه")
تحقق(ح6_سحب["فرع"] == "انشر-حزمة_وسط-1.0.0-سحب"، "سحب مركزي فرعه")
ح6_بلوب_سحب_نص = شبكة.اجلب(ح6_قاعدة + "/__آخر_بلوب")
ح6_بلوب_سحب = نشر.استخرج_نص(ح6_بلوب_سحب_نص، "content")
ح6_فهرس_سحب = سجل.حلّل_فهرس(ح6_بلوب_سحب["قيمة"])
تحقق(ح6_فهرس_سحب["نجاح"]، "بلوب السحب فهرس صالح")
تحقق(طول(ح6_فهرس_سحب["إدخالات"]) == ٢، "بلوب السحب إدخالان باقيان")
تحقق(طول(ح6_فهرس_سحب["سحوبات"]) == ٢، "بلوب السحب سحبان")
ح6_سحب_جديد = لاشيء
لكل ح6_سحب_واحد في ح6_فهرس_سحب["سحوبات"]:
  إذا ح6_سحب_واحد["اسم"] == "حزمة_وسط":
    إذا ح6_سحب_واحد["إصدار"] == "1.0.0":
      ح6_سحب_جديد = ح6_سحب_واحد
تحقق(ح6_سحب_جديد != لاشيء، "بلوب السحب فيه سطر السحب")
تحقق(ح6_سحب_جديد["سبب"] == "إصدار معيب"، "بلوب السحب سببه")
تحقق_خطأ(نشر.اسحب_مركزيا("حزمة_غائبة"، "1.0.0"، ""، "tester"، ح6_خيارات_نجاح)، "لا يوجد إصدار 1.0.0 للحزمة حزمة_غائبة في الفهرس — لا يمكن سحبه"، "سحب غائبة يرفض")
تحقق_خطأ(نشر.اسحب_مركزيا("حزمة_قديمة"، "0.9.0"، ""، "tester"، ح6_خيارات_نجاح)، "الإصدار 0.9.0 للحزمة حزمة_قديمة مسحوب أصلا"، "سحب مسحوبة يرفض")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
