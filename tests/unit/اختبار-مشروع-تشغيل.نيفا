# اختبار وحدة مشاريع — تشغيل: ابن، شغل، اختبر
# يطبع «ناجح» عند النجاح و«فاشل: السبب» عند الفشل.
# والتأكيدات تكيفية مع الوضع: في الوضع المقيد (المشغّل)
# يُرفض ابن برسالة سطر الأوامر ويُتخطى مفسر اختبر؛ وفي
# الوضع الموثوق يبني ابن فعلا ويتحقق اختبر من الوضعين.
استورد بيان
استورد تشفير
استورد مشروع

ناجح = صحيح
سبب = ""

دالة تحقق(شرط، رسالة):
  إذا شرط == خطأ:
    إذا ناجح:
      ناجح = خطأ
      سبب = رسالة

دالة تحقق_خطأ(نتيجة، متوقع، اسم_فحص):
  إذا نتيجة["نجاح"] == خطأ:
    تحقق(نتيجة["خطأ"] == متوقع، اسم_فحص)
  وإلا:
    تحقق(خطأ، اسم_فحص)

دالة ح4_مرشح_من_مجلد(ح4_مجلد):
  ح4_بيان = بيان.اقرأ_بيان(ح4_مجلد + "/بيان.حزمة")
  إذا ح4_بيان["نجاح"] == خطأ:
    ارجع ح4_بيان
  ح4_نص = اقرأ_ملف(ح4_مجلد + "/بيان.حزمة")
  ح4_بصمة = تشفير.جزّئ(ح4_نص)
  ارجع {"نجاح": صحيح، "مرشح": {"إصدار": ح4_بيان["بيان"]["إصدار"]، "بيان": ح4_بيان["بيان"]، "مصدر": "مصدر_" + ح4_بيان["بيان"]["اسم"]، "بصمة": ح4_بصمة، "مجلد": ح4_مجلد، "منشور": لاشيء}}

ح4_م_صغيرة = ح4_مرشح_من_مجلد("حزمة_صغيرة")
ح4_م_صغيرة11 = ح4_مرشح_من_مجلد("حزمة_صغيرة_1_1_0")
ح4_م_وسط = ح4_مرشح_من_مجلد("حزمة_وسط")
ح4_فهرس = {"حزمة_صغيرة": [ح4_م_صغيرة["مرشح"]، ح4_م_صغيرة11["مرشح"]]، "حزمة_وسط": [ح4_م_وسط["مرشح"]]}

ح4_جديد = مشروع.جديد("مشروعي"، "أداة"، "", "")
تحقق(ح4_جديد["نجاح"]، "جديد مشروعي")
ح4_أضف = مشروع.أضف_اعتماد("مشروعي"، "حزمة_وسط"، لاشيء، ح4_فهرس، {})
تحقق(ح4_أضف["نجاح"]، "أضف الوسط")

# ابن: موثوق يبني، ومقيد يرفض برسالة سطر الأوامر
ح4_ابن = مشروع.ابن("مشروعي")
إذا ح4_ابن["نجاح"]:
  تحقق(ح4_ابن["رمز"] == ٠، "رمز البناء صفر")
  تحقق(موجود("مشروعي/مصدر/رئيسي.نيفاب")، "ملف البناء موجود")
وإلا:
  تحقق_خطأ(ح4_ابن، "حزم ابن يحتاج سطر الأوامر — شغّل مباشرة: نيفا ابن مصدر/رئيسي.نيفا"، "ابن في المقيد يرفض")

# شغل: يشغّل الدخول ويعيد صفرا
ح4_شغل = مشروع.شغّل("مشروعي"، [])
تحقق(ح4_شغل["نجاح"]، "شغل ينجح")
تحقق(ح4_شغل["رمز"] == ٠، "رمز التشغيل صفر")

# شغل: شجرة غير متزامنة ترفض قبل التشغيل
ح4_حذف_ش = مشروع.احذف_شجرة("مشروعي/حزم/حزمة_صغيرة")
تحقق(ح4_حذف_ش["نجاح"]، "حذف الصغيرة للشغل")
ح4_شغل_غير = مشروع.شغّل("مشروعي"، [])
تحقق_خطأ(ح4_شغل_غير، "الشجرة المثبتة لا تطابق القفل:\n  الحزمة حزمة_صغيرة في القفل وليست مثبّتة في حزم/"، "غير متزامن يرفض الشغل")
ح4_ثبت_ش = مشروع.ثبّت_القفل("مشروعي"، ح4_فهرس، {})
تحقق(ح4_ثبت_ش["نجاح"]، "استعادة بعد الشغل")

# شغل: بصمة معدَّلة ترفض قبل التشغيل (الفكرة 2 — التحقق قبل كل تشغيل)
ح4_نص_مثبتة_ش = اقرأ_ملف("مشروعي/حزم/حزمة_صغيرة/بيان.حزمة")
اكتب_ملف("مشروعي/حزم/حزمة_صغيرة/بيان.حزمة"، ح4_نص_مثبتة_ش.استبدل("حزمة صغيرة للاختبار"، "حزمة معدلة"))
ح4_شغل_بصمة = مشروع.شغّل("مشروعي"، [])
تحقق_خطأ(ح4_شغل_بصمة، "الشجرة المثبتة لا تطابق القفل:\n  بصمة الحزمة حزمة_صغيرة لا تطابق القفل"، "بصمة معدَّلة ترفض الشغل")
ح4_ثبت_بصمة = مشروع.ثبّت_القفل("مشروعي"، ح4_فهرس، {})
تحقق(ح4_ثبت_بصمة["نجاح"]، "استعادة بعد بصمة الشغل")

# شغل: دخول غائب يرفض بصراحة (بعد تحقق سليم)
ح4_جديد_فارغ = مشروع.جديد("فارغي"، "فارغ"، "", "")
تحقق(ح4_جديد_فارغ["نجاح"]، "جديد فارغي")
ح4_أضف_فارغ = مشروع.أضف_اعتماد("فارغي"، "حزمة_صغيرة"، لاشيء، ح4_فهرس، {})
تحقق(ح4_أضف_فارغ["نجاح"]، "أضف للفارغ")
ح4_شغل_فارغ = مشروع.شغّل("فارغي"، [])
تحقق_خطأ(ح4_شغل_فارغ، "مسار الدخول غير موجود: مصدر/رئيسي.نيفا"، "دخول غائب يرفض")

# اختبر: المترجم يمر، والمفسر موثوق يمر ومقيد يُتخطى بصراحة
ح4_اختبر = مشروع.اختبر("مشروعي"، {})
إذا ح4_اختبر["نجاح"]:
  تحقق(طول(ح4_اختبر["نتائج"]) == ١، "نتيجة اختبار واحدة")
  تحقق(ح4_اختبر["نتائج"][٠]["مترجم"] == "ناجح"، "المترجم ناجح")
  تحقق(ح4_اختبر["نتائج"][٠]["مفسر"] == "ناجح"، "المفسر ناجح")
وإلا:
  تحقق_خطأ(ح4_اختبر، "اختبر: المفسر متخطى — شغّل في وضع موثوق للتحقق من الوضعين"، "المفسر متخطى في المقيد")

# اختبر: ملف فاشل يُبلَّغ فاشلا في المترجم
اكتب_ملف("مشروعي/اختبارات/اختبار-فاشل.نيفا", "اطبع \"فاشل: عمدا\"\n")
ح4_اختبر_فاشل = مشروع.اختبر("مشروعي"، {})
تحقق(ح4_اختبر_فاشل["نجاح"] == خطأ، "فاشل يرفض")
تحقق(ح4_اختبر_فاشل["خطأ"].يحتوي("اختبار-فاشل.نيفا (المترجم)")، "الفاشل مسمى بالمترجم")
احذف("مشروعي/اختبارات/اختبار-فاشل.نيفا")

# اختبر: بلا مجلد اختبارات يرفض
ح4_جديد_بلا = مشروع.جديد("مشروع_بلا"، "أداة"، "", "")
تحقق(ح4_جديد_بلا["نجاح"]، "جديد مشروع_بلا")
ح4_حذف_خت = مشروع.احذف_شجرة("مشروع_بلا/اختبارات")
تحقق(ح4_حذف_خت["نجاح"]، "حذف مجلد الاختبارات")
ح4_اختبر_بلا = مشروع.اختبر("مشروع_بلا"، {})
تحقق_خطأ(ح4_اختبر_بلا، "لا يوجد مجلد اختبارات في المشروع"، "بلا اختبارات يرفض")

إذا ناجح:
  اطبع "ناجح"
وإلا:
  اطبع "فاشل: " + سبب
