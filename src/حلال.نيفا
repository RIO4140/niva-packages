# الحلّال — حل الاعتماديات اتساعا (التصميم §6 + §16 الخطوة 3)
# يأخذ بيانا محللا وفهرسا حرفيا (قاموس اسم → قائمة مرشحين) وخيارات،
# ويرجع الحل الكامل مرتبا بالاسم أو خطأ عربيا — بلا كتابة جزئية أبدا.
# المرشح: {"إصدار"، "بيان" (بيان محلل)، "مصدر"، "بصمة"، "منشور" (ثواني يونكس أو لاشيء)}.
# الخيارات: {"وضع": "الأحدث"/"الأدنى"، "تهدئة_أيام": عدد، "الآن": عدد/لاشيء، "مصادر": {اسم: مصدر}، "تطوير": صحيح/خطأ}.
# وكل دوال هذه الوحدة ترجع قاموس نتيجة: {"نجاح": صحيح، ...} أو {"نجاح": خطأ، "خطأ": "رسالة عربية"}.
# محليات كل الدوال هنا ببادئة "حل_" — التفاف حول تسرب محليات المفسر (خطة الخطوة 1 §6).
صدر حلّ، حدّث_حزمة، حلّ_إلى_قفل، خيارات_افتراضية
استورد نص باسم نصوص
استورد إصدار
استورد بيان
استورد قفل
استورد وقت

دالة خيارات_افتراضية():
  ارجع {"وضع": "الأحدث"، "تهدئة_أيام": ٠، "الآن": لاشيء، "مصادر": {}، "تطوير": خطأ، "مثبّتة": []، "هدف_تحديث": لاشيء}

دالة حل_خيار(حل_خيارات، حل_مفتاح، حل_افتراضي):
  إذا حل_خيارات == لاشيء:
    ارجع حل_افتراضي
  إذا حل_مفتاح في حل_خيارات:
    ارجع حل_خيارات[حل_مفتاح]
  ارجع حل_افتراضي

دالة حل_حقل(حل_قاموس، حل_مفتاح، حل_افتراضي):
  إذا حل_مفتاح في حل_قاموس:
    ارجع حل_قاموس[حل_مفتاح]
  ارجع حل_افتراضي

دالة حل_انضم(حل_قائمة، حل_فاصل):
  حل_نص = ""
  حل_أول = صحيح
  لكل حل_عنصر في حل_قائمة:
    إذا حل_أول == خطأ:
      حل_نص = حل_نص + حل_فاصل
    حل_نص = حل_نص + حل_عنصر
    حل_أول = خطأ
  ارجع حل_نص

دالة حل_جد_إدخال(حل_قائمة، حل_اسم):
  لكل حل_إدخال في حل_قائمة:
    إذا حل_إدخال["اسم"] == حل_اسم:
      ارجع حل_إدخال
  ارجع لاشيء

دالة حل_ضع_إدخال(حل_قائمة، حل_إدخال):
  حل_نتيجة = []
  حل_وجد = خطأ
  لكل حل_قديم في حل_قائمة:
    إذا حل_قديم["اسم"] == حل_إدخال["اسم"]:
      حل_نتيجة.أضف(حل_إدخال)
      حل_وجد = صحيح
    وإلا:
      حل_نتيجة.أضف(حل_قديم)
  إذا حل_وجد == خطأ:
    حل_نتيجة.أضف(حل_إدخال)
  ارجع حل_نتيجة

دالة حل_احذف_إدخال(حل_قائمة، حل_اسم):
  حل_نتيجة = []
  لكل حل_قديم في حل_قائمة:
    إذا حل_قديم["اسم"] != حل_اسم:
      حل_نتيجة.أضف(حل_قديم)
  ارجع حل_نتيجة

دالة حل_متطلبات_ل(حل_متطلبات، حل_اسم):
  حل_إدخال = حل_جد_إدخال(حل_متطلبات، حل_اسم)
  إذا حل_إدخال == لاشيء:
    ارجع []
  ارجع حل_إدخال["قائمة"]

دالة حل_ضع_متطلبات(حل_متطلبات، حل_اسم، حل_قائمة):
  إذا طول(حل_قائمة) == ٠:
    ارجع حل_احذف_إدخال(حل_متطلبات، حل_اسم)
  ارجع حل_ضع_إدخال(حل_متطلبات، {"اسم": حل_اسم، "قائمة": حل_قائمة})

دالة حل_أضف_متطلب(حل_متطلبات، حل_اسم، حل_طالب، حل_نوع، حل_مواصفة):
  حل_قائمة = حل_متطلبات_ل(حل_متطلبات، حل_اسم)
  حل_قائمة.أضف({"طالب": حل_طالب، "نوع": حل_نوع، "مواصفة": حل_مواصفة})
  ارجع حل_ضع_متطلبات(حل_متطلبات، حل_اسم، حل_قائمة)

دالة حل_احذف_متطلبات_طالب(حل_متطلبات، حل_طالب):
  حل_متطلبات_جديدة = []
  حل_متأثرة = []
  لكل حل_إدخال في حل_متطلبات:
    حل_باقية = []
    لكل حل_متطلب في حل_إدخال["قائمة"]:
      إذا حل_متطلب["طالب"] != حل_طالب:
        حل_باقية.أضف(حل_متطلب)
    إذا طول(حل_باقية) != طول(حل_إدخال["قائمة"]):
      حل_متأثرة.أضف(حل_إدخال["اسم"])
    إذا طول(حل_باقية) > ٠:
      حل_متطلبات_جديدة.أضف({"اسم": حل_إدخال["اسم"]، "قائمة": حل_باقية})
  ارجع {"متطلبات": حل_متطلبات_جديدة، "متأثرة": حل_متأثرة}

دالة حل_أضف_طابور(حل_طابور، حل_اسم):
  إذا حل_اسم في حل_طابور:
    ارجع حل_طابور
  حل_طابور.أضف(حل_اسم)
  ارجع حل_طابور

دالة حل_أزل_طابور(حل_طابور، حل_اسم):
  حل_نتيجة = []
  لكل حل_عنصر في حل_طابور:
    إذا حل_عنصر != حل_اسم:
      حل_نتيجة.أضف(حل_عنصر)
  ارجع حل_نتيجة

دالة حل_أساس_نطاق(حل_مواصفة):
  حل_باقي = نصوص.من_الفهرس(حل_مواصفة، ١)
  حل_أجزاء = حل_باقي.قسم(".")
  إذا طول(حل_أجزاء) == ٢:
    ارجع حل_أجزاء[٠] + "." + حل_أجزاء[١] + ".0"
  ارجع حل_أجزاء[٠] + "." + حل_أجزاء[١] + "." + حل_أجزاء[٢]

دالة حل_رئيس_أساس(حل_أساس):
  حل_أجزاء = حل_أساس.قسم(".")
  ارجع عدد(حل_أجزاء[٠])

دالة حل_خطأ_تعارض(حل_اسم، حل_قائمة):
  حل_نص_خطأ = "تعارض اعتماديات في الحزمة " + حل_اسم + ":"
  لكل حل_متطلب في حل_قائمة:
    حل_نص_خطأ = حل_نص_خطأ + "\n  " + حل_متطلب["طالب"] + " يطلب " + حل_متطلب["مواصفة"]
  حل_نص_خطأ = حل_نص_خطأ + "\nثبّت إصدارا واحدا يرضي الطرفين في البيان، أو حدّث أحدهما"
  ارجع {"نجاح": خطأ، "خطأ": حل_نص_خطأ}

# دمج متطلبات حزمة واحدة إلى قيد واحد.
# التجاوز الصريح (طالب "تجاوز") يفوز على كل متطلب متعدٍّ — فغرضه
# فرض إصدار بعينه رغم تعارض الشجرة — ولا يتعارض إلا مع متطلب
# مباشر من البيان نفسه بإصدار مختلف أو نطاق لا يرضيه، أو مع تجاوز
# آخر مختلف. ومصدر مطلوب (رابط) من أي طالب يبقى قيدا على المصدر.
دالة حل_ادمج(حل_اسم، حل_قائمة، حل_جذر):
  حل_تجاوز = لاشيء
  حل_مصدر_تجاوز = لاشيء
  لكل حل_متطلب_أول في حل_قائمة:
    إذا حل_متطلب_أول["نوع"] == "مصدر":
      إذا حل_مصدر_تجاوز != لاشيء:
        إذا حل_متطلب_أول["مواصفة"] != حل_مصدر_تجاوز:
          ارجع حل_خطأ_تعارض(حل_اسم، حل_قائمة)
      حل_مصدر_تجاوز = حل_متطلب_أول["مواصفة"]
    وإلا إذا حل_متطلب_أول["طالب"] == "تجاوز":
      إذا حل_تجاوز != لاشيء:
        إذا حل_متطلب_أول["مواصفة"] != حل_تجاوز:
          ارجع حل_خطأ_تعارض(حل_اسم، حل_قائمة)
      حل_تجاوز = حل_متطلب_أول["مواصفة"]
  إذا حل_تجاوز != لاشيء:
    لكل حل_متطلب_مباشر في حل_قائمة:
      إذا حل_متطلب_مباشر["طالب"] == حل_جذر:
        إذا حل_متطلب_مباشر["نوع"] == "إصدار":
          إذا حل_متطلب_مباشر["مواصفة"] != حل_تجاوز:
            ارجع حل_خطأ_تعارض(حل_اسم، حل_قائمة)
        وإلا إذا حل_متطلب_مباشر["نوع"] == "نطاق":
          حل_مطابقة_مباشرة = إصدار.يطابق(حل_متطلب_مباشر، حل_تجاوز)
          إذا حل_مطابقة_مباشرة["نجاح"] == خطأ:
            ارجع حل_مطابقة_مباشرة
          إذا حل_مطابقة_مباشرة["يطابق"] == خطأ:
            ارجع حل_خطأ_تعارض(حل_اسم، حل_قائمة)
    ارجع {"نجاح": صحيح، "نوع": "إصدار"، "مواصفة": حل_تجاوز، "مصدر_مطلوب": حل_مصدر_تجاوز}
  حل_محددات = []
  حل_نطاقات = []
  حل_مصادر_مطلوبة = []
  لكل حل_متطلب في حل_قائمة:
    إذا حل_متطلب["نوع"] == "إصدار":
      حل_محددات.أضف(حل_متطلب)
    وإلا إذا حل_متطلب["نوع"] == "نطاق":
      حل_نطاقات.أضف(حل_متطلب)
    وإلا إذا حل_متطلب["نوع"] == "مصدر":
      حل_مصادر_مطلوبة.أضف(حل_متطلب)
  حل_مصدر_مطلوب = لاشيء
  إذا طول(حل_مصادر_مطلوبة) > ٠:
    حل_مصدر_مطلوب = حل_مصادر_مطلوبة[٠]["مواصفة"]
    لكل حل_مصدر_متطلب في حل_مصادر_مطلوبة:
      إذا حل_مصدر_متطلب["مواصفة"] != حل_مصدر_مطلوب:
        ارجع حل_خطأ_تعارض(حل_اسم، حل_قائمة)
  حل_محدد = لاشيء
  إذا طول(حل_محددات) > ٠:
    حل_محدد = حل_محددات[٠]["مواصفة"]
    لكل حل_محدد_متطلب في حل_محددات:
      إذا حل_محدد_متطلب["مواصفة"] != حل_محدد:
        ارجع حل_خطأ_تعارض(حل_اسم، حل_قائمة)
  حل_نطاق_مدمج = لاشيء
  حل_نطاق_أساس = ""
  إذا طول(حل_نطاقات) > ٠:
    حل_نطاق_أول = حل_نطاقات[٠]
    حل_نطاق_مدمج = حل_نطاق_أول["مواصفة"]
    حل_نطاق_أساس = حل_أساس_نطاق(حل_نطاق_أول["مواصفة"])
    حل_رئيس_نطاق = حل_رئيس_أساس(حل_نطاق_أساس)
    لكل حل_نطاق_متطلب في حل_نطاقات:
      حل_أساس_منافس = حل_أساس_نطاق(حل_نطاق_متطلب["مواصفة"])
      إذا حل_رئيس_أساس(حل_أساس_منافس) != حل_رئيس_نطاق:
        ارجع حل_خطأ_تعارض(حل_اسم، حل_قائمة)
      حل_مقارنة_أساس = إصدار.قارن_إصدارين(حل_أساس_منافس، حل_نطاق_أساس)
      إذا حل_مقارنة_أساس["نجاح"] == خطأ:
        ارجع حل_مقارنة_أساس
      إذا حل_مقارنة_أساس["مقارنة"] > ٠:
        حل_نطاق_مدمج = حل_نطاق_متطلب["مواصفة"]
        حل_نطاق_أساس = حل_أساس_منافس
  إذا حل_محدد != لاشيء:
    إذا حل_نطاق_مدمج != لاشيء:
      حل_مواصفة_نطاق = {"نوع": "نطاق"، "مواصفة": حل_نطاق_مدمج}
      حل_مطابقة_محدد = إصدار.يطابق(حل_مواصفة_نطاق، حل_محدد)
      إذا حل_مطابقة_محدد["نجاح"] == خطأ:
        ارجع حل_مطابقة_محدد
      إذا حل_مطابقة_محدد["يطابق"] == خطأ:
        ارجع حل_خطأ_تعارض(حل_اسم، حل_قائمة)
    ارجع {"نجاح": صحيح، "نوع": "إصدار"، "مواصفة": حل_محدد، "مصدر_مطلوب": حل_مصدر_مطلوب}
  إذا حل_نطاق_مدمج != لاشيء:
    ارجع {"نجاح": صحيح، "نوع": "نطاق"، "مواصفة": حل_نطاق_مدمج، "مصدر_مطلوب": حل_مصدر_مطلوب}
  ارجع {"نجاح": صحيح، "نوع": "الأحدث"، "مواصفة": "الأحدث"، "مصدر_مطلوب": حل_مصدر_مطلوب}

# تفضيل القفل: إن كانت الحزمة مثبّتة في القفل وإصدارها المثبّت يرضي
# القيد المدمج، والحزمة ليست هدف التحديث، وإصدارها موجود في الفهرس
# ببصمة صالحة، ارجع مرشحها — وإلا ارجع لاشيء فيُعاد الاختيار حرا.
# القفل لا يفرض الحزمة في الشجرة: حزمة غير واصلة لا تُختار أصلا.
دالة حل_مرشح_مقفل(حل_اسم، حل_مدمج، حل_مرشحون، حل_خيارات):
  إذا حل_مدمج["مصدر_مطلوب"] != لاشيء:
    ارجع لاشيء
  حل_مثبّتة_مقفلة = حل_خيار(حل_خيارات، "مثبّتة"، [])
  حل_هدف_مقفل = حل_خيار(حل_خيارات، "هدف_تحديث"، لاشيء)
  إذا حل_هدف_مقفل != لاشيء:
    إذا حل_اسم == حل_هدف_مقفل:
      ارجع لاشيء
  حل_مقفلة_مقفل = حل_جد_إدخال(حل_مثبّتة_مقفلة، حل_اسم)
  إذا حل_مقفلة_مقفل == لاشيء:
    ارجع لاشيء
  حل_مطابقة_مقفلة = إصدار.يطابق({"نوع": حل_مدمج["نوع"]، "مواصفة": حل_مدمج["مواصفة"]}، حل_مقفلة_مقفل["إصدار"])
  إذا حل_مطابقة_مقفلة["نجاح"] == خطأ:
    ارجع لاشيء
  إذا حل_مطابقة_مقفلة["يطابق"] == خطأ:
    ارجع لاشيء
  لكل حل_مرشح في حل_مرشحون:
    إذا حل_مرشح["إصدار"] == حل_مقفلة_مقفل["إصدار"]:
      إذا قفل.صالح_بصمة(حل_مرشح["بصمة"]):
        ارجع حل_مرشح
      ارجع لاشيء
  ارجع لاشيء

دالة حل_اختر(حل_اسم، حل_مدمج، حل_مرشحون، حل_وضع، حل_مصادر، حل_تهدئة، حل_الآن):
  حل_مصدر_فعال = لاشيء
  إذا حل_اسم في حل_مصادر:
    حل_مصدر_فعال = حل_مصادر[حل_اسم]
  إذا حل_مدمج["مصدر_مطلوب"] != لاشيء:
    إذا حل_مصدر_فعال != لاشيء:
      إذا حل_مصدر_فعال != حل_مدمج["مصدر_مطلوب"]:
        ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + حل_اسم + " غير موجودة في المصدر " + حل_مصدر_فعال}
    وإلا:
      حل_مصدر_فعال = حل_مدمج["مصدر_مطلوب"]
  حل_مؤهلون = []
  لكل حل_مرشح في حل_مرشحون:
    إذا حل_مصدر_فعال != لاشيء:
      إذا حل_حقل(حل_مرشح، "مصدر"، "") != حل_مصدر_فعال:
        تابع
    إذا قفل.صالح_بصمة(حل_حقل(حل_مرشح، "بصمة"، "")) == خطأ:
      تابع
    حل_مؤهلون.أضف(حل_مرشح)
  إذا حل_مصدر_فعال != لاشيء:
    إذا طول(حل_مؤهلون) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + حل_اسم + " غير موجودة في المصدر " + حل_مصدر_فعال}
  إذا حل_مدمج["نوع"] != "إصدار":
    إذا حل_تهدئة > ٠:
      حل_حد_تهدئة = حل_الآن - (حل_تهدئة * ٨٦٤٠٠)
      حل_بعد_تهدئة = []
      لكل حل_مرشح_تهدئة في حل_مؤهلون:
        حل_منشور = حل_حقل(حل_مرشح_تهدئة، "منشور"، لاشيء)
        إذا حل_منشور == لاشيء:
          حل_بعد_تهدئة.أضف(حل_مرشح_تهدئة)
        وإلا إذا حل_منشور <= حل_حد_تهدئة:
          حل_بعد_تهدئة.أضف(حل_مرشح_تهدئة)
      إذا طول(حل_بعد_تهدئة) == ٠:
        ارجع {"نجاح": خطأ، "خطأ": "كل إصدارات الحزمة " + حل_اسم + " حديثة — انتظر انتهاء التهدئة أو اطلب إصدارا بعينه"}
      حل_مؤهلون = حل_بعد_تهدئة
  حل_إصدارات = []
  لكل حل_مرشح_إصدار في حل_مؤهلون:
    حل_إصدارات.أضف(حل_حقل(حل_مرشح_إصدار، "إصدار"، ""))
  حل_مواصفة_اختيار = {"نوع": حل_مدمج["نوع"]، "مواصفة": حل_مدمج["مواصفة"]}
  إذا حل_وضع == "الأدنى":
    حل_اختيار = إصدار.اختر_أدنى(حل_اسم، حل_مواصفة_اختيار، حل_إصدارات)
  وإلا:
    حل_اختيار = إصدار.اختر_إصدار(حل_اسم، حل_مواصفة_اختيار، حل_إصدارات)
  إذا حل_اختيار["نجاح"] == خطأ:
    ارجع حل_اختيار
  لكل حل_مرشح_أخير في حل_مؤهلون:
    حل_تحليل_مرشح = إصدار.حلّل_إصدار(حل_حقل(حل_مرشح_أخير، "إصدار"، ""))
    إذا حل_تحليل_مرشح["نجاح"] == خطأ:
      تابع
    إذا حل_تحليل_مرشح["قانوني"] == حل_اختيار["إصدار"]:
      ارجع {"نجاح": صحيح، "مرشح": حل_مرشح_أخير، "إصدار": حل_اختيار["إصدار"]}
  ارجع {"نجاح": خطأ، "خطأ": "الإصدار " + حل_اختيار["إصدار"] + " غير موجود للحزمة " + حل_اسم}

دالة حل_افحص_دائرة_من(حل_اسم، حل_مسار، حل_جوار):
  حل_إدخال = حل_جد_إدخال(حل_جوار، حل_اسم)
  إذا حل_إدخال == لاشيء:
    ارجع {"نجاح": صحيح}
  لكل حل_ابن في حل_إدخال["أبناء"]:
    إذا حل_ابن في حل_مسار:
      حل_بداية = ٠
      بينما حل_مسار[حل_بداية] != حل_ابن:
        حل_بداية = حل_بداية + ١
      حل_دورة = []
      حل_فهرس_دورة = حل_بداية
      بينما حل_فهرس_دورة < طول(حل_مسار):
        حل_دورة.أضف(حل_مسار[حل_فهرس_دورة])
        حل_فهرس_دورة = حل_فهرس_دورة + ١
      حل_دورة.أضف(حل_ابن)
      ارجع {"نجاح": خطأ، "خطأ": "اعتماد دائري: " + حل_انضم(حل_دورة، " ← ")}
    حل_مسار_جديد = []
    لكل حل_عنصر_مسار في حل_مسار:
      حل_مسار_جديد.أضف(حل_عنصر_مسار)
    حل_مسار_جديد.أضف(حل_ابن)
    حل_فحص = حل_افحص_دائرة_من(حل_ابن، حل_مسار_جديد، حل_جوار)
    إذا حل_فحص["نجاح"] == خطأ:
      ارجع حل_فحص
  ارجع {"نجاح": صحيح}

دالة حلّ(حل_بيان، حل_فهرس، خيارات):
  حل_وضع = حل_خيار(خيارات، "وضع"، "الأحدث")
  حل_تهدئة = حل_خيار(خيارات، "تهدئة_أيام"، ٠)
  حل_الآن = حل_خيار(خيارات، "الآن"، لاشيء)
  إذا حل_الآن == لاشيء:
    حل_الآن = وقت.الآن()
  حل_مصادر = حل_خيار(خيارات، "مصادر"، {})
  حل_تطوير = حل_خيار(خيارات، "تطوير"، خطأ)
  حل_جذر = حل_بيان["اسم"]
  حل_متطلبات = []
  حل_محلول = []
  حل_طابور = []
  لكل حل_اعتماد في حل_بيان["اعتماديات"]:
    حل_طالب_بذرة = حل_حقل(حل_اعتماد، "طالب"، حل_جذر)
    حل_متطلبات = حل_أضف_متطلب(حل_متطلبات، حل_اعتماد["اسم"]، حل_طالب_بذرة، حل_اعتماد["نوع"]، حل_اعتماد["مواصفة"])
    حل_طابور = حل_أضف_طابور(حل_طابور، حل_اعتماد["اسم"])
  إذا حل_تطوير:
    لكل حل_اعتماد_تطوير في حل_بيان["اعتماديات_التطوير"]:
      حل_طالب_تطوير = حل_حقل(حل_اعتماد_تطوير، "طالب"، حل_جذر)
      حل_متطلبات = حل_أضف_متطلب(حل_متطلبات، حل_اعتماد_تطوير["اسم"]، حل_طالب_تطوير، حل_اعتماد_تطوير["نوع"]، حل_اعتماد_تطوير["مواصفة"])
      حل_طابور = حل_أضف_طابور(حل_طابور، حل_اعتماد_تطوير["اسم"])
  لكل حل_تجاوز في حل_بيان["تجاوز"]:
    حل_متطلبات = حل_أضف_متطلب(حل_متطلبات، حل_تجاوز["اسم"]، "تجاوز"، "إصدار"، حل_تجاوز["إصدار"])
    حل_طابور = حل_أضف_طابور(حل_طابور، حل_تجاوز["اسم"])
  حل_جولات = ٠
  بينما طول(حل_طابور) > ٠:
    حل_جولات = حل_جولات + ١
    إذا حل_جولات > ٢٠٠:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر حل الاعتماديات — دورة حل لا تنتهي"}
    حل_اسم = حل_طابور[٠]
    حل_طابور = حل_أزل_طابور(حل_طابور، حل_اسم)
    حل_قائمة = حل_متطلبات_ل(حل_متطلبات، حل_اسم)
    إذا طول(حل_قائمة) == ٠:
      حل_قديم = حل_جد_إدخال(حل_محلول، حل_اسم)
      إذا حل_قديم != لاشيء:
        حل_محلول = حل_احذف_إدخال(حل_محلول، حل_اسم)
        حل_حذف = حل_احذف_متطلبات_طالب(حل_متطلبات، حل_اسم)
        حل_متطلبات = حل_حذف["متطلبات"]
        لكل حل_متأثر في حل_حذف["متأثرة"]:
          حل_طابور = حل_أضف_طابور(حل_طابور، حل_متأثر)
      تابع
    حل_مدمج = حل_ادمج(حل_اسم، حل_قائمة، حل_جذر)
    إذا حل_مدمج["نجاح"] == خطأ:
      ارجع حل_مدمج
    إذا حل_اسم في حل_فهرس == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + حل_اسم + " غير موجودة في الفهرس"}
    حل_مرشح_مفضل = حل_مرشح_مقفل(حل_اسم، حل_مدمج، حل_فهرس[حل_اسم]، خيارات)
    إذا حل_مرشح_مفضل != لاشيء:
      حل_اختيار = {"نجاح": صحيح، "مرشح": حل_مرشح_مفضل، "إصدار": حل_مرشح_مفضل["إصدار"]}
    وإلا:
      حل_اختيار = حل_اختر(حل_اسم، حل_مدمج، حل_فهرس[حل_اسم]، حل_وضع، حل_مصادر، حل_تهدئة، حل_الآن)
    إذا حل_اختيار["نجاح"] == خطأ:
      ارجع حل_اختيار
    حل_مرشح = حل_اختيار["مرشح"]
    حل_إصدار_مختار = حل_اختيار["إصدار"]
    حل_بيان_مرشح = حل_حقل(حل_مرشح، "بيان"، لاشيء)
    إذا حل_بيان_مرشح == لاشيء:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + حل_اسم + " بلا بيان في الفهرس"}
    حل_قديم = حل_جد_إدخال(حل_محلول، حل_اسم)
    إذا حل_قديم != لاشيء:
      إذا حل_قديم["إصدار"] == حل_إصدار_مختار:
        تابع
      حل_حذف = حل_احذف_متطلبات_طالب(حل_متطلبات، حل_اسم)
      حل_متطلبات = حل_حذف["متطلبات"]
      لكل حل_متأثر في حل_حذف["متأثرة"]:
        حل_طابور = حل_أضف_طابور(حل_طابور، حل_متأثر)
    حل_محلول = حل_ضع_إدخال(حل_محلول، {"اسم": حل_اسم، "إصدار": حل_إصدار_مختار، "مصدر": حل_حقل(حل_مرشح، "مصدر"، "")، "بصمة": حل_حقل(حل_مرشح، "بصمة"، "")، "بيان": حل_بيان_مرشح})
    لكل حل_اعتماد_جديد في حل_بيان_مرشح["اعتماديات"]:
      حل_متطلبات = حل_أضف_متطلب(حل_متطلبات، حل_اعتماد_جديد["اسم"]، حل_اسم، حل_اعتماد_جديد["نوع"]، حل_اعتماد_جديد["مواصفة"])
      حل_طابور = حل_أضف_طابور(حل_طابور، حل_اعتماد_جديد["اسم"])
  حل_جوار = []
  حل_أبناء_جذر = []
  لكل حل_اعتماد_جذر في حل_بيان["اعتماديات"]:
    حل_أبناء_جذر.أضف(حل_اعتماد_جذر["اسم"])
  إذا حل_تطوير:
    لكل حل_اعتماد_تطوير_جذر في حل_بيان["اعتماديات_التطوير"]:
      حل_أبناء_جذر.أضف(حل_اعتماد_تطوير_جذر["اسم"])
  حل_جوار.أضف({"اسم": حل_جذر، "أبناء": حل_أبناء_جذر})
  لكل حل_محلولة في حل_محلول:
    حل_أبناء_محلولة = []
    لكل حل_اعتماد_محلول في حل_محلولة["بيان"]["اعتماديات"]:
      حل_أبناء_محلولة.أضف(حل_اعتماد_محلول["اسم"])
    حل_جوار.أضف({"اسم": حل_محلولة["اسم"]، "أبناء": حل_أبناء_محلولة})
  حل_فحص_دائرة = حل_افحص_دائرة_من(حل_جذر، [حل_جذر]، حل_جوار)
  إذا حل_فحص_دائرة["نجاح"] == خطأ:
    ارجع حل_فحص_دائرة
  لكل حل_تجاوز_فحص في حل_بيان["تجاوز"]:
    حل_قائمة_تجاوز = حل_متطلبات_ل(حل_متطلبات، حل_تجاوز_فحص["اسم"])
    حل_له_طالب_حقيقي = خطأ
    لكل حل_متطلب_تجاوز في حل_قائمة_تجاوز:
      إذا حل_متطلب_تجاوز["طالب"] != "تجاوز":
        حل_له_طالب_حقيقي = صحيح
    إذا حل_له_طالب_حقيقي == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "التجاوز " + حل_تجاوز_فحص["اسم"] + " لا يطابق أي اعتماد — تحقق من الاسم"}
  حل_مرتبة = قفل.رتّب_حسب_الاسم(حل_محلول)
  ارجع {"نجاح": صحيح، "حزم": حل_مرتبة، "تجاوزات": حل_بيان["تجاوز"]}

# التحديث الدقيق: يعيد حل الشجرة كاملة من البيان نفسه، مع تفضيل
# إصدارات القفل الحالي لكل حزمة عدا الهدف — فالهدف وحده يُعاد
# اختياره حرا، وبقية الشجرة تبقى مثبّتة ما دامت ترضي القيود الجديدة،
# وحزمة زال اعتمادها الوحيد تُحذف من الشجرة تلقائيا لأن القفل
# لا يفرضها. إصدار_مطلوب لاشيء يعني الأحدث المسموح، وإلا إصدار
# بعينه يدمج مع قيد البيان — فإن خرج عن النطاق رفض بتعارض.
# عند أي فشل لا يكتب شيئا: القفل القديم يبقى كما هو.
دالة حدّث_حزمة(حل_بيان، قفل_حالي، اسم، إصدار_مطلوب، حل_فهرس، خيارات):
  حل_هدف = حل_جد_إدخال(قفل_حالي، اسم)
  إذا حل_هدف == لاشيء:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + اسم + " غير مثبّتة — لا يمكن تحديثها"}
  حل_تحقق = قفل.تحقق_قفل_ضد_بيان(حل_بيان، قفل_حالي)
  إذا حل_تحقق["نجاح"] == خطأ:
    ارجع حل_تحقق
  حل_مثبّتة = []
  لكل حل_مقفلة في قفل_حالي:
    إذا حل_مقفلة["اسم"] == اسم:
      تابع
    حل_مثبّتة.أضف(حل_مقفلة)
  حل_خيارات_تحديث = {"وضع": حل_خيار(خيارات، "وضع"، "الأحدث")، "تهدئة_أيام": حل_خيار(خيارات، "تهدئة_أيام"، ٠)، "الآن": حل_خيار(خيارات، "الآن"، لاشيء)، "مصادر": حل_خيار(خيارات، "مصادر"، {})، "تطوير": حل_خيار(خيارات، "تطوير"، خطأ)، "مثبّتة": حل_مثبّتة، "هدف_تحديث": اسم}
  حل_بيان_مثبت = {"اسم": حل_بيان["اسم"]، "إصدار": حل_بيان["إصدار"]، "وصف": حل_بيان["وصف"]، "دخول": حل_بيان["دخول"]، "نسخة_نيفا": حل_بيان["نسخة_نيفا"]، "اعتماديات": حل_بيان["اعتماديات"]، "اعتماديات_التطوير": حل_بيان["اعتماديات_التطوير"]، "تجاوز": حل_بيان["تجاوز"]}
  إذا إصدار_مطلوب != لاشيء:
    حل_مواصفة_دقيقة = بيان.حلّل_مواصفة(إصدار_مطلوب)
    إذا حل_مواصفة_دقيقة["نجاح"] == خطأ:
      ارجع حل_مواصفة_دقيقة
    إذا حل_مواصفة_دقيقة["نوع"] != "إصدار":
      ارجع {"نجاح": خطأ، "خطأ": "مواصفة إصدار غير صالحة: " + إصدار_مطلوب}
    حل_اعتماديات_مثبتة = []
    لكل حل_اعتماد_أصلي في حل_بيان["اعتماديات"]:
      حل_اعتماديات_مثبتة.أضف(حل_اعتماد_أصلي)
    حل_اعتماديات_مثبتة.أضف({"اسم": اسم، "نوع": "إصدار"، "مواصفة": حل_مواصفة_دقيقة["مواصفة"]، "طالب": "المستخدم"})
    حل_بيان_مثبت = {"اسم": حل_بيان["اسم"]، "إصدار": حل_بيان["إصدار"]، "وصف": حل_بيان["وصف"]، "دخول": حل_بيان["دخول"]، "نسخة_نيفا": حل_بيان["نسخة_نيفا"]، "اعتماديات": حل_اعتماديات_مثبتة، "اعتماديات_التطوير": حل_بيان["اعتماديات_التطوير"]، "تجاوز": حل_بيان["تجاوز"]}
  حل_نتيجة = حلّ(حل_بيان_مثبت، حل_فهرس، حل_خيارات_تحديث)
  إذا حل_نتيجة["نجاح"] == خطأ:
    ارجع حل_نتيجة
  حل_جديد = حل_جد_إدخال(حل_نتيجة["حزم"]، اسم)
  ارجع {"نجاح": صحيح، "حزم": حل_نتيجة["حزم"]، "تجاوزات": حل_نتيجة["تجاوزات"]، "إصدار": حل_جديد["إصدار"]، "سابق": حل_هدف["إصدار"]}

دالة حلّ_إلى_قفل(حل_بيان، حل_فهرس، خيارات، مسار_القفل):
  حل_نتيجة = حلّ(حل_بيان، حل_فهرس، خيارات)
  إذا حل_نتيجة["نجاح"] == خطأ:
    ارجع حل_نتيجة
  حل_نص_قفل = قفل.ولّد_قفل_بتجاوز(حل_نتيجة["حزم"]، حل_نتيجة["تجاوزات"])
  إذا حل_نص_قفل["نجاح"] == خطأ:
    ارجع حل_نص_قفل
  حاول:
    حل_مؤقت = مسار_القفل + ".مؤقت"
    اكتب_ملف(حل_مؤقت، حل_نص_قفل["قفل"])
    انقل(حل_مؤقت، مسار_القفل)
    ارجع {"نجاح": صحيح، "قفل": حل_نص_قفل["قفل"]}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة القفل: " + مسار_القفل}
