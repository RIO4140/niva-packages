# المخزن العام «$نيفا/.نيفا/حزم/» — إنشاء وحجم وسقف وتثبيت محلي (التصميم §10)
# «$نيفا» في نيفا هو مجلد البرنامج، والبيت `~` تحته — فالمخزن في
# التطبيق مجلد ملفات التطبيق الخاص، وعلى سطح المكتب مجلد البرنامج
# الذي يعمل منه المدير. (اجتماع 45 §59: بعد الفصل صار المخزن
# تحت مجلد البرنامج لا تحت البيت.)
# وكل دوال هذه الوحدة ترجع قاموس نتيجة: {"نجاح": صحيح، ...} أو
# {"نجاح": خطأ، "خطأ": "رسالة عربية"}.
صدر مسار_المخزن، تأكد_المخزن، حجم_المخزن، تحقق_سقف_المخزن، تحقق_حزمة، ثبّت_محليا، احسب_حجم_مجلد، ملف_ضمن_السقف
استورد نص باسم نصوص
استورد إصدار
استورد بيان
استورد تشفير

دالة مسار_المخزن():
  ارجع "$نيفا/.نيفا/حزم"

دالة ملف_ضمن_السقف(حجم):
  إذا حجم > ٥٢٤٢٨٨٠:
    ارجع {"نجاح": خطأ، "خطأ": "الملف أكبر من 5 ميبيبايت"}
  ارجع {"نجاح": صحيح}

دالة اجمع_مسار(أسماء):
  نتيجة = ""
  لكل اسم في أسماء:
    إذا نتيجة == "":
      نتيجة = اسم
    وإلا:
      نتيجة = نتيجة + "/" + اسم
  ارجع نتيجة

دالة سرد_الشجرة():
  حاول:
    خام = اعرض_الشجرة()
    مدخلات = []
    مكدس_أسماء = []
    مكدس_عمق = []
    لكل سطر في خام:
      عمق = نصوص.عدد_مسافات_بادئة(سطر)
      اسم_خام = سطر.قص()
      مجلد = نصوص.ينتهي_ب(اسم_خام، "/")
      اسم = اسم_خام.استبدل("/", "")
      بينما طول(مكدس_عمق) > ٠:
        إذا مكدس_عمق[طول(مكدس_عمق) - ١] >= عمق:
          مكدس_أسماء.أزل()
          مكدس_عمق.أزل()
        وإلا:
          اكسر
      مكدس_أسماء.أضف(اسم)
      مكدس_عمق.أضف(عمق)
      مسار_مدخل = اجمع_مسار(مكدس_أسماء)
      نوع = "ملف"
      إذا مجلد:
        نوع = "مجلد"
      مدخلات.أضف({"مسار": مسار_مدخل، "نوع": نوع})
    ارجع {"نجاح": صحيح، "مدخلات": مدخلات}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر سرد شجرة الملفات"}

دالة جرد_بادئة(مسار):
  بادئة = مسار
  # اجتماع 45 §59: مسار `$نيفا/...` يمر كما هو — المحرك
  # يوسّعه إلى مجلد البرنامج؛ و`~/...` تُجرَّد إلى النسبي
  # (يُحل ضد البيت، مجلد الجلسة الحالي).
  إذا نصوص.يبدأ_ب(بادئة، "$نيفا/"):
    ارجع بادئة
  إذا نصوص.يبدأ_ب(بادئة، "~/"):
    بادئة = نصوص.من_الفهرس(بادئة، ٢)
  ارجع بادئة

دالة احسب_حجم_مجلد(مسار):
  بادئة = جرد_بادئة(مسار)
  حاول:
    حجم = حجم_المسار(بادئة)
    ارجع {"نجاح": صحيح، "حجم": حجم}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر حساب حجم المجلد: " + مسار}

دالة حجم_المخزن():
  إذا موجود("$نيفا/.نيفا/حزم") == خطأ:
    ارجع {"نجاح": صحيح، "حجم": ٠}
  ارجع احسب_حجم_مجلد("$نيفا/.نيفا/حزم")

دالة تحقق_سقف_المخزن(إضافي):
  حالي = حجم_المخزن()
  إذا حالي["نجاح"] == خطأ:
    ارجع حالي
  سقف = ١٠٢٤ * ١٠٢٤ * ١٠٢٤
  إذا حالي["حجم"] + إضافي > سقف:
    ارجع {"نجاح": خطأ، "خطأ": "مخزن الحزم ممتلئ (1 غيغابايت) — احذف حزمة أو امسح الذاكرة"}
  ارجع {"نجاح": صحيح، "حجم": حالي["حجم"]}

دالة تأكد_المخزن():
  مجلدات = ["$نيفا/.نيفا"، "$نيفا/.نيفا/حزم"، "$نيفا/.نيفا/حزم/ذاكرة"، "$نيفا/.نيفا/حزم/فهرس"]
  لكل مجلد في مجلدات:
    إذا موجود(مجلد) == خطأ:
      حاول:
        أنشئ_مجلد(مجلد)
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء المخزن: " + مجلد}
  ارجع {"نجاح": صحيح}

دالة تحقق_حزمة(مسار_مجلد):
  مسار = جرد_بادئة(مسار_مجلد)
  إذا موجود(مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "مجلد الحزمة غير موجود: " + مسار_مجلد}
  إذا نوع_المسار(مسار) != "مجلد":
    ارجع {"نجاح": خطأ، "خطأ": "مجلد الحزمة غير موجود: " + مسار_مجلد}
  مسار_البيان = مسار + "/بيان.حزمة"
  إذا موجود(مسار_البيان) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة بلا بيان: " + مسار_مجلد}
  ن_بيان = بيان.اقرأ_بيان(مسار_البيان)
  إذا ن_بيان["نجاح"] == خطأ:
    ارجع ن_بيان
  بيان_الحزمة = ن_بيان["بيان"]
  إذا بيان_الحزمة["نسخة_نيفا"] != لاشيء:
    ن_نسخة = إصدار.تحقق_نسخة_نيفا(بيان_الحزمة["نسخة_نيفا"])
    إذا ن_نسخة["نجاح"] == خطأ:
      ارجع ن_نسخة
  ن_سرد = سرد_الشجرة()
  إذا ن_سرد["نجاح"] == خطأ:
    ارجع ن_سرد
  ملفات = []
  مجموع = ٠
  لكل مدخل في ن_سرد["مدخلات"]:
    إذا نصوص.يبدأ_ب(مدخل["مسار"]، مسار + "/"):
      إذا مدخل["نوع"] == "ملف":
        اسم_الملف = نصوص.اسم_الملف(مدخل["مسار"])
        إذا اسم_الملف != "بيان.حزمة":
          إذا اسم_الملف != "قفل.حزمة":
            إذا نصوص.ينتهي_ب(اسم_الملف، ".نيفا") == خطأ:
              ارجع {"نجاح": خطأ، "خطأ": "ملف غير مسموح في الحزمة " + بيان_الحزمة["اسم"] + ": " + اسم_الملف}
        حجم = حجم_المسار(مدخل["مسار"])
        ن_سقف = ملف_ضمن_السقف(حجم)
        إذا ن_سقف["نجاح"] == خطأ:
          ارجع {"نجاح": خطأ، "خطأ": "ملف الحزمة أكبر من 5 ميبيبايت: " + اسم_الملف}
        مجموع = مجموع + حجم
        ملفات.أضف(مدخل["مسار"])
  ارجع {"نجاح": صحيح، "بيان": بيان_الحزمة، "ملفات": ملفات، "حجم": مجموع}

دالة ثبّت_محليا(مسار_حزمة):
  مسار = جرد_بادئة(مسار_حزمة)
  ن_تحقق = تحقق_حزمة(مسار)
  إذا ن_تحقق["نجاح"] == خطأ:
    ارجع ن_تحقق
  بيان_الحزمة = ن_تحقق["بيان"]
  ن_مخزن = تأكد_المخزن()
  إذا ن_مخزن["نجاح"] == خطأ:
    ارجع ن_مخزن
  هدف = "$نيفا/.نيفا/حزم/" + بيان_الحزمة["اسم"] + "-" + بيان_الحزمة["إصدار"]
  إذا موجود(هدف):
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + بيان_الحزمة["اسم"] + " مثبّتة أصلا — احذفها أولا لإعادة تثبيتها"}
  ن_سقف = تحقق_سقف_المخزن(ن_تحقق["حجم"])
  إذا ن_سقف["نجاح"] == خطأ:
    ارجع ن_سقف
  مؤقت = هدف + ".مؤقت"
  إذا موجود(مؤقت):
    ارجع {"نجاح": خطأ، "خطأ": "يوجد تثبيت مؤقت عالق: " + مؤقت}
  حاول:
    أنشئ_مجلد(مؤقت)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد التثبيت: " + مؤقت}
  ن_سرد = سرد_الشجرة()
  إذا ن_سرد["نجاح"] == خطأ:
    ارجع ن_سرد
  لكل مدخل في ن_سرد["مدخلات"]:
    إذا نصوص.يبدأ_ب(مدخل["مسار"]، مسار + "/"):
      إذا مدخل["نوع"] == "مجلد":
        نسبي = نصوص.من_الفهرس(مدخل["مسار"]، طول(مسار) + ١)
        حاول:
          أنشئ_مجلد(مؤقت + "/" + نسبي)
        ماعدا:
          ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد التثبيت: " + نسبي}
  لكل مسار_ملف في ن_تحقق["ملفات"]:
    نسبي = نصوص.من_الفهرس(مسار_ملف، طول(مسار) + ١)
    حاول:
      انسخ(مسار_ملف، مؤقت + "/" + نسبي)
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر نسخ ملف الحزمة: " + نسبي}
  حاول:
    نص_المصدر = اقرأ_ملف(مسار + "/بيان.حزمة")
    نص_المنسوخ = اقرأ_ملف(مؤقت + "/بيان.حزمة")
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر التحقق من الحزمة " + بيان_الحزمة["اسم"] + " بعد التثبيت"}
  إذا نص_المصدر != نص_المنسوخ:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر التحقق من الحزمة " + بيان_الحزمة["اسم"] + " بعد التثبيت"}
  حاول:
    انقل(مؤقت، هدف)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر تثبيت الحزمة " + بيان_الحزمة["اسم"]}
  ارجع {"نجاح": صحيح، "مسار": "$نيفا/.نيفا/حزم/" + بيان_الحزمة["اسم"] + "-" + بيان_الحزمة["إصدار"]، "حجم": ن_تحقق["حجم"]}
