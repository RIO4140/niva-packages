# ملف القفل «قفل.حزمة» — توليد وتحليل ومطابقة مع البيان (التصميم §4)
# القفل يولَّد آليا وحده ولا يحرره الإنسان بيده؛ وهو مصدر الحقيقة
# للنسخ القابلة للتكرار. وكل دوال هذه الوحدة ترجع قاموس نتيجة
# {"نجاح": صحيح، ...} أو {"نجاح": خطأ، "خطأ": "رسالة عربية"}.
صدر ولّد_قفل، حلّل_قفل، تحقق_قفل_ضد_بيان
استورد نص باسم نصوص
استورد إصدار

دالة صالح_بصمة(بصمة):
  إذا طول(بصمة) != ٦٤:
    ارجع خطأ
  فهرس = ٠
  بينما فهرس < طول(بصمة):
    إذا "0123456789abcdef".يحتوي(بصمة[فهرس]) == خطأ:
      ارجع خطأ
    فهرس = فهرس + ١
  ارجع صحيح

دالة أدخل_في(قائمة، موضع، عنصر):
  نتيجة = []
  فهرس = ٠
  بينما فهرس < طول(قائمة):
    إذا فهرس == موضع:
      نتيجة.أضف(عنصر)
    نتيجة.أضف(قائمة[فهرس])
    فهرس = فهرس + ١
  إذا موضع == طول(قائمة):
    نتيجة.أضف(عنصر)
  ارجع نتيجة

دالة رتّب_حسب_الاسم(حزم):
  مرتبة = []
  لكل حزمة في حزم:
    موضع = طول(مرتبة)
    بينما موضع > ٠:
      إذا حزمة["اسم"] < مرتبة[موضع - ١]["اسم"]:
        موضع = موضع - ١
      وإلا:
        اكسر
    مرتبة = أدخل_في(مرتبة، موضع، حزمة)
  ارجع مرتبة

دالة ولّد_قفل(حزم):
  أسماء = []
  لكل حزمة في حزم:
    إذا حزمة["اسم"] في أسماء:
      ارجع {"نجاح": خطأ، "خطأ": "حزمة مكررة في القفل: " + حزمة["اسم"]}
    أسماء.أضف(حزمة["اسم"])
  مرتبة = رتّب_حسب_الاسم(حزم)
  نص_القفل = "# قفل حزم — يولَّد آليا؛ لا تحرره بيدك\n"
  لكل حزمة في مرتبة:
    ن = إصدار.حلّل_إصدار(حزمة["إصدار"])
    إذا ن["نجاح"] == خطأ:
      ارجع ن
    إذا صالح_بصمة(حزمة["بصمة"]) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "بصمة غير صالحة في القفل للحزمة " + حزمة["اسم"]}
    نص_القفل = نص_القفل + حزمة["اسم"] + " " + ن["قانوني"] + " " + حزمة["مصدر"] + " " + حزمة["بصمة"] + "\n"
  ارجع {"نجاح": صحيح، "قفل": نص_القفل}

دالة حلّل_قفل(نص_القفل):
  سطور = نص_القفل.قسم("\n")
  حزم = []
  رقم = ٠
  لكل سطر_خام في سطور:
    رقم = رقم + ١
    سطر = سطر_خام.قص()
    إذا سطر == "":
      تابع
    إذا سطر[٠] == "#":
      تابع
    كلمات = نصوص.قسم_كلمات(سطر)
    إذا طول(كلمات) != ٤:
      ارجع {"نجاح": خطأ، "خطأ": "سطر غير صالح في القفل (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
    ن = إصدار.حلّل_إصدار(كلمات[١])
    إذا ن["نجاح"] == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح في القفل (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
    إذا صالح_بصمة(كلمات[٣]) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "بصمة غير صالحة في القفل (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
    حزم.أضف({"اسم": كلمات[٠]، "إصدار": ن["قانوني"]، "مصدر": كلمات[٢]، "بصمة": كلمات[٣]})
  ارجع {"نجاح": صحيح، "حزم": حزم}

دالة تحقق_قفل_ضد_بيان(بيان، حزم_القفل):
  لكل اعتماد في بيان["اعتماديات"]:
    وجد = خطأ
    لكل حزمة في حزم_القفل:
      إذا حزمة["اسم"] == اعتماد["اسم"]:
        وجد = صحيح
        إذا اعتماد["نوع"] == "إصدار":
          إذا حزمة["إصدار"] != اعتماد["مواصفة"]:
            ارجع {"نجاح": خطأ، "خطأ": "البيان والقفل مختلفان — شغّل حزم تحديث"}
    إذا وجد == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "البيان والقفل مختلفان — شغّل حزم تحديث"}
  ارجع {"نجاح": صحيح}
