# ملف القفل «قفل.حزمة» — توليد وتحليل ومطابقة مع البيان (التصميم §4)
# القفل يولَّد آليا وحده ولا يحرره الإنسان بيده؛ وهو مصدر الحقيقة
# للنسخ القابلة للتكرار. وكل دوال هذه الوحدة ترجع قاموس نتيجة
# {"نجاح": صحيح، ...} أو {"نجاح": خطأ، "خطأ": "رسالة عربية"}.
صدر ولّد_قفل، ولّد_قفل_بتجاوز، حلّل_قفل، تحقق_قفل_ضد_بيان، صالح_بصمة، رتّب_حسب_الاسم
استورد نص باسم نصوص
استورد إصدار

دالة صالح_بصمة(بصمة):
  إذا طول(بصمة) != ٦٤:
    ارجع خطأ
  فهرس = ٠
  بينما فهرس < طول(بصمة):
    إذا "0123456789abcdef".يحتوي(بصمة[فهرس]) == خطأ:
      ارجع خطأ
    فهرس = فهرس + ١
  ارجع صحيح

دالة أدخل_في(قائمة، موضع، عنصر):
  نتيجة = []
  فهرس = ٠
  بينما فهرس < طول(قائمة):
    إذا فهرس == موضع:
      نتيجة.أضف(عنصر)
    نتيجة.أضف(قائمة[فهرس])
    فهرس = فهرس + ١
  إذا موضع == طول(قائمة):
    نتيجة.أضف(عنصر)
  ارجع نتيجة

دالة رتّب_حسب_الاسم(حزم):
  مرتبة = []
  لكل حزمة في حزم:
    موضع = طول(مرتبة)
    بينما موضع > ٠:
      إذا حزمة["اسم"] < مرتبة[موضع - ١]["اسم"]:
        موضع = موضع - ١
      وإلا:
        اكسر
    مرتبة = أدخل_في(مرتبة، موضع، حزمة)
  ارجع مرتبة

دالة ولّد_قفل(حزم):
  أسماء = []
  لكل حزمة في حزم:
    إذا حزمة["اسم"] في أسماء:
      ارجع {"نجاح": خطأ، "خطأ": "حزمة مكررة في القفل: " + حزمة["اسم"]}
    أسماء.أضف(حزمة["اسم"])
  مرتبة = رتّب_حسب_الاسم(حزم)
  نص_القفل = "# قفل حزم — يولَّد آليا؛ لا تحرره بيدك\n"
  لكل حزمة في مرتبة:
    ن = إصدار.حلّل_إصدار(حزمة["إصدار"])
    إذا ن["نجاح"] == خطأ:
      ارجع ن
    إذا صالح_بصمة(حزمة["بصمة"]) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "بصمة غير صالحة في القفل للحزمة " + حزمة["اسم"]}
    نص_القفل = نص_القفل + حزمة["اسم"] + " " + ن["قانوني"] + " " + حزمة["مصدر"] + " " + حزمة["بصمة"] + "\n"
  ارجع {"نجاح": صحيح، "قفل": نص_القفل}

دالة ولّد_قفل_بتجاوز(حزم، تجاوزات):
  قفل_نتيجة = ولّد_قفل(حزم)
  إذا قفل_نتيجة["نجاح"] == خطأ:
    ارجع قفل_نتيجة
  قفل_تجاوزات_مرتبة = رتّب_حسب_الاسم(تجاوزات)
  قفل_نص = قفل_نتيجة["قفل"]
  قفل_أسماء_تجاوز = []
  لكل قفل_تجاوز في قفل_تجاوزات_مرتبة:
    إذا قفل_تجاوز["اسم"] في قفل_أسماء_تجاوز:
      ارجع {"نجاح": خطأ، "خطأ": "تجاوز مكرر في القفل: " + قفل_تجاوز["اسم"]}
    قفل_أسماء_تجاوز.أضف(قفل_تجاوز["اسم"])
    قفل_إصدار_تجاوز = إصدار.حلّل_إصدار(قفل_تجاوز["إصدار"])
    إذا قفل_إصدار_تجاوز["نجاح"] == خطأ:
      ارجع قفل_إصدار_تجاوز
    قفل_نص = قفل_نص + "# تجاوز: " + قفل_تجاوز["اسم"] + " " + قفل_إصدار_تجاوز["قانوني"] + "\n"
  ارجع {"نجاح": صحيح، "قفل": قفل_نص}

دالة حلّل_قفل(نص_القفل):
  سطور = نص_القفل.قسم("\n")
  حزم = []
  قفل_تجاوزات = []
  رقم = ٠
  لكل سطر_خام في سطور:
    رقم = رقم + ١
    سطر = سطر_خام.قص()
    إذا سطر == "":
      تابع
    إذا نصوص.يبدأ_ب(سطر، "# تجاوز: "):
      قفل_باقي = نصوص.من_الفهرس(سطر، طول("# تجاوز: "))
      قفل_كلمات = نصوص.قسم_كلمات(قفل_باقي)
      إذا طول(قفل_كلمات) != ٢:
        ارجع {"نجاح": خطأ، "خطأ": "سطر غير صالح في القفل (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
      قفل_ن_تجاوز = إصدار.حلّل_إصدار(قفل_كلمات[١])
      إذا قفل_ن_تجاوز["نجاح"] == خطأ:
        ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح في القفل (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
      لكل قفل_تجاوز_سابق في قفل_تجاوزات:
        إذا قفل_تجاوز_سابق["اسم"] == قفل_كلمات[٠]:
          ارجع {"نجاح": خطأ، "خطأ": "تجاوز مكرر في القفل: " + قفل_كلمات[٠] + " (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
      قفل_تجاوزات.أضف({"اسم": قفل_كلمات[٠]، "إصدار": قفل_ن_تجاوز["قانوني"]})
      تابع
    إذا سطر[٠] == "#":
      تابع
    كلمات = نصوص.قسم_كلمات(سطر)
    إذا طول(كلمات) != ٤:
      ارجع {"نجاح": خطأ، "خطأ": "سطر غير صالح في القفل (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
    ن = إصدار.حلّل_إصدار(كلمات[١])
    إذا ن["نجاح"] == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح في القفل (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
    إذا صالح_بصمة(كلمات[٣]) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "بصمة غير صالحة في القفل (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}
    حزم.أضف({"اسم": كلمات[٠]، "إصدار": ن["قانوني"]، "مصدر": كلمات[٢]، "بصمة": كلمات[٣]})
  ارجع {"نجاح": صحيح، "حزم": حزم، "تجاوزات": قفل_تجاوزات}

دالة تحقق_قفل_ضد_بيان(بيان، حزم_القفل):
  لكل اعتماد في بيان["اعتماديات"]:
    وجد = خطأ
    لكل حزمة في حزم_القفل:
      إذا حزمة["اسم"] == اعتماد["اسم"]:
        وجد = صحيح
        إذا اعتماد["نوع"] == "إصدار":
          إذا حزمة["إصدار"] != اعتماد["مواصفة"]:
            ارجع {"نجاح": خطأ، "خطأ": "البيان والقفل مختلفان — شغّل حزم تحديث"}
        وإلا إذا اعتماد["نوع"] != "مصدر":
          نتيجة_مطابقة = إصدار.يطابق(اعتماد، حزمة["إصدار"])
          إذا نتيجة_مطابقة["نجاح"] == خطأ:
            ارجع نتيجة_مطابقة
          إذا نتيجة_مطابقة["يطابق"] == خطأ:
            ارجع {"نجاح": خطأ، "خطأ": "البيان والقفل مختلفان — شغّل حزم تحديث"}
    إذا وجد == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "البيان والقفل مختلفان — شغّل حزم تحديث"}
  لكل قفل_تجاوز_بيان في قفل_تجاوزات_بيان(بيان):
    قفل_وجد_تجاوز = خطأ
    لكل قفل_حزمة في حزم_القفل:
      إذا قفل_حزمة["اسم"] == قفل_تجاوز_بيان["اسم"]:
        قفل_وجد_تجاوز = صحيح
        إذا قفل_حزمة["إصدار"] != قفل_تجاوز_بيان["إصدار"]:
          ارجع {"نجاح": خطأ، "خطأ": "البيان والقفل مختلفان — شغّل حزم تحديث"}
    إذا قفل_وجد_تجاوز == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "البيان والقفل مختلفان — شغّل حزم تحديث"}
  ارجع {"نجاح": صحيح}

# قراءة دفاعية لقسم التجاوز: بيان محلل حديثا فيه المفتاح دائما،
# وبيان حرفي قديم قد لا يكون فيه — فيعد بلا تجاوزات.
دالة قفل_تجاوزات_بيان(بيان):
  إذا "تجاوز" في بيان:
    ارجع بيان["تجاوز"]
  ارجع []
