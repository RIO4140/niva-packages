# موزّع أوامر `حزم <أمر>` — الخطوة 4 (التصميم §2 و§16)
# الواجهة برنامج نيفا عادي: `نفّذ` تأخذ قائمة كلمات
# (كما تأتي من سطر الأوامر) والفهرس والخيارات، وتعيد
# قاموس نتيجة: {"نجاح": صحيح، "نص": "..."} للعرض، أو
# {"نجاح": خطأ، "خطأ": "رسالة عربية"} للرفض. والعمل كله
# في المجلد الحالي (أساس "" — أي المجلد الحالي).
# والترجمة إلى أمر سطر حقيقي (`نيفا حزم`) وتمرير الوسائط
# قرار محرك منفصل — لا يبنيه هذا الملف ولا يعتمد عليه.
# محليات كل دالة ببادئة فريدة عبر سلسلة الاستدعاء كلها.
استورد نص باسم نصوص
استورد إصدار
استورد مشروع
استورد مخزن
استورد سجل
استورد نشر

دالة استعمال():
  ارجع "حزم — مدير حزم نيفا\n\nالأوامر:\n  حزم جديد <اسم> [--قالب أداة|مكتبة|فارغ] [--وصف نص]\n  حزم أضف <اسم> [مواصفة] [--تطوير]\n  حزم احذف <اسم> [--تطوير]\n  حزم أزل <اسم>\n  حزم تثبيت [اسم] [مواصفة]\n  حزم تحديث [اسم] [إصدار]\n  حدث حزم\n  حزم رقّ [--فهرس مجلد]\n  حزم أعد-التثبيت <اسم> [--فهرس مجلد]\n  حزم ابن\n  حزم شغل [وسائط...]\n  حزم اختبر\n  حزم تحقق\n  حزم لماذا <اسم>\n  حزم اعرض [اسم]\n  حزم افحص\n  حزم افحص-الفهرس [--فهرس مجلد]\n  حزم ابحث <كلمة> [--فهرس مجلد]\n  حزم قديم [اسم] [--فهرس مجلد]\n  حزم كلها [--فهرس مجلد]\n  حزم مثبتة\n  حزم ملفات <اسم>\n  حزم ما-الجديد [--فهرس مجلد]\n  حزم مستودعات\n  حزم نظف\n  حزم نظف-القديم\n  حزم اسحب <اسم> <إصدار> [سبب...] --فهرس مجلد\n  حزم انشر --مستودع مالك/مستودع --وسم وسم --ناشر دخول\n  حزم انشر --سحب <اسم> <إصدار> [سبب...] --ناشر دخول"

# نص المساعدة مع حجمي المثبّت وذاكرة الفهرس (البند 17
# والبند 92): ما هو مثبّت في المخزن العام ومجلد `حزم/`
# في المشروع، وما في ذاكرة الفهرس المحفوظ.
دالة نص_المساعدة_مع_الحجم():
  نص_حجم_مثبت = مخزن.حجم_المخزن()
  نص_مثبت = ٠
  إذا نص_حجم_مثبت["نجاح"]:
    نص_مثبت = نص_حجم_مثبت["حجم"]
  إذا موجود("حزم"):
    نص_حجم_مشروع = مخزن.احسب_حجم_مجلد("حزم")
    إذا نص_حجم_مشروع["نجاح"]:
      نص_مثبت = نص_مثبت + نص_حجم_مشروع["حجم"]
  نص_ذاكرة = مخزن.احسب_حجم_مجلد("$نيفا/.نيفا/حزم/فهرس")
  نص_ذاكرة_حجم = ٠
  إذا نص_ذاكرة["نجاح"]:
    نص_ذاكرة_حجم = نص_ذاكرة["حجم"]
  ارجع استعمال() + "\n\nحجم المثبّت: " + إصدار.رقم_لاتيني(نص_مثبت) + " بايت\nحجم ذاكرة الفهرس: " + إصدار.رقم_لاتيني(نص_ذاكرة_حجم) + " بايت"

# قيمة الراية `--مفتاح قيمة` من قائمة الوسائط، أو لاشيء
# إن غابت الراية أو غابت قيمتها بعدها.
دالة قيمة_راية(بخ_وسائط، بخ_مفتاح):
  بخ_فهرس = ٠
  بينما بخ_فهرس < طول(بخ_وسائط):
    إذا بخ_وسائط[بخ_فهرس] == "--" + بخ_مفتاح:
      إذا بخ_فهرس + ١ < طول(بخ_وسائط):
        ارجع بخ_وسائط[بخ_فهرس + ١]
      ارجع لاشيء
    بخ_فهرس = بخ_فهرس + ١
  ارجع لاشيء

# هل الراية `--مفتاح` حاضرة في قائمة الوسائط؟
دالة راية_حاضرة(عل_وسائط، عل_مفتاح):
  عل_فهرس = ٠
  بينما عل_فهرس < طول(عل_وسائط):
    إذا عل_وسائط[عل_فهرس] == "--" + عل_مفتاح:
      ارجع صحيح
    عل_فهرس = عل_فهرس + ١
  ارجع خطأ

# الموضعيات: الكلمات بعد الأمر الأول، بلا رايات ولا قيمها.
# والرايات بقيمة (`--قالب` و`--وصف` و`--فهرس` و`--مستودع`
# و`--وسم` و`--ناشر`) تتخطى كلمتين، وغيرها من الرايات
# (`--تطوير` و`--سحب`) كلمة واحدة.
دالة موضعيات(مو_وسائط):
  مو_قائمة = []
  مو_فهرس = ١
  بينما مو_فهرس < طول(مو_وسائط):
    مو_كلمة = مو_وسائط[مو_فهرس]
    إذا نصوص.يبدأ_ب(مو_كلمة، "--"):
      إذا مو_كلمة == "--قالب":
        مو_فهرس = مو_فهرس + ٢
        تابع
      إذا مو_كلمة == "--وصف":
        مو_فهرس = مو_فهرس + ٢
        تابع
      إذا مو_كلمة == "--فهرس":
        مو_فهرس = مو_فهرس + ٢
        تابع
      إذا مو_كلمة == "--مستودع":
        مو_فهرس = مو_فهرس + ٢
        تابع
      إذا مو_كلمة == "--وسم":
        مو_فهرس = مو_فهرس + ٢
        تابع
      إذا مو_كلمة == "--ناشر":
        مو_فهرس = مو_فهرس + ٢
        تابع
      مو_فهرس = مو_فهرس + ١
      تابع
    مو_قائمة.أضف(مو_كلمة)
    مو_فهرس = مو_فهرس + ١
  ارجع مو_قائمة

دالة نفّذ(نف_وسائط، نف_فهرس، نف_خيارات):
  إذا طول(نف_وسائط) == ٠:
    ارجع {"نجاح": صحيح، "نص": نص_المساعدة_مع_الحجم()}
  نف_أمر = نف_وسائط[٠]
  إذا نف_أمر == "--مساعدة":
    ارجع {"نجاح": صحيح، "نص": نص_المساعدة_مع_الحجم()}
  إذا نف_أمر == "مساعدة":
    ارجع {"نجاح": صحيح، "نص": نص_المساعدة_مع_الحجم()}
  إذا نف_أمر == "جديد":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "حزم جديد يحتاج اسم مشروع"}
    نف_قالب = "أداة"
    إذا طول(نف_موضعيات) > ١:
      نف_قالب = نف_موضعيات[١]
    نف_قالب_راية = قيمة_راية(نف_وسائط، "قالب")
    إذا نف_قالب_راية == لاشيء:
      إذا راية_حاضرة(نف_وسائط، "قالب"):
        ارجع {"نجاح": خطأ، "خطأ": "حزم جديد يحتاج قيمة بعد --قالب"}
    وإلا:
      نف_قالب = نف_قالب_راية
    نف_وصف = قيمة_راية(نف_وسائط، "وصف")
    إذا نف_وصف == لاشيء:
      نف_وصف = ""
    نف_جديد = مشروع.جديد(نف_موضعيات[٠]، نف_قالب، نف_وصف، "")
    إذا نف_جديد["نجاح"] == خطأ:
      ارجع نف_جديد
    ارجع {"نجاح": صحيح، "نص": "أنشئ المشروع " + نف_موضعيات[٠] + " (" + نف_قالب + ")"}
  إذا نف_أمر == "أضف":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "حزم أضف يحتاج اسم حزمة"}
    نف_مواصفة = لاشيء
    إذا طول(نف_موضعيات) > ١:
      نف_مواصفة = نف_موضعيات[١]
    نف_خيارات_أضف = {"تطوير": راية_حاضرة(نف_وسائط، "تطوير")}
    نف_أضف = مشروع.أضف_اعتماد("", نف_موضعيات[٠]، نف_مواصفة، نف_فهرس، نف_خيارات_أضف)
    إذا نف_أضف["نجاح"] == خطأ:
      ارجع نف_أضف
    ارجع {"نجاح": صحيح، "نص": "أضيف الاعتماد " + نف_موضعيات[٠] + " (" + نف_أضف["إصدار"] + ")"}
  إذا نف_أمر == "احذف":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "حزم احذف يحتاج اسم حزمة"}
    # الاعتماد المباشر في مشروع يُزال من البيان (المسار
    # القائم)؛ وما عداه — مثبّتة خارج البيان — يُلغى
    # تثبيتها بحكم الاجتماع 44 (رفض عند وجود طالب).
    نف_في_مشروع = مشروع.اعتماد_في_المشروع("", نف_موضعيات[٠])
    إذا نف_في_مشروع["موجود"] == خطأ:
      نف_أزل = مشروع.أزل_مثبتة("", نف_موضعيات[٠])
      إذا نف_أزل["نجاح"] == خطأ:
        ارجع نف_أزل
      ارجع {"نجاح": صحيح، "نص": نف_أزل["نص"]}
    نف_خيارات_حذف = {"تطوير": راية_حاضرة(نف_وسائط، "تطوير")}
    نف_حذف = مشروع.احذف_اعتماد("", نف_موضعيات[٠]، نف_فهرس، نف_خيارات_حذف)
    إذا نف_حذف["نجاح"] == خطأ:
      ارجع نف_حذف
    نف_نص_حذف = "حُذف الاعتماد " + نف_موضعيات[٠]
    إذا نف_حذف["بقيت"] != لاشيء:
      نف_نص_حذف = نف_نص_حذف + " — لكن الحزمة بقيت مثبّتة لأن " + نف_حذف["طالب"] + " يطلبها"
    ارجع {"نجاح": صحيح، "نص": نف_نص_حذف}
  إذا نف_أمر == "تثبيت":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) == ٠:
      نف_ثبت = مشروع.ثبّت_القفل("", نف_فهرس، نف_خيارات)
      إذا نف_ثبت["نجاح"] == خطأ:
        ارجع نف_ثبت
      ارجع {"نجاح": صحيح، "نص": "ثُبّت القفل حرفيا"}
    نف_مواصفة = لاشيء
    إذا طول(نف_موضعيات) > ١:
      نف_مواصفة = نف_موضعيات[١]
    نف_ثبت_اسم = مشروع.ثبّت_بالاسم(نف_موضعيات[٠]، نف_مواصفة، نف_فهرس، نف_خيارات)
    إذا نف_ثبت_اسم["نجاح"] == خطأ:
      ارجع نف_ثبت_اسم
    ارجع {"نجاح": صحيح، "نص": "ثُبّتت الحزمة " + نف_موضعيات[٠]}
  إذا نف_أمر == "تحديث":
    نف_موضعيات = موضعيات(نف_وسائط)
    نف_اسم = لاشيء
    نف_إصدار = لاشيء
    إذا طول(نف_موضعيات) > ٠:
      نف_اسم = نف_موضعيات[٠]
    إذا طول(نف_موضعيات) > ١:
      نف_إصدار = نف_موضعيات[١]
    # تجديد الفهرس (التصميم §7: `حزم تحديث` يجدّده) — جهد
    # مبذول بصمت: دون إنترنت أو بوابة شبكة يفشل ويُتجاهل
    # وتُستخدم النسخة المحفوظة كما هي.
    نف_تجديد = سجل.نزّل_الفهرس(لاشيء)
    نف_حدث = مشروع.حدّث("", نف_اسم، نف_إصدار، نف_فهرس، نف_خيارات)
    إذا نف_حدث["نجاح"] == خطأ:
      ارجع نف_حدث
    ارجع {"نجاح": صحيح، "نص": "حُدّثت الشجرة"}
  إذا نف_أمر == "ابن":
    نف_ابن = مشروع.ابن("")
    إذا نف_ابن["نجاح"] == خطأ:
      ارجع نف_ابن
    ارجع {"نجاح": صحيح، "نص": "انتهى البناء بنجاح"}
  إذا نف_أمر == "شغل":
    نف_وسائط_شغل = []
    نف_فهرس_شغل = ١
    بينما نف_فهرس_شغل < طول(نف_وسائط):
      نف_وسائط_شغل.أضف(نف_وسائط[نف_فهرس_شغل])
      نف_فهرس_شغل = نف_فهرس_شغل + ١
    نف_شغل = مشروع.شغّل("", نف_وسائط_شغل)
    إذا نف_شغل["نجاح"] == خطأ:
      ارجع نف_شغل
    ارجع {"نجاح": صحيح، "نص": "انتهى التشغيل بنجاح"}
  إذا نف_أمر == "اختبر":
    نف_اختبر = مشروع.اختبر("", نف_خيارات)
    إذا نف_اختبر["نجاح"] == خطأ:
      ارجع نف_اختبر
    ارجع {"نجاح": صحيح، "نص": "نجحت كل الاختبارات في الوضعين"}
  إذا نف_أمر == "تحقق":
    نف_تحقق = مشروع.تحقق("")
    إذا نف_تحقق["نجاح"] == خطأ:
      ارجع نف_تحقق
    ارجع {"نجاح": صحيح، "نص": "الشجرة المثبتة تطابق القفل"}
  إذا نف_أمر == "لماذا":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "حزم لماذا يحتاج اسم حزمة"}
    نف_لماذا = مشروع.لماذا("", نف_موضعيات[٠])
    إذا نف_لماذا["نجاح"] == خطأ:
      ارجع نف_لماذا
    ارجع {"نجاح": صحيح، "نص": نف_لماذا["نص"]}
  إذا نف_أمر == "اعرض":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) > ٠:
      نف_خيارات_سجل = {"مجلد_فهرس": قيمة_راية(نف_وسائط، "فهرس")}
      نف_اعرض_حزمة = سجل.اعرض_حزمة(نف_موضعيات[٠]، نف_خيارات_سجل)
      إذا نف_اعرض_حزمة["نجاح"] == خطأ:
        ارجع نف_اعرض_حزمة
      ارجع {"نجاح": صحيح، "نص": نف_اعرض_حزمة["نص"]}
    نف_اعرض = مشروع.اعرض("", نف_خيارات)
    إذا نف_اعرض["نجاح"] == خطأ:
      ارجع نف_اعرض
    ارجع {"نجاح": صحيح، "نص": نف_اعرض["شجرة"]}
  إذا نف_أمر == "افحص":
    نف_افحص = مشروع.افحص_عزل("")
    إذا نف_افحص["نجاح"] == خطأ:
      ارجع نف_افحص
    ارجع {"نجاح": صحيح، "نص": "لا استيراد غير معلن"}
  إذا نف_أمر == "ابحث":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "حزم ابحث يحتاج كلمة بحث"}
    نف_خيارات_سجل = {"مجلد_فهرس": قيمة_راية(نف_وسائط، "فهرس")}
    نف_ابحث = سجل.ابحث(نف_موضعيات[٠]، نف_خيارات_سجل)
    إذا نف_ابحث["نجاح"] == خطأ:
      ارجع نف_ابحث
    ارجع {"نجاح": صحيح، "نص": نف_ابحث["نص"]}
  إذا نف_أمر == "قديم":
    نف_موضعيات = موضعيات(نف_وسائط)
    نف_اسم_قديم = لاشيء
    إذا طول(نف_موضعيات) > ٠:
      نف_اسم_قديم = نف_موضعيات[٠]
    نف_خيارات_سجل = {"مجلد_فهرس": قيمة_راية(نف_وسائط، "فهرس")}
    نف_قديم = سجل.قديم(نف_اسم_قديم، نف_خيارات_سجل)
    إذا نف_قديم["نجاح"] == خطأ:
      ارجع نف_قديم
    ارجع {"نجاح": صحيح، "نص": نف_قديم["نص"]}
  إذا نف_أمر == "اسحب":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) < ٢:
      ارجع {"نجاح": خطأ، "خطأ": "حزم اسحب يحتاج اسم حزمة وإصدارا"}
    نف_سبب_سحب = ""
    نف_م_سحب = ٢
    بينما نف_م_سحب < طول(نف_موضعيات):
      إذا نف_سبب_سحب == "":
        نف_سبب_سحب = نف_موضعيات[نف_م_سحب]
      وإلا:
        نف_سبب_سحب = نف_سبب_سحب + " " + نف_موضعيات[نف_م_سحب]
      نف_م_سحب = نف_م_سحب + ١
    نف_خيارات_سجل = {"مجلد_فهرس": قيمة_راية(نف_وسائط، "فهرس")}
    نف_اسحب = سجل.اسحب(نف_موضعيات[٠]، نف_موضعيات[١]، نف_سبب_سحب، نف_خيارات_سجل)
    إذا نف_اسحب["نجاح"] == خطأ:
      ارجع نف_اسحب
    ارجع {"نجاح": صحيح، "نص": نف_اسحب["نص"]}
  إذا نف_أمر == "أزل":
    نف_موضعيات = موضعيات(نف_وسائط)
    إذا طول(نف_موضعيات) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "حزم أزل يحتاج اسم حزمة"}
