دالة انضم_مسار(ان_أساس، ان_نسبي):
  إذا ان_أساس == "":
    ارجع ان_نسبي
  إذا ان_أساس == ".":
    ارجع ان_نسبي
  ارجع ان_أساس + "/" + ان_نسبي

دالة قيمة_خيار(خي_خيارات، خي_مفتاح، خي_افتراضي):
  إذا خي_خيارات == لاشيء:
    ارجع خي_افتراضي
  إذا خي_مفتاح في خي_خيارات:
    ارجع خي_خيارات[خي_مفتاح]
  ارجع خي_افتراضي

دالة حقل_أو(حق_قاموس، حق_مفتاح، حق_افتراضي):
  إذا حق_مفتاح في حق_قاموس:
    ارجع حق_قاموس[حق_مفتاح]
  ارجع حق_افتراضي

# سرد شجرة مجلد: مدخلات {مسار نسبي، نوع} — والمسار نسبي إلى
# المجلد نفسه. العمق 3 والسقف 200 سطر حدّا المحرك (اعرض_الشجرة)،
# فحزمة بملفات أعمق لا تُجمع كاملة هنا (كما في مخزن الخطوة 1).
دالة سرد_مجلد(سر_مسار):
  حاول:
    سر_خام = اعرض_الشجرة(سر_مسار)
    سر_مدخلات = []
    سر_مكدس_أسماء = []
    سر_مكدس_عمق = []
    لكل سر_سطر في سر_خام:
      سر_عمق = نصوص.عدد_مسافات_بادئة(سر_سطر)
      سر_اسم_خام = سر_سطر.قص()
      سر_مجلد = نصوص.ينتهي_ب(سر_اسم_خام، "/")
      سر_اسم = سر_اسم_خام.استبدل("/", "")
      بينما طول(سر_مكدس_عمق) > ٠:
        إذا سر_مكدس_عمق[طول(سر_مكدس_عمق) - ١] >= سر_عمق:
          سر_مكدس_أسماء.أزل()
          سر_مكدس_عمق.أزل()
        وإلا:
          اكسر
      سر_مكدس_أسماء.أضف(سر_اسم)
      سر_مكدس_عمق.أضف(سر_عمق)
      سر_مسار_مدخل = سر_مكدس_أسماء[٠]
      سر_فهرس_مسار = ١
      بينما سر_فهرس_مسار < طول(سر_مكدس_أسماء):
        سر_مسار_مدخل = سر_مسار_مدخل + "/" + سر_مكدس_أسماء[سر_فهرس_مسار]
        سر_فهرس_مسار = سر_فهرس_مسار + ١
      سر_نوع = "ملف"
      إذا سر_مجلد:
        سر_نوع = "مجلد"
      سر_مدخلات.أضف({"مسار": سر_مسار_مدخل، "نوع": سر_نوع})
    ارجع {"نجاح": صحيح، "مدخلات": سر_مدخلات}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر سرد شجرة الملفات: " + سر_مسار}

# حذف شجرة كاملة (ملفات ثم مجلدات من الأعمق، ثم الجذر).
# الاسم ليس `احذف_مجلد` عمدا — فذاك أمر مسطّح غير متكرر،
# ولو سُمّي به لحجب نفسه واستدعى نفسه إلى الأبد.
# ويرفض المسارات الخطرة ("", ".", "~", "/", أو فيها "..").
دالة احذف_شجرة(حش_مسار):
  إذا حش_مسار == "":
    ارجع {"نجاح": خطأ، "خطأ": "مسار غير صالح للحذف: " + حش_مسار}
  إذا حش_مسار == ".":
    ارجع {"نجاح": خطأ، "خطأ": "مسار غير صالح للحذف: " + حش_مسار}
  إذا حش_مسار == "~":
    ارجع {"نجاح": خطأ، "خطأ": "مسار غير صالح للحذف: " + حش_مسار}
  إذا حش_مسار == "/":
    ارجع {"نجاح": خطأ، "خطأ": "مسار غير صالح للحذف: " + حش_مسار}
  إذا حش_مسار.يحتوي(".."):
    ارجع {"نجاح": خطأ، "خطأ": "مسار غير صالح للحذف: " + حش_مسار}
  إذا موجود(حش_مسار) == خطأ:
    ارجع {"نجاح": صحيح، "حذف": ٠}
  حش_سرد = سرد_مجلد(حش_مسار)
  إذا حش_سرد["نجاح"] == خطأ:
    ارجع حش_سرد
  حش_مدخلات = حش_سرد["مدخلات"]
  حش_عدد = ٠
  حش_فهرس = طول(حش_مدخلات) - ١
  بينما حش_فهرس >= ٠:
    حش_مدخل = حش_مدخلات[حش_فهرس]
    إذا حش_مدخل["نوع"] == "ملف":
      حاول:
        احذف(حش_مسار + "/" + حش_مدخل["مسار"])
        حش_عدد = حش_عدد + ١
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر حذف الملف: " + حش_مدخل["مسار"]}
    حش_فهرس = حش_فهرس - ١
  حش_فهرس = طول(حش_مدخلات) - ١
  بينما حش_فهرس >= ٠:
    حش_مدخل = حش_مدخلات[حش_فهرس]
    إذا حش_مدخل["نوع"] == "مجلد":
      حاول:
        احذف_مجلد(حش_مسار + "/" + حش_مدخل["مسار"])
        حش_عدد = حش_عدد + ١
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر حذف المجلد: " + حش_مدخل["مسار"]}
    حش_فهرس = حش_فهرس - ١
  حاول:
    احذف_مجلد(حش_مسار)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر حذف المجلد: " + حش_مسار}
  ارجع {"نجاح": صحيح، "حذف": حش_عدد}

# نسخ مجلد ذريا: إلى مؤقت ثم `انقل` إلى الهدف — فلا هدف
# نصف منسوخ أبدا. ويرفض هدفا موجودا (بلا كتابة فوق صامتة).
دالة انسخ_مجلد(نس_مصدر، نس_هدف):
  إذا موجود(نس_مصدر) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "المجلد المصدر غير موجود: " + نس_مصدر}
  إذا موجود(نس_هدف):
    ارجع {"نجاح": خطأ، "خطأ": "المجلد الهدف موجود: " + نس_هدف}
  نس_مؤقت = نس_هدف + ".مؤقت"
  إذا موجود(نس_مؤقت):
    ارجع {"نجاح": خطأ، "خطأ": "يوجد نسخ مؤقت عالق: " + نس_مؤقت}
  نس_سرد = سرد_مجلد(نس_مصدر)
  إذا نس_سرد["نجاح"] == خطأ:
    ارجع نس_سرد
  حاول:
    أنشئ_مجلد(نس_مؤقت)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد النسخ: " + نس_مؤقت}
  لكل نس_مدخل في نس_سرد["مدخلات"]:
    إذا نس_مدخل["نوع"] == "مجلد":
      حاول:
        أنشئ_مجلد(نس_مؤقت + "/" + نس_مدخل["مسار"])
      ماعدا:
        احذف_شجرة(نس_مؤقت)
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد النسخ: " + نس_مدخل["مسار"]}
  نس_عدد = ٠
  لكل نس_مدخل_ملف في نس_سرد["مدخلات"]:
    إذا نس_مدخل_ملف["نوع"] == "ملف":
      حاول:
        انسخ(نس_مصدر + "/" + نس_مدخل_ملف["مسار"]، نس_مؤقت + "/" + نس_مدخل_ملف["مسار"])
        نس_عدد = نس_عدد + ١
      ماعدا:
        احذف_شجرة(نس_مؤقت)
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر نسخ ملف الحزمة: " + نس_مدخل_ملف["مسار"]}
  حاول:
    انقل(نس_مؤقت، نس_هدف)
  ماعدا:
    احذف_شجرة(نس_مؤقت)
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر تثبيت الحزمة: " + نس_هدف}
  ارجع {"نجاح": صحيح، "ملفات": نس_عدد}

# استبدال مجلد بمجلد آخر: القديم إلى `.قديم`، ثم النسخ، ثم
# حذف القديم؛ وعند فشل النسخ يعود القديم مكانه.
دالة استبدل_مجلد(سب_مصدر، سب_هدف):
  إذا موجود(سب_هدف) == خطأ:
    ارجع انسخ_مجلد(سب_مصدر، سب_هدف)
  سب_قديم = سب_هدف + ".قديم"
  إذا موجود(سب_قديم):
    ارجع {"نجاح": خطأ، "خطأ": "يوجد استبدال عالق: " + سب_قديم}
  حاول:
    انقل(سب_هدف، سب_قديم)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر استبدال المجلد: " + سب_هدف}
  سب_نسخ = انسخ_مجلد(سب_مصدر، سب_هدف)
  إذا سب_نسخ["نجاح"] == خطأ:
    حاول:
      انقل(سب_قديم، سب_هدف)
    ماعدا:
      ارجع سب_نسخ
    ارجع سب_نسخ
  سب_حذف = احذف_شجرة(سب_قديم)
  إذا سب_حذف["نجاح"] == خطأ:
    ارجع سب_حذف
  ارجع سب_نسخ

# بصمة الحزمة = بصمة SHA-256 لنص `بيان.حزمة` كما هو — يعيد
# `تحقق` حسابها من النسخة المثبتة نفسها (خطة الخطوة 4).
دالة بصمة_حزمة(بص_مسار):
  بص_مسار_بيان = انضم_مسار(بص_مسار، "بيان.حزمة")
  إذا موجود(بص_مسار_بيان) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة بلا بيان: " + بص_مسار}
  حاول:
    بص_نص = اقرأ_ملف(بص_مسار_بيان)
    ارجع {"نجاح": صحيح، "بصمة": تشفير.جزّئ(بص_نص)}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة البيان: " + بص_مسار_بيان}

# اسم وإصدار وبصمة نسخة مثبّتة في مجلد (للمقارنة مع القفل).
دالة بصمة_مثبتة(بم_مسار):
  بم_بيان = بيان.اقرأ_بيان(انضم_مسار(بم_مسار، "بيان.حزمة"))
  إذا بم_بيان["نجاح"] == خطأ:
    ارجع بم_بيان
  بم_بصمة = بصمة_حزمة(بم_مسار)
  إذا بم_بصمة["نجاح"] == خطأ:
    ارجع بم_بصمة
  ارجع {"نجاح": صحيح، "بصمة": بم_بصمة["بصمة"]، "إصدار": بم_بيان["بيان"]["إصدار"]، "اسم": بم_بيان["بيان"]["اسم"]}

# بيان حزمة مثبّتة في `حزم/<اسم>` داخل مشروع.
دالة بيان_مثبت(بث_أساس، بث_اسم):
  بث_مسار = انضم_مسار(انضم_مسار(بث_أساس، "حزم")، بث_اسم)
  ارجع بيان.اقرأ_بيان(انضم_مسار(بث_مسار، "بيان.حزمة"))

# قراءة مشروع: بيانه المحلل ومساره — ويرفض خارج المشروع
# بالرسالة القانونية «ليس مشروع حزم — شغّل حزم جديد أولا».
دالة اقرأ_مشروع(قم_أساس):
  قم_مسار_بيان = انضم_مسار(قم_أساس، "بيان.حزمة")
  إذا موجود(قم_مسار_بيان) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "ليس مشروع حزم — شغّل حزم جديد أولا"}
  قم_نتيجة = بيان.اقرأ_بيان(قم_مسار_بيان)
  إذا قم_نتيجة["نجاح"] == خطأ:
    ارجع قم_نتيجة
  ارجع {"نجاح": صحيح، "بيان": قم_نتيجة["بيان"]، "مسار": قم_أساس، "مسار_البيان": قم_مسار_بيان}

# قراءة قفل مشروع إن وُجد (يوجد=خطأ إن غاب — لا خطأ).
دالة اقرأ_قفل_مشروع(قل_أساس):
  قل_مسار_قفل = انضم_مسار(قل_أساس، "قفل.حزمة")
  إذا موجود(قل_مسار_قفل) == خطأ:
    ارجع {"نجاح": صحيح، "يوجد": خطأ، "حزم": []، "تجاوزات": []}
  حاول:
    قل_نص = اقرأ_ملف(قل_مسار_قفل)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة القفل: " + قل_مسار_قفل}
  قل_نتيجة = قفل.حلّل_قفل(قل_نص)
  إذا قل_نتيجة["نجاح"] == خطأ:
    ارجع قل_نتيجة
  ارجع {"نجاح": صحيح، "يوجد": صحيح، "حزم": قل_نتيجة["حزم"]، "تجاوزات": قل_نتيجة["تجاوزات"]}

# مجلد مرشح للتثبيت: حقل `مجلد` الصريح أولا، ثم المخزن
# العام `~/.نيفا/حزم/<اسم>-<إصدار>`؛ وإلا رفض دون اتصال.
دالة مجلد_مرشح(مر_مرشح، مر_اسم):
  إذا "مجلد" في مر_مرشح:
    مر_مجلد = مر_مرشح["مجلد"]
    إذا موجود(مر_مجلد):
      إذا تفاصيل_المسار(مر_مجلد)["نوع"] == "مجلد":
        ارجع {"نجاح": صحيح، "مجلد": مر_مجلد}
  مر_مخزن = "$نيفا/.نيفا/حزم/" + مر_اسم + "-" + مر_مرشح["إصدار"]
  إذا موجود(مر_مخزن):
    ارجع {"نجاح": صحيح، "مجلد": مر_مخزن}
  ارجع {"نجاح": خطأ، "خطأ": "غير متصل — والحزمة " + مر_اسم + " " + مر_مرشح["إصدار"] + " غير محفوظة محليا"}

# مرشح بعينه من فهرس حرفي (بالاسم والإصدار القانوني).
دالة مرشح_من_فهرس(جم_فهرس، جم_اسم، جم_إصدار):
  إذا جم_اسم في جم_فهرس == خطأ:
    ارجع لاشيء
  لكل جم_مرشح في جم_فهرس[جم_اسم]:
    إذا جم_مرشح["إصدار"] == جم_إصدار:
      ارجع جم_مرشح
  ارجع لاشيء

# كتابة قفل ذرية: ملف مؤقت ثم `انقل` (كـ`حلّ_إلى_قفل`).
دالة اكتب_قفل(كق_مسار، كق_حزم، كق_تجاوزات):
  كق_نص = قفل.ولّد_قفل_بتجاوز(كق_حزم، كق_تجاوزات)
  إذا كق_نص["نجاح"] == خطأ:
    ارجع كق_نص
  حاول:
    كق_مؤقت = كق_مسار + ".مؤقت"
    اكتب_ملف(كق_مؤقت، كق_نص["قفل"])
    انقل(كق_مؤقت، كق_مسار)
    ارجع {"نجاح": صحيح، "قفل": كق_نص["قفل"]}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة القفل: " + كق_مسار}

# تعديل نص البيان سطرا: إضافة اعتماد إلى قسم أو حذفه منه، مع
# حفظ التعليقات والترتيب وكل سطر آخر حرفيا. والقسم أحد
# `اعتماديات` أو `اعتماديات_التطوير`. والنص الجديد يُعاد
# تحليله قبل الرجوع به — فلا نص مكسور يخرج من هنا أبدا.
# حذف اعتماد غائب خطأ يسمّيه؛ وإضافة اعتماد موجود تبقي
# سطره القديم (والداعي يرفض الموجود قبلها برسالة التحديث).
دالة عدّل_بيان_نصا(عب_نص، عب_اسم، عب_مواصفة، عب_قسم، عب_حذف):
  عب_عنوان = عب_قسم + ":"
  عب_سطور = عب_نص.قسم("\n")
  عب_جديدة = []
  عب_في_القسم = خطأ
  عب_رأى_القسم = خطأ
  عب_تم = خطأ
  عب_فهرس = ٠
  بينما عب_فهرس < طول(عب_سطور):
    عب_سطر = عب_سطور[عب_فهرس]
    عب_مقصوص = عب_سطر.قص()
    إذا عب_مقصوص == عب_عنوان:
      عب_رأى_القسم = صحيح
      عب_في_القسم = صحيح
      عب_جديدة.أضف(عب_سطر)
      عب_فهرس = عب_فهرس + ١
      تابع
    إذا عب_في_القسم:
      عب_هو_سطر_قسم = خطأ
      إذا طول(عب_سطر) > ٠:
        إذا عب_سطر[٠] == " ":
          عب_هو_سطر_قسم = صحيح
      إذا عب_هو_سطر_قسم == خطأ:
        عب_في_القسم = خطأ
        إذا عب_حذف == خطأ:
          إذا عب_تم == خطأ:
            عب_جديدة.أضف("  " + عب_اسم + " " + عب_مواصفة)
            عب_تم = صحيح
        عب_جديدة.أضف(عب_سطر)
        عب_فهرس = عب_فهرس + ١
        تابع
      عب_كلمات = نصوص.قسم_كلمات(عب_مقصوص)
      إذا طول(عب_كلمات) > ٠:
        إذا عب_كلمات[٠] == عب_اسم:
          إذا عب_حذف:
            عب_تم = صحيح
            عب_فهرس = عب_فهرس + ١
            تابع
          عب_تم = صحيح
          عب_جديدة.أضف(عب_سطر)
          عب_فهرس = عب_فهرس + ١
          تابع
      عب_جديدة.أضف(عب_سطر)
      عب_فهرس = عب_فهرس + ١
      تابع
    عب_جديدة.أضف(عب_سطر)
    عب_فهرس = عب_فهرس + ١
  إذا عب_حذف == خطأ:
    إذا عب_تم == خطأ:
      إذا عب_رأى_القسم:
        عب_جديدة.أضف("  " + عب_اسم + " " + عب_مواصفة)
        عب_تم = صحيح
      وإلا:
        عب_جديدة.أضف(عب_عنوان)
        عب_جديدة.أضف("  " + عب_اسم + " " + عب_مواصفة)
        عب_تم = صحيح
  إذا عب_تم == خطأ:
    إذا عب_حذف:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + عب_اسم + " ليست اعتمادا في المشروع"}
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر تعديل البيان"}
  عب_نص_جديد = ""
  عب_أول = صحيح
  لكل عب_سطر_جديد في عب_جديدة:
    إذا عب_أول == خطأ:
      عب_نص_جديد = عب_نص_جديد + "\n"
    عب_نص_جديد = عب_نص_جديد + عب_سطر_جديد
    عب_أول = خطأ
  عب_تحقق = بيان.حلّل_بيان(عب_نص_جديد)
  إذا عب_تحقق["نجاح"] == خطأ:
    ارجع عب_تحقق
  ارجع {"نجاح": صحيح، "نص": عب_نص_جديد، "بيان": عب_تحقق["بيان"]}

# نسخة بيان محلل بقوائم جديدة (فلا يُمس الأصل عند إضافة
# اعتماد أو حذفه قبل الحل).
دالة نسخة_من_بيان(نب_بيان):
  نب_اعتماديات = []
  لكل نب_اعتماد في نب_بيان["اعتماديات"]:
    نب_اعتماديات.أضف(نب_اعتماد)
  نب_تطوير = []
  لكل نب_اعتماد_تطوير في نب_بيان["اعتماديات_التطوير"]:
    نب_تطوير.أضف(نب_اعتماد_تطوير)
  نب_تجاوز = []
  لكل نب_تجاوز_واحد في نب_بيان["تجاوز"]:
    نب_تجاوز.أضف(نب_تجاوز_واحد)
  ارجع {"اسم": نب_بيان["اسم"]، "إصدار": نب_بيان["إصدار"]، "وصف": نب_بيان["وصف"]، "دخول": نب_بيان["دخول"]، "نسخة_نيفا": نب_بيان["نسخة_نيفا"]، "اعتماديات": نب_اعتماديات، "اعتماديات_التطوير": نب_تطوير، "تجاوز": نب_تجاوز}

# مزامنة مجلد `حزم/` مع قائمة محلولة: حذف الزائد، وتثبيت
# الناقص أو المختلف إصدارا أو بصمة، وترك المطابق كما هو.
# والتركيب من مجلدات المرشحين (أو المخزن العام بديلا).
دالة مزامنة_حزم(مز_أساس، مز_حزم_محلولة، مز_فهرس):
  مز_مجلد_حزم = انضم_مسار(مز_أساس، "حزم")
  إذا موجود(مز_مجلد_حزم) == خطأ:
    حاول:
      أنشئ_مجلد(مز_مجلد_حزم)
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء مجلد حزم: " + مز_مجلد_حزم}
  مز_مطلوبة = []
  لكل مز_حزمة في مز_حزم_محلولة:
    مز_مطلوبة.أضف(مز_حزمة["اسم"])
  مز_محذوفة = []
  مز_سرد = سرد_مجلد(مز_مجلد_حزم)
  إذا مز_سرد["نجاح"] == خطأ:
    ارجع مز_سرد
  لكل مز_مدخل في مز_سرد["مدخلات"]:
    إذا مز_مدخل["نوع"] == "مجلد":
      إذا مز_مدخل["مسار"].يحتوي("/") == خطأ:
        إذا مز_مدخل["مسار"] في مز_مطلوبة == خطأ:
          مز_حذف = احذف_شجرة(مز_مجلد_حزم + "/" + مز_مدخل["مسار"])
          إذا مز_حذف["نجاح"] == خطأ:
            ارجع مز_حذف
          مز_محذوفة.أضف(مز_مدخل["مسار"])
  مز_مثبتة = []
  لكل مز_حزمة_ث في مز_حزم_محلولة:
    مز_هدف = مز_مجلد_حزم + "/" + مز_حزمة_ث["اسم"]
    مز_يحتاج = صحيح
    إذا موجود(مز_هدف):
      مز_بصمة_حالية = بصمة_مثبتة(مز_هدف)
      إذا مز_بصمة_حالية["نجاح"]:
        إذا مز_بصمة_حالية["بصمة"] == مز_حزمة_ث["بصمة"]:
          إذا مز_بصمة_حالية["إصدار"] == مز_حزمة_ث["إصدار"]:
            مز_يحتاج = خطأ
    إذا مز_يحتاج:
      # الثقة (الفكرة 6): بلا بصمة مسجلة لا تثبيت — فالحزمة
      # التي لا بصمة لها في القفل/الفهرس تُرفض لا تُثبَّت
      # بلا تحقق. (والقاعدة 5: لا مخرج صامت أبدا عند عدم
      # تطابق بصمة — بلا علامة تجاوز وبلا وضع تحذير وبلا
      # تثبيت جزئي؛ وأي طلب لعلامة تجاوز يُرفض بالقاعدة.)
      إذا قفل.صالح_بصمة(مز_حزمة_ث["بصمة"]) == خطأ:
        ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + مز_حزمة_ث["اسم"] + " بلا بصمة مسجلة — لا يمكن تثبيتها"}
      مز_مرشح = مرشح_من_فهرس(مز_فهرس، مز_حزمة_ث["اسم"]، مز_حزمة_ث["إصدار"])
      إذا مز_مرشح == لاشيء:
        ارجع {"نجاح": خطأ، "خطأ": "غير متصل — والحزمة " + مز_حزمة_ث["اسم"] + " " + مز_حزمة_ث["إصدار"] + " غير محفوظة محليا"}
      مز_مجلد = مجلد_مرشح(مز_مرشح، مز_حزمة_ث["اسم"])
      إذا مز_مجلد["نجاح"] == خطأ:
        ارجع مز_مجلد
      # بصمة المصدر قبل النسخ: فالهدف القديم يبقى سليما
      # عند الرفض، ولا يُستبدل بمصدر معدَّل أبدا.
      مز_بصمة_مصدر = بصمة_مثبتة(مز_مجلد["مجلد"])
      إذا مز_بصمة_مصدر["نجاح"] == خطأ:
        ارجع {"نجاح": خطأ، "خطأ": "بصمة الحزمة " + مز_حزمة_ث["اسم"] + " لا تطابق البصمة المسجلة"}
      إذا مز_بصمة_مصدر["بصمة"] != مز_حزمة_ث["بصمة"]:
        ارجع {"نجاح": خطأ، "خطأ": "بصمة الحزمة " + مز_حزمة_ث["اسم"] + " لا تطابق البصمة المسجلة"}
      مز_نسخ = استبدل_مجلد(مز_مجلد["مجلد"]، مز_هدف)
      إذا مز_نسخ["نجاح"] == خطأ:
        ارجع مز_نسخ
      # بصمة المنسوخ بعد النسخ: فلا نسخة فاسدة تبقى، ولا
      # تثبيت جزئي — وعند الفشل يُحذف المنسوخ كاملا.
      مز_بصمة_منسوخ = بصمة_مثبتة(مز_هدف)
      إذا مز_بصمة_منسوخ["نجاح"] == خطأ:
        احذف_شجرة(مز_هدف)
        ارجع {"نجاح": خطأ، "خطأ": "بصمة الحزمة " + مز_حزمة_ث["اسم"] + " لا تطابق البصمة المسجلة"}
      إذا مز_بصمة_منسوخ["بصمة"] != مز_حزمة_ث["بصمة"]:
        احذف_شجرة(مز_هدف)
        ارجع {"نجاح": خطأ، "خطأ": "بصمة الحزمة " + مز_حزمة_ث["اسم"] + " لا تطابق البصمة المسجلة"}
      مز_مثبتة.أضف(مز_حزمة_ث["اسم"])
  ارجع {"نجاح": صحيح، "ثبّت": مز_مثبتة، "حذف": مز_محذوفة}

# أسماء الوحدات المستوردة في ملف `.نيفا` (سطور `استورد`
# و`من ... استورد` بعد القص؛ والتعليقات والفراغات تُتجاهل).
# والفحص نصي ثابت: سطر داخل نص طويل قد يظهر استيرادا
# وهميا — حدّ موثق، لا خلل صامت.
دالة استيرادات_ملف(سي_مسار):
  حاول:
    سي_نص = اقرأ_ملف(سي_مسار)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة الملف: " + سي_مسار}
  سي_أسماء = []
  سي_سطور = سي_نص.قسم("\n")
  لكل سي_سطر_خام في سي_سطور:
    سي_سطر = سي_سطر_خام.قص()
    إذا سي_سطر == "":
      تابع
    إذا سي_سطر[٠] == "#":
      تابع
    سي_كلمات = نصوص.قسم_كلمات(سي_سطر)
    إذا طول(سي_كلمات) == ٠:
      تابع
    إذا سي_كلمات[٠] == "استورد":
      إذا طول(سي_كلمات) >= ٢:
        سي_أسماء.أضف(سي_كلمات[١])
      تابع
    إذا سي_كلمات[٠] == "من":
      إذا طول(سي_كلمات) >= ٢:
        سي_أسماء.أضف(سي_كلمات[١])
      تابع
  ارجع {"نجاح": صحيح، "أسماء": سي_أسماء}

# كل ملفات `.نيفا` تحت مجلد (مسارات نسبية إليه).
دالة ملفات_نيفا_في(مف_مجلد):
  مف_سرد = سرد_مجلد(مف_مجلد)
  إذا مف_سرد["نجاح"] == خطأ:
    ارجع مف_سرد
  مف_ملفات = []
  لكل مف_مدخل في مف_سرد["مدخلات"]:
    إذا مف_مدخل["نوع"] == "ملف":
      إذا نصوص.ينتهي_ب(مف_مدخل["مسار"]، ".نيفا"):
        مف_ملفات.أضف(مف_مدخل["مسار"])
  ارجع {"نجاح": صحيح، "ملفات": مف_ملفات}

# `حزم جديد <اسم> [قالب] [وصف]` — ينشئ مجلد مشروع بالهيكل
# (§8): بيان + `حزم/` + `اختبارات/` + نقطة دخول حسب القالب.
# والقوالب: أداة (افتراضي — `مصدر/رئيسي.نيفا`)، مكتبة (الدخول
# ملف الجذر `<اسم>.نيفا` نفسه، كما يتطلب اتفاق الاستيراد §8)،
# فارغ (بلا ملف دخول؛ والدخول الافتراضي في البيان بلا ملف
# فيرفض `شغل` بصراحة). ولا `قفل.حزمة` عند الإنشاء — يولَّد
# عند أول تثبيت. وعند أي فشل بعد إنشاء المجلد يُحذف كاملا.
دالة جديد(جد_اسم، جد_قالب، جد_وصف، جد_أساس):
  إذا جد_قالب != "أداة":
    إذا جد_قالب != "مكتبة":
      إذا جد_قالب != "فارغ":
        ارجع {"نجاح": خطأ، "خطأ": "قالب غير معروف: " + جد_قالب + " — القوالب: أداة، مكتبة، فارغ"}
  إذا جد_اسم.يحتوي("-"):
    ارجع {"نجاح": خطأ، "خطأ": "اسم المشروع " + جد_اسم + " فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"}
  إذا بيان.صالح_اسم_حزمة(جد_اسم) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "اسم مشروع غير صالح: " + جد_اسم}
  إذا جد_اسم في بيان.أسماء_الوحدات_الأصلية():
    ارجع {"نجاح": خطأ، "خطأ": جد_اسم + " وحدة أصلية — لا يمكن تثبيت حزمة بهذا الاسم"}
  جد_مسار = انضم_مسار(جد_أساس، جد_اسم)
  إذا موجود(جد_مسار):
    ارجع {"نجاح": خطأ، "خطأ": "المجلد " + جد_اسم + " موجود — اختر اسما آخر"}
  جد_دخول = "مصدر/رئيسي.نيفا"
  إذا جد_قالب == "مكتبة":
    جد_دخول = جد_اسم + ".نيفا"
  جد_بيان = {"اسم": جد_اسم، "إصدار": "0.1.0"، "وصف": جد_وصف، "دخول": جد_دخول، "نسخة_نيفا": لاشيء، "اعتماديات": []، "اعتماديات_التطوير": []، "تجاوز": []}
  جد_نتيجة_بيان = بيان.ولّد_بيان(جد_بيان)
  إذا جد_نتيجة_بيان["نجاح"] == خطأ:
    ارجع جد_نتيجة_بيان
  جد_نص_بيان = جد_نتيجة_بيان["نص"]
  حاول:
    أنشئ_مجلد(جد_مسار)
    أنشئ_مجلد(انضم_مسار(جد_مسار، "حزم"))
    أنشئ_مجلد(انضم_مسار(جد_مسار، "اختبارات"))
    اكتب_ملف(انضم_مسار(جد_مسار، "بيان.حزمة")، جد_نص_بيان)
  ماعدا:
    احذف_شجرة(جد_مسار)
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء المشروع: " + جد_اسم}
  إذا جد_قالب == "أداة":
    حاول:
      أنشئ_مجلد(انضم_مسار(جد_مسار، "مصدر"))
      اكتب_ملف(انضم_مسار(جد_مسار، "مصدر/رئيسي.نيفا")، "# نقطة دخول الأداة " + جد_اسم + "\nاطبع \"مرحبا من " + جد_اسم + "\"\n")
    ماعدا:
      احذف_شجرة(جد_مسار)
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء المشروع: " + جد_اسم}
  إذا جد_قالب == "مكتبة":
    حاول:
      اكتب_ملف(انضم_مسار(جد_مسار، جد_اسم + ".نيفا")، "# مكتبة " + جد_اسم + " — نقطة الدخول للمكتبة\nصدر مرحبا\nدالة مرحبا():\n  ارجع \"مرحبا من " + جد_اسم + "\"\n")
    ماعدا:
      احذف_شجرة(جد_مسار)
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء المشروع: " + جد_اسم}
  حاول:
    اكتب_ملف(انضم_مسار(جد_مسار، "اختبارات/اختبار-أول.نيفا")، "# أول اختبار في المشروع — ملف مستقل بذاته\nإذا ١ + ١ == ٢:\n  اطبع \"ناجح\"\nوإلا:\n  اطبع \"فاشل: الجمع\"\n")
  ماعدا:
    احذف_شجرة(جد_مسار)
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر إنشاء المشروع: " + جد_اسم}
  ارجع {"نجاح": صحيح، "اسم": جد_اسم، "قالب": جد_قالب، "مسار": جد_مسار}

# `حزم أضف <اسم> [مواصفة]` — يضيف اعتمادا إلى البيان ثم
# يحلّ ويثبّت في `حزم/` ويعيد كتابة القفل؛ والثلاث معا أو
# لا شيء (§6 الذرية): الملفات أولا، ثم القفل، ثم البيان.
# والمواصفة الغائبة تعني `الأحدث`؛ وخيار `تطوير` يضيف إلى
# قسم التطوير. والحلّ في مشروع يشمل اعتماديات التطوير.
# وعند فشل كتابة البيان بعد الملفات والقفل: يُستعاد القفل
# القديم وتُحذف المجلدات المثبّتة حديثا.
دالة أضف_اعتماد(أض_أساس، أض_اسم، أض_مواصفة، أض_فهرس، أض_خيارات):
  أض_مشروع = اقرأ_مشروع(أض_أساس)
  إذا أض_مشروع["نجاح"] == خطأ:
    ارجع أض_مشروع
  أض_بيان = أض_مشروع["بيان"]
  أض_تطوير = قيمة_خيار(أض_خيارات، "تطوير"، خطأ)
  أض_قسم = "اعتماديات"
  إذا أض_تطوير:
    أض_قسم = "اعتماديات_التطوير"
  لكل أض_موجود في أض_بيان["اعتماديات"]:
    إذا أض_موجود["اسم"] == أض_اسم:
      ارجع {"نجاح": خطأ، "خطأ": "الاعتماد " + أض_اسم + " موجود في البيان — استخدم حزم تحديث " + أض_اسم}
  لكل أض_موجود_تطوير في أض_بيان["اعتماديات_التطوير"]:
    إذا أض_موجود_تطوير["اسم"] == أض_اسم:
      ارجع {"نجاح": خطأ، "خطأ": "الاعتماد " + أض_اسم + " موجود في البيان — استخدم حزم تحديث " + أض_اسم}
  إذا أض_اسم == أض_بيان["اسم"]:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة تعتمد على نفسها"}
  إذا أض_اسم في بيان.أسماء_الوحدات_الأصلية():
    ارجع {"نجاح": خطأ، "خطأ": أض_اسم + " وحدة أصلية — لا يمكن تثبيت حزمة بهذا الاسم"}
  أض_مواصفة_فعلية = أض_مواصفة
  إذا أض_مواصفة_فعلية == لاشيء:
    أض_مواصفة_فعلية = "الأحدث"
  أض_محللة = بيان.حلّل_مواصفة(أض_مواصفة_فعلية)
  إذا أض_محللة["نجاح"] == خطأ:
    ارجع أض_محللة
  أض_جديد = نسخة_من_بيان(أض_بيان)
  أض_اعتماد_جديد = {"اسم": أض_اسم، "نوع": أض_محللة["نوع"]، "مواصفة": أض_محللة["مواصفة"]}
  إذا أض_تطوير:
    أض_قائمة_تطوير = أض_جديد["اعتماديات_التطوير"]
    أض_قائمة_تطوير.أضف(أض_اعتماد_جديد)
    أض_جديد["اعتماديات_التطوير"] = أض_قائمة_تطوير
  وإلا:
    أض_قائمة = أض_جديد["اعتماديات"]
    أض_قائمة.أضف(أض_اعتماد_جديد)
    أض_جديد["اعتماديات"] = أض_قائمة
  أض_خيارات_حل = {"وضع": قيمة_خيار(أض_خيارات، "وضع"، "الأحدث")، "تهدئة_أيام": قيمة_خيار(أض_خيارات، "تهدئة_أيام"، ٠)، "الآن": قيمة_خيار(أض_خيارات، "الآن"، لاشيء)، "مصادر": قيمة_خيار(أض_خيارات، "مصادر"، {})، "تطوير": صحيح، "مثبّتة": []، "هدف_تحديث": لاشيء}
  أض_حل = حلال.حلّ(أض_جديد، أض_فهرس، أض_خيارات_حل)
  إذا أض_حل["نجاح"] == خطأ:
    ارجع أض_حل
  أض_قفل_قديم = اقرأ_قفل_مشروع(أض_أساس)
  أض_نص_قفل_قديم = لاشيء
  إذا أض_قفل_قديم["يوجد"]:
    حاول:
      أض_نص_قفل_قديم = اقرأ_ملف(انضم_مسار(أض_أساس، "قفل.حزمة"))
    ماعدا:
      أض_نص_قفل_قديم = لاشيء
  أض_مزامنة = مزامنة_حزم(أض_أساس، أض_حل["حزم"]، أض_فهرس)
  إذا أض_مزامنة["نجاح"] == خطأ:
    ارجع أض_مزامنة
  أض_مسار_قفل = انضم_مسار(أض_أساس، "قفل.حزمة")
  أض_كتابة_قفل = اكتب_قفل(أض_مسار_قفل، أض_حل["حزم"]، أض_حل["تجاوزات"])
  إذا أض_كتابة_قفل["نجاح"] == خطأ:
    ارجع أض_كتابة_قفل
  حاول:
    أض_نص_بيان_قديم = اقرأ_ملف(أض_مشروع["مسار_البيان"])
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة البيان: " + أض_مشروع["مسار_البيان"]}
  أض_تعديل = عدّل_بيان_نصا(أض_نص_بيان_قديم، أض_اسم، أض_محللة["مواصفة"]، أض_قسم، خطأ)
  إذا أض_تعديل["نجاح"] == خطأ:
    إذا أض_نص_قفل_قديم != لاشيء:
      حاول:
        اكتب_ملف(أض_مسار_قفل + ".مؤقت"، أض_نص_قفل_قديم)
        انقل(أض_مسار_قفل + ".مؤقت"، أض_مسار_قفل)
      ماعدا:
        ارجع أض_تعديل
    وإلا:
      حاول:
        احذف(أض_مسار_قفل)
      ماعدا:
        ارجع أض_تعديل
    لكل أض_مثبت في أض_مزامنة["ثبّت"]:
      احذف_شجرة(انضم_مسار(انضم_مسار(أض_أساس، "حزم")، أض_مثبت))
    ارجع أض_تعديل
  حاول:
    أض_مؤقت_بيان = أض_مشروع["مسار_البيان"] + ".مؤقت"
    اكتب_ملف(أض_مؤقت_بيان، أض_تعديل["نص"])
    انقل(أض_مؤقت_بيان، أض_مشروع["مسار_البيان"])
  ماعدا:
    إذا أض_نص_قفل_قديم != لاشيء:
      حاول:
        اكتب_ملف(أض_مسار_قفل + ".مؤقت"، أض_نص_قفل_قديم)
        انقل(أض_مسار_قفل + ".مؤقت"، أض_مسار_قفل)
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة البيان: " + أض_مشروع["مسار_البيان"]}
    وإلا:
      حاول:
        احذف(أض_مسار_قفل)
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة البيان: " + أض_مشروع["مسار_البيان"]}
    لكل أض_مثبت_ث في أض_مزامنة["ثبّت"]:
      احذف_شجرة(انضم_مسار(انضم_مسار(أض_أساس، "حزم")، أض_مثبت_ث))
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة البيان: " + أض_مشروع["مسار_البيان"]}
  أض_إصدار = لاشيء
  لكل أض_محلولة في أض_حل["حزم"]:
    إذا أض_محلولة["اسم"] == أض_اسم:
      أض_إصدار = أض_محلولة["إصدار"]
  أض_حزم_موجزة = []
  لكل أض_محلولة_ث في أض_حل["حزم"]:
    أض_حزم_موجزة.أضف({"اسم": أض_محلولة_ث["اسم"]، "إصدار": أض_محلولة_ث["إصدار"]})
  ارجع {"نجاح": صحيح، "اسم": أض_اسم، "إصدار": أض_إصدار، "حزم": أض_حزم_موجزة}

# `حزم احذف <اسم>` — يحذف السطر من البيان، ويعيد الحل،
# ويحذف من `حزم/` ما لم يعد مطلوبا، ويعيد كتابة القفل.
# واعتماد مباشر ما زال مطلوبا متعديا يبقى مثبّتا ويُبلَّغ
# بذلك (لا يُحذف من تحت طالب آخر). والتراجع عند فشل كتابة
# البيان يعيد نصّي البيان والقفل؛ والمجلدات المحذوفة لا
# تعود إلا بـ`حزم تثبيت` — حدّ موثق.
دالة احذف_اعتماد(حذ_أساس، حذ_اسم، حذ_فهرس، حذ_خيارات):
  حذ_مشروع = اقرأ_مشروع(حذ_أساس)
  إذا حذ_مشروع["نجاح"] == خطأ:
    ارجع حذ_مشروع
  حذ_بيان = حذ_مشروع["بيان"]
  حذ_في_تشغيل = خطأ
  لكل حذ_موجود في حذ_بيان["اعتماديات"]:
    إذا حذ_موجود["اسم"] == حذ_اسم:
      حذ_في_تشغيل = صحيح
  حذ_في_تطوير = خطأ
  لكل حذ_موجود_تطوير في حذ_بيان["اعتماديات_التطوير"]:
    إذا حذ_موجود_تطوير["اسم"] == حذ_اسم:
      حذ_في_تطوير = صحيح
  إذا حذ_في_تشغيل == خطأ:
    إذا حذ_في_تطوير == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + حذ_اسم + " ليست اعتمادا في المشروع"}
  حذ_قسم = "اعتماديات"
  إذا حذ_في_تشغيل == خطأ:
    حذ_قسم = "اعتماديات_التطوير"
  حذ_جديد = نسخة_من_بيان(حذ_بيان)
  إذا حذ_في_تشغيل:
    حذ_باقية = []
    لكل حذ_اعتماد في حذ_جديد["اعتماديات"]:
      إذا حذ_اعتماد["اسم"] != حذ_اسم:
        حذ_باقية.أضف(حذ_اعتماد)
    حذ_جديد["اعتماديات"] = حذ_باقية
  إذا حذ_في_تطوير:
    حذ_باقية_تطوير = []
    لكل حذ_اعتماد_تطوير في حذ_جديد["اعتماديات_التطوير"]:
      إذا حذ_اعتماد_تطوير["اسم"] != حذ_اسم:
        حذ_باقية_تطوير.أضف(حذ_اعتماد_تطوير)
    حذ_جديد["اعتماديات_التطوير"] = حذ_باقية_تطوير
  حذ_خيارات_حل = {"وضع": قيمة_خيار(حذ_خيارات، "وضع"، "الأحدث")، "تهدئة_أيام": قيمة_خيار(حذ_خيارات، "تهدئة_أيام"، ٠)، "الآن": قيمة_خيار(حذ_خيارات، "الآن"، لاشيء)، "مصادر": قيمة_خيار(حذ_خيارات، "مصادر"، {})، "تطوير": صحيح، "مثبّتة": []، "هدف_تحديث": لاشيء}
  حذ_حل = حلال.حلّ(حذ_جديد، حذ_فهرس، حذ_خيارات_حل)
  إذا حذ_حل["نجاح"] == خطأ:
    ارجع حذ_حل
  حذ_قفل_قديم = اقرأ_قفل_مشروع(حذ_أساس)
  حذ_نص_قفل_قديم = لاشيء
  إذا حذ_قفل_قديم["يوجد"]:
    حاول:
      حذ_نص_قفل_قديم = اقرأ_ملف(انضم_مسار(حذ_أساس، "قفل.حزمة"))
    ماعدا:
      حذ_نص_قفل_قديم = لاشيء
  حذ_مزامنة = مزامنة_حزم(حذ_أساس، حذ_حل["حزم"]، حذ_فهرس)
  إذا حذ_مزامنة["نجاح"] == خطأ:
    ارجع حذ_مزامنة
  حذ_مسار_قفل = انضم_مسار(حذ_أساس، "قفل.حزمة")
  حذ_كتابة_قفل = اكتب_قفل(حذ_مسار_قفل، حذ_حل["حزم"]، حذ_حل["تجاوزات"])
  إذا حذ_كتابة_قفل["نجاح"] == خطأ:
    ارجع حذ_كتابة_قفل
  حاول:
    حذ_نص_بيان_قديم = اقرأ_ملف(حذ_مشروع["مسار_البيان"])
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة البيان: " + حذ_مشروع["مسار_البيان"]}
  حذ_تعديل = عدّل_بيان_نصا(حذ_نص_بيان_قديم، حذ_اسم، "", حذ_قسم، صحيح)
  إذا حذ_تعديل["نجاح"] == خطأ:
    إذا حذ_نص_قفل_قديم != لاشيء:
      حاول:
        اكتب_ملف(حذ_مسار_قفل + ".مؤقت"، حذ_نص_قفل_قديم)
        انقل(حذ_مسار_قفل + ".مؤقت"، حذ_مسار_قفل)
      ماعدا:
        ارجع حذ_تعديل
    وإلا:
      حاول:
        احذف(حذ_مسار_قفل)
      ماعدا:
        ارجع حذ_تعديل
    ارجع حذ_تعديل
  إذا حذ_في_تشغيل:
    إذا حذ_في_تطوير:
      حذ_تعديل_ث = عدّل_بيان_نصا(حذ_تعديل["نص"]، حذ_اسم، "", "اعتماديات_التطوير"، صحيح)
      إذا حذ_تعديل_ث["نجاح"] == خطأ:
        إذا حذ_نص_قفل_قديم != لاشيء:
          حاول:
            اكتب_ملف(حذ_مسار_قفل + ".مؤقت"، حذ_نص_قفل_قديم)
            انقل(حذ_مسار_قفل + ".مؤقت"، حذ_مسار_قفل)
          ماعدا:
            ارجع حذ_تعديل_ث
        وإلا:
          حاول:
            احذف(حذ_مسار_قفل)
          ماعدا:
            ارجع حذ_تعديل_ث
        ارجع حذ_تعديل_ث
      حذ_تعديل = حذ_تعديل_ث
  حاول:
    حذ_مؤقت_بيان = حذ_مشروع["مسار_البيان"] + ".مؤقت"
    اكتب_ملف(حذ_مؤقت_بيان، حذ_تعديل["نص"])
    انقل(حذ_مؤقت_بيان، حذ_مشروع["مسار_البيان"])
  ماعدا:
    إذا حذ_نص_قفل_قديم != لاشيء:
      حاول:
        اكتب_ملف(حذ_مسار_قفل + ".مؤقت"، حذ_نص_قفل_قديم)
        انقل(حذ_مسار_قفل + ".مؤقت"، حذ_مسار_قفل)
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة البيان: " + حذ_مشروع["مسار_البيان"]}
    وإلا:
      حاول:
        احذف(حذ_مسار_قفل)
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة البيان: " + حذ_مشروع["مسار_البيان"]}
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة البيان: " + حذ_مشروع["مسار_البيان"]}
  حذ_بقيت = لاشيء
  حذ_طالب_بقيت = لاشيء
  لكل حذ_محلولة في حذ_حل["حزم"]:
    إذا حذ_محلولة["اسم"] == حذ_اسم:
      حذ_بقيت = حذ_اسم
  إذا حذ_بقيت != لاشيء:
    لكل حذ_محلولة_ث في حذ_حل["حزم"]:
      لكل حذ_اعتماد_طالب في حذ_محلولة_ث["بيان"]["اعتماديات"]:
        إذا حذ_اعتماد_طالب["اسم"] == حذ_اسم:
          حذ_طالب_بقيت = حذ_محلولة_ث["اسم"]
  ارجع {"نجاح": صحيح، "اسم": حذ_اسم، "حذفت": حذ_مزامنة["حذف"]، "بقيت": حذ_بقيت، "طالب": حذ_طالب_بقيت}

# `حزم تثبيت` بلا وسائط داخل مشروع — يثبّت القفل حرفيا
# في `حزم/` (أمر الإعداد بعد الاستنساخ): القفل مصدر
# الحقيقة، فلا إعادة حل ولا أحدث صامت. والبيان والقفل
# المختلفان يرفضان قبل أي كتابة.
دالة ثبّت_القفل(ثق_أساس، ثق_فهرس، ثق_خيارات):
  ثق_مشروع = اقرأ_مشروع(ثق_أساس)
  إذا ثق_مشروع["نجاح"] == خطأ:
    ارجع ثق_مشروع
  ثق_قفل = اقرأ_قفل_مشروع(ثق_أساس)
  إذا ثق_قفل["نجاح"] == خطأ:
    ارجع ثق_قفل
  إذا ثق_قفل["يوجد"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد قفل.حزمة — شغّل حزم تحديث"}
  ثق_تحقق = قفل.تحقق_قفل_ضد_بيان(ثق_مشروع["بيان"]، ثق_قفل["حزم"])
  إذا ثق_تحقق["نجاح"] == خطأ:
    ارجع ثق_تحقق
  ثق_مزامنة = مزامنة_حزم(ثق_أساس، ثق_قفل["حزم"]، ثق_فهرس)
  إذا ثق_مزامنة["نجاح"] == خطأ:
    ارجع ثق_مزامنة
  ثق_حزم_موجزة = []
  لكل ثق_حزمة في ثق_قفل["حزم"]:
    ثق_حزم_موجزة.أضف({"اسم": ثق_حزمة["اسم"]، "إصدار": ثق_حزمة["إصدار"]})
  ارجع {"نجاح": صحيح، "حزم": ثق_حزم_موجزة}

# `حزم تثبيت <اسم> [مواصفة]` بلا مشروع — يثبّت حزمة
# بالاسم في المخزن العام وحده (جذر تركيبي اسمه `حزم`،
# وبلا اعتماديات تطوير — فقفل المكتبة لا يُفرض على
# مستخدمها، §16/4.15). والمواصفة الغائبة تعني `الأحدث`.
# وكل حزمة محلولة تُنسخ من مجلدها إلى المخزن عبر
# `مخزن.ثبّت_محليا` (فيرفض الموجودة أصلا بلا كتابة فوق).
دالة ثبّت_بالاسم(ثب_اسم، ثب_مواصفة، ثب_فهرس، ثب_خيارات):
  إذا ثب_اسم في بيان.أسماء_الوحدات_الأصلية():
    ارجع {"نجاح": خطأ، "خطأ": ثب_اسم + " وحدة أصلية — لا يمكن تثبيت حزمة بهذا الاسم"}
  ثب_مواصفة_فعلية = ثب_مواصفة
  إذا ثب_مواصفة_فعلية == لاشيء:
    ثب_مواصفة_فعلية = "الأحدث"
  ثب_محللة = بيان.حلّل_مواصفة(ثب_مواصفة_فعلية)
  إذا ثب_محللة["نجاح"] == خطأ:
    ارجع ثب_محللة
  ثب_جذر = {"اسم": "حزم"، "إصدار": "0.1.0"، "وصف": ""، "دخول": "مصدر/رئيسي.نيفا"، "نسخة_نيفا": لاشيء، "اعتماديات": [{"اسم": ثب_اسم، "نوع": ثب_محللة["نوع"]، "مواصفة": ثب_محللة["مواصفة"]}]، "اعتماديات_التطوير": []، "تجاوز": []}
  ثب_خيارات_حل = {"وضع": قيمة_خيار(ثب_خيارات، "وضع"، "الأحدث")، "تهدئة_أيام": قيمة_خيار(ثب_خيارات، "تهدئة_أيام"، ٠)، "الآن": قيمة_خيار(ثب_خيارات، "الآن"، لاشيء)، "مصادر": قيمة_خيار(ثب_خيارات، "مصادر"، {})، "تطوير": خطأ، "مثبّتة": []، "هدف_تحديث": لاشيء}
  ثب_حل = حلال.حلّ(ثب_جذر، ثب_فهرس، ثب_خيارات_حل)
  إذا ثب_حل["نجاح"] == خطأ:
    ارجع ثب_حل
  ثب_حزم_موجزة = []
  لكل ثب_حزمة في ثب_حل["حزم"]:
    ثب_مرشح = مرشح_من_فهرس(ثب_فهرس، ثب_حزمة["اسم"]، ثب_حزمة["إصدار"])
    إذا ثب_مرشح == لاشيء:
      ارجع {"نجاح": خطأ، "خطأ": "غير متصل — والحزمة " + ثب_حزمة["اسم"] + " " + ثب_حزمة["إصدار"] + " غير محفوظة محليا"}
    ثب_مجلد = مجلد_مرشح(ثب_مرشح، ثب_حزمة["اسم"])
    إذا ثب_مجلد["نجاح"] == خطأ:
      ارجع ثب_مجلد
    ثب_تثبيت = مخزن.ثبّت_محليا(ثب_مجلد["مجلد"])
    إذا ثب_تثبيت["نجاح"] == خطأ:
      ارجع ثب_تثبيت
    ثب_حزم_موجزة.أضف({"اسم": ثب_حزمة["اسم"]، "إصدار": ثب_حزمة["إصدار"]})
  ارجع {"نجاح": صحيح، "حزم": ثب_حزم_موجزة}

# `حزم تحديث [اسم] [إصدار]` — يعيد حل النطاقات `^` إلى
# الأحدث المسموح ويعيد كتابة القفل ومزامنة `حزم/`؛ وبلا اسم
# يحدّث الشجرة كلها، وباسم يحدّث حزمة واحدة بدقة (عبر
# `حدّث_حزمة` بتفضيل القفل لغير الهدف — خطة الخطوة 3 D11).
# والقفل القديم يُستعاد عند فشل كتابة القفل الجديد.
دالة حدّث(حد_أساس، حد_اسم، حد_إصدار، حد_فهرس، حد_خيارات):
  حد_مشروع = اقرأ_مشروع(حد_أساس)
  إذا حد_مشروع["نجاح"] == خطأ:
    ارجع حد_مشروع
  حد_قفل = اقرأ_قفل_مشروع(حد_أساس)
  إذا حد_قفل["نجاح"] == خطأ:
    ارجع حد_قفل
  إذا حد_قفل["يوجد"]:
    حد_مطابقة = قفل.تحقق_قفل_ضد_بيان(حد_مشروع["بيان"]، حد_قفل["حزم"])
    إذا حد_مطابقة["نجاح"] == خطأ:
      ارجع حد_مطابقة
  حد_خيارات_حل = {"وضع": قيمة_خيار(حد_خيارات، "وضع"، "الأحدث")، "تهدئة_أيام": قيمة_خيار(حد_خيارات، "تهدئة_أيام"، ٠)، "الآن": قيمة_خيار(حد_خيارات، "الآن"، لاشيء)، "مصادر": قيمة_خيار(حد_خيارات، "مصادر"، {})، "تطوير": صحيح، "مثبّتة": []، "هدف_تحديث": لاشيء}
  حد_حل = لاشيء
  حد_إصدار_جديد = لاشيء
  حد_إصدار_سابق = لاشيء
  إذا حد_اسم == لاشيء:
    حد_حل = حلال.حلّ(حد_مشروع["بيان"]، حد_فهرس، حد_خيارات_حل)
  وإلا:
    حد_دقيق = حلال.حدّث_حزمة(حد_مشروع["بيان"]، حد_قفل["حزم"]، حد_اسم، حد_إصدار، حد_فهرس، حد_خيارات_حل)
    إذا حد_دقيق["نجاح"] == خطأ:
      ارجع حد_دقيق
    حد_حل = {"نجاح": صحيح، "حزم": حد_دقيق["حزم"]، "تجاوزات": حد_دقيق["تجاوزات"]}
    حد_إصدار_جديد = حد_دقيق["إصدار"]
    حد_إصدار_سابق = حد_دقيق["سابق"]
  إذا حد_حل["نجاح"] == خطأ:
    ارجع حد_حل
  حد_نص_قفل_قديم = لاشيء
  حاول:
    حد_نص_قفل_قديم = اقرأ_ملف(انضم_مسار(حد_أساس، "قفل.حزمة"))
  ماعدا:
    حد_نص_قفل_قديم = لاشيء
  حد_مزامنة = مزامنة_حزم(حد_أساس، حد_حل["حزم"]، حد_فهرس)
  إذا حد_مزامنة["نجاح"] == خطأ:
    ارجع حد_مزامنة
  حد_مسار_قفل = انضم_مسار(حد_أساس، "قفل.حزمة")
  حد_كتابة_قفل = اكتب_قفل(حد_مسار_قفل، حد_حل["حزم"]، حد_حل["تجاوزات"])
  إذا حد_كتابة_قفل["نجاح"] == خطأ:
    إذا حد_نص_قفل_قديم != لاشيء:
      حاول:
        اكتب_ملف(حد_مسار_قفل + ".مؤقت"، حد_نص_قفل_قديم)
        انقل(حد_مسار_قفل + ".مؤقت"، حد_مسار_قفل)
      ماعدا:
        ارجع حد_كتابة_قفل
    ارجع حد_كتابة_قفل
  حد_حزم_موجزة = []
  لكل حد_حزمة في حد_حل["حزم"]:
    حد_حزم_موجزة.أضف({"اسم": حد_حزمة["اسم"]، "إصدار": حد_حزمة["إصدار"]})
  ارجع {"نجاح": صحيح، "حزم": حد_حزم_موجزة، "إصدار": حد_إصدار_جديد، "سابق": حد_إصدار_سابق}

# `حزم تحقق` — يقارن `حزم/` والقفل حرفيا (الاسم والإصدار
# والبصمة)، والبيان بالقفل أولا، ويبلّغ عن كل اختلاف أو
# نقص أو زيادة — قبل التشغيل لا بعده. والمخالفات قائمة
# كاملة لا أولها وحده؛ والرسالة تبدأ بالعنوان القانوني.
# ونسخة المخزن العام — إن وُجدت لإدخال قفل — تُفحص بصمتها
# أيضا؛ وغيابها من المخزن ليس مخالفة (فالمشروع لا المخزن
# هو المثبَّت).
دالة تحقق(تح_أساس):
  تح_مشروع = اقرأ_مشروع(تح_أساس)
  إذا تح_مشروع["نجاح"] == خطأ:
    ارجع تح_مشروع
  تح_قفل = اقرأ_قفل_مشروع(تح_أساس)
  إذا تح_قفل["نجاح"] == خطأ:
    ارجع تح_قفل
  تح_مخالفات = []
  إذا تح_قفل["يوجد"] == خطأ:
    تح_مخالفات.أضف("لا يوجد قفل.حزمة — شغّل حزم تحديث")
  وإلا:
    تح_مطابقة = قفل.تحقق_قفل_ضد_بيان(تح_مشروع["بيان"]، تح_قفل["حزم"])
    إذا تح_مطابقة["نجاح"] == خطأ:
      تح_مخالفات.أضف(تح_مطابقة["خطأ"])
    تح_مجلد_حزم = انضم_مسار(تح_أساس، "حزم")
    لكل تح_إدخال في تح_قفل["حزم"]:
      تح_هدف = تح_مجلد_حزم + "/" + تح_إدخال["اسم"]
      إذا موجود(تح_هدف) == خطأ:
        تح_مخالفات.أضف("الحزمة " + تح_إدخال["اسم"] + " في القفل وليست مثبّتة في حزم/")
        تابع
      تح_مثبتة = بصمة_مثبتة(تح_هدف)
      إذا تح_مثبتة["نجاح"] == خطأ:
        تح_مخالفات.أضف("الحزمة " + تح_إدخال["اسم"] + " مثبّتة بلا بيان صالح")
        تابع
      إذا تح_مثبتة["إصدار"] != تح_إدخال["إصدار"]:
        تح_مخالفات.أضف("الحزمة " + تح_إدخال["اسم"] + " مثبّتة بالإصدار " + تح_مثبتة["إصدار"] + " والقفل يطلب " + تح_إدخال["إصدار"])
      وإلا إذا تح_مثبتة["بصمة"] != تح_إدخال["بصمة"]:
        تح_مخالفات.أضف("بصمة الحزمة " + تح_إدخال["اسم"] + " لا تطابق القفل")
      تح_مخزن = "$نيفا/.نيفا/حزم/" + تح_إدخال["اسم"] + "-" + تح_إدخال["إصدار"]
      إذا موجود(تح_مخزن):
        تح_مثبتة_مخزن = بصمة_مثبتة(تح_مخزن)
        إذا تح_مثبتة_مخزن["نجاح"]:
          إذا تح_مثبتة_مخزن["بصمة"] != تح_إدخال["بصمة"]:
            تح_مخالفات.أضف("بصمة الحزمة " + تح_إدخال["اسم"] + " في المخزن العام لا تطابق القفل")
    تح_سرد = سرد_مجلد(تح_مجلد_حزم)
    إذا تح_سرد["نجاح"]:
      لكل تح_مدخل في تح_سرد["مدخلات"]:
        إذا تح_مدخل["نوع"] == "مجلد":
          إذا تح_مدخل["مسار"].يحتوي("/") == خطأ:
            تح_في_القفل = خطأ
            لكل تح_إدخال_ث في تح_قفل["حزم"]:
              إذا تح_إدخال_ث["اسم"] == تح_مدخل["مسار"]:
                تح_في_القفل = صحيح
            إذا تح_في_القفل == خطأ:
              تح_مخالفات.أضف("مجلد زائد في حزم/ ليس في القفل: " + تح_مدخل["مسار"])
  إذا طول(تح_مخالفات) > ٠:
    تح_نص = "الشجرة المثبتة لا تطابق القفل:"
    لكل تح_مخالفة في تح_مخالفات:
      تح_نص = تح_نص + "\n  " + تح_مخالفة
    ارجع {"نجاح": خطأ، "خطأ": تح_نص، "مخالفات": تح_مخالفات}
  ارجع {"نجاح": صحيح، "مخالفات": []}

# `حزم ابن` — يبني المشروع الحالي (مصنوع بايت كود `.نيفاب`
# عبر أمر `ابن` القائم). والبناء يحتاج ثنائي `نيفا` في
# المسار — ففي الوضع المقيّد أو التطبيق يرفض بصراحة
# ويدلّ على الأمر المباشر، لا بناء وهمي.
دالة ابن(ابن_أساس):
  ابن_مشروع = اقرأ_مشروع(ابن_أساس)
  إذا ابن_مشروع["نجاح"] == خطأ:
    ارجع ابن_مشروع
  ابن_دخول = ابن_مشروع["بيان"]["دخول"]
  ابن_مسار_دخول = انضم_مسار(ابن_أساس، ابن_دخول)
  إذا موجود(ابن_مسار_دخول) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "مسار الدخول غير موجود: " + ابن_دخول}
  حاول:
    ابن_معرف = عمليات.أنشئ("نيفا ابن " + ابن_مسار_دخول)
    ابن_رمز = عمليات.انتظر(ابن_معرف)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "حزم ابن يحتاج سطر الأوامر — شغّل مباشرة: نيفا ابن " + ابن_دخول}
  إذا ابن_رمز != ٠:
    ارجع {"نجاح": خطأ، "خطأ": "انتهى البناء برمز خروج " + إصدار.رقم_لاتيني(ابن_رمز)}
  ارجع {"نجاح": صحيح، "رمز": ابن_رمز}

# `حزم شغل [وسائط...]` — يشغّل نقطة دخول المشروع الحالي
# ويمرّر الوسائط لها (على سطر الأوامر؛ والبرنامج لا
# يقرأها بعد — فلا دالة وسائط في اللغة اليوم، حدّ موثق).
# ويرفض التشغيل إن كانت الشجرة غير متزامنة مع القفل
# (§16: `تحقق` أولا)، وإن كان الدخول غائبا، وإن طلب
# البيان محركا أحدث. والتشغيل عبر `عمليات.أنشئ` على ملف
# `.نيفا` نفسه — فيعمل في الوضع المقيّد على سطح المكتب،
# ويرفض في التطبيق والمتصفح بصراحة. ودخل البرنامج فارغ
# (فـ`ادخل` فيه يرى نهاية الدخل — حدّ موثق).
دالة شغّل(شغ_أساس، شغ_وسائط):
  شغ_مشروع = اقرأ_مشروع(شغ_أساس)
  إذا شغ_مشروع["نجاح"] == خطأ:
    ارجع شغ_مشروع
  شغ_تحقق = تحقق(شغ_أساس)
  إذا شغ_تحقق["نجاح"] == خطأ:
    ارجع شغ_تحقق
  شغ_دخول = شغ_مشروع["بيان"]["دخول"]
  شغ_مسار_دخول = انضم_مسار(شغ_أساس، شغ_دخول)
  إذا موجود(شغ_مسار_دخول) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "مسار الدخول غير موجود: " + شغ_دخول}
  إذا شغ_مشروع["بيان"]["نسخة_نيفا"] != لاشيء:
    شغ_نسخة = إصدار.تحقق_نسخة_نيفا(شغ_مشروع["بيان"]["نسخة_نيفا"])
    إذا شغ_نسخة["نجاح"] == خطأ:
      ارجع شغ_نسخة
  شغ_أمر = شغ_مسار_دخول
  لكل شغ_وسيط في شغ_وسائط:
    شغ_أمر = شغ_أمر + " " + شغ_وسيط
  حاول:
    شغ_معرف = عمليات.أنشئ(شغ_أمر)
    شغ_رمز = عمليات.انتظر(شغ_معرف)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر تشغيل " + شغ_دخول + " — التشغيل الخارجي غير متاح في هذه البيئة"}
  إذا شغ_رمز != ٠:
    ارجع {"نجاح": خطأ، "خطأ": "انتهى " + شغ_دخول + " برمز خروج " + إصدار.رقم_لاتيني(شغ_رمز)}
  ارجع {"نجاح": صحيح، "رمز": شغ_رمز}

# تشغيل ملف اختبار واحد في وضع واحد عبر قناة، وجمع
# سطوره: ناجح إن طبع سطرا `ناجح` تماما ولا سطر `فاشل`
# ورمز خروجه صفر؛ ومتخطى إن تعذّر التشغيل أصلا.
دالة شغّل_اختبار(خم_أمر، خم_ملف):
  حاول:
    خم_معرف = تواصل.أنبوب(خم_أمر)
  ماعدا:
    ارجع {"حالة": "متخطى"، "سبب": "التشغيل الخارجي غير متاح في هذه البيئة"}
  خم_سطور = []
  خم_انتهى = خطأ
  بينما خم_انتهى == خطأ:
    حاول:
      خم_سطر = تواصل.استقبل(خم_معرف)
      خم_سطور.أضف(خم_سطر)
    ماعدا:
      خم_انتهى = صحيح
  حاول:
    خم_رمز = تواصل.أغلق(خم_معرف)
  ماعدا:
    حاول:
      تواصل.أوقف(خم_معرف)
    ماعدا:
      ارجع {"حالة": "فاشل"، "سبب": "تعذّر إغلاق قناة الاختبار: " + خم_ملف}
    ارجع {"حالة": "فاشل"، "سبب": "تعذّر إغلاق قناة الاختبار: " + خم_ملف}
  إذا خم_رمز != ٠:
    ارجع {"حالة": "فاشل"، "سبب": "انتهى " + خم_ملف + " برمز خروج " + إصدار.رقم_لاتيني(خم_رمز)}
  خم_ناجح = خطأ
  خم_فاشل = خطأ
  لكل خم_سطر_م في خم_سطور:
    إذا خم_سطر_م == "ناجح":
      خم_ناجح = صحيح
    إذا نصوص.يبدأ_ب(خم_سطر_م، "فاشل"):
      خم_فاشل = صحيح
  إذا خم_فاشل:
    ارجع {"حالة": "فاشل"، "سبب": "الاختبار " + خم_ملف + " طبع فاشل"}
  إذا خم_ناجح:
    ارجع {"حالة": "ناجح"، "سبب": ""}
  ارجع {"حالة": "فاشل"، "سبب": "الاختبار " + خم_ملف + " لم يطبع ناجح"}

# `حزم اختبر` — يشغّل اختبارات `اختبارات/` في الوضعين
# (المترجم والمفسر) ويقرّر النتيجة. والمترجم يعمل عبر
# قناة على ملف `.نيفا` نفسه؛ والمفسر يحتاج ثنائي `نيفا`
# في المسار (وضع موثوق) — ففي الوضع المقيّد يُتخطى
# بتحذير وتفشل النتيجة الإجمالية بصراحة (نقص صادق، لا
# نجاح وهمي). وملف بلا سطر `ناجح` فاشل ولو خرج صفرا.
دالة اختبر(خت_أساس، خت_خيارات):
  خت_مشروع = اقرأ_مشروع(خت_أساس)
  إذا خت_مشروع["نجاح"] == خطأ:
    ارجع خت_مشروع
  خت_مجلد = انضم_مسار(خت_أساس، "اختبارات")
  إذا موجود(خت_مجلد) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد مجلد اختبارات في المشروع"}
  خت_ملفات = ملفات_نيفا_في(خت_مجلد)
  إذا خت_ملفات["نجاح"] == خطأ:
    ارجع خت_ملفات
  خت_نتائج = []
  خت_متخطى_مترجم = خطأ
  خت_متخطى_مفسر = خطأ
  لكل خت_ملف في خت_ملفات["ملفات"]:
    خت_مسار = خت_مجلد + "/" + خت_ملف
    خت_مترجم = شغّل_اختبار(خت_مسار، خت_ملف)
    خت_مفسر = شغّل_اختبار("نيفا --مفسر " + خت_مسار، خت_ملف)
    إذا خت_مترجم["حالة"] == "متخطى":
      خت_متخطى_مترجم = صحيح
    إذا خت_مفسر["حالة"] == "متخطى":
      خت_متخطى_مفسر = صحيح
    خت_نتائج.أضف({"ملف": خت_ملف، "مترجم": خت_مترجم["حالة"]، "مفسر": خت_مفسر["حالة"]، "سبب_مترجم": خت_مترجم["سبب"]، "سبب_مفسر": خت_مفسر["سبب"]})
  خت_فشل = []
  لكل خت_نتيجة في خت_نتائج:
    إذا خت_نتيجة["مترجم"] == "فاشل":
      خت_فشل.أضف(خت_نتيجة["ملف"] + " (المترجم)")
    إذا خت_نتيجة["مفسر"] == "فاشل":
      خت_فشل.أضف(خت_نتيجة["ملف"] + " (المفسر)")
  إذا طول(خت_فشل) > ٠:
    خت_نص = "اختبر: فشل "
    خت_أول = صحيح
    لكل خت_فاشل في خت_فشل:
      إذا خت_أول == خطأ:
        خت_نص = خت_نص + "، "
      خت_نص = خت_نص + خت_فاشل
      خت_أول = خطأ
    ارجع {"نجاح": خطأ، "خطأ": خت_نص، "نتائج": خت_نتائج}
  إذا خت_متخطى_مترجم:
    إذا خت_متخطى_مفسر:
      ارجع {"نجاح": خطأ، "خطأ": "اختبر: التشغيل الخارجي غير متاح في هذه البيئة"، "نتائج": خت_نتائج}
  إذا خت_متخطى_مفسر:
    ارجع {"نجاح": خطأ، "خطأ": "اختبر: المفسر متخطى — شغّل في وضع موثوق للتحقق من الوضعين"، "نتائج": خت_نتائج}
  إذا طول(خت_نتائج) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "لا توجد اختبارات في اختبارات/"، "نتائج": خت_نتائج}
  ارجع {"نجاح": صحيح، "نتائج": خت_نتائج}

# جيران كل حزمة في شجرة القفل: الجذر بأبناء تشغيله
# وتطويره، وكل حزمة أخرى بأبناء تشغيلها وحدهم (فلا تُحل
# اعتماديات تطوير الحزم — فقفل المكتبة لا يُفرض).
دالة جيران_لماذا(جي_أساس، جي_قفل_حزم، جي_جذر):
  جي_جيران = []
  جي_أبناء_جذر = []
  لكل جي_اعتماد في جي_جذر["اعتماديات"]:
    جي_أبناء_جذر.أضف(جي_اعتماد["اسم"])
  لكل جي_اعتماد_تطوير في جي_جذر["اعتماديات_التطوير"]:
    جي_أبناء_جذر.أضف(جي_اعتماد_تطوير["اسم"])
  جي_جيران.أضف({"اسم": جي_جذر["اسم"]، "أبناء": جي_أبناء_جذر})
  لكل جي_إدخال في جي_قفل_حزم:
    جي_أبناء = []
    جي_مثبت = بيان_مثبت(جي_أساس، جي_إدخال["اسم"])
    إذا جي_مثبت["نجاح"]:
      لكل جي_اعتماد_م في جي_مثبت["بيان"]["اعتماديات"]:
        جي_أبناء.أضف(جي_اعتماد_م["اسم"])
    جي_جيران.أضف({"اسم": جي_إدخال["اسم"]، "أبناء": جي_أبناء})
  ارجع {"نجاح": صحيح، "جيران": جي_جيران}

# `حزم لماذا <اسم>` — يشرح لماذا هذه الحزمة بهذا الإصدار:
# كل سلسلة اعتماديات من جذر المشروع إليها، والإصدار من
# القفل. والبحث عمق أول برزمة صريحة لا استدعاء ذاتي،
# وحارس الدائرة يمنع النزول في اسم ظهر في المسار الحالي.
دالة لماذا(لم_أساس، لم_اسم):
  لم_مشروع = اقرأ_مشروع(لم_أساس)
  إذا لم_مشروع["نجاح"] == خطأ:
    ارجع لم_مشروع
  إذا لم_اسم == لم_مشروع["بيان"]["اسم"]:
    ارجع {"نجاح": خطأ، "خطأ": "لا توجد سلسلة اعتماديات إلى الحزمة " + لم_اسم}
  لم_قفل = اقرأ_قفل_مشروع(لم_أساس)
  إذا لم_قفل["نجاح"] == خطأ:
    ارجع لم_قفل
  لم_في_القفل = خطأ
  لم_إصدار = ""
  لكل لم_إدخال في لم_قفل["حزم"]:
    إذا لم_إدخال["اسم"] == لم_اسم:
      لم_في_القفل = صحيح
      لم_إصدار = لم_إدخال["إصدار"]
  إذا لم_في_القفل == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا توجد سلسلة اعتماديات إلى الحزمة " + لم_اسم}
  لم_جيران = جيران_لماذا(لم_أساس، لم_قفل["حزم"]، لم_مشروع["بيان"])
  إذا لم_جيران["نجاح"] == خطأ:
    ارجع لم_جيران
  لم_سلاسل = []
  لم_رزمة = [[لم_مشروع["بيان"]["اسم"]]]
  بينما طول(لم_رزمة) > ٠:
    لم_مسار = لم_رزمة[طول(لم_رزمة) - ١]
    لم_رزمة.أزل()
    لم_آخر = لم_مسار[طول(لم_مسار) - ١]
    إذا لم_آخر == لم_اسم:
      لم_سلاسل.أضف(لم_مسار)
      تابع
    لم_أبناء = []
    لكل لم_جار في لم_جيران["جيران"]:
      إذا لم_جار["اسم"] == لم_آخر:
        لم_أبناء = لم_جار["أبناء"]
    لكل لم_ابن في لم_أبناء:
      إذا لم_ابن في لم_مسار:
        تابع
      لم_مسار_جديد = []
      لكل لم_عنصر في لم_مسار:
        لم_مسار_جديد.أضف(لم_عنصر)
      لم_مسار_جديد.أضف(لم_ابن)
      لم_رزمة.أضف(لم_مسار_جديد)
  إذا طول(لم_سلاسل) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "لا توجد سلسلة اعتماديات إلى الحزمة " + لم_اسم}
  لم_نص = ""
  لم_أول_سلسلة = صحيح
  لكل لم_سلسلة في لم_سلاسل:
    إذا لم_أول_سلسلة == خطأ:
      لم_نص = لم_نص + "\n"
    لم_أول_عنصر = صحيح
    لكل لم_عنصر_س في لم_سلسلة:
      إذا لم_أول_عنصر == خطأ:
        لم_نص = لم_نص + " ← "
      لم_نص = لم_نص + لم_عنصر_س
      لم_أول_عنصر = خطأ
    لم_نص = لم_نص + " (" + لم_إصدار + ")"
    لم_أول_سلسلة = خطأ
  ارجع {"نجاح": صحيح، "اسم": لم_اسم، "إصدار": لم_إصدار، "سلاسل": لم_سلاسل، "نص": لم_نص}

# `حزم اعرض` — شجرة اعتماديات المشروع من البيان والقفل
# (والإصدار من القفل، والغائب يُوسم ولا يُنزَل فيه)؛
# وبرزمة صريحة لا استدعاء ذاتي، وحارس دائري. وخارج
# المشروع يعرض المخزن العام قائمة مسطحة مرتبة بالاسم.
دالة اعرض(عر_أساس، عر_خيارات):
  عر_مشروع = اقرأ_مشروع(عر_أساس)
  إذا عر_مشروع["نجاح"]:
    عر_قفل = اقرأ_قفل_مشروع(عر_أساس)
    إذا عر_قفل["نجاح"] == خطأ:
      ارجع عر_قفل
    عر_جيران = جيران_لماذا(عر_أساس، عر_قفل["حزم"]، عر_مشروع["بيان"])
    إذا عر_جيران["نجاح"] == خطأ:
      ارجع عر_جيران
    عر_إصدارات = {}
    لكل عر_إدخال في عر_قفل["حزم"]:
      عر_إصدارات[عر_إدخال["اسم"]] = عر_إدخال["إصدار"]
    عر_سطور = [عر_مشروع["بيان"]["اسم"] + " " + عر_مشروع["بيان"]["إصدار"]]
    عر_رزمة = []
    عر_أبناء_جذر = []
    لكل عر_جار في عر_جيران["جيران"]:
      إذا عر_جار["اسم"] == عر_مشروع["بيان"]["اسم"]:
        عر_أبناء_جذر = عر_جار["أبناء"]
    عر_رزمة.أضف({"اسم": عر_مشروع["بيان"]["اسم"]، "عمق": ٠، "أبناء": عر_أبناء_جذر، "التالي": ٠})
    عر_مسار = [عر_مشروع["بيان"]["اسم"]]
    بينما طول(عر_رزمة) > ٠:
      عر_إطار = عر_رزمة[طول(عر_رزمة) - ١]
      إذا عر_إطار["التالي"] >= طول(عر_إطار["أبناء"]):
        عر_رزمة.أزل()
        عر_مسار.أزل()
        تابع
      عر_ابن = عر_إطار["أبناء"][عر_إطار["التالي"]]
      عر_رزمة.أزل()
      عر_إطار["التالي"] = عر_إطار["التالي"] + ١
      عر_رزمة.أضف(عر_إطار)
      عر_إزاحة = ""
      عر_م = ٠
      بينما عر_م < عر_إطار["عمق"] + ١:
        عر_إزاحة = عر_إزاحة + "  "
        عر_م = عر_م + ١
      عر_إصدار_ابن = "؟"
      إذا عر_ابن في عر_إصدارات:
        عر_إصدار_ابن = عر_إصدارات[عر_ابن]
      عر_سطر = عر_إزاحة + عر_ابن + " " + عر_إصدار_ابن
      إذا عر_ابن في عر_مسار:
        عر_سطر = عر_سطر + " (دائري)"
        عر_سطور.أضف(عر_سطر)
        تابع
      إذا موجود(انضم_مسار(انضم_مسار(عر_أساس، "حزم")، عر_ابن)) == خطأ:
        عر_سطر = عر_سطر + " (غير مثبّتة)"
        عر_سطور.أضف(عر_سطر)
        تابع
      عر_سطور.أضف(عر_سطر)
      عر_أبناء_ابن = []
      لكل عر_جار_ث في عر_جيران["جيران"]:
        إذا عر_جار_ث["اسم"] == عر_ابن:
          عر_أبناء_ابن = عر_جار_ث["أبناء"]
      عر_رزمة.أضف({"اسم": عر_ابن، "عمق": عر_إطار["عمق"] + ١، "أبناء": عر_أبناء_ابن، "التالي": ٠})
      عر_مسار.أضف(عر_ابن)
    عر_نص = ""
    عر_أول = صحيح
    لكل عر_سطر_ن في عر_سطور:
      إذا عر_أول == خطأ:
        عر_نص = عر_نص + "\n"
      عر_نص = عر_نص + عر_سطر_ن
      عر_أول = خطأ
    ارجع {"نجاح": صحيح، "مشروع": صحيح، "شجرة": عر_نص، "سطور": عر_سطور}
  عر_مخزن = سرد_مجلد("$نيفا/.نيفا/حزم")
  إذا عر_مخزن["نجاح"] == خطأ:
    ارجع {"نجاح": صحيح، "مشروع": خطأ، "شجرة": "المخزن العام فارغ"، "سطور": []}
  عر_مدخلات = []
  لكل عر_مدخل في عر_مخزن["مدخلات"]:
    إذا عر_مدخل["نوع"] == "مجلد":
      عر_مثبتة = بصمة_مثبتة("$نيفا/.نيفا/حزم/" + عر_مدخل["مسار"])
      إذا عر_مثبتة["نجاح"]:
        عر_مدخلات.أضف({"اسم": عر_مثبتة["اسم"]، "إصدار": عر_مثبتة["إصدار"]})
  عر_مرتبة = قفل.رتّب_حسب_الاسم(عر_مدخلات)
  عر_سطور_مخزن = []
  لكل عر_مثبتة_م في عر_مرتبة:
    عر_سطور_مخزن.أضف(عر_مثبتة_م["اسم"] + " " + عر_مثبتة_م["إصدار"])
  عر_نص_مخزن = ""
  عر_أول_مخزن = صحيح
  لكل عر_سطر_م في عر_سطور_مخزن:
    إذا عر_أول_مخزن == خطأ:
      عر_نص_مخزن = عر_نص_مخزن + "\n"
    عر_نص_مخزن = عر_نص_مخزن + عر_سطر_م
    عر_أول_مخزن = خطأ
  إذا عر_نص_مخزن == "":
    عر_نص_مخزن = "المخزن العام فارغ"
  ارجع {"نجاح": صحيح، "مشروع": خطأ، "شجرة": عر_نص_مخزن، "سطور": عر_سطور_مخزن}

# `حزم افحص عزل` — الفحص الساكن للمشروع: كل `استورد`
# في `مصدر/` لا بد أن يكون وحدة أصلية أو اعتماد تشغيل
# أو اسم المشروع نفسه أو ملف `.نيفا` في المجلد نفسه؛
# وفي `اختبارات/` يضاف اعتماد التطوير. والمخالفة تسمّي
# الاسم والملف. (حدّ موثق: سطر يبدأ بـ`استورد` داخل
# نص طويل يُقرأ خطأ.)
دالة افحص_عزل(فع_أساس):
  فع_مشروع = اقرأ_مشروع(فع_أساس)
  إذا فع_مشروع["نجاح"] == خطأ:
    ارجع فع_مشروع
  فع_مسموح_تشغيل = []
  لكل فع_أصلي في بيان.أسماء_الوحدات_الأصلية():
    فع_مسموح_تشغيل.أضف(فع_أصلي)
  لكل فع_اعتماد في فع_مشروع["بيان"]["اعتماديات"]:
    فع_مسموح_تشغيل.أضف(فع_اعتماد["اسم"])
  فع_مسموح_تشغيل.أضف(فع_مشروع["بيان"]["اسم"])
  فع_مسموح_تطوير = []
  لكل فع_مسموح في فع_مسموح_تشغيل:
    فع_مسموح_تطوير.أضف(فع_مسموح)
  لكل فع_اعتماد_تطوير في فع_مشروع["بيان"]["اعتماديات_التطوير"]:
    فع_مسموح_تطوير.أضف(فع_اعتماد_تطوير["اسم"])
  فع_مخالفات = []
  فع_مجلدات = [{"مجلد": "مصدر"، "مسموح": فع_مسموح_تشغيل}، {"مجلد": "اختبارات"، "مسموح": فع_مسموح_تطوير}]
  لكل فع_مجلد في فع_مجلدات:
    فع_مسار_مجلد = انضم_مسار(فع_أساس، فع_مجلد["مجلد"])
    إذا موجود(فع_مسار_مجلد) == خطأ:
      تابع
    فع_ملفات = ملفات_نيفا_في(فع_مسار_مجلد)
    إذا فع_ملفات["نجاح"] == خطأ:
      تابع
    لكل فع_ملف في فع_ملفات["ملفات"]:
      فع_مسار_ملف = فع_مسار_مجلد + "/" + فع_ملف
      فع_استيرادات = استيرادات_ملف(فع_مسار_ملف)
      إذا فع_استيرادات["نجاح"] == خطأ:
        تابع
      فع_مجلد_ملف = ""
      إذا فع_ملف.يحتوي("/"):
        فع_مجلد_ملف = نصوص.قبل_الفهرس(فع_ملف، طول(فع_ملف) - طول(نصوص.اسم_الملف(فع_ملف)) - ١)
      فع_أخوة = []
      لكل فع_ملف_ث في فع_ملفات["ملفات"]:
        فع_مجلد_ملف_ث = ""
        إذا فع_ملف_ث.يحتوي("/"):
          فع_مجلد_ملف_ث = نصوص.قبل_الفهرس(فع_ملف_ث، طول(فع_ملف_ث) - طول(نصوص.اسم_الملف(فع_ملف_ث)) - ١)
        إذا فع_مجلد_ملف_ث == فع_مجلد_ملف:
          فع_اسم_ملف = نصوص.اسم_الملف(فع_ملف_ث)
          فع_اسم_وحدة = فع_اسم_ملف
          إذا نصوص.ينتهي_ب(فع_اسم_ملف، ".نيفا"):
            فع_اسم_وحدة = نصوص.قبل_الفهرس(فع_اسم_ملف، طول(فع_اسم_ملف) - ٥)
          فع_أخوة.أضف(فع_اسم_وحدة)
      لكل فع_استيراد في فع_استيرادات["أسماء"]:
        فع_مسموح = خطأ
        لكل فع_اسم_مسموح في فع_مجلد["مسموح"]:
          إذا فع_اسم_مسموح == فع_استيراد:
            فع_مسموح = صحيح
        إذا فع_مسموح == خطأ:
          لكل فع_أخ في فع_أخوة:
            إذا فع_أخ == فع_استيراد:
              فع_مسموح = صحيح
        إذا فع_مسموح == خطأ:
          فع_مخالفات.أضف({"ملف": فع_مجلد["مجلد"] + "/" + فع_ملف، "اسم": فع_استيراد})
  إذا طول(فع_مخالفات) > ٠:
    فع_نص = ""
    فع_أول = صحيح
    لكل فع_مخالفة في فع_مخالفات:
      إذا فع_أول == خطأ:
        فع_نص = فع_نص + "\n"
      فع_نص = فع_نص + "استيراد غير معلن: " + فع_مخالفة["اسم"] + " في " + فع_مخالفة["ملف"] + " — أعلنه في البيان أولا"
      فع_أول = خطأ
    ارجع {"نجاح": خطأ، "خطأ": فع_نص، "مخالفات": فع_مخالفات}
  ارجع {"نجاح": صحيح، "مخالفات": []}


# هل الاسم اعتماد مباشر (تشغيل أو تطوير) في مشروع؟
# بلا مشروع يرجع "مشروع": خطأ — فلا خطأ هنا أبدا.
دالة اعتماد_في_المشروع(فم_أساس، فم_اسم):
  فم_مشروع = اقرأ_مشروع(فم_أساس)
  إذا فم_مشروع["نجاح"] == خطأ:
    ارجع {"نجاح": صحيح، "مشروع": خطأ، "موجود": خطأ}
  لكل فم_اعتماد في فم_مشروع["بيان"]["اعتماديات"]:
    إذا فم_اعتماد["اسم"] == فم_اسم:
      ارجع {"نجاح": صحيح، "مشروع": صحيح، "موجود": صحيح}
  لكل فم_اعتماد_تطوير في فم_مشروع["بيان"]["اعتماديات_التطوير"]:
    إذا فم_اعتماد_تطوير["اسم"] == فم_اسم:
      ارجع {"نجاح": صحيح، "مشروع": صحيح، "موجود": صحيح}
  ارجع {"نجاح": صحيح، "مشروع": صحيح، "موجود": خطأ}

# مجلد وحدة مثبّتة: `حزم/<اسم>` في المشروع أولا،
# ثم أحدث نسخة في المخزن العام `<اسم>-<إصدار>`؛
# وغيابهما رفض صريح. والمشروع يفوز عند التكرار.
دالة مجلد_مثبت(مم_أساس، مم_اسم):
  مم_مسار_مشروع = انضم_مسار(انضم_مسار(مم_أساس، "حزم")، مم_اسم)
  إذا موجود(مم_مسار_مشروع):
    مم_بصمة_مشروع = بصمة_مثبتة(مم_مسار_مشروع)
    إذا مم_بصمة_مشروع["نجاح"]:
      ارجع {"نجاح": صحيح، "مسار": مم_مسار_مشروع، "إصدار": مم_بصمة_مشروع["إصدار"]، "مشروع": صحيح}
  مم_سرد = سرد_مجلد("$نيفا/.نيفا/حزم")
  إذا مم_سرد["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + مم_اسم + " غير مثبّتة — ثبّتها أولا"}
  مم_أفضل = لاشيء
  لكل مم_مدخل في مم_سرد["مدخلات"]:
    إذا مم_مدخل["نوع"] != "مجلد":
      تابع
    إذا مم_مدخل["مسار"].يحتوي("/") :
      تابع
    إذا نصوص.يبدأ_ب(مم_مدخل["مسار"]، مم_اسم + "-") == خطأ:
      تابع
    مم_بصمة = بصمة_مثبتة("$نيفا/.نيفا/حزم/" + مم_مدخل["مسار"])
    إذا مم_بصمة["نجاح"] == خطأ:
      تابع
    إذا مم_بصمة["اسم"] != مم_اسم:
      تابع
    إذا مم_أفضل == لاشيء:
      مم_أفضل = {"مسار": "$نيفا/.نيفا/حزم/" + مم_مدخل["مسار"]، "إصدار": مم_بصمة["إصدار"]}
    وإلا:
      مم_مقارنة = إصدار.قارن_إصدارين(مم_بصمة["إصدار"]، مم_أفضل["إصدار"])
      إذا مم_مقارنة["نجاح"]:
        إذا مم_مقارنة["مقارنة"] > ٠:
          مم_أفضل = {"مسار": "$نيفا/.نيفا/حزم/" + مم_مدخل["مسار"]، "إصدار": مم_بصمة["إصدار"]}
  إذا مم_أفضل == لاشيء:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + مم_اسم + " غير مثبّتة — ثبّتها أولا"}
  ارجع {"نجاح": صحيح، "مسار": مم_أفضل["مسار"]، "إصدار": مم_أفضل["إصدار"]، "مشروع": خطأ}

# `حزم مثبتة` (البند 11): كل المثبّتات — مشروعا
# ومخزنا عاما — اسم وإصدار لكل واحدة + سطر بعددها.
# والمشروع يفوز عند تكرار الاسم في الجهتين.
دالة مثبتة(مث_أساس):
  مث_صفوف = []
  مث_مشروع = اقرأ_مشروع(مث_أساس)
  إذا مث_مشروع["نجاح"]:
    مث_سرد_مشروع = سرد_مجلد(انضم_مسار(مث_أساس، "حزم"))
    إذا مث_سرد_مشروع["نجاح"]:
      لكل مث_مدخل في مث_سرد_مشروع["مدخلات"]:
        إذا مث_مدخل["نوع"] != "مجلد":
          تابع
        إذا مث_مدخل["مسار"].يحتوي("/"):
          تابع
        مث_بصمة = بصمة_مثبتة(انضم_مسار(انضم_مسار(مث_أساس، "حزم")، مث_مدخل["مسار"]))
        إذا مث_بصمة["نجاح"]:
          مث_صفوف.أضف({"اسم": مث_بصمة["اسم"]، "إصدار": مث_بصمة["إصدار"]، "مصدر": "مشروع"})
  مث_سرد_مخزن = سرد_مجلد("$نيفا/.نيفا/حزم")
  إذا مث_سرد_مخزن["نجاح"]:
    لكل مث_مدخل_مخزن في مث_سرد_مخزن["مدخلات"]:
      إذا مث_مدخل_مخزن["نوع"] != "مجلد":
        تابع
      إذا مث_مدخل_مخزن["مسار"].يحتوي("/"):
        تابع
      مث_بصمة_مخزن = بصمة_مثبتة("$نيفا/.نيفا/حزم/" + مث_مدخل_مخزن["مسار"])
      إذا مث_بصمة_مخزن["نجاح"] == خطأ:
        تابع
      مث_موجود = خطأ
      لكل مث_صف في مث_صفوف:
        إذا مث_صف["اسم"] == مث_بصمة_مخزن["اسم"]:
          مث_موجود = صحيح
      إذا مث_موجود == خطأ:
        مث_صفوف.أضف({"اسم": مث_بصمة_مخزن["اسم"]، "إصدار": مث_بصمة_مخزن["إصدار"]، "مصدر": "مخزن"})
  مث_مرتبة = قفل.رتّب_حسب_الاسم(مث_صفوف)
  إذا طول(مث_مرتبة) == ٠:
    ارجع {"نجاح": صحيح، "حزم": []، "نص": "لا توجد حزم مثبّتة"}
  مث_سطور = []
  لكل مث_صف_م في مث_مرتبة:
    مث_سطور.أضف(مث_صف_م["اسم"] + " " + مث_صف_م["إصدار"])
  مث_سطور.أضف("عدد المثبّتات: " + إصدار.رقم_لاتيني(طول(مث_مرتبة)))
  مث_نص = ""
  مث_أول = صحيح
  لكل مث_سطر في مث_سطور:
    إذا مث_أول == خطأ:
      مث_نص = مث_نص + "\n"
    مث_نص = مث_نص + مث_سطر
    مث_أول = خطأ
  ارجع {"نجاح": صحيح، "حزم": مث_مرتبة، "نص": مث_نص}

# `حزم ملفات <اسم>` (البند 10): ملفات وحدة مثبّتة
# من سجل التثبيت المحلي — مسارات نسبية إلى مجلدها.
دالة ملفات_مثبتة(مل_أساس، مل_اسم):
  مل_مثبت = مجلد_مثبت(مل_أساس، مل_اسم)
  إذا مل_مثبت["نجاح"] == خطأ:
    ارجع مل_مثبت
  مل_سرد = سرد_مجلد(مل_مثبت["مسار"])
  إذا مل_سرد["نجاح"] == خطأ:
    ارجع مل_سرد
  مل_ملفات = []
  لكل مل_مدخل في مل_سرد["مدخلات"]:
    إذا مل_مدخل["نوع"] == "ملف":
      مل_ملفات.أضف(مل_مدخل["مسار"])
  مل_سطور = [مل_اسم + " " + مل_مثبت["إصدار"] + ":"]
  لكل مل_ملف في مل_ملفات:
    مل_سطور.أضف("  " + مل_ملف)
  مل_نص = ""
  مل_أول = صحيح
  لكل مل_سطر في مل_سطور:
    إذا مل_أول == خطأ:
      مل_نص = مل_نص + "\n"
    مل_نص = مل_نص + مل_سطر
    مل_أول = خطأ
  ارجع {"نجاح": صحيح، "اسم": مل_اسم، "إصدار": مل_مثبت["إصدار"]، "ملفات": مل_ملفات، "نص": مل_نص}

# إلغاء تثبيت وحدة (البند 14 — حكم الاجتماع 44):
# يرفض إن اعتمدت عليها مثبّتة أخرى (بخطأ يسمّي
# الطالب الأول أبجديا)، وبلا طالب يحذف مجلدها إلا
# ملف `إعدادات.حزمة` فيبقى في مكانه.
دالة أزل_مثبتة(أز_أساس، أز_اسم):
  أز_مثبت = مجلد_مثبت(أز_أساس، أز_اسم)
  إذا أز_مثبت["نجاح"] == خطأ:
    ارجع أز_مثبت
  أز_في_مشروع = اعتماد_في_المشروع(أز_أساس، أز_اسم)
  إذا أز_في_مشروع["موجود"]:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + أز_اسم + " اعتماد في المشروع — استخدم حزم احذف " + أز_اسم}
  أز_مجلدات = []
  أز_مشروع = اقرأ_مشروع(أز_أساس)
  إذا أز_مشروع["نجاح"]:
    أز_سرد_مشروع = سرد_مجلد(انضم_مسار(أز_أساس، "حزم"))
    إذا أز_سرد_مشروع["نجاح"]:
      لكل أز_مدخل في أز_سرد_مشروع["مدخلات"]:
        إذا أز_مدخل["نوع"] != "مجلد":
          تابع
        إذا أز_مدخل["مسار"].يحتوي("/"):
          تابع
        أز_مجلدات.أضف(انضم_مسار(انضم_مسار(أز_أساس، "حزم")، أز_مدخل["مسار"]))
  أز_سرد_مخزن = سرد_مجلد("$نيفا/.نيفا/حزم")
  إذا أز_سرد_مخزن["نجاح"]:
    لكل أز_مدخل_مخزن في أز_سرد_مخزن["مدخلات"]:
      إذا أز_مدخل_مخزن["نوع"] != "مجلد":
        تابع
      إذا أز_مدخل_مخزن["مسار"].يحتوي("/"):
        تابع
      أز_مجلدات.أضف("$نيفا/.نيفا/حزم/" + أز_مدخل_مخزن["مسار"])
  أز_طالبون = []
  لكل أز_مجلد في أز_مجلدات:
    إذا أز_مجلد == أز_مثبت["مسار"]:
      تابع
    أز_بيان = بيان.اقرأ_بيان(انضم_مسار(أز_مجلد، "بيان.حزمة"))
    إذا أز_بيان["نجاح"] == خطأ:
      تابع
    لكل أز_اعتماد في أز_بيان["بيان"]["اعتماديات"]:
      إذا أز_اعتماد["اسم"] == أز_اسم:
        أز_طالبون.أضف({"اسم": أز_بيان["بيان"]["اسم"]})
  إذا طول(أز_طالبون) > ٠:
    أز_مرتبة = قفل.رتّب_حسب_الاسم(أز_طالبون)
    ارجع {"نجاح": خطأ، "خطأ": "الوحدة " + أز_اسم + " مطلوبة من " + أز_مرتبة[٠]["اسم"] + " — احذف " + أز_مرتبة[٠]["اسم"] + " أولا"}
  أز_سرد = سرد_مجلد(أز_مثبت["مسار"])
  إذا أز_سرد["نجاح"] == خطأ:
    ارجع أز_سرد
  أز_إعداد = موجود(أز_مثبت["مسار"] + "/إعدادات.حزمة")
  أز_فهرس = طول(أز_سرد["مدخلات"]) - ١
  بينما أز_فهرس >= ٠:
    أز_مدخل = أز_سرد["مدخلات"][أز_فهرس]
    إذا أز_مدخل["نوع"] == "ملف":
      إذا أز_مدخل["مسار"] == "إعدادات.حزمة":
        أز_فهرس = أز_فهرس - ١
        تابع
      حاول:
        احذف(أز_مثبت["مسار"] + "/" + أز_مدخل["مسار"])
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر حذف الملف: " + أز_مدخل["مسار"]}
    أز_فهرس = أز_فهرس - ١
  أز_فهرس = طول(أز_سرد["مدخلات"]) - ١
  بينما أز_فهرس >= ٠:
    أز_مدخل_مجلد = أز_سرد["مدخلات"][أز_فهرس]
    إذا أز_مدخل_مجلد["نوع"] == "مجلد":
      حاول:
        احذف_مجلد(أز_مثبت["مسار"] + "/" + أز_مدخل_مجلد["مسار"])
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر حذف المجلد: " + أز_مدخل_مجلد["مسار"]}
    أز_فهرس = أز_فهرس - ١
  إذا أز_إعداد:
    ارجع {"نجاح": صحيح، "اسم": أز_اسم، "إصدار": أز_مثبت["إصدار"]، "بقي_إعداد": صحيح، "نص": "حُذفت الوحدة " + أز_اسم + " — وبقيت إعداداتها"}
  حاول:
    احذف_مجلد(أز_مثبت["مسار"])
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر حذف المجلد: " + أز_مثبت["مسار"]}
  ارجع {"نجاح": صحيح، "اسم": أز_اسم، "إصدار": أز_مثبت["إصدار"]، "بقي_إعداد": خطأ، "نص": "حُذفت الوحدة " + أز_اسم}
