# إصدارات نيفا — تحليل وتطبيع ومقارنة ومطابقة (رئيسي.فرعي.إصلاحي)
# الصيغة القانونية أرقام لاتينية وحدها؛ وتُقبل الأرقام المشرقية عند الكتابة
# فتُطبَّع إلى اللاتينية عند التحليل (التصميم §5).
# الإصدار التجريبي: لاحقة بعد الثلاثة أرقام (1.2.3-تجريبي) — لا يختاره
# الحلّال أبدا إلا بطلبه بالاسم الكامل (التصميم §16 — الخطوة 2).
# وكل دوال هذه الوحدة ترجع قاموس نتيجة: {"نجاح": صحيح، ...} أو
# {"نجاح": خطأ، "خطأ": "رسالة عربية"} — لأن اللغة بلا أمر رفع خطأ
# مخصص في v1، فالخطأ قيمة ترجع لا استثناء يُرفع.
صدر طبّع_أرقام، رقم_لاتيني، كلها_أرقام، صالح_لاحقة، حلّل_إصدار، قارن_إصدارين، تجريبي، يطابق، اختر_إصدار، اختر_أدنى، نسخة_المحرك، تحقق_نسخة_نيفا
استورد نص باسم نصوص

دالة طبّع_أرقام(النص):
  ن = النص.استبدل("٠", "0").استبدل("١", "1").استبدل("٢", "2").استبدل("٣", "3").استبدل("٤", "4").استبدل("٥", "5").استبدل("٦", "6").استبدل("٧", "7").استبدل("٨", "8").استبدل("٩", "9").استبدل("٫", ".")
  ارجع ن

دالة رقم_لاتيني(عدد):
  ارجع طبّع_أرقام(نص(عدد))

دالة كلها_أرقام(النص):
  إذا طول(النص) == ٠:
    ارجع خطأ
  أرقام = "0123456789"
  فهرس = ٠
  بينما فهرس < طول(النص):
    إذا أرقام.يحتوي(النص[فهرس]) == خطأ:
      ارجع خطأ
    فهرس = فهرس + ١
  ارجع صحيح

دالة صالح_لاحقة(لاحقة):
  إذا طول(لاحقة) == ٠:
    ارجع خطأ
  ممنوعة_لاحقة = [" ", ":", "/", "\\", "_", "#", "@", "،", "؟", "!", "ـ", "ً", "ٌ", "ٍ", "َ", "ُ", "ِ", "ّ", "ْ", "(", ")", "[", "]", "{", "}", "|", "*", "?", "<", ">", "\"", "'", "`", "~", "$", "%", "^", "&", "+", "=", ";", ","]
  فهرس_حرف = ٠
  بينما فهرس_حرف < طول(لاحقة):
    إذا لاحقة[فهرس_حرف] في ممنوعة_لاحقة:
      ارجع خطأ
    فهرس_حرف = فهرس_حرف + ١
  معرفات_لاحقة = لاحقة.قسم(".")
  لكل معرف_لاحقة في معرفات_لاحقة:
    إذا طول(معرف_لاحقة) == ٠:
      ارجع خطأ
    وجد_حرف_معرف = خطأ
    فهرس_معرف = ٠
    بينما فهرس_معرف < طول(معرف_لاحقة):
      إذا معرف_لاحقة[فهرس_معرف] != "-":
        وجد_حرف_معرف = صحيح
      فهرس_معرف = فهرس_معرف + ١
    إذا وجد_حرف_معرف == خطأ:
      ارجع خطأ
  ارجع صحيح

دالة حلّل_إصدار(نص_الإصدار):
  مطبّع = طبّع_أرقام(نص_الإصدار)
  أجزاء_شرطة = مطبّع.قسم("-")
  ثلاثية_خام = أجزاء_شرطة[٠]
  لاحقة_خام = لاشيء
  إذا طول(أجزاء_شرطة) > ١:
    لاحقة_خام = أجزاء_شرطة[١]
    فهرس_جزء = ٢
    بينما فهرس_جزء < طول(أجزاء_شرطة):
      لاحقة_خام = لاحقة_خام + "-" + أجزاء_شرطة[فهرس_جزء]
      فهرس_جزء = فهرس_جزء + ١
    إذا صالح_لاحقة(لاحقة_خام) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح: " + نص_الإصدار + " — الصيغة رئيسي.فرعي.إصلاحي"}
  أجزاء = ثلاثية_خام.قسم(".")
  إذا طول(أجزاء) != ٣:
    ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح: " + نص_الإصدار + " — الصيغة رئيسي.فرعي.إصلاحي"}
  لكل جزء في أجزاء:
    إذا كلها_أرقام(جزء) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح: " + نص_الإصدار + " — الصيغة رئيسي.فرعي.إصلاحي"}
  رئيسي = عدد(أجزاء[٠])
  فرعي = عدد(أجزاء[١])
  إصلاحي = عدد(أجزاء[٢])
  قانوني = طبّع_أرقام(نص(رئيسي)) + "." + طبّع_أرقام(نص(فرعي)) + "." + طبّع_أرقام(نص(إصلاحي))
  إذا لاحقة_خام == لاشيء:
    ارجع {"نجاح": صحيح، "رئيسي": رئيسي، "فرعي": فرعي، "إصلاحي": إصلاحي، "قانوني": قانوني، "تجريبي": خطأ، "لاحقة": لاشيء}
  قانوني = قانوني + "-" + لاحقة_خام
  ارجع {"نجاح": صحيح، "رئيسي": رئيسي، "فرعي": فرعي، "إصلاحي": إصلاحي، "قانوني": قانوني، "تجريبي": صحيح، "لاحقة": لاحقة_خام}

دالة قارن_إصدارين(أ، ب):
  ن_أ = حلّل_إصدار(أ)
  إذا ن_أ["نجاح"] == خطأ:
    ارجع ن_أ
  ن_ب = حلّل_إصدار(ب)
  إذا ن_ب["نجاح"] == خطأ:
    ارجع ن_ب
  إذا ن_أ["رئيسي"] != ن_ب["رئيسي"]:
    إذا ن_أ["رئيسي"] > ن_ب["رئيسي"]:
      ارجع {"نجاح": صحيح، "مقارنة": ١}
    ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
  إذا ن_أ["فرعي"] != ن_ب["فرعي"]:
    إذا ن_أ["فرعي"] > ن_ب["فرعي"]:
      ارجع {"نجاح": صحيح، "مقارنة": ١}
    ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
  إذا ن_أ["إصلاحي"] != ن_ب["إصلاحي"]:
    إذا ن_أ["إصلاحي"] > ن_ب["إصلاحي"]:
      ارجع {"نجاح": صحيح، "مقارنة": ١}
    ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
  إذا ن_أ["تجريبي"] == خطأ:
    إذا ن_ب["تجريبي"] == خطأ:
      ارجع {"نجاح": صحيح، "مقارنة": ٠}
    ارجع {"نجاح": صحيح، "مقارنة": ١}
  إذا ن_ب["تجريبي"] == خطأ:
    ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
  معرفات_أ = ن_أ["لاحقة"].قسم(".")
  معرفات_ب = ن_ب["لاحقة"].قسم(".")
  أقصر = طول(معرفات_أ)
  إذا طول(معرفات_ب) < أقصر:
    أقصر = طول(معرفات_ب)
  فهرس_معرف = ٠
  بينما فهرس_معرف < أقصر:
    معرف_أ = معرفات_أ[فهرس_معرف]
    معرف_ب = معرفات_ب[فهرس_معرف]
    إذا معرف_أ != معرف_ب:
      إذا كلها_أرقام(معرف_أ):
        إذا كلها_أرقام(معرف_ب):
          إذا عدد(معرف_أ) > عدد(معرف_ب):
            ارجع {"نجاح": صحيح، "مقارنة": ١}
          ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
        ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
      إذا كلها_أرقام(معرف_ب):
        ارجع {"نجاح": صحيح، "مقارنة": ١}
      إذا معرف_أ < معرف_ب:
        ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
      ارجع {"نجاح": صحيح، "مقارنة": ١}
    فهرس_معرف = فهرس_معرف + ١
  إذا طول(معرفات_أ) == طول(معرفات_ب):
    ارجع {"نجاح": صحيح، "مقارنة": ٠}
  إذا طول(معرفات_أ) < طول(معرفات_ب):
    ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
  ارجع {"نجاح": صحيح، "مقارنة": ١}

دالة تجريبي(نص_الإصدار):
  ن_تجريبي = حلّل_إصدار(نص_الإصدار)
  إذا ن_تجريبي["نجاح"] == خطأ:
    ارجع ن_تجريبي
  ارجع {"نجاح": صحيح، "تجريبي": ن_تجريبي["تجريبي"]}

دالة يطابق(مواصفة_محللة، إصدار_مرشح):
  إذا مواصفة_محللة["نوع"] == "مصدر":
    ارجع {"نجاح": خطأ، "خطأ": "المواصفة مصدر رابط — لا تطابق إصدارا"}
  مرشح_محلل = حلّل_إصدار(إصدار_مرشح)
  إذا مرشح_محلل["نجاح"] == خطأ:
    ارجع مرشح_محلل
  إذا مواصفة_محللة["نوع"] == "إصدار":
    ارجع {"نجاح": صحيح، "يطابق": مرشح_محلل["قانوني"] == مواصفة_محللة["مواصفة"]}
  إذا مواصفة_محللة["نوع"] == "الأحدث":
    ارجع {"نجاح": صحيح، "يطابق": مرشح_محلل["تجريبي"] == خطأ}
  إذا مواصفة_محللة["نوع"] == "نطاق":
    إذا مرشح_محلل["تجريبي"]:
      ارجع {"نجاح": صحيح، "يطابق": خطأ}
    باقي_نطاق = نصوص.من_الفهرس(مواصفة_محللة["مواصفة"]، ١)
    أجزاء_نطاق = باقي_نطاق.قسم(".")
    رئيسي_نطاق = عدد(أجزاء_نطاق[٠])
    إذا مرشح_محلل["رئيسي"] != رئيسي_نطاق:
      ارجع {"نجاح": صحيح، "يطابق": خطأ}
    إذا طول(أجزاء_نطاق) == ٢:
      أساس_قانوني = أجزاء_نطاق[٠] + "." + أجزاء_نطاق[١] + ".0"
    وإلا:
      أساس_قانوني = أجزاء_نطاق[٠] + "." + أجزاء_نطاق[١] + "." + أجزاء_نطاق[٢]
    مقارنة_أساس = قارن_إصدارين(مرشح_محلل["قانوني"]، أساس_قانوني)
    إذا مقارنة_أساس["مقارنة"] < ٠:
      ارجع {"نجاح": صحيح، "يطابق": خطأ}
    ارجع {"نجاح": صحيح، "يطابق": صحيح}
  ارجع {"نجاح": خطأ، "خطأ": "نوع مواصفة غير معروف: " + مواصفة_محللة["نوع"]}

دالة اختر_إصدار(اسم_حزمة، مواصفة_محللة، قائمة_إصدارات):
  إذا مواصفة_محللة["نوع"] == "مصدر":
    ارجع {"نجاح": خطأ، "خطأ": "المواصفة مصدر رابط — لا تختار إصدارا"}
  أفضل_إصدار = لاشيء
  أفضل_قانوني = ""
  رأى_صالح = خطأ
  لكل مرشح_قائمة في قائمة_إصدارات:
    نتيجة_مطابقة = يطابق(مواصفة_محللة، مرشح_قائمة)
    إذا نتيجة_مطابقة["نجاح"] == خطأ:
      تابع
    رأى_صالح = صحيح
    إذا نتيجة_مطابقة["يطابق"] == خطأ:
      تابع
    مرشح_محلل = حلّل_إصدار(مرشح_قائمة)
    إذا أفضل_إصدار == لاشيء:
      أفضل_إصدار = مرشح_قائمة
      أفضل_قانوني = مرشح_محلل["قانوني"]
    وإلا:
      مقارنة_أفضل = قارن_إصدارين(مرشح_محلل["قانوني"]، أفضل_قانوني)
      إذا مقارنة_أفضل["مقارنة"] > ٠:
        أفضل_إصدار = مرشح_قائمة
        أفضل_قانوني = مرشح_محلل["قانوني"]
  إذا أفضل_إصدار == لاشيء:
    إذا مواصفة_محللة["نوع"] == "إصدار":
      ارجع {"نجاح": خطأ، "خطأ": "الإصدار " + مواصفة_محللة["مواصفة"] + " غير موجود للحزمة " + اسم_حزمة}
    إذا مواصفة_محللة["نوع"] == "الأحدث":
      إذا رأى_صالح:
        ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار مستقر للحزمة " + اسم_حزمة + " — والإصدارات المتاحة تجريبية فقط"}
      ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار للحزمة " + اسم_حزمة}
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار يطابق " + مواصفة_محللة["مواصفة"] + " للحزمة " + اسم_حزمة}
  ارجع {"نجاح": صحيح، "إصدار": أفضل_قانوني}

دالة اختر_أدنى(اسم_حزمة، مواصفة_محللة، قائمة_إصدارات):
  إذا مواصفة_محللة["نوع"] == "مصدر":
    ارجع {"نجاح": خطأ، "خطأ": "المواصفة مصدر رابط — لا تختار إصدارا"}
  أدنى_إصدار = لاشيء
  أدنى_قانوني = ""
  رأى_صالح_أدنى = خطأ
  لكل مرشح_أدنى في قائمة_إصدارات:
    نتيجة_أدنى = يطابق(مواصفة_محللة، مرشح_أدنى)
    إذا نتيجة_أدنى["نجاح"] == خطأ:
      تابع
    رأى_صالح_أدنى = صحيح
    إذا نتيجة_أدنى["يطابق"] == خطأ:
      تابع
    مرشح_محلل_أدنى = حلّل_إصدار(مرشح_أدنى)
    إذا أدنى_إصدار == لاشيء:
      أدنى_إصدار = مرشح_أدنى
      أدنى_قانوني = مرشح_محلل_أدنى["قانوني"]
    وإلا:
      مقارنة_أدنى = قارن_إصدارين(مرشح_محلل_أدنى["قانوني"]، أدنى_قانوني)
      إذا مقارنة_أدنى["مقارنة"] < ٠:
        أدنى_إصدار = مرشح_أدنى
        أدنى_قانوني = مرشح_محلل_أدنى["قانوني"]
  إذا أدنى_إصدار == لاشيء:
    إذا مواصفة_محللة["نوع"] == "إصدار":
      ارجع {"نجاح": خطأ، "خطأ": "الإصدار " + مواصفة_محللة["مواصفة"] + " غير موجود للحزمة " + اسم_حزمة}
    إذا مواصفة_محللة["نوع"] == "الأحدث":
      إذا رأى_صالح_أدنى:
        ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار مستقر للحزمة " + اسم_حزمة + " — والإصدارات المتاحة تجريبية فقط"}
      ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار للحزمة " + اسم_حزمة}
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار يطابق " + مواصفة_محللة["مواصفة"] + " للحزمة " + اسم_حزمة}
  ارجع {"نجاح": صحيح، "إصدار": أدنى_قانوني}

دالة نسخة_المحرك():
  نص_النسخة = النسخة()
  إذا نصوص.يبدأ_ب(نص_النسخة، "محرك نيفا "):
    باقي = نصوص.من_الفهرس(نص_النسخة، طول("محرك نيفا "))
    ارجع حلّل_إصدار(باقي)
  ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة نسخة المحرك"}

دالة تحقق_نسخة_نيفا(أدنى):
  ن_أدنى = حلّل_إصدار(أدنى)
  إذا ن_أدنى["نجاح"] == خطأ:
    ارجع ن_أدنى
  ن_محرك = نسخة_المحرك()
  إذا ن_محرك["نجاح"] == خطأ:
    ارجع ن_محرك
  مقارنة = قارن_إصدارين(ن_محرك["قانوني"]، ن_أدنى["قانوني"])
  إذا مقارنة["مقارنة"] < ٠:
    ارجع {"نجاح": خطأ، "خطأ": "المحرك أقدم من المطلوب: المطلوب " + ن_أدنى["قانوني"] + " والحالي " + ن_محرك["قانوني"]}
  ارجع {"نجاح": صحيح، "الأدنى": ن_أدنى["قانوني"]، "الحالي": ن_محرك["قانوني"]}
