# إصدارات نيفا — تحليل وتطبيع ومقارنة (رئيسي.فرعي.إصلاحي)
# الصيغة القانونية أرقام لاتينية وحدها؛ وتُقبل الأرقام المشرقية عند الكتابة
# فتُطبَّع إلى اللاتينية عند التحليل (التصميم §5).
صدر طبّع_أرقام، رقم_لاتيني، كلها_أرقام، حلّل_إصدار، قارن_إصدارين، نسخة_المحرك، تحقق_نسخة_نيفا
استورد نص باسم نصوص

دالة طبّع_أرقام(النص):
  ن = النص.استبدل("٠", "0").استبدل("١", "1").استبدل("٢", "2").استبدل("٣", "3").استبدل("٤", "4").استبدل("٥", "5").استبدل("٦", "6").استبدل("٧", "7").استبدل("٨", "8").استبدل("٩", "9").استبدل("٫", ".")
  ارجع ن

دالة رقم_لاتيني(عدد):
  ارجع طبّع_أرقام(نص(عدد))

دالة كلها_أرقام(النص):
  إذا طول(النص) == ٠:
    ارجع خطأ
  أرقام = "0123456789"
  فهرس = ٠
  بينما فهرس < طول(النص):
    إذا أرقام.يحتوي(النص[فهرس]) == خطأ:
      ارجع خطأ
    فهرس = فهرس + ١
  ارجع صحيح

دالة حلّل_إصدار(نص_الإصدار):
  مطبّع = طبّع_أرقام(نص_الإصدار)
  أجزاء = مطبّع.قسم(".")
  إذا طول(أجزاء) != ٣:
    ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح: " + نص_الإصدار + " — الصيغة رئيسي.فرعي.إصلاحي"}
  لكل جزء في أجزاء:
    إذا كلها_أرقام(جزء) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح: " + نص_الإصدار + " — الصيغة رئيسي.فرعي.إصلاحي"}
  رئيسي = عدد(أجزاء[٠])
  فرعي = عدد(أجزاء[١])
  إصلاحي = عدد(أجزاء[٢])
  قانوني = طبّع_أرقام(نص(رئيسي)) + "." + طبّع_أرقام(نص(فرعي)) + "." + طبّع_أرقام(نص(إصلاحي))
  ارجع {"نجاح": صحيح، "رئيسي": رئيسي، "فرعي": فرعي، "إصلاحي": إصلاحي، "قانوني": قانوني}

دالة قارن_إصدارين(أ، ب):
  ن_أ = حلّل_إصدار(أ)
  إذا ن_أ["نجاح"] == خطأ:
    ارجع ن_أ
  ن_ب = حلّل_إصدار(ب)
  إذا ن_ب["نجاح"] == خطأ:
    ارجع ن_ب
  إذا ن_أ["رئيسي"] != ن_ب["رئيسي"]:
    إذا ن_أ["رئيسي"] > ن_ب["رئيسي"]:
      ارجع {"نجاح": صحيح، "مقارنة": ١}
    ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
  إذا ن_أ["فرعي"] != ن_ب["فرعي"]:
    إذا ن_أ["فرعي"] > ن_ب["فرعي"]:
      ارجع {"نجاح": صحيح، "مقارنة": ١}
    ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
  إذا ن_أ["إصلاحي"] != ن_ب["إصلاحي"]:
    إذا ن_أ["إصلاحي"] > ن_ب["إصلاحي"]:
      ارجع {"نجاح": صحيح، "مقارنة": ١}
    ارجع {"نجاح": صحيح، "مقارنة": ٠ - ١}
  ارجع {"نجاح": صحيح، "مقارنة": ٠}

دالة نسخة_المحرك():
  نص_النسخة = النسخة()
  إذا نصوص.يبدأ_ب(نص_النسخة، "محرك نيفا "):
    باقي = نصوص.من_الفهرس(نص_النسخة، طول("محرك نيفا "))
    ارجع حلّل_إصدار(باقي)
  ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة نسخة المحرك"}

دالة تحقق_نسخة_نيفا(أدنى):
  ن_أدنى = حلّل_إصدار(أدنى)
  إذا ن_أدنى["نجاح"] == خطأ:
    ارجع ن_أدنى
  ن_محرك = نسخة_المحرك()
  إذا ن_محرك["نجاح"] == خطأ:
    ارجع ن_محرك
  مقارنة = قارن_إصدارين(ن_محرك["قانوني"]، ن_أدنى["قانوني"])
  إذا مقارنة["مقارنة"] < ٠:
    ارجع {"نجاح": خطأ، "خطأ": "المحرك أقدم من المطلوب: المطلوب " + ن_أدنى["قانوني"] + " والحالي " + ن_محرك["قانوني"]}
  ارجع {"نجاح": صحيح، "الأدنى": ن_أدنى["قانوني"]، "الحالي": ن_محرك["قانوني"]}
