# أدوات نصية صغيرة لمدير حزم نيفا — بلا اعتماديات
صدر يبدأ_ب، ينتهي_ب، قسم_كلمات، عدد_مسافات_بادئة، من_الفهرس، قبل_الفهرس، اسم_الملف

دالة يبدأ_ب(نص، بادئة):
  إذا طول(بادئة) > طول(نص):
    ارجع خطأ
  فهرس = ٠
  بينما فهرس < طول(بادئة):
    إذا نص[فهرس] != بادئة[فهرس]:
      ارجع خطأ
    فهرس = فهرس + ١
  ارجع صحيح

دالة ينتهي_ب(نص، لاحقة):
  إذا طول(لاحقة) > طول(نص):
    ارجع خطأ
  بداية = طول(نص) - طول(لاحقة)
  فهرس = ٠
  بينما فهرس < طول(لاحقة):
    إذا نص[بداية + فهرس] != لاحقة[فهرس]:
      ارجع خطأ
    فهرس = فهرس + ١
  ارجع صحيح

دالة قسم_كلمات(نص):
  أجزاء = نص.قسم(" ")
  نتيجة = []
  لكل جزء في أجزاء:
    إذا جزء != "":
      نتيجة.أضف(جزء)
  ارجع نتيجة

دالة عدد_مسافات_بادئة(سطر):
  عدد = ٠
  بينما عدد < طول(سطر):
    إذا سطر[عدد] == " ":
      عدد = عدد + ١
    وإلا:
      اكسر
  ارجع عدد

دالة من_الفهرس(نص، فهرس):
  نتيجة = ""
  عداد = فهرس
  بينما عداد < طول(نص):
    نتيجة = نتيجة + نص[عداد]
    عداد = عداد + ١
  ارجع نتيجة

دالة قبل_الفهرس(نص، فهرس):
  نتيجة = ""
  عداد = ٠
  بينما عداد < فهرس:
    نتيجة = نتيجة + نص[عداد]
    عداد = عداد + ١
  ارجع نتيجة

دالة اسم_الملف(مسار):
  أجزاء = مسار.قسم("/")
  ارجع أجزاء[طول(أجزاء) - ١]
