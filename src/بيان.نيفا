# ملف البيان «بيان.حزمة» — تحليل صارم وقراءة
# البيان ملف بيانات نصي UTF-8 يُقرأ ولا يُنفَّذ أبدا (التصميم §3 و§10).
# كل دوال هذه الوحدة ترجع قاموس نتيجة: {"نجاح": صحيح، ...} أو
# {"نجاح": خطأ، "خطأ": "رسالة عربية"} — لأن اللغة بلا أمر رفع خطأ
# مخصص في v1، فالخطأ قيمة ترجع لا استثناء يُرفع.
صدر حلّل_بيان، اقرأ_بيان، حلّل_مواصفة، نفس_الحزمة، صالح_اسم_حزمة، أسماء_الوحدات_الأصلية، ولّد_بيان
استورد نص باسم نصوص
استورد إصدار

دالة أسماء_الوحدات_الأصلية():
  ارجع ["رياضيات"، "عشوائي"، "وقت"، "شبكة"، "عمليات"، "ذاكرة"، "ملفات"، "نظام"، "تواصل"، "تشفير"، "أمن"، "غير_متزامن"، "جهاز"]

دالة خطأ_سطر(رسالة، رقم):
  ارجع {"نجاح": خطأ، "خطأ": رسالة + " (السطر " + إصدار.رقم_لاتيني(رقم) + ")"}

دالة أوجد_نقطتين(سطر):
  فهرس = ٠
  بينما فهرس < طول(سطر):
    إذا سطر[فهرس] == ":":
      ارجع فهرس
    فهرس = فهرس + ١
  ارجع ٠ - ١

# قاعدة الاسم (التصميم §3 — قرار المالك المباشر 2026-11-07 ~07:31
# «امنع الشرطة في أسماء الحزم»): حروف عربية أو لاتينية وأرقام
# و`_` فقط؛ والشرطة `-` ممنوعة (فهي علامة طرح في المحلل فلا
# تُقرأ جزءا من المعرف)؛ والفاصل هو `_` وحدها.
دالة صالح_اسم_حزمة(اسم):
  إذا طول(اسم) == ٠:
    ارجع خطأ
  إذا اسم[٠] == "-":
    ارجع خطأ
  إذا اسم[طول(اسم) - ١] == "-":
    ارجع خطأ
  ممنوعة = [" "، ":"، "/"، "\\"، "."، "-"، "#"، "@"، "،"، "؟"، "!"، "ـ"، "ً"، "ٌ"، "ٍ"، "َ"، "ُ"، "ِ"، "ّ"، "ْ"، "("، ")"، "["، "]"، "{"، "}"، "|"، "*"، "?"، "<"، ">"، "\""، "'"، "`"، "~"، "$"، "%"، "^"، "&"، "+"، "="، ";"، ","]
  فهرس = ٠
  بينما فهرس < طول(اسم):
    حرف = اسم[فهرس]
    إذا حرف في ممنوعة:
      ارجع خطأ
    فهرس = فهرس + ١
  ارجع صحيح

دالة نفس_الحزمة(اسم_أ، اسم_ب):
  ارجع اسم_أ == اسم_ب

دالة حلّل_مواصفة(مواصفة):
  مواصفة_مطبعة = إصدار.طبّع_أرقام(مواصفة)
  إذا مواصفة_مطبعة == "الأحدث":
    ارجع {"نجاح": صحيح، "نوع": "الأحدث"، "مواصفة": "الأحدث"}
  إذا نصوص.يبدأ_ب(مواصفة_مطبعة، "https://"):
    ارجع {"نجاح": صحيح، "نوع": "مصدر"، "مواصفة": مواصفة}
  إذا نصوص.يبدأ_ب(مواصفة_مطبعة، "http://"):
    ارجع {"نجاح": صحيح، "نوع": "مصدر"، "مواصفة": مواصفة}
  رموز_نطاق = ["~" ، ">" ، "<" ، "="]
  لكل رمز_نطاق في رموز_نطاق:
    إذا نصوص.يبدأ_ب(مواصفة_مطبعة، رمز_نطاق):
      ارجع {"نجاح": خطأ، "خطأ": "مواصفة إصدار غير صالحة: " + مواصفة + " — النطاقات غير مدعومة في v1 (المسموح: إصدار محدد أو الأحدث أو ^)"}
  إذا نصوص.يبدأ_ب(مواصفة_مطبعة، "^"):
    باقي = نصوص.من_الفهرس(مواصفة_مطبعة، ١)
    إذا باقي.يحتوي("-"):
      ارجع {"نجاح": خطأ، "خطأ": "مواصفة إصدار غير صالحة: " + مواصفة + " — النطاق لا يقبل إصدارا تجريبيا"}
    أجزاء = باقي.قسم(".")
    صالح_العدد = خطأ
    إذا طول(أجزاء) == ٢:
      صالح_العدد = صحيح
    إذا طول(أجزاء) == ٣:
      صالح_العدد = صحيح
    إذا صالح_العدد:
      كلها_صالحة = صحيح
      لكل جزء في أجزاء:
        إذا إصدار.كلها_أرقام(جزء) == خطأ:
          كلها_صالحة = خطأ
      إذا كلها_صالحة:
        ارجع {"نجاح": صحيح، "نوع": "نطاق"، "مواصفة": مواصفة_مطبعة}
    ارجع {"نجاح": خطأ، "خطأ": "مواصفة إصدار غير صالحة: " + مواصفة}
  ن = إصدار.حلّل_إصدار(مواصفة)
  إذا ن["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "مواصفة إصدار غير صالحة: " + مواصفة}
  ارجع {"نجاح": صحيح، "نوع": "إصدار"، "مواصفة": ن["قانوني"]}

دالة حلّل_بيان(نص_البيان):
  سطور = نص_البيان.قسم("\n")
  البيان = {"اسم": لاشيء، "إصدار": لاشيء، "وصف": ""، "دخول": "مصدر/رئيسي.نيفا"، "نسخة_نيفا": لاشيء، "اعتماديات": []، "اعتماديات_التطوير": []، "تجاوز": []}
  القسم = ""
  رأى_اعتماديات = خطأ
  رأى_تطوير = خطأ
  رأى_تجاوز = خطأ
  مفاتيح_رأيتها = []
  رقم = ٠
  لكل سطر_خام في سطور:
    رقم = رقم + ١
    سطر = سطر_خام.قص()
    إذا سطر == "":
      تابع
    إذا سطر[٠] == "#":
      تابع
    إذا سطر == "اعتماديات:":
      إذا رأى_اعتماديات:
        ارجع خطأ_سطر("قسم مكرر في البيان: اعتماديات"، رقم)
      رأى_اعتماديات = صحيح
      القسم = "اعتماديات"
      تابع
    إذا سطر == "اعتماديات_التطوير:":
      إذا رأى_تطوير:
        ارجع خطأ_سطر("قسم مكرر في البيان: اعتماديات_التطوير"، رقم)
      رأى_تطوير = صحيح
      القسم = "اعتماديات_التطوير"
      تابع
    إذا سطر == "تجاوز:":
      إذا رأى_تجاوز:
        ارجع خطأ_سطر("قسم مكرر في البيان: تجاوز"، رقم)
      رأى_تجاوز = صحيح
      القسم = "تجاوز"
      تابع
    إذا القسم == "":
      نقطتان = أوجد_نقطتين(سطر)
      إذا نقطتان < ٠:
        ارجع خطأ_سطر("سطر غير صالح في البيان"، رقم)
      مفتاح = نصوص.قبل_الفهرس(سطر، نقطتان).قص()
      قيمة = نصوص.من_الفهرس(سطر، نقطتان + ١).قص()
      مفاتيح_معروفة = ["اسم"، "إصدار"، "وصف"، "دخول"، "نسخة_نيفا"]
      إذا مفتاح في مفاتيح_معروفة == خطأ:
        ارجع خطأ_سطر("مفتاح غير معروف في البيان: " + مفتاح، رقم)
      إذا مفتاح في مفاتيح_رأيتها:
        ارجع خطأ_سطر("مفتاح مكرر في البيان: " + مفتاح، رقم)
      مفاتيح_رأيتها.أضف(مفتاح)
      إذا مفتاح == "اسم":
        إذا قيمة.يحتوي("-"):
          ارجع خطأ_سطر("اسم الحزمة " + قيمة + " فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"، رقم)
        إذا صالح_اسم_حزمة(قيمة) == خطأ:
          ارجع خطأ_سطر("اسم حزمة غير صالح: " + قيمة، رقم)
        إذا قيمة في أسماء_الوحدات_الأصلية():
          ارجع خطأ_سطر(قيمة + " وحدة أصلية — لا يمكن تثبيت حزمة بهذا الاسم"، رقم)
        البيان["اسم"] = قيمة
      وإلا إذا مفتاح == "إصدار":
        ن = إصدار.حلّل_إصدار(قيمة)
        إذا ن["نجاح"] == خطأ:
          ارجع ن
        البيان["إصدار"] = ن["قانوني"]
      وإلا إذا مفتاح == "وصف":
        البيان["وصف"] = قيمة
      وإلا إذا مفتاح == "دخول":
        إذا نصوص.ينتهي_ب(قيمة، ".نيفا") == خطأ:
          ارجع خطأ_سطر("مسار الدخول غير صالح: " + قيمة، رقم)
        إذا قيمة.يحتوي(".."):
          ارجع خطأ_سطر("مسار الدخول غير صالح: " + قيمة، رقم)
        إذا نصوص.يبدأ_ب(قيمة، "/"):
          ارجع خطأ_سطر("مسار الدخول غير صالح: " + قيمة، رقم)
        البيان["دخول"] = قيمة
      وإلا إذا مفتاح == "نسخة_نيفا":
        ن = إصدار.حلّل_إصدار(قيمة)
        إذا ن["نجاح"] == خطأ:
          ارجع ن
        البيان["نسخة_نيفا"] = ن["قانوني"]
    وإلا:
      إذا القسم == "تجاوز":
        كلمات_تجاوز = نصوص.قسم_كلمات(سطر)
        إذا طول(كلمات_تجاوز) != ٢:
          ارجع خطأ_سطر("سطر تجاوز غير صالح في البيان"، رقم)
        اسم_تجاوز = كلمات_تجاوز[٠]
        إصدار_تجاوز = كلمات_تجاوز[١]
        إذا اسم_تجاوز.يحتوي("-"):
          ارجع خطأ_سطر("اسم التجاوز " + اسم_تجاوز + " فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"، رقم)
        إذا صالح_اسم_حزمة(اسم_تجاوز) == خطأ:
          ارجع خطأ_سطر("اسم تجاوز غير صالح: " + اسم_تجاوز، رقم)
        لكل تجاوز_قديم في البيان["تجاوز"]:
          إذا تجاوز_قديم["اسم"] == اسم_تجاوز:
            ارجع خطأ_سطر("تجاوز مكرر في البيان: " + اسم_تجاوز، رقم)
        ن_تجاوز = إصدار.حلّل_إصدار(إصدار_تجاوز)
        إذا ن_تجاوز["نجاح"] == خطأ:
          ارجع ن_تجاوز
        قائمة_تجاوز = البيان["تجاوز"]
        قائمة_تجاوز.أضف({"اسم": اسم_تجاوز، "إصدار": ن_تجاوز["قانوني"]})
        البيان["تجاوز"] = قائمة_تجاوز
        تابع
      كلمات = نصوص.قسم_كلمات(سطر)
      إذا طول(كلمات) != ٢:
        ارجع خطأ_سطر("سطر اعتماد غير صالح في البيان"، رقم)
      اسم_اعتماد = كلمات[٠]
      مواصفة = كلمات[١]
      إذا اسم_اعتماد.يحتوي("-"):
        ارجع خطأ_سطر("اسم الاعتماد " + اسم_اعتماد + " فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"، رقم)
      إذا صالح_اسم_حزمة(اسم_اعتماد) == خطأ:
        ارجع خطأ_سطر("اسم اعتماد غير صالح: " + اسم_اعتماد، رقم)
      قائمة_القسم = البيان[القسم]
      لكل اعتماد في قائمة_القسم:
        إذا اعتماد["اسم"] == اسم_اعتماد:
          ارجع خطأ_سطر("اعتماد مكرر في البيان: " + اسم_اعتماد، رقم)
      مواصفة_محللة = حلّل_مواصفة(مواصفة)
      إذا مواصفة_محللة["نجاح"] == خطأ:
        ارجع مواصفة_محللة
      اعتماد_جديد = {"اسم": اسم_اعتماد، "نوع": مواصفة_محللة["نوع"]، "مواصفة": مواصفة_محللة["مواصفة"]}
      قائمة_القسم.أضف(اعتماد_جديد)
      البيان[القسم] = قائمة_القسم
  إذا البيان["اسم"] == لاشيء:
    ارجع {"نجاح": خطأ، "خطأ": "اسم الحزمة مفقود في البيان"}
  إذا البيان["إصدار"] == لاشيء:
    ارجع {"نجاح": خطأ، "خطأ": "إصدار الحزمة مفقود في البيان"}
  لكل اعتماد في البيان["اعتماديات"]:
    إذا اعتماد["اسم"] == البيان["اسم"]:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة تعتمد على نفسها"}
  لكل اعتماد في البيان["اعتماديات_التطوير"]:
    إذا اعتماد["اسم"] == البيان["اسم"]:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة تعتمد على نفسها"}
  ارجع {"نجاح": صحيح، "بيان": البيان}

دالة اقرأ_بيان(مسار):
  إذا موجود(مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "البيان غير موجود: " + مسار}
  إذا حجم_المسار(مسار) > ٥٢٤٢٨٨٠:
    ارجع {"نجاح": خطأ، "خطأ": "البيان أكبر من 5 ميبيبايت: " + مسار}
  حاول:
    نص_البيان = اقرأ_ملف(مسار)
    ارجع حلّل_بيان(نص_البيان)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة البيان: " + مسار}

# توليد نص بيان قانوني من قاموس محلل — الصيغة القانونية للكتابة
# (يستعملها `جديد` لبناء البيان من الصفر). المفاتيح بترتيب ثابت،
# والأقسام الفارغة لا تُكتب، والأرقام لاتينية كما في القاموس.
# والنص المولَّد يعيد التحليل إلى القاموس نفسه (تختبره الوحدة).
# محليات هذه الدالة ببادئة "ب_" — التفاف حول تسرب محليات المفسر.
دالة ولّد_بيان(ب_بيان):
  ب_نص = "اسم: " + ب_بيان["اسم"] + "\n"
  ب_نص = ب_نص + "إصدار: " + ب_بيان["إصدار"] + "\n"
  ب_نص = ب_نص + "وصف: " + ب_بيان["وصف"] + "\n"
  ب_نص = ب_نص + "دخول: " + ب_بيان["دخول"] + "\n"
  إذا ب_بيان["نسخة_نيفا"] != لاشيء:
    ب_نص = ب_نص + "نسخة_نيفا: " + ب_بيان["نسخة_نيفا"] + "\n"
  إذا طول(ب_بيان["اعتماديات"]) > ٠:
    ب_نص = ب_نص + "اعتماديات:\n"
    لكل ب_اعتماد في ب_بيان["اعتماديات"]:
      ب_نص = ب_نص + "  " + ب_اعتماد["اسم"] + " " + ب_اعتماد["مواصفة"] + "\n"
  إذا طول(ب_بيان["اعتماديات_التطوير"]) > ٠:
    ب_نص = ب_نص + "اعتماديات_التطوير:\n"
    لكل ب_اعتماد_تطوير في ب_بيان["اعتماديات_التطوير"]:
      ب_نص = ب_نص + "  " + ب_اعتماد_تطوير["اسم"] + " " + ب_اعتماد_تطوير["مواصفة"] + "\n"
  إذا طول(ب_بيان["تجاوز"]) > ٠:
    ب_نص = ب_نص + "تجاوز:\n"
    لكل ب_تجاوز في ب_بيان["تجاوز"]:
      ب_نص = ب_نص + "  " + ب_تجاوز["اسم"] + " " + ب_تجاوز["إصدار"] + "\n"
  ارجع {"نجاح": صحيح، "نص": ب_نص}
