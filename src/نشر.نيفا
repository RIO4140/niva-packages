# معرف عميل OAuth لنيفا على جيت هاب — علني وليس سرا
# (يُشحن في الكود)؛ ولا يُستعمل client_secret أبدا.
دالة معرف_العميل():
  ارجع "Ov23li5eP6OjsCudgfnM"

# مستودع الفهرس المركزي (مالكه المالك).
دالة مستودع_الفهرس():
  ارجع "RIO4140/niva-index"

# قيمة خيار من قاموس الخيارات، أو لاشيء إن غاب المفتاح.
دالة خيار(خي_خيارات، خي_مفتاح):
  إذا خي_مفتاح في خي_خيارات:
    ارجع خي_خيارات[خي_مفتاح]
  ارجع لاشيء

# قواعد العناوين: "قاعدة" في الخيارات تقلب كل المضيفات
# إلى خادم محاكٍ واحد (للاختبار)؛ وبلاها العناوين الحقيقية.
دالة قاعدة_الجهاز(قع_خيارات):
  قع_قاعدة = خيار(قع_خيارات، "قاعدة")
  إذا قع_قاعدة == لاشيء:
    ارجع "https://github.com"
  ارجع قع_قاعدة

دالة قاعدة_الواجهة(قع_خيارات):
  قع_قاعدة = خيار(قع_خيارات، "قاعدة")
  إذا قع_قاعدة == لاشيء:
    ارجع "https://api.github.com"
  ارجع قع_قاعدة

دالة قاعدة_الخام(قع_خيارات):
  قع_قاعدة = خيار(قع_خيارات، "قاعدة")
  إذا قع_قاعدة == لاشيء:
    ارجع "https://raw.githubusercontent.com"
  ارجع قع_قاعدة

# فهرس أول ظهور لجزء في نص بدءا من موضع، أو -١ إن غاب.
دالة ابحث_في(جح_نص، جح_جزء، جح_من):
  إذا طول(جح_جزء) == ٠:
    ارجع جح_من
  إذا جح_من < ٠:
    ارجع ٠ - ١
  جح_فهرس = جح_من
  جح_حد = طول(جح_نص) - طول(جح_جزء)
  بينما جح_فهرس <= جح_حد:
    جح_مطابق = صحيح
    جح_ج = ٠
    بينما جح_ج < طول(جح_جزء):
      إذا جح_نص[جح_فهرس + جح_ج] != جح_جزء[جح_ج]:
        جح_مطابق = خطأ
        اكسر
      جح_ج = جح_ج + ١
    إذا جح_مطابق:
      ارجع جح_فهرس
    جح_فهرس = جح_فهرس + ١
  ارجع ٠ - ١

# استخراج قيمة نصية من رد JSON: `"مفتاح": "قيمة"` بدءا
# من موضع؛ والهروب الشائع (\" و\\ و\/ و\n) يُفك.
دالة استخرج_نص_بعد(خب_جسون، خب_مفتاح، خب_من):
  إذا خب_من < ٠:
    ارجع {"نجاح": خطأ، "خطأ": "الحقل مفقود في الرد: " + خب_مفتاح}
  خب_نمط = "\"" + خب_مفتاح + "\""
  خب_موضع = ابحث_في(خب_جسون، خب_نمط، خب_من)
  إذا خب_موضع < ٠:
    ارجع {"نجاح": خطأ، "خطأ": "الحقل مفقود في الرد: " + خب_مفتاح}
  خب_فهرس = خب_موضع + طول(خب_نمط)
  بينما خب_فهرس < طول(خب_جسون):
    إذا خب_جسون[خب_فهرس] == " ":
      خب_فهرس = خب_فهرس + ١
    وإلا إذا خب_جسون[خب_فهرس] == ":":
      خب_فهرس = خب_فهرس + ١
      اكسر
    وإلا:
      ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (الحقل " + خب_مفتاح + ")"}
  بينما خب_فهرس < طول(خب_جسون):
    إذا خب_جسون[خب_فهرس] == " ":
      خب_فهرس = خب_فهرس + ١
    وإلا:
      اكسر
  إذا خب_فهرس >= طول(خب_جسون):
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (الحقل " + خب_مفتاح + ")"}
  إذا خب_جسون[خب_فهرس] != "\"":
    ارجع {"نجاح": خطأ، "خطأ": "الحقل " + خب_مفتاح + " ليس نصا في الرد"}
  خب_فهرس = خب_فهرس + ١
  خب_قيمة = ""
  بينما خب_فهرس < طول(خب_جسون):
    خب_حرف = خب_جسون[خب_فهرس]
    إذا خب_حرف == "\"":
      ارجع {"نجاح": صحيح، "قيمة": خب_قيمة}
    إذا خب_حرف == "\\":
      خب_فهرس = خب_فهرس + ١
      إذا خب_فهرس >= طول(خب_جسون):
        ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (هروب مقطوع)"}
      خب_مهرب = خب_جسون[خب_فهرس]
      إذا خب_مهرب == "n":
        خب_قيمة = خب_قيمة + "\n"
      وإلا إذا خب_مهرب == "t":
        خب_قيمة = خب_قيمة + "\t"
      وإلا إذا خب_مهرب == "r":
        خب_قيمة = خب_قيمة + "\r"
      وإلا إذا خب_مهرب == "\"":
        خب_قيمة = خب_قيمة + "\""
      وإلا إذا خب_مهرب == "\\":
        خب_قيمة = خب_قيمة + "\\"
      وإلا إذا خب_مهرب == "/":
        خب_قيمة = خب_قيمة + "/"
      وإلا:
        ارجع {"نجاح": خطأ، "خطأ": "حرف هروب غير مدعوم في الرد"}
      خب_فهرس = خب_فهرس + ١
      تابع
    خب_قيمة = خب_قيمة + خب_حرف
    خب_فهرس = خب_فهرس + ١
  ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (نص غير مغلق)"}

# استخراج قيمة نصية من رد JSON من البداية.
دالة استخرج_نص(خن_جسون، خن_مفتاح):
  ارجع استخرج_نص_بعد(خن_جسون، خن_مفتاح، ٠)

# استخراج قيمة عددية من رد JSON: `"مفتاح": 123`.
دالة استخرج_عدد(خد_جسون، خد_مفتاح):
  خد_نمط = "\"" + خد_مفتاح + "\""
  خد_موضع = ابحث_في(خد_جسون، خد_نمط، ٠)
  إذا خد_موضع < ٠:
    ارجع {"نجاح": خطأ، "خطأ": "الحقل مفقود في الرد: " + خد_مفتاح}
  خد_فهرس = خد_موضع + طول(خد_نمط)
  بينما خد_فهرس < طول(خد_جسون):
    إذا خد_جسون[خد_فهرس] == " ":
      خد_فهرس = خد_فهرس + ١
    وإلا إذا خد_جسون[خد_فهرس] == ":":
      خد_فهرس = خد_فهرس + ١
      اكسر
    وإلا:
      ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (الحقل " + خد_مفتاح + ")"}
  بينما خد_فهرس < طول(خد_جسون):
    إذا خد_جسون[خد_فهرس] == " ":
      خد_فهرس = خد_فهرس + ١
    وإلا:
      اكسر
  خد_أرقام = ""
  بينما خد_فهرس < طول(خد_جسون):
    خد_حرف = خد_جسون[خد_فهرس]
    إذا "0123456789".يحتوي(خد_حرف):
      خد_أرقام = خد_أرقام + خد_حرف
      خد_فهرس = خد_فهرس + ١
    وإلا:
      اكسر
  إذا طول(خد_أرقام) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "الحقل " + خد_مفتاح + " ليس عددا في الرد"}
  ارجع {"نجاح": صحيح، "قيمة": عدد(خد_أرقام)}

# هروب نص لبناء جسم JSON: " و\ والسطر الجديد.
دالة هرّب_جسون(هر_نص):
  هر_نتيجة = ""
  هر_فهرس = ٠
  بينما هر_فهرس < طول(هر_نص):
    هر_حرف = هر_نص[هر_فهرس]
    إذا هر_حرف == "\"":
      هر_نتيجة = هر_نتيجة + "\\\""
    وإلا إذا هر_حرف == "\\":
      هر_نتيجة = هر_نتيجة + "\\\\"
    وإلا إذا هر_حرف == "\n":
      هر_نتيجة = هر_نتيجة + "\\n"
    وإلا إذا هر_حرف == "\t":
      هر_نتيجة = هر_نتيجة + "\\t"
    وإلا إذا هر_حرف == "\r":
      هر_نتيجة = هر_نتيجة + "\\r"
    وإلا:
      هر_نتيجة = هر_نتيجة + هر_حرف
    هر_فهرس = هر_فهرس + ١
  ارجع هر_نتيجة

# عدد برقمين بأرقام لاتينية (05 لا 5).
دالة بطّن_رقمين(بط_عدد):
  إذا بط_عدد < ١٠:
    ارجع "0" + إصدار.رقم_لاتيني(بط_عدد)
  ارجع إصدار.رقم_لاتيني(بط_عدد)

# الطابع الزمني الحالي بتوقيت UTC بصيغة الفهرس
# `YYYY-MM-DDTHH:MM:SSZ` (الفكرة 4).
دالة طابع_الآن():
  طا_تاريخ = وقت.التاريخ_العالمي()
  ارجع إصدار.رقم_لاتيني(طا_تاريخ["سنة"]) + "-" + بطّن_رقمين(طا_تاريخ["شهر"]) + "-" + بطّن_رقمين(طا_تاريخ["يوم"]) + "T" + بطّن_رقمين(طا_تاريخ["ساعة"]) + ":" + بطّن_رقمين(طا_تاريخ["دقيقة"]) + ":" + بطّن_رقمين(طا_تاريخ["ثانية"]) + "Z"

# POST مصدّق إلى واجهة جيت هاب — عبر شبكة.أرسل بقناة
# الترويسات (اجتماع 30): Authorization وAccept.
# والفشل أيّا كان سببه يرجع رسالة السياق المعطاة.
دالة أرسل_مصدّق(أر_مسار، أر_جسم، أر_رمز، أر_خيارات، أر_رسالة):
  أر_ترويسات = {"Authorization": "Bearer " + أر_رمز، "Accept": "application/vnd.github+json"}
  حاول:
    أر_رد = شبكة.أرسل(قاعدة_الواجهة(أر_خيارات) + أر_مسار، أر_جسم، "application/json"، أر_ترويسات)
    ارجع {"نجاح": صحيح، "رد": أر_رد}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": أر_رسالة}

# GET عام (بلا اعتماد — للمستودعات العامة) مع رسالة
# سياق عند الفشل.
دالة اجلب_أو_خطأ(جل_رابط، جل_رسالة):
  حاول:
    جل_رد = شبكة.اجلب(جل_رابط)
    ارجع {"نجاح": صحيح، "رد": جل_رد}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": جل_رسالة}

# تسجيل الدخول — تدفق الجهاز (خطة الخطوة الخامسة §4.1):
# POST رمز الجهاز، ثم طباعة user_code والرابط، ثم
# الاستطلاع كل interval حتى الرمز أو الرفض أو المهلة.
# والرمز يرجع في الذاكرة فقط — لا يُطبع أبدا.
دالة سجّل_دخول(دخ_خيارات):
  دخ_قاعدة = قاعدة_الجهاز(دخ_خيارات)
  دخ_سيناريو = خيار(دخ_خيارات، "سيناريو")
  دخ_عنوان_رمز = دخ_قاعدة + "/login/device/code"
  إذا دخ_سيناريو != لاشيء:
    إذا خيار(دخ_خيارات، "قاعدة") != لاشيء:
      دخ_عنوان_رمز = دخ_عنوان_رمز + "?سيناريو=" + دخ_سيناريو
  دخ_عنوان_دخول = دخ_قاعدة + "/login/oauth/access_token"
  دخ_جسم = "client_id=" + معرف_العميل() + "&scope=public_repo"
  حاول:
    دخ_رد = شبكة.أرسل(دخ_عنوان_رمز، دخ_جسم، "application/x-www-form-urlencoded")
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر الاتصال بجيت هاب — تأكد من الاتصال بالإنترنت ومن السماح بالشبكة"}
  دخ_جهاز = استخرج_نص(دخ_رد، "device_code")
  إذا دخ_جهاز["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (تدفق الجهاز بلا رمز)"}
  دخ_كود = استخرج_نص(دخ_رد، "user_code")
  إذا دخ_كود["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (تدفق الجهاز بلا رمز مستخدم)"}
  دخ_رابط = استخرج_نص(دخ_رد، "verification_uri")
  إذا دخ_رابط["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (تدفق الجهاز بلا رابط)"}
  دخ_انتهاء = استخرج_عدد(دخ_رد، "expires_in")
  إذا دخ_انتهاء["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (تدفق الجهاز بلا مهلة)"}
  دخ_فاصل_ن = استخرج_عدد(دخ_رد، "interval")
  إذا دخ_فاصل_ن["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (تدفق الجهاز بلا فاصل)"}
  اطبع "رمز التفويض: " + دخ_كود["قيمة"]
  اطبع "افتح هذا الرابط في المتصفح وفوّض مرة واحدة: " + دخ_رابط["قيمة"]
  دخ_بداية = وقت.الآن()
  دخ_فاصل = دخ_فاصل_ن["قيمة"]
  دخ_جسم_استطلاع = "client_id=" + معرف_العميل() + "&device_code=" + دخ_جهاز["قيمة"] + "&grant_type=urn:ietf:params:oauth:grant-type:device_code"
  بينما ١ == ١:
    وقت.نوم(دخ_فاصل)
    إذا وقت.الآن() - دخ_بداية > دخ_انتهاء["قيمة"]:
      ارجع {"نجاح": خطأ، "خطأ": "انتهت مهلة التفويض — أعد حزم انشر من جديد"}
    حاول:
      دخ_رد_استطلاع = شبكة.أرسل(دخ_عنوان_دخول، دخ_جسم_استطلاع، "application/x-www-form-urlencoded")
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر الاتصال بجيت هاب — تأكد من الاتصال بالإنترنت ومن السماح بالشبكة"}
    دخ_رمز = استخرج_نص(دخ_رد_استطلاع، "access_token")
    إذا دخ_رمز["نجاح"]:
      ارجع {"نجاح": صحيح، "رمز": دخ_رمز["قيمة"]}
    دخ_خطأ = استخرج_نص(دخ_رد_استطلاع، "error")
    إذا دخ_خطأ["نجاح"] == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (بلا رمز وبلا خطأ)"}
    إذا دخ_خطأ["قيمة"] == "authorization_pending":
      تابع
    إذا دخ_خطأ["قيمة"] == "slow_down":
      دخ_فاصل = دخ_فاصل + ٥
      تابع
    إذا دخ_خطأ["قيمة"] == "expired_token":
      ارجع {"نجاح": خطأ، "خطأ": "انتهت صلاحية رمز الجهاز — أعد حزم انشر من جديد"}
    إذا دخ_خطأ["قيمة"] == "access_denied":
      ارجع {"نجاح": خطأ، "خطأ": "ألغى الناشر التفويض"}
    ارجع {"نجاح": خطأ، "خطأ": "رفض التفويض: " + دخ_خطأ["قيمة"]}

# فحوص صيغة مدخلات الأمر — قبل أي شبكة (قاعدة 5: لا
# مخرج صامت أبدا، ولا طلب شبكة بعد مدخل مكسور).
دالة تحقق_مستودع(مست_مستودع):
  مست_أجزاء = مست_مستودع.قسم("/")
  إذا طول(مست_أجزاء) != ٢:
    ارجع {"نجاح": خطأ، "خطأ": "مستودع المصدر غير صالح — اكتبه مالك/مستودع"}
  إذا طول(مست_أجزاء[٠]) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "مستودع المصدر غير صالح — اكتبه مالك/مستودع"}
  إذا طول(مست_أجزاء[١]) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "مستودع المصدر غير صالح — اكتبه مالك/مستودع"}
  إذا مست_مستودع.يحتوي(" "):
    ارجع {"نجاح": خطأ، "خطأ": "مستودع المصدر غير صالح — اكتبه مالك/مستودع"}
  ارجع {"نجاح": صحيح}

دالة تحقق_وسم(وسم_وسم):
  إذا طول(وسم_وسم) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "الوسم غير صالح — اكتب وسم الإصدار كما في جيت هاب (مثال v1.0.0)"}
  إذا وسم_وسم.يحتوي(" "):
    ارجع {"نجاح": خطأ، "خطأ": "الوسم غير صالح — اكتب وسم الإصدار كما في جيت هاب (مثال v1.0.0)"}
  ارجع {"نجاح": صحيح}

دالة تحقق_ناشر(ناش_ناشر):
  إذا طول(ناش_ناشر) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "اسم الناشر غير صالح — اكتب دخول جيت هاب"}
  إذا ناش_ناشر.يحتوي(" "):
    ارجع {"نجاح": خطأ، "خطأ": "اسم الناشر غير صالح — اكتب دخول جيت هاب"}
  ارجع {"نجاح": صحيح}

# هدف الكتابة: فرع مباشر إن كان الناشر مالك الفهرس،
# وإلا تفرعه (أو التفرع القائم إن وُجد).
دالة حدّد_هدف(هد_ناشر، هد_رمز، هد_خيارات):
  إذا هد_ناشر == "RIO4140":
    ارجع {"نجاح": صحيح، "هدف": مستودع_الفهرس()، "مباشر": صحيح}
  هد_فحص = اجلب_أو_خطأ(قاعدة_الواجهة(هد_خيارات) + "/repos/" + هد_ناشر + "/niva-index"، "تعذّر فحص التفرع")
  إذا هد_فحص["نجاح"]:
    ارجع {"نجاح": صحيح، "هدف": هد_ناشر + "/niva-index"، "مباشر": خطأ}
  هد_تفرع = أرسل_مصدّق("/repos/" + مستودع_الفهرس() + "/forks"، "{}"، هد_رمز، هد_خيارات، "تعذّر إنشاء تفرع مستودع الفهرس — إن كان التفرع موجودا أصلا فحدّثه من جيت هاب وحاول مجددا")
  إذا هد_تفرع["نجاح"] == خطأ:
    ارجع هد_تفرع
  ارجع {"نجاح": صحيح، "هدف": هد_ناشر + "/niva-index"، "مباشر": خطأ}

# مرجع أساس الفهرس + نصه الحالي من مستودع الهدف.
دالة اقرأ_فهرس_الهدف(فخ_هدف، فخ_خيارات):
  فخ_مرجع = اجلب_أو_خطأ(قاعدة_الواجهة(فخ_خيارات) + "/repos/" + فخ_هدف + "/git/ref/heads/main"، "تعذّر قراءة مرجع أساس الفهرس")
  إذا فخ_مرجع["نجاح"] == خطأ:
    ارجع فخ_مرجع
  فخ_موضع_كائن = ابحث_في(فخ_مرجع["رد"]، "\"object\""، ٠)
  إذا فخ_موضع_كائن < ٠:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (مرجع الأساس بلا بصمة)"}
  فخ_أساس = استخرج_نص_بعد(فخ_مرجع["رد"]، "sha"، فخ_موضع_كائن)
  إذا فخ_أساس["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (مرجع الأساس بلا بصمة)"}
  إذا سجل.صالح_بصمة_التزام(فخ_أساس["قيمة"]) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (بصمة أساس غير صالحة)"}
  فخ_خام = اجلب_أو_خطأ(قاعدة_الخام(فخ_خيارات) + "/" + فخ_هدف + "/main/فهرس.حزمة"، "تعذّر قراءة فهرس.حزمة الحالي")
  إذا فخ_خام["نجاح"] == خطأ:
    ارجع فخ_خام
  ارجع {"نجاح": صحيح، "أساس": فخ_أساس["قيمة"]، "نص": فخ_خام["رد"]}

# فهرس مركزي الحالي (القراءة العامة قبل الدخول).
دالة اقرأ_الفهرس_المركزي(مر_خيارات):
  مر_خام = اجلب_أو_خطأ(قاعدة_الخام(مر_خيارات) + "/" + مستودع_الفهرس() + "/main/فهرس.حزمة"، "تعذّر قراءة الفهرس المركزي — تأكد من الاتصال بالإنترنت ومن السماح بالشبكة")
  إذا مر_خام["نجاح"] == خطأ:
    ارجع مر_خام
  مر_تحليل = سجل.حلّل_فهرس(مر_خام["رد"])
  إذا مر_تحليل["نجاح"] == خطأ:
    ارجع مر_تحليل
  ارجع {"نجاح": صحيح، "نص": مر_خام["رد"]، "إدخالات": مر_تحليل["إدخالات"]، "سحوبات": مر_تحليل["سحوبات"]}

# هذا الإصدار منشور أصلا؟ — الفهرس يرفض التكرار (قاعدة 5).
دالة تحقق_عدم_تكرار(تكر_إدخالات، تكر_اسم، تكر_إصدار):
  لكل تكر_إدخال في تكر_إدخالات:
    إذا تكر_إدخال["اسم"] == تكر_اسم:
      إذا تكر_إدخال["إصدار"] == تكر_إصدار:
        ارجع {"نجاح": خطأ، "خطأ": "الإصدار " + تكر_إصدار + " للحزمة " + تكر_اسم + " منشور أصلا في الفهرس — غيّر الإصدار"}
  ارجع {"نجاح": صحيح}

# هذا الإصدار موجود وغير مسحوب؟ — لسحب مركزي.
دالة تحقق_سحب_ممكن(تح_إدخالات، تح_سحوبات، تح_اسم، تح_إصدار):
  تح_موجود = خطأ
  لكل تح_إدخال في تح_إدخالات:
    إذا تح_إدخال["اسم"] == تح_اسم:
      إذا تح_إدخال["إصدار"] == تح_إصدار:
        تح_موجود = صحيح
  إذا تح_موجود == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار " + تح_إصدار + " للحزمة " + تح_اسم + " في الفهرس — لا يمكن سحبه"}
  إذا سجل.مسحوب(تح_اسم، تح_إصدار، تح_سحوبات):
    ارجع {"نجاح": خطأ، "خطأ": "الإصدار " + تح_إصدار + " للحزمة " + تح_اسم + " مسحوب أصلا"}
  ارجع {"نجاح": صحيح}

# السلسلة الثماني (خطة الخطوة الخامسة §4.2 خطوات 4–8):
# كائن ثم شجرة ثم التزام ثم مرجع ثم طلب دمج.
دالة نفّذ_سلسلة(سل_رمز، سل_هدف، سل_أساس، سل_نص_جديد، سل_فرع، سل_عنوان، سل_جسم، سل_خيارات):
  سل_مالك_هدف = سل_هدف.قسم("/")[٠]
  سل_كائن = أرسل_مصدّق("/repos/" + سل_هدف + "/git/blobs"، "{\"content\": \"" + هرّب_جسون(سل_نص_جديد) + "\", \"encoding\": \"utf-8\"}"، سل_رمز، سل_خيارات، "تعذّر إنشاء كائن الفهرس في جيت هاب")
  إذا سل_كائن["نجاح"] == خطأ:
    ارجع سل_كائن
  سل_بصمة_كائن = استخرج_نص(سل_كائن["رد"]، "sha")
  إذا سل_بصمة_كائن["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (الكائن بلا بصمة)"}
  سل_شجرة_جسم = "{\"base_tree\": \"" + سل_أساس + "\", \"tree\": [{\"path\": \"فهرس.حزمة\", \"mode\": \"100644\", \"type\": \"blob\", \"sha\": \"" + سل_بصمة_كائن["قيمة"] + "\"}]}"
  سل_شجرة = أرسل_مصدّق("/repos/" + سل_هدف + "/git/trees"، سل_شجرة_جسم، سل_رمز، سل_خيارات، "تعذّر إنشاء شجرة الفهرس في جيت هاب")
  إذا سل_شجرة["نجاح"] == خطأ:
    ارجع سل_شجرة
  سل_بصمة_شجرة = استخرج_نص(سل_شجرة["رد"]، "sha")
  إذا سل_بصمة_شجرة["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (الشجرة بلا بصمة)"}
  سل_التزام_جسم = "{\"message\": \"" + هرّب_جسون(سل_عنوان) + "\", \"tree\": \"" + سل_بصمة_شجرة["قيمة"] + "\", \"parents\": [\"" + سل_أساس + "\"]}"
  سل_التزام = أرسل_مصدّق("/repos/" + سل_هدف + "/git/commits"، سل_التزام_جسم، سل_رمز، سل_خيارات، "تعذّر إنشاء التزام الفهرس في جيت هاب")
  إذا سل_التزام["نجاح"] == خطأ:
    ارجع سل_التزام
  سل_بصمة_التزام = استخرج_نص(سل_التزام["رد"]، "sha")
  إذا سل_بصمة_التزام["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (الالتزام بلا بصمة)"}
  سل_مرجع_جسم = "{\"ref\": \"refs/heads/" + سل_فرع + "\", \"sha\": \"" + سل_بصمة_التزام["قيمة"] + "\"}"
  سل_مرجع = أرسل_مصدّق("/repos/" + سل_هدف + "/git/refs"، سل_مرجع_جسم، سل_رمز، سل_خيارات، "تعذّر إنشاء فرع النشر في جيت هاب — إن كان الفرع موجودا أصلا فاحذفه وحاول مجددا")
  إذا سل_مرجع["نجاح"] == خطأ:
    ارجع سل_مرجع
  سل_طلب_جسم = "{\"title\": \"" + هرّب_جسون(سل_عنوان) + "\", \"head\": \"" + سل_مالك_هدف + ":" + سل_فرع + "\", \"base\": \"main\", \"body\": \"" + هرّب_جسون(سل_جسم) + "\"}"
  سل_طلب = أرسل_مصدّق("/repos/" + مستودع_الفهرس() + "/pulls"، سل_طلب_جسم، سل_رمز، سل_خيارات، "تعذّر إنشاء طلب الدمج في جيت هاب")
  إذا سل_طلب["نجاح"] == خطأ:
    ارجع سل_طلب
  سل_رقم = استخرج_عدد(سل_طلب["رد"]، "number")
  إذا سل_رقم["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (طلب الدمج بلا رقم)"}
  ارجع {"نجاح": صحيح، "طلب": سل_رقم["قيمة"]}

# `حزم انشر` — نشر مشروع محلي في الفهرس المركزي
# (خطة الخطوة الخامسة §4.2): فحوص ما قبل النشر أولا،
# ثم الدخول، ثم السلسلة. والرمز لا يظهر في أي نص هنا.
دالة انشر(نش_أساس، نش_مستودع، نش_وسم، نش_ناشر، نش_خيارات):
  نش_مشروع = مشروع.اقرأ_مشروع(نش_أساس)
  إذا نش_مشروع["نجاح"] == خطأ:
    ارجع نش_مشروع
  نش_بيان = نش_مشروع["بيان"]
  إذا نش_بيان["اسم"].يحتوي("-"):
    ارجع {"نجاح": خطأ، "خطأ": "اسم الحزمة " + نش_بيان["اسم"] + " فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"}
  نش_تحقق_مستودع = تحقق_مستودع(نش_مستودع)
  إذا نش_تحقق_مستودع["نجاح"] == خطأ:
    ارجع نش_تحقق_مستودع
  نش_تحقق_وسم = تحقق_وسم(نش_وسم)
  إذا نش_تحقق_وسم["نجاح"] == خطأ:
    ارجع نش_تحقق_وسم
  نش_تحقق_ناشر = تحقق_ناشر(نش_ناشر)
  إذا نش_تحقق_ناشر["نجاح"] == خطأ:
    ارجع نش_تحقق_ناشر
  نش_مركزي = اقرأ_الفهرس_المركزي(نش_خيارات)
  إذا نش_مركزي["نجاح"] == خطأ:
    ارجع نش_مركزي
  نش_تكرار_مركزي = تحقق_عدم_تكرار(نش_مركزي["إدخالات"]، نش_بيان["اسم"]، نش_بيان["إصدار"])
  إذا نش_تكرار_مركزي["نجاح"] == خطأ:
    ارجع نش_تكرار_مركزي
  نش_بيان_وسم = اجلب_أو_خطأ(قاعدة_الخام(نش_خيارات) + "/" + نش_مستودع + "/" + نش_وسم + "/بيان.حزمة"، "تعذّر قراءة بيان.حزمة عند الوسم " + نش_وسم + " في مستودع " + نش_مستودع + " — تأكد أن الوسم موجود وأن البيان منشور فيه")
  إذا نش_بيان_وسم["نجاح"] == خطأ:
    ارجع نش_بيان_وسم
  نش_بيان_وسم_ن = بيان.حلّل_بيان(نش_بيان_وسم["رد"])
  إذا نش_بيان_وسم_ن["نجاح"] == خطأ:
    ارجع نش_بيان_وسم_ن
  نش_بيان_وسم_ق = نش_بيان_وسم_ن["بيان"]
  إذا نش_بيان_وسم_ق["اسم"] != نش_بيان["اسم"]:
    ارجع {"نجاح": خطأ، "خطأ": "بيان.حزمة عند الوسم " + نش_وسم + " لحزمة " + نش_بيان_وسم_ق["اسم"] + " لا يطابق المشروع المحلي " + نش_بيان["اسم"]}
  إذا نش_بيان_وسم_ق["إصدار"] != نش_بيان["إصدار"]:
    ارجع {"نجاح": خطأ، "خطأ": "بيان.حزمة عند الوسم " + نش_وسم + " بإصدار " + نش_بيان_وسم_ق["إصدار"] + " لا يطابق المشروع المحلي " + نش_بيان["إصدار"]}
  نش_بصمة = تشفير.جزّئ(نش_بيان_وسم["رد"])
  نش_التزام = اجلب_أو_خطأ(قاعدة_الواجهة(نش_خيارات) + "/repos/" + نش_مستودع + "/commits/" + نش_وسم، "تعذّر قراءة التزام الوسم " + نش_وسم + " في مستودع " + نش_مستودع)
  إذا نش_التزام["نجاح"] == خطأ:
    ارجع نش_التزام
  نش_بصمة_التزام = استخرج_نص(نش_التزام["رد"]، "sha")
  إذا نش_بصمة_التزام["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (التزام الوسم بلا بصمة)"}
  إذا سجل.صالح_بصمة_التزام(نش_بصمة_التزام["قيمة"]) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "رد غير صالح من جيت هاب (بصمة التزام غير صالحة)"}
  نش_دخول = سجّل_دخول(نش_خيارات)
  إذا نش_دخول["نجاح"] == خطأ:
    ارجع نش_دخول
  نش_هدف_ن = حدّد_هدف(نش_ناشر، نش_دخول["رمز"]، نش_خيارات)
  إذا نش_هدف_ن["نجاح"] == خطأ:
    ارجع نش_هدف_ن
  نش_فهرس_ن = اقرأ_فهرس_الهدف(نش_هدف_ن["هدف"]، نش_خيارات)
  إذا نش_فهرس_ن["نجاح"] == خطأ:
    ارجع نش_فهرس_ن
  نش_تحليل_هدف = سجل.حلّل_فهرس(نش_فهرس_ن["نص"])
  إذا نش_تحليل_هدف["نجاح"] == خطأ:
    ارجع نش_تحليل_هدف
  نش_تكرار_هدف = تحقق_عدم_تكرار(نش_تحليل_هدف["إدخالات"]، نش_بيان["اسم"]، نش_بيان["إصدار"])
  إذا نش_تكرار_هدف["نجاح"] == خطأ:
    ارجع نش_تكرار_هدف
  # الحجم مقاس فعليا من مجلد المشروع المحلي عند النشر
  # (مجموع بايتات ملفاته) — والاعتماديات من بيان الوسم
  # نفسه لا المحلي، فهو حقيقة ما يُنشر.
  نش_مسار_حجم = نش_أساس
  إذا نش_مسار_حجم == "":
    نش_مسار_حجم = "."
  نش_حجم = مخزن.احسب_حجم_مجلد(نش_مسار_حجم)
  إذا نش_حجم["نجاح"] == خطأ:
    ارجع نش_حجم
  نش_سطر = سجل.سطر_فهرس({"اسم": نش_بيان["اسم"]، "إصدار": نش_بيان["إصدار"]، "مستودع": "github.com/" + نش_مستودع، "وسم": نش_وسم، "بصمة_التزام": نش_بصمة_التزام["قيمة"]، "ناشر": نش_ناشر، "طابع": طابع_الآن()، "بصمة": نش_بصمة، "حجم": نش_حجم["حجم"]، "اعتماديات": نش_بيان_وسم_ق["اعتماديات"]، "وصف": نش_بيان["وصف"]})
  إذا نش_سطر["نجاح"] == خطأ:
    ارجع نش_سطر
  نش_نص_جديد = نش_فهرس_ن["نص"]
  إذا نش_نص_جديد != "":
    إذا نصوص.ينتهي_ب(نش_نص_جديد، "\n") == خطأ:
      نش_نص_جديد = نش_نص_جديد + "\n"
  نش_نص_جديد = نش_نص_جديد + نش_سطر["سطر"] + "\n"
  نش_فرع = "انشر-" + نش_بيان["اسم"] + "-" + نش_بيان["إصدار"]
  نش_عنوان = "انشر " + نش_بيان["اسم"] + " " + نش_بيان["إصدار"]
  نش_جسم = "نشر حزمة " + نش_بيان["اسم"] + " " + نش_بيان["إصدار"] + " من مستودع github.com/" + نش_مستودع + " عند الوسم " + نش_وسم + ".\nالناشر: " + نش_ناشر + "\nبصمة الالتزام: " + نش_بصمة_التزام["قيمة"] + "\nبصمة البيان: " + نش_بصمة
  نش_سلسلة = نفّذ_سلسلة(نش_دخول["رمز"]، نش_هدف_ن["هدف"]، نش_فهرس_ن["أساس"]، نش_نص_جديد، نش_فرع، نش_عنوان، نش_جسم، نش_خيارات)
  إذا نش_سلسلة["نجاح"] == خطأ:
    ارجع نش_سلسلة
  ارجع {"نجاح": صحيح، "نص": "نُشرت الحزمة " + نش_بيان["اسم"] + " " + نش_بيان["إصدار"] + " — طلب الدمج رقم " + إصدار.رقم_لاتيني(نش_سلسلة["طلب"]) + " في مستودع الفهرس"، "طلب": نش_سلسلة["طلب"]، "فرع": نش_فرع}

# سحب مركزي عبر طلب دمج (خطة الخطوة الخامسة §4.4):
# الفحوص أولا، ثم الدخول، ثم السلسلة. والسطر المنشور
# الأصلي يبقى في الفهرس — لا حذف أبدا.
دالة اسحب_مركزيا(سح_اسم، سح_إصدار، سح_سبب، سح_ناشر، سح_خيارات):
  إذا سح_اسم.يحتوي("-"):
    ارجع {"نجاح": خطأ، "خطأ": "اسم الحزمة " + سح_اسم + " فيه شرطة - — استخدم الشرطة السفلية _ بدلا منها"}
  سح_ن_إصدار = إصدار.حلّل_إصدار(سح_إصدار)
  إذا سح_ن_إصدار["نجاح"] == خطأ:
    ارجع سح_ن_إصدار
  سح_قانوني = سح_ن_إصدار["قانوني"]
  سح_تحقق_ناشر = تحقق_ناشر(سح_ناشر)
  إذا سح_تحقق_ناشر["نجاح"] == خطأ:
    ارجع سح_تحقق_ناشر
  سح_مركزي = اقرأ_الفهرس_المركزي(سح_خيارات)
  إذا سح_مركزي["نجاح"] == خطأ:
    ارجع سح_مركزي
  سح_ممكن_مركزي = تحقق_سحب_ممكن(سح_مركزي["إدخالات"]، سح_مركزي["سحوبات"]، سح_اسم، سح_قانوني)
  إذا سح_ممكن_مركزي["نجاح"] == خطأ:
    ارجع سح_ممكن_مركزي
  سح_دخول = سجّل_دخول(سح_خيارات)
  إذا سح_دخول["نجاح"] == خطأ:
    ارجع سح_دخول
  سح_هدف_ن = حدّد_هدف(سح_ناشر، سح_دخول["رمز"]، سح_خيارات)
  إذا سح_هدف_ن["نجاح"] == خطأ:
    ارجع سح_هدف_ن
  سح_فهرس_ن = اقرأ_فهرس_الهدف(سح_هدف_ن["هدف"]، سح_خيارات)
  إذا سح_فهرس_ن["نجاح"] == خطأ:
    ارجع سح_فهرس_ن
  سح_تحليل_هدف = سجل.حلّل_فهرس(سح_فهرس_ن["نص"])
  إذا سح_تحليل_هدف["نجاح"] == خطأ:
    ارجع سح_تحليل_هدف
  سح_ممكن_هدف = تحقق_سحب_ممكن(سح_تحليل_هدف["إدخالات"]، سح_تحليل_هدف["سحوبات"]، سح_اسم، سح_قانوني)
  إذا سح_ممكن_هدف["نجاح"] == خطأ:
    ارجع سح_ممكن_هدف
  سح_سطر = سجل.سطر_سحب(سح_اسم، سح_قانوني، سح_سبب)
  إذا سح_سطر["نجاح"] == خطأ:
    ارجع سح_سطر
  سح_نص_جديد = سح_فهرس_ن["نص"]
  إذا سح_نص_جديد != "":
    إذا نصوص.ينتهي_ب(سح_نص_جديد، "\n") == خطأ:
      سح_نص_جديد = سح_نص_جديد + "\n"
  سح_نص_جديد = سح_نص_جديد + سح_سطر["سطر"] + "\n"
  سح_فرع = "انشر-" + سح_اسم + "-" + سح_قانوني + "-سحب"
  سح_عنوان = "سحب " + سح_اسم + " " + سح_قانوني
  سح_جسم = "سحب الإصدار " + سح_قانوني + " للحزمة " + سح_اسم + " من الفهرس.\nالناشر: " + سح_ناشر + "\nالسبب: " + سح_سبب
  سح_سلسلة = نفّذ_سلسلة(سح_دخول["رمز"]، سح_هدف_ن["هدف"]، سح_فهرس_ن["أساس"]، سح_نص_جديد، سح_فرع، سح_عنوان، سح_جسم، سح_خيارات)
  إذا سح_سلسلة["نجاح"] == خطأ:
    ارجع سح_سلسلة
  ارجع {"نجاح": صحيح، "نص": "سُحب الإصدار " + سح_قانوني + " للحزمة " + سح_اسم + " — طلب الدمج رقم " + إصدار.رقم_لاتيني(سح_سلسلة["طلب"]) + " في مستودع الفهرس"، "طلب": سح_سلسلة["طلب"]، "فرع": سح_فرع}

# فحص صحة الفهرس (البند 90 — قرار الاجتماع 50
# §64): يقارن كل إدخال في الفهرس بمصدره المنشور —
# وسمه وبصمة التزامه وبيان.حزمة عنده (الاسم والإصدار
# وبصمة SHA-256 لنص البيان). والفهرس يُقرأ عبر
# سجل.اقرأ_الفهرس (مجلد محلي إن حُدد في الخيارات،
# وإلا الفعّال)؛ فالمكرر والسحب بلا إدخال يرفضهما
# حلّل_فهرس نفسه قبل أي جلب. والمسحوب يُفحص أيضا
# (وسمه ما زال منشورا) ويُبلَّغ عنه في النتيجة.
# والحجم لا يُتحقق منه عن بعد أبدا — فهو مقاس محليا
# عند النشر (مجموع بايتات مجلد الحزمة)، ومجموع شجرة
# بعيدة ليس القياس نفسه؛ فلا فحص وهمي له.
# والخيارات: {"قاعدة": قاعدة أو لاشيء، "مجلد_فهرس":
# مجلد أو لاشيء}. والنجاح: {"نجاح": صحيح، "عدد": N،
# "مسحوبات": [...]، "نص": "الفهرس سليم: N إدخالا"
# (+ سطر "مسحوب: اسم إصدار" لكل مسحوب)}؛ والفهرس
# الفارغ: {"نجاح": صحيح، "عدد": ٠، "نص": "لا مدخلات
# للفحص"}؛ والفشل: {"نجاح": خطأ، "خطأ": <كل الأخطاء
# سطرا سطرا>، "أخطاء": [...]}. قراءة فقط — بلا كتابة
# وبلا رمز دخول.
دالة افحص_الفهرس(فح_خيارات):
  فح_مجلد = لاشيء
  إذا "مجلد_فهرس" في فح_خيارات:
    فح_مجلد = فح_خيارات["مجلد_فهرس"]
  فح_فهرس = سجل.اقرأ_الفهرس({"مجلد_فهرس": فح_مجلد، "تنزيل": صحيح})
  إذا فح_فهرس["نجاح"] == خطأ:
    ارجع فح_فهرس
  فح_إدخالات = فح_فهرس["إدخالات"]
  فح_سحوبات = فح_فهرس["سحوبات"]
  إذا طول(فح_إدخالات) == ٠:
    ارجع {"نجاح": صحيح، "عدد": ٠، "مسحوبات": []، "نص": "لا مدخلات للفحص"}
  فح_أخطاء = []
  فح_مسحوبات = []
  لكل فح_إدخال في فح_إدخالات:
    فح_اسم = فح_إدخال["اسم"]
    فح_إصدار = فح_إدخال["إصدار"]
    إذا سجل.مسحوب(فح_اسم، فح_إصدار، فح_سحوبات):
      فح_مسحوبات.أضف(فح_اسم + " " + فح_إصدار)
    فح_مستودع_كامل = فح_إدخال["مستودع"]
    إذا نصوص.يبدأ_ب(فح_مستودع_كامل، "github.com/") == خطأ:
      فح_أخطاء.أضف("مستودع غير صالح في الفهرس للحزمة " + فح_اسم + " " + فح_إصدار + ": " + فح_مستودع_كامل)
      تابع
    فح_مستودع = نصوص.من_الفهرس(فح_مستودع_كامل، طول("github.com/"))
    فح_تحقق_مستودع = تحقق_مستودع(فح_مستودع)
    إذا فح_تحقق_مستودع["نجاح"] == خطأ:
      فح_أخطاء.أضف("مستودع غير صالح في الفهرس للحزمة " + فح_اسم + " " + فح_إصدار + ": " + فح_مستودع_كامل)
      تابع
    فح_وسم = فح_إدخال["وسم"]
    فح_التزام = اجلب_أو_خطأ(قاعدة_الواجهة(فح_خيارات) + "/repos/" + فح_مستودع + "/commits/" + فح_وسم، "تعذّر قراءة التزام الوسم " + فح_وسم + " في مستودع " + فح_مستودع)
    إذا فح_التزام["نجاح"] == خطأ:
      فح_أخطاء.أضف(فح_التزام["خطأ"])
      تابع
    فح_بصمة_التزام = استخرج_نص(فح_التزام["رد"]، "sha")
    إذا فح_بصمة_التزام["نجاح"] == خطأ:
      فح_أخطاء.أضف("رد غير صالح من جيت هاب (التزام الوسم " + فح_وسم + " بلا بصمة) للحزمة " + فح_اسم + " " + فح_إصدار)
      تابع
    إذا فح_بصمة_التزام["قيمة"] != فح_إدخال["بصمة_التزام"]:
      فح_أخطاء.أضف("بصمة الالتزام في الفهرس لا تطابق التزام الوسم " + فح_وسم + " للحزمة " + فح_اسم + " " + فح_إصدار)
      تابع
    فح_بيان_وسم = اجلب_أو_خطأ(قاعدة_الخام(فح_خيارات) + "/" + فح_مستودع + "/" + فح_وسم + "/بيان.حزمة"، "تعذّر قراءة بيان.حزمة عند الوسم " + فح_وسم + " في مستودع " + فح_مستودع)
    إذا فح_بيان_وسم["نجاح"] == خطأ:
      فح_أخطاء.أضف(فح_بيان_وسم["خطأ"])
      تابع
    فح_بيان_وسم_ن = بيان.حلّل_بيان(فح_بيان_وسم["رد"])
    إذا فح_بيان_وسم_ن["نجاح"] == خطأ:
      فح_أخطاء.أضف("بيان.حزمة عند الوسم " + فح_وسم + " غير صالح للحزمة " + فح_اسم + " " + فح_إصدار + ": " + فح_بيان_وسم_ن["خطأ"])
      تابع
    فح_بيان_وسم_ق = فح_بيان_وسم_ن["بيان"]
    إذا فح_بيان_وسم_ق["اسم"] != فح_اسم:
      فح_أخطاء.أضف("بيان.حزمة عند الوسم " + فح_وسم + " لحزمة " + فح_بيان_وسم_ق["اسم"] + " لا يطابق الفهرس " + فح_اسم)
      تابع
    إذا فح_بيان_وسم_ق["إصدار"] != فح_إصدار:
      فح_أخطاء.أضف("بيان.حزمة عند الوسم " + فح_وسم + " بإصدار " + فح_بيان_وسم_ق["إصدار"] + " لا يطابق الفهرس " + فح_إصدار)
      تابع
    فح_بصمة = تشفير.جزّئ(فح_بيان_وسم["رد"])
    إذا فح_بصمة != فح_إدخال["بصمة"]:
      فح_أخطاء.أضف("بصمة البيان في الفهرس لا تطابق بيان.حزمة عند الوسم " + فح_وسم + " للحزمة " + فح_اسم + " " + فح_إصدار)
      تابع
  إذا طول(فح_أخطاء) > ٠:
    فح_نص_أخطاء = ""
    لكل فح_خطأ في فح_أخطاء:
      إذا فح_نص_أخطاء == "":
        فح_نص_أخطاء = فح_خطأ
      وإلا:
        فح_نص_أخطاء = فح_نص_أخطاء + "\n" + فح_خطأ
    ارجع {"نجاح": خطأ، "خطأ": فح_نص_أخطاء، "أخطاء": فح_أخطاء، "عدد": طول(فح_إدخالات)}
  فح_نص = "الفهرس سليم: " + إصدار.رقم_لاتيني(طول(فح_إدخالات)) + " إدخالا"
  لكل فح_مسحوب في فح_مسحوبات:
    فح_نص = فح_نص + "\nمسحوب: " + فح_مسحوب
  ارجع {"نجاح": صحيح، "عدد": طول(فح_إدخالات)، "مسحوبات": فح_مسحوبات، "نص": فح_نص}
