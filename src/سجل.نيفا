دالة عنوان_الفهرس_الافتراضي():
  ارجع "https://raw.githubusercontent.com/RIO4140/niva-index/main/فهرس.حزمة"

# عنوان ملف البصمة الثابت بجانب الفهرس في المستودع
# الرسمي — نصه ست عشري SHA-256 لنص `فهرس.حزمة`.
دالة عنوان_بصمة_الفهرس_الافتراضي():
  ارجع "https://raw.githubusercontent.com/RIO4140/niva-index/main/بصمة.فهرس"

دالة مسار_الفهرس_المحفوظ():
  ارجع "$نيفا/.نيفا/حزم/فهرس/فهرس.حزمة"

دالة مسار_طابع_الفهرس():
  ارجع "$نيفا/.نيفا/حزم/فهرس/طابع.فهرس"

# بصمة النسخة المحفوظة — تُكتب عند كل تنزيل ناجح
# وتُتحقق منها عند كل قراءة للمحفوظ إن وُجدت.
دالة مسار_بصمة_الفهرس_المحفوظة():
  ارجع "$نيفا/.نيفا/حزم/فهرس/بصمة.فهرس"

# النسخة السابقة من الفهرس المحفوظ — يحتفظ بها
# التنزيل قبل الكتابة فوقها، ويمسحها `نظف-القديم`.
دالة مسار_الفهرس_القديم():
  ارجع "$نيفا/.نيفا/حزم/فهرس/فهرس.حزمة.قديم"

# مرساة الثقة المضمّنة (البند 88): الفهرس الرسمي
# الوحيد — مالكه ومستودعه ثابتان في الكود لا في ملف
# يحرره المستخدم؛ فالبصمة لا تُقبل إلا من هذا المصدر
# عند التنزيل من العنوان الافتراضي.
دالة ناشر_الفهرس_الموثوق():
  ارجع "RIO4140"

دالة مستودع_الفهرس_الموثوق():
  ارجع "RIO4140/niva-index"

# هل الرابط من المستودع الرسمي وحده؟
دالة تحقق_مصدر_موثوق(مص_رابط):
  ارجع نصوص.يبدأ_ب(مص_رابط، "https://raw.githubusercontent.com/RIO4140/niva-index/main/")

# الحجم بايتات: أرقام لاتينية فقط، بلا إشارة وبلا فراغ.
دالة صالح_حجم(حج_نص):
  ارجع إصدار.كلها_أرقام(حج_نص)

# تحليل رمز `يعتمد_على`: `-` بلا اعتماديات؛ وإلا
# اعتماديات مفصولة بفاصلة، كل منها `اسم:مواصفة`
# (الفصل على أول نقطتين فقط — فمواصفة المصدر رابط
# فيه نقطتان وشرطات مائلة). والمواصفة تُحلَّل بقاعدة
# البيان نفسها، فما رفضه البيان يرفضه الفهرس.
دالة حلّل_اعتماديات_فهرس(حف_رمز، حف_رقم):
  إذا حف_رمز == "-":
    ارجع {"نجاح": صحيح، "اعتماديات": []}
  حف_أجزاء = حف_رمز.قسم(",")
  حف_اعتماديات = []
  لكل حف_جزء في حف_أجزاء:
    حف_نقطتان = ٠ - ١
    حف_فهرس = ٠
    بينما حف_فهرس < طول(حف_جزء):
      إذا حف_جزء[حف_فهرس] == ":":
        حف_نقطتان = حف_فهرس
        اكسر
      حف_فهرس = حف_فهرس + ١
    إذا حف_نقطتان < ٠:
      ارجع {"نجاح": خطأ، "خطأ": "اعتماديات غير صالحة في الفهرس (السطر " + إصدار.رقم_لاتيني(حف_رقم) + ")"}
    حف_اسم = نصوص.قبل_الفهرس(حف_جزء، حف_نقطتان)
    حف_مواصفة = نصوص.من_الفهرس(حف_جزء، حف_نقطتان + ١)
    إذا طول(حف_اسم) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "اعتماديات غير صالحة في الفهرس (السطر " + إصدار.رقم_لاتيني(حف_رقم) + ")"}
    إذا طول(حف_مواصفة) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "اعتماديات غير صالحة في الفهرس (السطر " + إصدار.رقم_لاتيني(حف_رقم) + ")"}
    إذا بيان.صالح_اسم_حزمة(حف_اسم) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "اسم اعتماد غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(حف_رقم) + ")"}
    حف_محللة = بيان.حلّل_مواصفة(حف_مواصفة)
    إذا حف_محللة["نجاح"] == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "اعتماديات غير صالحة في الفهرس (السطر " + إصدار.رقم_لاتيني(حف_رقم) + ")"}
    حف_اعتماديات.أضف({"اسم": حف_اسم، "نوع": حف_محللة["نوع"]، "مواصفة": حف_محللة["مواصفة"]})
  ارجع {"نجاح": صحيح، "اعتماديات": حف_اعتماديات}

# ترميز اعتماديات بيان إلى رمز الفهرس — عكس التحليل.
دالة رمّز_اعتماديات(رم_اعتماديات):
  إذا طول(رم_اعتماديات) == ٠:
    ارجع "-"
  رم_رمز = ""
  لكل رم_اعتماد في رم_اعتماديات:
    رم_قطعة = رم_اعتماد["اسم"] + ":" + رم_اعتماد["مواصفة"]
    إذا رم_رمز == "":
      رم_رمز = رم_قطعة
    وإلا:
      رم_رمز = رم_رمز + "," + رم_قطعة
  ارجع رم_رمز

# التحقق من بصمة الفهرس (البند 8): البصمة المتوقعة
# 64 خانة ستعشرية صغيرة؛ والمطابقة حساب SHA-256 لنص
# الفهرس نفسه. والفشل رفض صريح — بلا تثبيت جزئي،
# وبلا قراءة أي مدخل من النص.
دالة تحقق_بصمة_الفهرس(بص_نص، بص_متوقعة):
  بص_مقصوصة = بص_متوقعة.قص()
  إذا قفل.صالح_بصمة(بص_مقصوصة) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "بصمة الفهرس غير صالحة — لم يُثبَّت شيء"}
  إذا تشفير.جزّئ(بص_نص) != بص_مقصوصة:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر التحقق من الفهرس — لم يُثبَّت شيء"}
  ارجع {"نجاح": صحيح}

# هل طابع الجلب أحدث من 20 دقيقة (1200 ثانية)؟
# طابع لاشيء (غائب أو فاسد) يعني غير حديث أبدا.
دالة فهرس_حديث(فح_طابع، فح_الآن):
  إذا فح_طابع == لاشيء:
    ارجع خطأ
  إذا فح_الآن - فح_طابع < ١٢٠٠:
    ارجع صحيح
  ارجع خطأ

# التحديث الذكي (البند 5): الفهرس المحفوظ الحديث
# يُستخدم كما هو بلا جلب؛ والقديم يُعاد جلبه بأفضل
# جهد — والفشل دون إنترنت أو بلا بوابة لا يكسر القراءة
# فتُستخدم النسخة المحفوظة؛ وبلا محفوظ أصلا رفض صريح.
# والفهرس المحلي (`--فهرس`) لا يُجدَّد أبدا.
دالة حدّث_ذكي(حذ_خيارات):
  حذ_مجلد = لاشيء
  إذا "مجلد_فهرس" في حذ_خيارات:
    حذ_مجلد = حذ_خيارات["مجلد_فهرس"]
  إذا حذ_مجلد != لاشيء:
    ارجع {"نجاح": صحيح، "حدّث": خطأ، "مصدر": "محلي"}
  حذ_طابع = لاشيء
  حذ_مسار_طابع = مسار_طابع_الفهرس()
  إذا موجود(حذ_مسار_طابع):
    حاول:
      حذ_طابع = عدد(اقرأ_ملف(حذ_مسار_طابع))
    ماعدا:
      حذ_طابع = لاشيء
  إذا فهرس_حديث(حذ_طابع، وقت.الآن()):
    ارجع {"نجاح": صحيح، "حدّث": خطأ، "مصدر": "محفوظ"}
  حذ_نزّل = نزّل_الفهرس(لاشيء)
  إذا حذ_نزّل["نجاح"]:
    ارجع {"نجاح": صحيح، "حدّث": صحيح، "عدد": حذ_نزّل["عدد"]، "مصدر": "مركزي"}
  إذا موجود(مسار_الفهرس_المحفوظ()):
    ارجع {"نجاح": صحيح، "حدّث": خطأ، "مصدر": "محفوظ"}
  ارجع {"نجاح": خطأ، "خطأ": "لا يوجد فهرس محفوظ محليا — اتصل بالإنترنت لتنزيله أولا"}

# المستودعات المشتركة (البند 1): الفهرس الرسمي وحده
# اليوم — كل مستودع بسطر (اسمه ورابطه) + سطر بعددها.
دالة مستودعات():
  مست_قائمة = [{"اسم": "الفهرس الافتراضي"، "رابط": عنوان_الفهرس_الافتراضي()}]
  مست_نص = "الفهرس الافتراضي: " + عنوان_الفهرس_الافتراضي() + "\nعدد المستودعات: 1"
  ارجع {"نجاح": صحيح، "مستودعات": مست_قائمة، "عدد": ١، "نص": مست_نص}

# بصمة الالتزام (الفكرة 3): SHA الكامل للالتزام في مستودع
# المصدر — 40 خانة ستعشرية صغيرة كما يكتبها جيت هاب.
دالة صالح_بصمة_التزام(شا_بصمة):
  إذا طول(شا_بصمة) != ٤٠:
    ارجع خطأ
  شا_فهرس = ٠
  بينما شا_فهرس < طول(شا_بصمة):
    إذا "0123456789abcdef".يحتوي(شا_بصمة[شا_فهرس]) == خطأ:
      ارجع خطأ
    شا_فهرس = شا_فهرس + ١
  ارجع صحيح

# الطابع الزمني (الفكرة 4): صيغة ISO 8601 بتوقيت UTC حصر
# `YYYY-MM-DDTHH:MM:SSZ` — كما يكتبها سير عمل الفهرس.
دالة صالح_طابع(طا_طابع):
  إذا طول(طا_طابع) != ٢٠:
    ارجع خطأ
  إذا طا_طابع[٤] != "-":
    ارجع خطأ
  إذا طا_طابع[٧] != "-":
    ارجع خطأ
  إذا طا_طابع[١٠] != "T":
    ارجع خطأ
  إذا طا_طابع[١٣] != ":":
    ارجع خطأ
  إذا طا_طابع[١٦] != ":":
    ارجع خطأ
  إذا طا_طابع[١٩] != "Z":
    ارجع خطأ
  طا_مواضع = [٠، ١، ٢، ٣، ٥، ٦، ٨، ٩، ١١، ١٢، ١٤، ١٥، ١٧، ١٨]
  لكل طا_موضع في طا_مواضع:
    إذا "0123456789".يحتوي(طا_طابع[طا_موضع]) == خطأ:
      ارجع خطأ
  ارجع صحيح

# المستودع المصدر: `github.com/مالك/مستودع` — بلا مخطط،
# والمقطعان بعد المضيف غير فارغين.
دالة صالح_مستودع(مست_مستودع):
  إذا نصوص.يبدأ_ب(مست_مستودع، "github.com/") == خطأ:
    ارجع خطأ
  مست_باقي = نصوص.من_الفهرس(مست_مستودع، طول("github.com/"))
  مست_أجزاء = مست_باقي.قسم("/")
  إذا طول(مست_أجزاء) != ٢:
    ارجع خطأ
  إذا طول(مست_أجزاء[٠]) == ٠:
    ارجع خطأ
  إذا طول(مست_أجزاء[١]) == ٠:
    ارجع خطأ
  ارجع صحيح

# تحليل سطر فهرس واحد (إدخال أو سحب) مع رقم سطره — كل
# خطأ يسمّي السطر. والوصف باقي السطر بعد الحقول العشرة.
دالة حلّل_سطر_فهرس(سط_سطر، سط_رقم):
  سط_كلمات = نصوص.قسم_كلمات(سط_سطر)
  إذا طول(سط_كلمات) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "سطر فهرس غير صالح (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  إذا سط_كلمات[٠] == "سحب":
    إذا طول(سط_كلمات) < ٣:
      ارجع {"نجاح": خطأ، "خطأ": "سطر سحب غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
    إذا بيان.صالح_اسم_حزمة(سط_كلمات[١]) == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "اسم حزمة غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
    سط_ن_سحب = إصدار.حلّل_إصدار(سط_كلمات[٢])
    إذا سط_ن_سحب["نجاح"] == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
    سط_سبب = ""
    سط_م = ٣
    بينما سط_م < طول(سط_كلمات):
      إذا سط_سبب == "":
        سط_سبب = سط_كلمات[سط_م]
      وإلا:
        سط_سبب = سط_سبب + " " + سط_كلمات[سط_م]
      سط_م = سط_م + ١
    ارجع {"نجاح": صحيح، "نوع": "سحب"، "سحب": {"اسم": سط_كلمات[١]، "إصدار": سط_ن_سحب["قانوني"]، "سبب": سط_سبب، "سطر": سط_رقم}}
  إذا طول(سط_كلمات) < ١٠:
    ارجع {"نجاح": خطأ، "خطأ": "سطر فهرس غير صالح (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  إذا بيان.صالح_اسم_حزمة(سط_كلمات[٠]) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "اسم حزمة غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  سط_ن_إصدار = إصدار.حلّل_إصدار(سط_كلمات[١])
  إذا سط_ن_إصدار["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "إصدار غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  إذا صالح_مستودع(سط_كلمات[٢]) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "مستودع غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  إذا صالح_بصمة_التزام(سط_كلمات[٤]) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "بصمة التزام غير صالحة في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  إذا صالح_طابع(سط_كلمات[٦]) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "طابع زمني غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  إذا قفل.صالح_بصمة(سط_كلمات[٧]) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "بصمة غير صالحة في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  إذا صالح_حجم(سط_كلمات[٨]) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "حجم غير صالح في الفهرس (السطر " + إصدار.رقم_لاتيني(سط_رقم) + ")"}
  سط_اعتماديات = حلّل_اعتماديات_فهرس(سط_كلمات[٩]، سط_رقم)
  إذا سط_اعتماديات["نجاح"] == خطأ:
    ارجع سط_اعتماديات
  سط_وصف = ""
  سط_م_وصف = ١٠
  بينما سط_م_وصف < طول(سط_كلمات):
    إذا سط_وصف == "":
      سط_وصف = سط_كلمات[سط_م_وصف]
    وإلا:
      سط_وصف = سط_وصف + " " + سط_كلمات[سط_م_وصف]
    سط_م_وصف = سط_م_وصف + ١
  ارجع {"نجاح": صحيح، "نوع": "إدخال"، "إدخال": {"اسم": سط_كلمات[٠]، "إصدار": سط_ن_إصدار["قانوني"]، "مستودع": سط_كلمات[٢]، "وسم": سط_كلمات[٣]، "بصمة_التزام": سط_كلمات[٤]، "ناشر": سط_كلمات[٥]، "طابع": سط_كلمات[٦]، "بصمة": سط_كلمات[٧]، "حجم": عدد(سط_كلمات[٨])، "اعتماديات": سط_اعتماديات["اعتماديات"]، "وصف": سط_وصف، "سطر": سط_رقم}}

# تحليل نص فهرس كامل: تعليقات `#` وأسطر فارغة تُتخطى؛
# وسطر مكرر (اسم+إصدار) خطأ، وسحب بلا إدخال منشور خطأ،
# وسحب مكرر خطأ — فالفهرس إلحاقي ولا استبدال صامت فيه.
دالة حلّل_فهرس(فه_نص):
  فه_سطور = فه_نص.قسم("\n")
  فه_إدخالات = []
  فه_سحوبات = []
  فه_رقم = ٠
  لكل فه_سطر_خام في فه_سطور:
    فه_رقم = فه_رقم + ١
    فه_سطر = فه_سطر_خام.قص()
    إذا فه_سطر == "":
      تابع
    إذا فه_سطر[٠] == "#":
      تابع
    فه_ن = حلّل_سطر_فهرس(فه_سطر، فه_رقم)
    إذا فه_ن["نجاح"] == خطأ:
      ارجع فه_ن
    إذا فه_ن["نوع"] == "سحب":
      فه_سحوبات.أضف(فه_ن["سحب"])
    وإلا:
      فه_إدخالات.أضف(فه_ن["إدخال"])
  لكل فه_إدخال_أ في فه_إدخالات:
    لكل فه_إدخال_ب في فه_إدخالات:
      إذا فه_إدخال_أ["سطر"] < فه_إدخال_ب["سطر"]:
        إذا فه_إدخال_أ["اسم"] == فه_إدخال_ب["اسم"]:
          إذا فه_إدخال_أ["إصدار"] == فه_إدخال_ب["إصدار"]:
            ارجع {"نجاح": خطأ، "خطأ": "سطر مكرر في الفهرس: " + فه_إدخال_ب["اسم"] + " " + فه_إدخال_ب["إصدار"] + " (السطر " + إصدار.رقم_لاتيني(فه_إدخال_ب["سطر"]) + ")"}
  لكل فه_سحب_أ في فه_سحوبات:
    فه_وجد = خطأ
    لكل فه_إدخال_ج في فه_إدخالات:
      إذا فه_إدخال_ج["اسم"] == فه_سحب_أ["اسم"]:
        إذا فه_إدخال_ج["إصدار"] == فه_سحب_أ["إصدار"]:
          فه_وجد = صحيح
    إذا فه_وجد == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار " + فه_سحب_أ["إصدار"] + " للحزمة " + فه_سحب_أ["اسم"] + " في الفهرس — لا يمكن سحبه (السطر " + إصدار.رقم_لاتيني(فه_سحب_أ["سطر"]) + ")"}
    لكل فه_سحب_ب في فه_سحوبات:
      إذا فه_سحب_أ["سطر"] < فه_سحب_ب["سطر"]:
        إذا فه_سحب_أ["اسم"] == فه_سحب_ب["اسم"]:
          إذا فه_سحب_أ["إصدار"] == فه_سحب_ب["إصدار"]:
            ارجع {"نجاح": خطأ، "خطأ": "سحب مكرر في الفهرس: " + فه_سحب_ب["اسم"] + " " + فه_سحب_ب["إصدار"] + " (السطر " + إصدار.رقم_لاتيني(فه_سحب_ب["سطر"]) + ")"}
  ارجع {"نجاح": صحيح، "إدخالات": فه_إدخالات، "سحوبات": فه_سحوبات}

# توليد سطر فهرس من قاموس إدخال — ويُعاد تحليله للتأكد
# قبل الرجوع به، فلا سطر مكسور يخرج من هنا أبدا.
# والقاموس يحمل "حجم" (بايتات) و"اعتماديات" (قائمة
# اعتماديات بيان) — وغيابهما خطأ لا افتراض صامت.
دالة سطر_فهرس(سف_إدخال):
  إذا "حجم" في سف_إدخال == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "سطر فهرس يحتاج حجما (بايتات)"}
  إذا "اعتماديات" في سف_إدخال == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "سطر فهرس يحتاج اعتماديات"}
  سف_سطر = سف_إدخال["اسم"] + " " + سف_إدخال["إصدار"] + " " + سف_إدخال["مستودع"] + " " + سف_إدخال["وسم"] + " " + سف_إدخال["بصمة_التزام"] + " " + سف_إدخال["ناشر"] + " " + سف_إدخال["طابع"] + " " + سف_إدخال["بصمة"] + " " + إصدار.رقم_لاتيني(سف_إدخال["حجم"]) + " " + رمّز_اعتماديات(سف_إدخال["اعتماديات"])
  إذا سف_إدخال["وصف"] != "":
    سف_سطر = سف_سطر + " " + سف_إدخال["وصف"]
  سف_ن = حلّل_سطر_فهرس(سف_سطر، ١)
  إذا سف_ن["نجاح"] == خطأ:
    ارجع سف_ن
  ارجع {"نجاح": صحيح، "سطر": سف_سطر}

# توليد سطر سحب — ويُعاد تحليله للتأكد قبل الرجوع به.
دالة سطر_سحب(خط_اسم، خط_إصدار، خط_سبب):
  خط_ن = إصدار.حلّل_إصدار(خط_إصدار)
  إذا خط_ن["نجاح"] == خطأ:
    ارجع خط_ن
  خط_سطر = "سحب " + خط_اسم + " " + خط_ن["قانوني"]
  إذا خط_سبب != "":
    خط_سطر = خط_سطر + " " + خط_سبب
  خط_تحقق = حلّل_سطر_فهرس(خط_سطر، ١)
  إذا خط_تحقق["نجاح"] == خطأ:
    ارجع خط_تحقق
  ارجع {"نجاح": صحيح، "سطر": خط_سطر}

دالة رتّب_أدخل(رتب_قائمة، رتب_موضع، رتب_عنصر):
  رتب_نتيجة = []
  رتب_فهرس = ٠
  بينما رتب_فهرس < طول(رتب_قائمة):
    إذا رتب_فهرس == رتب_موضع:
      رتب_نتيجة.أضف(رتب_عنصر)
    رتب_نتيجة.أضف(رتب_قائمة[رتب_فهرس])
    رتب_فهرس = رتب_فهرس + ١
  إذا رتب_موضع == طول(رتب_قائمة):
    رتب_نتيجة.أضف(رتب_عنصر)
  ارجع رتب_نتيجة

# ترتيب إصدارات: الأحدث أولا (تنازليا) — فيُقرأ [٠]
# أحدث إصدار دائما.
دالة رتّب_إصدارات(رتب_مدخلات):
  رتب_مرتبة = []
  لكل رتب_واحد في رتب_مدخلات:
    رتب_موضع = طول(رتب_مرتبة)
    بينما رتب_موضع > ٠:
      رتب_مقارنة = إصدار.قارن_إصدارين(رتب_واحد، رتب_مرتبة[رتب_موضع - ١])
      رتب_قيمة = ٠
      إذا رتب_مقارنة["نجاح"]:
        رتب_قيمة = رتب_مقارنة["مقارنة"]
      إذا رتب_قيمة > ٠:
        رتب_موضع = رتب_موضع - ١
      وإلا:
        اكسر
    رتب_مرتبة = رتّب_أدخل(رتب_مرتبة، رتب_موضع، رتب_واحد)
  ارجع رتب_مرتبة

# هل هذا الإصدار مسحوب؟ — السحب يبقيه صالحا للقفل
# القديم ولا يُحلّ لجديد (التصميم §16 — الخطوة 5).
دالة مسحوب(مسح_اسم، مسح_إصدار، مسح_سحوبات):
  لكل مسح_سحب في مسح_سحوبات:
    إذا مسح_سحب["اسم"] == مسح_اسم:
      إذا مسح_سحب["إصدار"] == مسح_إصدار:
        ارجع صحيح
  ارجع خطأ

# إصدارات حزمة من الفهرس — الأحدث أولا، فارغة إن غابت.
دالة إصدارات_الحزمة(إص_اسم، إص_إدخالات):
  إص_قائمة = []
  لكل إص_إدخال في إص_إدخالات:
    إذا إص_إدخال["اسم"] == إص_اسم:
      إص_قائمة.أضف(إص_إدخال["إصدار"])
  ارجع رتّب_إصدارات(إص_قائمة)

# أحدث إصدار مستقر غير مسحوب — أو خطأ يسمّي السبب:
# غياب الحزمة، أو سحب كل إصداراتها، أو تجريبية فقط.
دالة أحدث_غير_مسحوب(أح_اسم، أح_إدخالات، أح_سحوبات):
  أح_إصدارات = إصدارات_الحزمة(أح_اسم، أح_إدخالات)
  إذا طول(أح_إصدارات) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + أح_اسم + " غير موجودة في الفهرس"}
  أح_صالحة = []
  لكل أح_إصدار في أح_إصدارات:
    إذا مسحوب(أح_اسم، أح_إصدار، أح_سحوبات) == خطأ:
      أح_صالحة.أضف(أح_إصدار)
  إذا طول(أح_صالحة) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "كل إصدارات الحزمة " + أح_اسم + " مسحوبة — لا يوجد إصدار صالح للتثبيت الجديد"}
  أح_اختيار = إصدار.اختر_إصدار(أح_اسم، {"نوع": "الأحدث"، "مواصفة": "الأحدث"}، أح_صالحة)
  ارجع أح_اختيار

# سطر الإضافة الجاهز الذي يطبعه `ابحث` (التصميم §16).
دالة سطر_إضافة(إض_اسم، إض_إصدار):
  ارجع "حزم أضف " + إض_اسم + " " + إض_إصدار

# كتابة فهرس ذرية: ملف مؤقت ثم `انقل` — فلا ملف
# سليم يُقطع قبل نجاح بديله أبدا.
دالة اكتب_فهرس_ذريا(كف_مسار، كف_نص):
  حاول:
    كف_مؤقت = كف_مسار + ".مؤقت"
    اكتب_ملف(كف_مؤقت، كف_نص)
    انقل(كف_مؤقت، كف_مسار)
    ارجع {"نجاح": صحيح}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر كتابة الفهرس: " + كف_مسار}

# عنوان ملف البصمة المقابل لعنوان فهرس: استبدال
# المقطع الأخير `فهرس.حزمة` بـ`بصمة.فهرس`.
دالة عنوان_بصمة_لعنوان(عب_عنوان):
  عب_لاحقة = "/فهرس.حزمة"
  إذا نصوص.ينتهي_ب(عب_عنوان، عب_لاحقة):
    ارجع نصوص.قبل_الفهرس(عب_عنوان، طول(عب_عنوان) - طول(عب_لاحقة)) + "/بصمة.فهرس"
  ارجع عب_عنوان + "/بصمة.فهرس"

# تنزيل الفهرس من عنوان (أو الافتراضي): `شبكة.اجلب`
# GET فقط تحت بوابة الشبكة؛ والبصمة تُجلب وتُتحقق
# منها قبل قراءة أي مدخل — ففهرس بلا بصمة مطابقة
# يُرفض صراحة ولا يمسّ نسخة محفوظة سليمة أبدا؛
# والتحليل بعد التحقق، والحفظ ذري مع طابع زمني
# (ثواني منذ 1970 بأرقام لاتينية) وبصمة محفوظة؛
# والنسخة المحفوظة السابقة تُنسخ إلى `.قديم` قبل
# الكتابة فوقها (بأفضل جهد — فشل النسخ لا يوقف
# التحديث، فهي ذاكرة لا مصدر حقيقة).
دالة نزّل_الفهرس(نز_عنوان):
  نز_رابط = نز_عنوان
  إذا نز_رابط == لاشيء:
    نز_رابط = عنوان_الفهرس_الافتراضي()
  نز_مخزن = مخزن.تأكد_المخزن()
  إذا نز_مخزن["نجاح"] == خطأ:
    ارجع نز_مخزن
  حاول:
    نز_نص = شبكة.اجلب(نز_رابط)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر تنزيل الفهرس — تأكد من الاتصال بالإنترنت ومن السماح بالشبكة"}
  حاول:
    نز_بصمة_نص = شبكة.اجلب(عنوان_بصمة_لعنوان(نز_رابط))
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر التحقق من الفهرس — لم يُثبَّت شيء"}
  نز_تحقق = تحقق_بصمة_الفهرس(نز_نص، نز_بصمة_نص)
  إذا نز_تحقق["نجاح"] == خطأ:
    ارجع نز_تحقق
  نز_تحليل = حلّل_فهرس(نز_نص)
  إذا نز_تحليل["نجاح"] == خطأ:
    ارجع نز_تحليل
  إذا موجود(مسار_الفهرس_المحفوظ()):
    حاول:
      نز_قديم_نص = اقرأ_ملف(مسار_الفهرس_المحفوظ())
      اكتب_ملف(مسار_الفهرس_القديم()، نز_قديم_نص)
    ماعدا:
      نز_نسخ_قديم_فشل = صحيح
  نز_كتابة = اكتب_فهرس_ذريا(مسار_الفهرس_المحفوظ()، نز_نص)
  إذا نز_كتابة["نجاح"] == خطأ:
    ارجع نز_كتابة
  نز_كتابة_بصمة = اكتب_فهرس_ذريا(مسار_بصمة_الفهرس_المحفوظة()، نز_بصمة_نص.قص())
  إذا نز_كتابة_بصمة["نجاح"] == خطأ:
    ارجع نز_كتابة_بصمة
  نز_ثواني = وقت.الآن()
  حاول:
    اكتب_ملف(مسار_طابع_الفهرس()، إصدار.طبّع_أرقام(نص(نز_ثواني)))
    ارجع {"نجاح": صحيح، "عدد": طول(نز_تحليل["إدخالات"])، "سحوبات": طول(نز_تحليل["سحوبات"])، "طابع": نز_ثواني، "مصدر": "مركزي"، "بصمة": نز_بصمة_نص.قص()}
  ماعدا:
    ارجع {"نجاح": صحيح، "عدد": طول(نز_تحليل["إدخالات"])، "سحوبات": طول(نز_تحليل["سحوبات"])، "طابع": لاشيء، "مصدر": "مركزي"، "بصمة": نز_بصمة_نص.قص()}

# قراءة نص فهرس من مسار (مع سقف 5 ميبيبايت كالبيان).
دالة اقرأ_نص_فهرس(قن_مسار):
  إذا موجود(قن_مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "الفهرس غير موجود: " + قن_مسار}
  إذا حجم_المسار(قن_مسار) > ٥٢٤٢٨٨٠:
    ارجع {"نجاح": خطأ، "خطأ": "الفهرس أكبر من 5 ميبيبايت: " + قن_مسار}
  حاول:
    قن_نص = اقرأ_ملف(قن_مسار)
    ارجع {"نجاح": صحيح، "نص": قن_نص}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة الفهرس: " + قن_مسار}

# قراءة فهرس مجلد محلي — سجل كامل بلا شبكة (التصميم §16).
# وإن وُجد ملف `بصمة.فهرس` في المجلد تُتحقق منه قبل
# قراءة أي مدخل؛ وغيابه يعني فهرسا يملكه المستخدم
# بلا بصمة منشورة فيُقبل كما هو.
دالة اقرأ_فهرس_محلي(مح_مجلد):
  مح_مسار = مح_مجلد + "/فهرس.حزمة"
  إذا موجود(مح_مسار) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد فهرس.حزمة في المجلد " + مح_مجلد}
  مح_نص = اقرأ_نص_فهرس(مح_مسار)
  إذا مح_نص["نجاح"] == خطأ:
    ارجع مح_نص
  مح_مسار_بصمة = مح_مجلد + "/بصمة.فهرس"
  إذا موجود(مح_مسار_بصمة):
    حاول:
      مح_بصمة_نص = اقرأ_ملف(مح_مسار_بصمة)
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة بصمة الفهرس: " + مح_مسار_بصمة}
    مح_تحقق = تحقق_بصمة_الفهرس(مح_نص["نص"]، مح_بصمة_نص)
    إذا مح_تحقق["نجاح"] == خطأ:
      ارجع مح_تحقق
  مح_تحليل = حلّل_فهرس(مح_نص["نص"])
  إذا مح_تحليل["نجاح"] == خطأ:
    ارجع مح_تحليل
  ارجع {"نجاح": صحيح، "إدخالات": مح_تحليل["إدخالات"]، "سحوبات": مح_تحليل["سحوبات"]، "طابع": لاشيء، "مصدر": "محلي"، "مجلد": مح_مجلد}

# قراءة الفهرس الفعّال: مجلد محلي إن حُدد في الخيارات،
# وإلا النسخة المحفوظة، وإلا تنزيل مرة واحدة (إن سُمح)
# ثم قراءة المحفوظ؛ ودون إنترنت وبلا محفوظ رفض صريح.
# والخيارات: {"مجلد_فهرس": مسار أو لاشيء، "تنزيل": صحيح/خطأ}.
# والمحفوظ يُتحقق من بصمته إن وُجد ملفها؛ والتحديث
# الذكي (البند 5) يجدّده إن قَدُم قبل القراءة — إلا مع
# "تنزيل": خطأ فيُقرأ كما هو بلا جلب.
دالة اقرأ_الفهرس(قر_خيارات):
  قر_مجلد = لاشيء
  إذا "مجلد_فهرس" في قر_خيارات:
    قر_مجلد = قر_خيارات["مجلد_فهرس"]
  إذا قر_مجلد != لاشيء:
    ارجع اقرأ_فهرس_محلي(قر_مجلد)
  قر_محفوظ = مسار_الفهرس_المحفوظ()
  إذا موجود(قر_محفوظ):
    قر_نص = اقرأ_نص_فهرس(قر_محفوظ)
    إذا قر_نص["نجاح"] == خطأ:
      ارجع قر_نص
    قر_مسار_بصمة = مسار_بصمة_الفهرس_المحفوظة()
    إذا موجود(قر_مسار_بصمة):
      حاول:
        قر_بصمة_نص = اقرأ_ملف(قر_مسار_بصمة)
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة بصمة الفهرس المحفوظ"}
      قر_تحقق = تحقق_بصمة_الفهرس(قر_نص["نص"]، قر_بصمة_نص)
      إذا قر_تحقق["نجاح"] == خطأ:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر التحقق من الفهرس المحفوظ — لم يُثبَّت شيء"}
    قر_تحليل = حلّل_فهرس(قر_نص["نص"])
    إذا قر_تحليل["نجاح"] == خطأ:
      ارجع قر_تحليل
    قر_طابع = لاشيء
    قر_مسار_طابع = مسار_طابع_الفهرس()
    إذا موجود(قر_مسار_طابع):
      حاول:
        قر_نص_طابع = اقرأ_ملف(قر_مسار_طابع)
        قر_طابع = عدد(قر_نص_طابع)
      ماعدا:
        قر_طابع = لاشيء
    قر_تنزيل = صحيح
    إذا "تنزيل" في قر_خيارات:
      قر_تنزيل = قر_خيارات["تنزيل"]
    إذا قر_تنزيل:
      قر_ذكي = حدّث_ذكي(قر_خيارات)
      إذا قر_ذكي["نجاح"]:
        إذا قر_ذكي["حدّث"]:
          ارجع اقرأ_الفهرس({"مجلد_فهرس": لاشيء، "تنزيل": خطأ})
    ارجع {"نجاح": صحيح، "إدخالات": قر_تحليل["إدخالات"]، "سحوبات": قر_تحليل["سحوبات"]، "طابع": قر_طابع، "مصدر": "محفوظ"}
  قر_تنزيل = صحيح
  إذا "تنزيل" في قر_خيارات:
    قر_تنزيل = قر_خيارات["تنزيل"]
  إذا قر_تنزيل == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد فهرس محفوظ محليا — اتصل بالإنترنت لتنزيله أولا"}
  قر_نزّل = نزّل_الفهرس(لاشيء)
  إذا قر_نزّل["نجاح"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد فهرس محفوظ محليا — اتصل بالإنترنت لتنزيله أولا"}
  ارجع اقرأ_الفهرس({"مجلد_فهرس": لاشيء، "تنزيل": خطأ})

# `حزم ابحث <كلمة>` — بحث في الفهرس بالاسم والوصف؛
# والنتيجة حزمة واحدة بأحدث إصدار مستقر غير مسحوب،
# مع سطر الإضافة الجاهز. والمسحوبة كل إصداراتها لا
# تظهر في البحث (تظهر في `اعرض` مع حالتها).
دالة ابحث(بح_كلمة، بح_خيارات):
  بح_فهرس = اقرأ_الفهرس(بح_خيارات)
  إذا بح_فهرس["نجاح"] == خطأ:
    ارجع بح_فهرس
  بح_أسماء = []
  لكل بح_إدخال في بح_فهرس["إدخالات"]:
    إذا بح_إدخال["اسم"] في بح_أسماء == خطأ:
      بح_أسماء.أضف(بح_إدخال["اسم"])
  بح_نتائج = []
  لكل بح_اسم في بح_أسماء:
    بح_أحدث = أحدث_غير_مسحوب(بح_اسم، بح_فهرس["إدخالات"]، بح_فهرس["سحوبات"])
    إذا بح_أحدث["نجاح"] == خطأ:
      تابع
    بح_إدخال_أحدث = لاشيء
    لكل بح_إدخال_ث في بح_فهرس["إدخالات"]:
      إذا بح_إدخال_ث["اسم"] == بح_اسم:
        إذا بح_إدخال_ث["إصدار"] == بح_أحدث["إصدار"]:
          بح_إدخال_أحدث = بح_إدخال_ث
    إذا بح_إدخال_أحدث == لاشيء:
      تابع
    إذا بح_إدخال_أحدث["اسم"].يحتوي(بح_كلمة):
      بح_نتائج.أضف({"اسم": بح_إدخال_أحدث["اسم"]، "إصدار": بح_إدخال_أحدث["إصدار"]، "وصف": بح_إدخال_أحدث["وصف"]، "سطر_إضافة": سطر_إضافة(بح_إدخال_أحدث["اسم"]، بح_إدخال_أحدث["إصدار"])})
    وإلا إذا بح_إدخال_أحدث["وصف"].يحتوي(بح_كلمة):
      بح_نتائج.أضف({"اسم": بح_إدخال_أحدث["اسم"]، "إصدار": بح_إدخال_أحدث["إصدار"]، "وصف": بح_إدخال_أحدث["وصف"]، "سطر_إضافة": سطر_إضافة(بح_إدخال_أحدث["اسم"]، بح_إدخال_أحدث["إصدار"])})
  بح_مرتبة = قفل.رتّب_حسب_الاسم(بح_نتائج)
  بح_سطور = []
  لكل بح_نتيجة في بح_مرتبة:
    بح_سطور.أضف(بح_نتيجة["اسم"] + " " + بح_نتيجة["إصدار"] + " — " + بح_نتيجة["وصف"])
    بح_سطور.أضف("  " + بح_نتيجة["سطر_إضافة"])
  بح_نص = ""
  بح_أول = صحيح
  لكل بح_سطر في بح_سطور:
    إذا بح_أول == خطأ:
      بح_نص = بح_نص + "\n"
    بح_نص = بح_نص + بح_سطر
    بح_أول = خطأ
  إذا طول(بح_مرتبة) == ٠:
    بح_نص = "لا توجد نتائج لـ " + بح_كلمة
  ارجع {"نجاح": صحيح، "نتائج": بح_مرتبة، "عدد": طول(بح_مرتبة)، "نص": بح_نص}

# `حزم اعرض <اسم>` — تفاصيل حزمة من الفهرس: إصداراتها
# مع علامة السحب وسببها، وحقول شفافية أحدث إصدار
# (المصدر والوسم والناشر والطابع والبصمة)، وسطر الإضافة.
# والمسحوبة كل إصداراتها تُعرض بلا سطر إضافة.
دالة اعرض_حزمة(عرض_اسم، عرض_خيارات):
  عرض_فهرس = اقرأ_الفهرس(عرض_خيارات)
  إذا عرض_فهرس["نجاح"] == خطأ:
    ارجع عرض_فهرس
  عرض_إصدارات = إصدارات_الحزمة(عرض_اسم، عرض_فهرس["إدخالات"])
  إذا طول(عرض_إصدارات) == ٠:
    ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + عرض_اسم + " غير موجودة في الفهرس"}
  عرض_أحدث = أحدث_غير_مسحوب(عرض_اسم، عرض_فهرس["إدخالات"]، عرض_فهرس["سحوبات"])
  عرض_أحدث_إصدار = لاشيء
  إذا عرض_أحدث["نجاح"]:
    عرض_أحدث_إصدار = عرض_أحدث["إصدار"]
  عرض_إدخال_أحدث = لاشيء
  عرض_إصدار_عرض = عرض_إصدارات[٠]
  إذا عرض_أحدث_إصدار != لاشيء:
    عرض_إصدار_عرض = عرض_أحدث_إصدار
  لكل عرض_إدخال في عرض_فهرس["إدخالات"]:
    إذا عرض_إدخال["اسم"] == عرض_اسم:
      إذا عرض_إدخال["إصدار"] == عرض_إصدار_عرض:
        عرض_إدخال_أحدث = عرض_إدخال
  عرض_سطور = [عرض_اسم + " — " + عرض_إدخال_أحدث["وصف"]]
  إذا عرض_أحدث_إصدار != لاشيء:
    عرض_سطور.أضف("الأحدث: " + عرض_أحدث_إصدار)
  وإلا:
    عرض_سطور.أضف("الأحدث: لا يوجد إصدار صالح — كل الإصدارات مسحوبة")
  عرض_سطور.أضف("الإصدارات:")
  لكل عرض_إصدار في عرض_إصدارات:
    عرض_سطر_إصدار = "  " + عرض_إصدار
    إذا مسحوب(عرض_اسم، عرض_إصدار، عرض_فهرس["سحوبات"]):
      عرض_سطر_إصدار = عرض_سطر_إصدار + " (مسحوب"
      لكل عرض_سحب في عرض_فهرس["سحوبات"]:
        إذا عرض_سحب["اسم"] == عرض_اسم:
          إذا عرض_سحب["إصدار"] == عرض_إصدار:
            إذا عرض_سحب["سبب"] != "":
              عرض_سطر_إصدار = عرض_سطر_إصدار + " — " + عرض_سحب["سبب"]
      عرض_سطر_إصدار = عرض_سطر_إصدار + ")"
    عرض_سطور.أضف(عرض_سطر_إصدار)
  عرض_سطور.أضف("المصدر: " + عرض_إدخال_أحدث["مستودع"])
  عرض_سطور.أضف("الوسم: " + عرض_إدخال_أحدث["وسم"])
  عرض_سطور.أضف("الناشر: " + عرض_إدخال_أحدث["ناشر"])
  عرض_سطور.أضف("الطابع: " + عرض_إدخال_أحدث["طابع"])
  عرض_سطور.أضف("البصمة: " + عرض_إدخال_أحدث["بصمة"])
  عرض_سطور.أضف("الحجم: " + إصدار.رقم_لاتيني(عرض_إدخال_أحدث["حجم"]) + " بايت")
  عرض_يعتمد = "بلا اعتماديات"
  إذا طول(عرض_إدخال_أحدث["اعتماديات"]) > ٠:
    عرض_يعتمد = ""
    لكل عرض_اعتماد في عرض_إدخال_أحدث["اعتماديات"]:
      عرض_قطعة = عرض_اعتماد["اسم"] + " " + عرض_اعتماد["مواصفة"]
      إذا عرض_يعتمد == "":
        عرض_يعتمد = عرض_قطعة
      وإلا:
        عرض_يعتمد = عرض_يعتمد + "، " + عرض_قطعة
  عرض_سطور.أضف("يعتمد على: " + عرض_يعتمد)
  إذا عرض_أحدث_إصدار != لاشيء:
    عرض_سطور.أضف("سطر الإضافة: " + سطر_إضافة(عرض_اسم، عرض_أحدث_إصدار))
  عرض_نص = ""
  عرض_أول = صحيح
  لكل عرض_سطر في عرض_سطور:
    إذا عرض_أول == خطأ:
      عرض_نص = عرض_نص + "\n"
    عرض_نص = عرض_نص + عرض_سطر
    عرض_أول = خطأ
  ارجع {"نجاح": صحيح، "نص": عرض_نص، "حزمة": عرض_إدخال_أحدث، "إصدارات": عرض_إصدارات، "الأحدث": عرض_أحدث_إصدار}

# صفوف `قديم` لمشروع: لكل حزمة في القفل — المثبت من
# القفل، والمسموح أحدث ما يطابق مواصفة البيان المباشرة
# في الفهرس (بلا مواصفة مباشرة «—»، وبلا نطاق «رابط»)،
# والأحدث أحدث مستقر غير مسحوب في الفهرس.
دالة صفوف_قديم_مشروع(صم_أساس، صم_فهرس):
  صم_مشروع = مشروع.اقرأ_مشروع(صم_أساس)
  إذا صم_مشروع["نجاح"] == خطأ:
    ارجع صم_مشروع
  صم_قفل = مشروع.اقرأ_قفل_مشروع(صم_أساس)
  إذا صم_قفل["نجاح"] == خطأ:
    ارجع صم_قفل
  إذا صم_قفل["يوجد"] == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد قفل.حزمة — شغّل حزم تحديث"}
  صم_بيان = صم_مشروع["بيان"]
  صم_صفوف = []
  لكل صم_مقفل في صم_قفل["حزم"]:
    صم_اسم = صم_مقفل["اسم"]
    صم_مثبت = صم_مقفل["إصدار"]
    صم_مواصفة = لاشيء
    لكل صم_اعتماد في صم_بيان["اعتماديات"]:
      إذا صم_اعتماد["اسم"] == صم_اسم:
        صم_مواصفة = صم_اعتماد
    إذا صم_مواصفة == لاشيء:
      لكل صم_اعتماد_تطوير في صم_بيان["اعتماديات_التطوير"]:
        إذا صم_اعتماد_تطوير["اسم"] == صم_اسم:
          صم_مواصفة = صم_اعتماد_تطوير
    صم_مسموح = "—"
    صم_أحدث = "؟"
    صم_إصدارات = إصدارات_الحزمة(صم_اسم، صم_فهرس["إدخالات"])
    إذا طول(صم_إصدارات) == ٠:
      صم_مسموح = "غير موجود في الفهرس"
      صم_أحدث = "غير موجود في الفهرس"
    وإلا:
      صم_أحدث_ن = أحدث_غير_مسحوب(صم_اسم، صم_فهرس["إدخالات"]، صم_فهرس["سحوبات"])
      إذا صم_أحدث_ن["نجاح"]:
        صم_أحدث = صم_أحدث_ن["إصدار"]
      وإلا:
        صم_أحدث = "كل الإصدارات مسحوبة"
      إذا صم_مواصفة != لاشيء:
        إذا صم_مواصفة["نوع"] == "مصدر":
          صم_مسموح = "رابط — بلا إصدار"
        وإلا:
          صم_غير_مسحوبة = []
          لكل صم_إصدار في صم_إصدارات:
            إذا مسحوب(صم_اسم، صم_إصدار، صم_فهرس["سحوبات"]) == خطأ:
              صم_غير_مسحوبة.أضف(صم_إصدار)
          صم_اختيار = إصدار.اختر_إصدار(صم_اسم، صم_مواصفة، صم_غير_مسحوبة)
          إذا صم_اختيار["نجاح"]:
            صم_مسموح = صم_اختيار["إصدار"]
          وإلا:
            صم_مسموح = "لا يوجد إصدار مسموح"
    صم_صفوف.أضف({"اسم": صم_اسم، "المثبت": صم_مثبت، "المسموح": صم_مسموح، "الأحدث": صم_أحدث})
  ارجع {"نجاح": صحيح، "صفوف": قفل.رتّب_حسب_الاسم(صم_صفوف)}

# صفوف `قديم` للمخزن العام (بلا مشروع): المثبت من
# المخزن، والأحدث من الفهرس، والمسموح «—» بلا بيان.
دالة صفوف_قديم_مخزن(صخ_فهرس):
  صخ_سرد = مشروع.سرد_مجلد("$نيفا/.نيفا/حزم")
  إذا صخ_سرد["نجاح"] == خطأ:
    ارجع {"نجاح": صحيح، "صفوف": []}
  صخ_صفوف = []
  لكل صخ_مدخل في صخ_سرد["مدخلات"]:
    إذا صخ_مدخل["نوع"] == "مجلد":
      صخ_مثبتة = مشروع.بصمة_مثبتة("$نيفا/.نيفا/حزم/" + صخ_مدخل["مسار"])
      إذا صخ_مثبتة["نجاح"]:
        صخ_اسم = صخ_مثبتة["اسم"]
        صخ_مثبت = صخ_مثبتة["إصدار"]
        صخ_أحدث = "؟"
        صخ_إصدارات = إصدارات_الحزمة(صخ_اسم، صخ_فهرس["إدخالات"])
        إذا طول(صخ_إصدارات) == ٠:
          صخ_أحدث = "غير موجود في الفهرس"
        وإلا:
          صخ_أحدث_ن = أحدث_غير_مسحوب(صخ_اسم، صخ_فهرس["إدخالات"]، صخ_فهرس["سحوبات"])
          إذا صخ_أحدث_ن["نجاح"]:
            صخ_أحدث = صخ_أحدث_ن["إصدار"]
          وإلا:
            صخ_أحدث = "كل الإصدارات مسحوبة"
        صخ_صفوف.أضف({"اسم": صخ_اسم، "المثبت": صخ_مثبت، "المسموح": "—"، "الأحدث": صخ_أحدث})
  ارجع {"نجاح": صحيح، "صفوف": قفل.رتّب_حسب_الاسم(صخ_صفوف)}

# `حزم قديم [اسم]` — بلا اسم: جدول المثبت/المسموح/
# الأحدث لمشروع (أو للمخزن العام بلا مشروع)؛ وباسم:
# إصدارات الحزمة في الفهرس مع علامتي الأحدث والمسحوب.
دالة قديم(قد_اسم، قد_خيارات):
  قد_فهرس = اقرأ_الفهرس(قد_خيارات)
  إذا قد_فهرس["نجاح"] == خطأ:
    ارجع قد_فهرس
  إذا قد_اسم != لاشيء:
    قد_إصدارات = إصدارات_الحزمة(قد_اسم، قد_فهرس["إدخالات"])
    إذا طول(قد_إصدارات) == ٠:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + قد_اسم + " غير موجودة في الفهرس"}
    قد_أحدث = أحدث_غير_مسحوب(قد_اسم، قد_فهرس["إدخالات"]، قد_فهرس["سحوبات"])
    قد_سطور = [قد_اسم + ":"]
    لكل قد_إصدار في قد_إصدارات:
      قد_سطر = "  " + قد_إصدار
      قد_تجريبي = إصدار.تجريبي(قد_إصدار)
      إذا قد_تجريبي["نجاح"]:
        إذا قد_تجريبي["تجريبي"]:
          قد_سطر = قد_سطر + " (تجريبي)"
      إذا قد_أحدث["نجاح"]:
        إذا قد_إصدار == قد_أحدث["إصدار"]:
          قد_سطر = قد_سطر + " (الأحدث)"
      إذا مسحوب(قد_اسم، قد_إصدار، قد_فهرس["سحوبات"]):
        قد_سطر = قد_سطر + " (مسحوب)"
      قد_سطور.أضف(قد_سطر)
    قد_نص = ""
    قد_أول = صحيح
    لكل قد_سطر_ن في قد_سطور:
      إذا قد_أول == خطأ:
        قد_نص = قد_نص + "\n"
      قد_نص = قد_نص + قد_سطر_ن
      قد_أول = خطأ
    ارجع {"نجاح": صحيح، "نص": قد_نص، "إصدارات": قد_إصدارات، "الأحدث": قد_أحدث}
  قد_مشروع = مشروع.اقرأ_مشروع("")
  إذا قد_مشروع["نجاح"]:
    قد_صفوف = صفوف_قديم_مشروع("", قد_فهرس)
  وإلا:
    قد_صفوف = صفوف_قديم_مخزن(قد_فهرس)
  إذا قد_صفوف["نجاح"] == خطأ:
    ارجع قد_صفوف
  إذا طول(قد_صفوف["صفوف"]) == ٠:
    ارجع {"نجاح": صحيح، "صفوف": []، "نص": "لا توجد حزم مثبّتة"}
  قد_سطور_جدول = ["المثبت / المسموح / الأحدث:"]
  لكل قد_صف في قد_صفوف["صفوف"]:
    قد_سطور_جدول.أضف(قد_صف["اسم"] + ": المثبت " + قد_صف["المثبت"] + "، المسموح " + قد_صف["المسموح"] + "، الأحدث " + قد_صف["الأحدث"])
  قد_نص_جدول = ""
  قد_أول_جدول = صحيح
  لكل قد_سطر_ج في قد_سطور_جدول:
    إذا قد_أول_جدول == خطأ:
      قد_نص_جدول = قد_نص_جدول + "\n"
    قد_نص_جدول = قد_نص_جدول + قد_سطر_ج
    قد_أول_جدول = خطأ
  ارجع {"نجاح": صحيح، "صفوف": قد_صفوف["صفوف"]، "نص": قد_نص_جدول}

# `حزم اسحب <اسم> <إصدار> [سبب...]` — إلحاق سطر سحب
# بفهرس محلي يملكه المستخدم (الفهرس المركزي يُسحب
# بطلب دمج — انظر خطة الخطوة الخامسة). والسطر المنشور
# يبقى في الملف حرفيا — لا حذف ولا استبدال أبدا.
دالة اسحب(سحب_اسم، سحب_إصدار، سحب_سبب، سحب_خيارات):
  سحب_مجلد = لاشيء
  إذا "مجلد_فهرس" في سحب_خيارات:
    سحب_مجلد = سحب_خيارات["مجلد_فهرس"]
  إذا سحب_مجلد == لاشيء:
    ارجع {"نجاح": خطأ، "خطأ": "السحب يكون في فهرس محلي — حدّد المجلد بـ --فهرس <مجلد> (سحب نسخة من الفهرس المركزي يتم بطلب دمج — انظر خطة الخطوة الخامسة)"}
  سحب_ن_إصدار = إصدار.حلّل_إصدار(سحب_إصدار)
  إذا سحب_ن_إصدار["نجاح"] == خطأ:
    ارجع سحب_ن_إصدار
  سحب_قانوني = سحب_ن_إصدار["قانوني"]
  سحب_فهرس = اقرأ_فهرس_محلي(سحب_مجلد)
  إذا سحب_فهرس["نجاح"] == خطأ:
    ارجع سحب_فهرس
  سحب_موجود = خطأ
  لكل سحب_إدخال في سحب_فهرس["إدخالات"]:
    إذا سحب_إدخال["اسم"] == سحب_اسم:
      إذا سحب_إدخال["إصدار"] == سحب_قانوني:
        سحب_موجود = صحيح
  إذا سحب_موجود == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "لا يوجد إصدار " + سحب_قانوني + " للحزمة " + سحب_اسم + " في الفهرس — لا يمكن سحبه"}
  إذا مسحوب(سحب_اسم، سحب_قانوني، سحب_فهرس["سحوبات"]):
    ارجع {"نجاح": خطأ، "خطأ": "الإصدار " + سحب_قانوني + " للحزمة " + سحب_اسم + " مسحوب أصلا"}
  سحب_سطر = سطر_سحب(سحب_اسم، سحب_قانوني، سحب_سبب)
  إذا سحب_سطر["نجاح"] == خطأ:
    ارجع سحب_سطر
  سحب_مسار = سحب_مجلد + "/فهرس.حزمة"
  حاول:
    سحب_نص_قديم = اقرأ_ملف(سحب_مسار)
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة الفهرس: " + سحب_مسار}
  إذا سحب_نص_قديم != "":
    إذا نصوص.ينتهي_ب(سحب_نص_قديم، "\n") == خطأ:
      سحب_نص_قديم = سحب_نص_قديم + "\n"
  سحب_نص_جديد = سحب_نص_قديم + سحب_سطر["سطر"] + "\n"
  سحب_كتابة = اكتب_فهرس_ذريا(سحب_مسار، سحب_نص_جديد)
  إذا سحب_كتابة["نجاح"] == خطأ:
    ارجع سحب_كتابة
  سحب_مسار_بصمة = سحب_مجلد + "/بصمة.فهرس"
  إذا موجود(سحب_مسار_بصمة):
    سحب_كتابة_بصمة = اكتب_فهرس_ذريا(سحب_مسار_بصمة، تشفير.جزّئ(سحب_نص_جديد))
    إذا سحب_كتابة_بصمة["نجاح"] == خطأ:
      ارجع سحب_كتابة_بصمة
  ارجع {"نجاح": صحيح، "نص": "سُحب الإصدار " + سحب_قانوني + " للحزمة " + سحب_اسم}

# `حزم كلها` — كل الوحدات المتاحة في الفهرس (البند 12):
# حزمة واحدة بأحدث إصدار مستقر غير مسحوب، مع وصفها؛
# والمسحوبة كل إصداراتها ليست متاحة فلا تظهر.
دالة كلها(كله_خيارات):
  كله_فهرس = اقرأ_الفهرس(كله_خيارات)
  إذا كله_فهرس["نجاح"] == خطأ:
    ارجع كله_فهرس
  كله_أسماء = []
  لكل كله_إدخال في كله_فهرس["إدخالات"]:
    إذا كله_إدخال["اسم"] في كله_أسماء == خطأ:
      كله_أسماء.أضف(كله_إدخال["اسم"])
  كله_وحدات = []
  لكل كله_اسم في كله_أسماء:
    كله_أحدث = أحدث_غير_مسحوب(كله_اسم، كله_فهرس["إدخالات"]، كله_فهرس["سحوبات"])
    إذا كله_أحدث["نجاح"] == خطأ:
      تابع
    كله_إدخال_أحدث = لاشيء
    لكل كله_إدخال_ث في كله_فهرس["إدخالات"]:
      إذا كله_إدخال_ث["اسم"] == كله_اسم:
        إذا كله_إدخال_ث["إصدار"] == كله_أحدث["إصدار"]:
          كله_إدخال_أحدث = كله_إدخال_ث
    إذا كله_إدخال_أحدث == لاشيء:
      تابع
    كله_وحدات.أضف({"اسم": كله_اسم، "إصدار": كله_أحدث["إصدار"]، "وصف": كله_إدخال_أحدث["وصف"]})
  كله_مرتبة = قفل.رتّب_حسب_الاسم(كله_وحدات)
  كله_سطور = []
  لكل كله_وحدة في كله_مرتبة:
    كله_سطور.أضف(كله_وحدة["اسم"] + " " + كله_وحدة["إصدار"] + " — " + كله_وحدة["وصف"])
  كله_سطور.أضف("عدد الوحدات: " + إصدار.رقم_لاتيني(طول(كله_مرتبة)))
  كله_نص = ""
  كله_أول = صحيح
  لكل كله_سطر في كله_سطور:
    إذا كله_أول == خطأ:
      كله_نص = كله_نص + "\n"
    كله_نص = كله_نص + كله_سطر
    كله_أول = خطأ
  إذا طول(كله_مرتبة) == ٠:
    كله_نص = "لا توجد وحدات في الفهرس"
  ارجع {"نجاح": صحيح، "وحدات": كله_مرتبة، "عدد": طول(كله_مرتبة)، "نص": كله_نص}

# هل الإصدار الأول أحدث من الثاني؟ — مقارنة قانونية،
# وما لا يُقارن (نص ليس إصدارا) يعني لا.
دالة أحدث_من(أح_أ، أح_ب):
  أح_مقارنة = إصدار.قارن_إصدارين(أح_أ، أح_ب)
  إذا أح_مقارنة["نجاح"] == خطأ:
    ارجع خطأ
  إذا أح_مقارنة["مقارنة"] > ٠:
    ارجع صحيح
  ارجع خطأ

# `حزم ما-الجديد` (البند 86): المثبّت الذي له إصدار
# أحدث في الفهرس — سطر لكل وحدة (المثبت والأحدث)،
# أو «كل شيء محدّث». والمقارنة من صفوف `قديم` نفسها.
دالة ما_الجديد(جد_خيارات):
  جد_فهرس = اقرأ_الفهرس(جد_خيارات)
  إذا جد_فهرس["نجاح"] == خطأ:
    ارجع جد_فهرس
  جد_مشروع = مشروع.اقرأ_مشروع("")
  إذا جد_مشروع["نجاح"]:
    جد_صفوف = صفوف_قديم_مشروع("", جد_فهرس)
  وإلا:
    جد_صفوف = صفوف_قديم_مخزن(جد_فهرس)
  إذا جد_صفوف["نجاح"] == خطأ:
    ارجع جد_صفوف
  جد_جديدة = []
  لكل جد_صف في جد_صفوف["صفوف"]:
    إذا أحدث_من(جد_صف["الأحدث"]، جد_صف["المثبت"]):
      جد_جديدة.أضف(جد_صف)
  إذا طول(جد_جديدة) == ٠:
    ارجع {"نجاح": صحيح، "صفوف": []، "نص": "كل شيء محدّث"}
  جد_سطور = ["ما الجديد:"]
  لكل جد_صف_ج في جد_جديدة:
    جد_سطور.أضف(جد_صف_ج["اسم"] + ": المثبت " + جد_صف_ج["المثبت"] + "، الأحدث " + جد_صف_ج["الأحدث"])
  جد_نص = ""
  جد_أول = صحيح
  لكل جد_سطر في جد_سطور:
    إذا جد_أول == خطأ:
      جد_نص = جد_نص + "\n"
    جد_نص = جد_نص + جد_سطر
    جد_أول = خطأ
  ارجع {"نجاح": صحيح، "صفوف": جد_جديدة، "نص": جد_نص}

# `حزم نظف-القديم` (البندان 92 و93): يحذف النسخة
# السابقة من الفهرس المحفوظ وحدها؛ والفهرس الحالي
# لا يُمس.
دالة نظف_القديم():
  نظق_مسار = مسار_الفهرس_القديم()
  إذا موجود(نظق_مسار) == خطأ:
    ارجع {"نجاح": صحيح، "حذف": خطأ، "نص": "لا يوجد فهرس قديم"}
  حاول:
    احذف(نظق_مسار)
    ارجع {"نجاح": صحيح، "حذف": صحيح، "نص": "مُسح الفهرس القديم"}
  ماعدا:
    ارجع {"نجاح": خطأ، "خطأ": "تعذّر مسح الفهرس القديم: " + نظق_مسار}

# `حزم نظف` (البندان 92 و93): يمسح ذاكرة الفهرس كلها
# (المحفوظ وطابعه وبصمته والقديم)؛ ويُعاد الجلب عند
# الحاجة. والمثبّتات لا تُمس أبدا.
دالة نظف():
  نظ_مسارات = [مسار_الفهرس_المحفوظ()، مسار_طابع_الفهرس()، مسار_بصمة_الفهرس_المحفوظة()، مسار_الفهرس_القديم()]
  نظ_عدد = ٠
  لكل نظ_مسار في نظ_مسارات:
    إذا موجود(نظ_مسار):
      حاول:
        احذف(نظ_مسار)
        نظ_عدد = نظ_عدد + ١
      ماعدا:
        ارجع {"نجاح": خطأ، "خطأ": "تعذّر مسح ذاكرة الفهرس: " + نظ_مسار}
  إذا نظ_عدد == ٠:
    ارجع {"نجاح": صحيح، "حذف": ٠، "نص": "لا توجد ذاكرة فهرس"}
  ارجع {"نجاح": صحيح، "حذف": نظ_عدد، "نص": "مُسحت ذاكرة الفهرس"}

# تحويل إدخالات الفهرس إلى فهرس الحلّال (البند 87):
# كل إدخال مرشح ببيان مركّب من حقول الفهرس — والبيان
# يحمل اعتماديات الإدخال كما نُشرت، فيحلّها الحلّال
# عند التثبيت كما يحلّ اعتماديات البيان المحلي.
# والمسحوبة تُستبعد: لا تُحلّ لتثبيت جديد أبدا
# (وتبقى صالحة للأقفال القديمة عبر فهارسها اليدوية).
دالة مرشحات_للحلّ(مر_إدخالات، مر_سحوبات):
  مر_فهرس = {}
  لكل مر_إدخال في مر_إدخالات:
    إذا مسحوب(مر_إدخال["اسم"]، مر_إدخال["إصدار"]، مر_سحوبات):
      تابع
    مر_بيان = {"اسم": مر_إدخال["اسم"]، "إصدار": مر_إدخال["إصدار"]، "وصف": مر_إدخال["وصف"]، "دخول": ""، "نسخة_نيفا": لاشيء، "اعتماديات": مر_إدخال["اعتماديات"]، "اعتماديات_التطوير": []، "تجاوز": []}
    مر_مرشح = {"إصدار": مر_إدخال["إصدار"]، "بيان": مر_بيان، "مصدر": مر_إدخال["مستودع"]، "بصمة": مر_إدخال["بصمة"]}
    إذا مر_إدخال["اسم"] في مر_فهرس:
      مر_قائمة = مر_فهرس[مر_إدخال["اسم"]]
      مر_قائمة.أضف(مر_مرشح)
      مر_فهرس[مر_إدخال["اسم"]] = مر_قائمة
    وإلا:
      مر_فهرس[مر_إدخال["اسم"]] = [مر_مرشح]
  ارجع {"نجاح": صحيح، "فهرس": مر_فهرس}

# `حزم أعد-التثبيت <اسم>` (البند 15): إعادة تثبيت
# وحدة مثبّتة — في المشروع بالنسخة المقفلة، وفي
# المخزن العام بأحدث نسخة غير مسحوبة من الفهرس.
# والمصدر نسخة المخزن العام `<اسم>-<إصدار>`؛ وغيابه
# رفض صريح بلا تثبيت جزئي. والبصمة تُتحقق قبل النسخ
# وبعده؛ وملف `إعدادات.حزمة` يُحفظ ويُعاد مكانه.
دالة أعد_تثبيت(أعت_اسم، أعت_خيارات):
  أعت_مثبت = مشروع.مجلد_مثبت("", أعت_اسم)
  إذا أعت_مثبت["نجاح"] == خطأ:
    ارجع أعت_مثبت
  أعت_مسار = أعت_مثبت["مسار"]
  أعت_سابق = أعت_مثبت["إصدار"]
  أعت_هدف = لاشيء
  أعت_بصمة = لاشيء
  إذا أعت_مثبت["مشروع"]:
    أعت_قفل = مشروع.اقرأ_قفل_مشروع("")
    إذا أعت_قفل["نجاح"] == خطأ:
      ارجع أعت_قفل
    لكل أعت_مقفلة في أعت_قفل["حزم"]:
      إذا أعت_مقفلة["اسم"] == أعت_اسم:
        أعت_هدف = أعت_مقفلة["إصدار"]
        أعت_بصمة = أعت_مقفلة["بصمة"]
    إذا أعت_هدف == لاشيء:
      ارجع {"نجاح": خطأ، "خطأ": "الحزمة " + أعت_اسم + " ليست في قفل المشروع — ثبّتها أولا"}
  وإلا:
    أعت_فهرس = اقرأ_الفهرس(أعت_خيارات)
    إذا أعت_فهرس["نجاح"] == خطأ:
      ارجع أعت_فهرس
    أعت_أحدث = أحدث_غير_مسحوب(أعت_اسم، أعت_فهرس["إدخالات"]، أعت_فهرس["سحوبات"])
    إذا أعت_أحدث["نجاح"] == خطأ:
      ارجع أعت_أحدث
    أعت_هدف = أعت_أحدث["إصدار"]
    لكل أعت_إدخال في أعت_فهرس["إدخالات"]:
      إذا أعت_إدخال["اسم"] == أعت_اسم:
        إذا أعت_إدخال["إصدار"] == أعت_هدف:
          أعت_بصمة = أعت_إدخال["بصمة"]
  أعت_مصدر = "$نيفا/.نيفا/حزم/" + أعت_اسم + "-" + أعت_هدف
  إذا موجود(أعت_مصدر) == خطأ:
    ارجع {"نجاح": خطأ، "خطأ": "غير متصل — والحزمة " + أعت_اسم + " " + أعت_هدف + " غير محفوظة محليا"}
  أعت_بصمة_مصدر = مشروع.بصمة_مثبتة(أعت_مصدر)
  إذا أعت_بصمة_مصدر["نجاح"] == خطأ:
    ارجع أعت_بصمة_مصدر
  إذا أعت_بصمة_مصدر["بصمة"] != أعت_بصمة:
    ارجع {"نجاح": خطأ، "خطأ": "بصمة الحزمة " + أعت_اسم + " لا تطابق البصمة المسجلة"}
  # المصدر هو الهدف نفسه (إعادة تثبيت نفس النسخة في
  # المخزن): لا حذف ولا نسخ — البصمة تحققت أعلاه،
  # والملفات والإعدادات تبقى كما هي.
  إذا أعت_مصدر == أعت_مسار:
    ارجع {"نجاح": صحيح، "اسم": أعت_اسم، "سابق": أعت_سابق، "إصدار": أعت_هدف، "نص": "أُعيد تثبيت الحزمة " + أعت_اسم + " " + أعت_هدف}
  أعت_إعداد = لاشيء
  أعت_مسار_إعداد = أعت_مسار + "/إعدادات.حزمة"
  إذا موجود(أعت_مسار_إعداد):
    حاول:
      أعت_إعداد = اقرأ_ملف(أعت_مسار_إعداد)
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر قراءة إعدادات الحزمة " + أعت_اسم}
  أعت_حذف = مشروع.احذف_شجرة(أعت_مسار)
  إذا أعت_حذف["نجاح"] == خطأ:
    ارجع أعت_حذف
  أعت_نسخ = مشروع.انسخ_مجلد(أعت_مصدر، أعت_مسار)
  إذا أعت_نسخ["نجاح"] == خطأ:
    إذا أعت_إعداد != لاشيء:
      حاول:
        أنشئ_مجلد(أعت_مسار)
        اكتب_ملف(أعت_مسار_إعداد، أعت_إعداد)
      ماعدا:
        ارجع أعت_نسخ
    ارجع أعت_نسخ
  أعت_بصمة_بعد = مشروع.بصمة_مثبتة(أعت_مسار)
  إذا أعت_بصمة_بعد["نجاح"] == خطأ:
    مشروع.احذف_شجرة(أعت_مسار)
    ارجع أعت_بصمة_بعد
  إذا أعت_بصمة_بعد["بصمة"] != أعت_بصمة:
    مشروع.احذف_شجرة(أعت_مسار)
    إذا أعت_إعداد != لاشيء:
      حاول:
        أنشئ_مجلد(أعت_مسار)
        اكتب_ملف(أعت_مسار_إعداد، أعت_إعداد)
      ماعدا:
        أعت_إعادة_إعداد_فشلت = صحيح
    ارجع {"نجاح": خطأ، "خطأ": "بصمة الحزمة " + أعت_اسم + " لا تطابق البصمة المسجلة"}
  إذا أعت_إعداد != لاشيء:
    حاول:
      اكتب_ملف(أعت_مسار_إعداد، أعت_إعداد)
    ماعدا:
      ارجع {"نجاح": خطأ، "خطأ": "تعذّر إعادة إعدادات الحزمة " + أعت_اسم}
  إذا أعت_هدف == أعت_سابق:
    ارجع {"نجاح": صحيح، "اسم": أعت_اسم، "سابق": أعت_سابق، "إصدار": أعت_هدف، "نص": "أُعيد تثبيت الحزمة " + أعت_اسم + " " + أعت_هدف}
  ارجع {"نجاح": صحيح، "اسم": أعت_اسم، "سابق": أعت_سابق، "إصدار": أعت_هدف، "نص": "أُعيد تثبيت الحزمة " + أعت_اسم + " — من " + أعت_سابق + " إلى " + أعت_هدف}

# ترقية المخزن العام (نصف `رقّ` — البند 16): كل
# مثبّتة في المخزن لها أحدث في الفهرس تُعاد تثبيتها؛
# وعند أول فشل يُتوقف ويُرجع الخطأ مع ما رُقّي قبله.
دالة رقّ_المخزن(رق_خيارات):
  رق_فهرس = اقرأ_الفهرس(رق_خيارات)
  إذا رق_فهرس["نجاح"] == خطأ:
    ارجع رق_فهرس
  رق_صفوف = صفوف_قديم_مخزن(رق_فهرس)
  إذا رق_صفوف["نجاح"] == خطأ:
    ارجع رق_صفوف
  رق_رقّى = []
  رق_سطور = []
  لكل رق_صف في رق_صفوف["صفوف"]:
    إذا أحدث_من(رق_صف["الأحدث"]، رق_صف["المثبت"]) == خطأ:
      تابع
    رق_نتيجة = أعد_تثبيت(رق_صف["اسم"]، رق_خيارات)
    إذا رق_نتيجة["نجاح"] == خطأ:
      ارجع {"نجاح": خطأ، "خطأ": رق_نتيجة["خطأ"]، "رقّى": رق_رقّى}
    رق_رقّى.أضف(رق_نتيجة)
    رق_سطور.أضف(رق_صف["اسم"] + ": " + رق_صف["المثبت"] + " ← " + رق_صف["الأحدث"])
  إذا طول(رق_رقّى) == ٠:
    ارجع {"نجاح": صحيح، "رقّى": []، "نص": "كل شيء محدّث"}
  رق_نص = "رُقّيت الوحدات:"
  لكل رق_سطر في رق_سطور:
    رق_نص = رق_نص + "\n" + رق_سطر
  ارجع {"نجاح": صحيح، "رقّى": رق_رقّى، "نص": رق_نص}
